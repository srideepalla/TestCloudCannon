---
import ArticleSchema from "@components/utils/ArticleSchema.astro";
import BreadcrumbSchema from "@components/utils/BreadcrumbSchema.astro";
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Footer from "@components/navigation/footer/Footer.astro";
import MainNavigation from "@components/navigation/main-nav/MainNav.astro";
import Side from "@components/navigation/side/Side.astro";
import MainComponent from "@components/utils/MainComponent.astro";
import LocalizedLink from "@components/utils/LocalizedLink.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Text from "@core-elements/text/Text.astro";
import footerData from "@data/footer.json";
import mainNavData from "@data/mainNav.json";
import seoData from "@data/seo.json";
import sidebarNavData from "@data/sidebarNav.json";
import Layout from "@layouts/BaseLayout.astro";
import Split from "@wrappers/split/Split.astro";
import { render } from "astro:content";
import { getCurrentLocale, localizeData, localizeText, localizePath } from "@utils/i18n";

const componentImports = {
  ...import.meta.glob("../components/building-blocks/**/*.astro", { eager: true }),
  ...import.meta.glob("../components/page-sections/**/*.astro", { eager: true }),
};

const mdxComponents: Record<string, any> = {};

Object.entries(componentImports).forEach(([path, module]) => {
  const fileName = path.split("/").at(-1)!.replace(".astro", "");

  mdxComponents[fileName] = (module as any).default;
});

// Localize internal links inside rendered markdown/MDX bodies (keeps the locale).
mdxComponents.a = LocalizedLink;

interface SidebarLink {
  text: string;
  href: string;
  openInNewTab?: boolean;
}

interface Props {
  title: string;
  pageHeading?: string;
  description?: string;
  image?: string;
  collection: string;
  slug?: string;
  entry?: any;
  noindex?: boolean;
}

const { title, pageHeading, description, image, collection, entry, noindex } = Astro.props;
const sidebar = (sidebarNavData as Record<string, { heading: string; links: SidebarLink[] }>)[
  collection
];
const locale = getCurrentLocale(Astro.url.pathname);
const sidebarNavItems = sidebar?.links.map((link) => ({ name: localizeText(link.text, locale), path: link.href, openInNewTab: link.openInNewTab })) ?? [];
const sidebarHeading = localizeText(sidebar?.heading, locale);
const homeLabel = localizeText("Home", locale);
const Content = entry ? (await render(entry)).Content : null;
const pageSections = entry?.data?.pageSections ?? [];
const sidebarBlocks = entry?.data?.sidebarBlocks ?? [];
const pageDescription = description || seoData.description;

const siteOrigin = "https://iba.stevieawards.com";
const sectionPath = `/${collection}/${sidebar?.links[0]?.href.split("/").pop()}`;

// For nested pages (e.g. a committee under the "Judging Committees" listing),
// derive an intermediate breadcrumb from the entry's parent slug segment and
// match it to the matching sidebar link so it shows a readable label + link.
const slugParts = (entry?.id ?? "").split("/").filter(Boolean);
const parentSegment = slugParts.length > 1 ? slugParts[0] : null;
const parentLink = parentSegment
  ? sidebar?.links.find(
      (l: SidebarLink) =>
        l.href.split("/").pop()?.toLowerCase() === parentSegment.toLowerCase()
    )
  : null;

const breadcrumbItems = [
  { name: "Home", url: `${siteOrigin}/` },
  ...(sidebar?.heading
    ? [{ name: sidebar.heading, url: `${siteOrigin}${sectionPath}` }]
    : []),
  ...(parentLink
    ? [{ name: parentLink.text, url: `${siteOrigin}${parentLink.href}` }]
    : []),
  { name: title, url: Astro.url.href },
];

const articleDate = entry?.data?.date ?? null;
const articleAuthor = entry?.data?.author ?? null;
---

<Layout
  title={title}
  description={pageDescription}
  image={image}
  noindex={noindex}
  ogType={articleDate ? "article" : "website"}
>
  <BreadcrumbSchema
    slot="head"
    items={breadcrumbItems}
  />

  {
    articleDate && (
      <ArticleSchema
        slot="head"
        headline={title}
        description={pageDescription}
        image={image}
        datePublished={articleDate}
        author={articleAuthor}
        url={Astro.url.href}
      />
    )
  }

  <!-- banner landmark — see the note in Page.astro. -->
  <header>
    <!-- First focusable element in the document (WCAG 2.4.1). -->
    <a
      class="skip-link"
      href="#main"
    >
      Skip to main content
    </a>
    <MainNavigation {...localizeData(mainNavData, locale)} />
  </header>

  <CustomSection
    colorScheme="dark"
    backgroundColor="base"
    maxContentWidth="3xl"
    paddingHorizontal="xl"
    paddingVertical="sm"
    class="breadcrumb-bar"
  >
    <nav aria-label="Breadcrumb">
      <a href={localizePath("/", Astro.url.pathname)}>{homeLabel}</a>
      <span class="breadcrumb-sep">&gt;</span>
      <a href={localizePath(`/${collection}/${sidebar?.links[0]?.href.split("/").pop()}`, Astro.url.pathname)}>{sidebarHeading}</a>
      <span class="breadcrumb-sep">&gt;</span>
      {
        parentLink && (
          <>
            <a href={localizePath(parentLink.href, Astro.url.pathname)}>{localizeText(parentLink.text, locale)}</a>
            <span class="breadcrumb-sep">&gt;</span>
          </>
        )
      }
      <span
        class="breadcrumb-current"
        aria-current="page">{title}</span>
    </nav>
  </CustomSection>

  <!-- The sidebar is a complementary landmark, which must not sit inside <main>.
       <main> therefore wraps the content column only, and the two are siblings
       inside the split. This also makes the skip link bypass the sidebar nav. -->
  <div class="collection-layout">
    <CustomSection
      colorScheme="light"
      backgroundColor="base"
      maxContentWidth="3xl"
      paddingHorizontal="xl"
      paddingVertical="3xl"
      class="collection-section"
    >
      <Split
        distributionMode="fixed-flexible"
        fixedWidth={280}
        minSplitWidth={1024}
        gap="6xl"
        class="collection-split"
      >
        {/* An <aside> scoped to sectioning content (this sits inside the section
            CustomSection renders) maps to `generic` unless it has an accessible
            name. Without the label it is not a landmark at all, and its contents
            count as page content outside any landmark. */}
        {
          sidebar && (
            <aside
              slot="first"
              class="collection-sidebar"
              aria-label={sidebar.heading}
            >
              <div
                class="sidebar-heading"
                data-theme="dark"
              >
                {sidebar.heading}
              </div>
              <Side
                navData={sidebarNavItems}
                class="collection-sidenav"
              />
              <div
                class="sidebar-blocks"
                data-editable="component"
                data-component="utils/main-component"
                data-prop-sections="sidebarBlocks"
              >
                <MainComponent sections={sidebarBlocks} />
              </div>
            </aside>
          )
        }
        <!-- tabindex="-1" so the skip link moves focus here, not just the scroll
             position. See the same note in Page.astro. -->
        <main
          id="main"
          slot="second"
          class="collection-content"
          tabindex="-1"
        >
          {
            pageHeading ? (
              <Heading
                level="h1"
                size="3xl"
                data-prop="pageHeading"
                text={pageHeading}
                class="collection-title"
              />
            ) : (
              <Heading
                level="h1"
                size="3xl"
                data-prop="title"
                text={title}
                class="collection-title"
              />
            )
          }
          {
            pageSections.length > 0 ? (
              <div
                data-editable="component"
                data-component="utils/main-component"
                data-prop-sections="pageSections"
              >
                <MainComponent sections={pageSections} />
              </div>
            ) : (
              <Text
                size="lg"
                data-prop="@content"
                class="prose"
              >
                {Content ? <Content components={mdxComponents} /> : <slot />}
              </Text>
            )
          }
        </main>
      </Split>
    </CustomSection>
  </div>

  <Footer {...localizeData(footerData, locale)} />
</Layout>

<style is:global>
  .collection-layout {
    min-height: 60vh;
  }

  .collection-section .split {
    margin-top: 0;
  }

  @media (width < 1024px) {
    .collection-section .split > .split-inner,
    .collection-section .split > .split-inner.gap-6xl {
      gap: var(--spacing-3xl) !important;
    }

    .collection-section .collection-content {
      margin-top: 0;
    }

    .collection-section .collection-content > :first-child,
    .collection-section .collection-content .collection-title {
      margin-top: 0 !important;
    }
  }

  .breadcrumb-bar a {
    font-size: var(--font-size-sm);
    color: var(--color-link-strong);
    text-decoration: none;
  }

  .breadcrumb-bar a:hover {
    text-decoration: underline;
  }

  .breadcrumb-sep {
    color: var(--color-link-strong);
    margin: 0 0.5rem;
    font-size: var(--font-size-sm);
  }

  .breadcrumb-current {
    font-size: var(--font-size-sm);
    color: var(--color-text-strong);
  }

  .sidebar-heading {
    font-family: var(--font-headings), sans-serif;
    font-weight: var(--font-weight-bold);
    background-color: var(--color-bg);
    color: var(--color-text-strong);
    padding: 0.75rem 1rem;
    font-size: var(--font-size-md);
    text-transform: uppercase;
  }

  .collection-sidenav .nav-item a,
  .collection-sidenav .nav-item .nav-item-trigger {
    color: var(--color-text-strong);
  }

  .collection-sidenav .nav-item a:hover,
  .collection-sidenav .nav-item a:focus-visible {
    color: var(--color-brand);
  }
  .collection-title {
    font-weight: var(--font-weight-semibold);
    margin-top: 0;
  }

  .sidebar-blocks {
    margin-top: -4px;
    display: flex;
    flex-direction: column;
    gap: 0;
    align-items: center;
  }

  .sidebar-blocks .embed-wrapper {
    width: 100%;
    max-width: 280px;
  }

  .sidebar-blocks > :global(*) {
    margin-top: 0;
  }

  .prose {
    /* Markdown wraps blank-line-separated content in <p> elements. Do not let
       the browser's user-agent stylesheet decide their margins: it creates a
       large, browser-dependent gap between winner categories and award levels.
       Keep ordinary prose rhythm explicit, and treat a paragraph containing
       only <strong> as the category label used by the winners pages. */
    p {
      margin-block: 0 var(--spacing-md);
    }

    p:has(> strong:only-child) {
      margin-block: var(--spacing-lg) var(--spacing-xs);
    }

    p:first-child {
      margin-block-start: 0;
    }

    a {
      color: var(--color-link-strong);
      text-decoration: underline;
      transition: color 0.2s ease-in-out;
      &:hover {
        color: var(--color-link-strong-hover);
      }
    }
  }
</style>
