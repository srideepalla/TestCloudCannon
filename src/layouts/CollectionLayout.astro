---
import ArticleSchema from "@components/utils/ArticleSchema.astro";
import BreadcrumbSchema from "@components/utils/BreadcrumbSchema.astro";
import CustomSection from "@builders/custom-section/CustomSection.astro";
import BreadcrumbBar from "@components/navigation/breadcrumb-bar/BreadcrumbBar.astro";
import Footer from "@components/navigation/footer/Footer.astro";
import MainNavigation from "@components/navigation/main-nav/MainNav.astro";
import SidebarNavBox from "@components/navigation/side/SidebarNavBox.astro";
import MainComponent from "@components/utils/MainComponent.astro";
import LocalizedLink from "@components/utils/LocalizedLink.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Text from "@core-elements/text/Text.astro";
import footerData from "@data/footer.json";
import mainNavData from "@data/mainNav.json";
import seoData from "@data/seo.json";
import sidebarNavData from "@data/sidebarNav.json";
import Layout from "@layouts/BaseLayout.astro";
import Split from "@wrappers/split/Split.astro";
import { render } from "astro:content";
import { getCurrentLocale, localizeData, localizeText } from "@utils/i18n";

const componentImports = {
  ...import.meta.glob("../components/building-blocks/**/*.astro", { eager: true }),
  ...import.meta.glob("../components/page-sections/**/*.astro", { eager: true }),
};

const mdxComponents: Record<string, any> = {};

Object.entries(componentImports).forEach(([path, module]) => {
  const fileName = path.split("/").at(-1)!.replace(".astro", "");

  mdxComponents[fileName] = (module as any).default;
});

// Localize internal links inside rendered markdown/MDX bodies (keeps the locale).
mdxComponents.a = LocalizedLink;

interface SidebarLink {
  text: string;
  href: string;
  openInNewTab?: boolean;
}

interface Props {
  title: string;
  pageHeading?: string;
  description?: string;
  image?: string;
  collection: string;
  slug?: string;
  entry?: any;
  noindex?: boolean;
}

const { title, pageHeading, description, image, collection, entry, noindex } = Astro.props;
const sidebar = (sidebarNavData as Record<string, { heading: string; links: SidebarLink[] }>)[
  collection
];
const locale = getCurrentLocale(Astro.url.pathname);
const sidebarNavItems = sidebar?.links.map((link) => ({ name: localizeText(link.text, locale) as string, path: link.href, openInNewTab: link.openInNewTab })) ?? [];
const sidebarHeading = localizeText(sidebar?.heading, locale) as string;
const homeLabel = localizeText("Home", locale) as string;
const Content = entry ? (await render(entry)).Content : null;
const pageSections = entry?.data?.pageSections ?? [];
const sidebarBlocks = entry?.data?.sidebarBlocks ?? [];
const pageDescription = description || seoData.description;

const siteOrigin = "https://women.stevieawards.com";
const sectionPath = `/${collection}/${sidebar?.links[0]?.href.split("/").pop()}`;
const breadcrumbItems = [
  { name: "Home", url: `${siteOrigin}/` },
  ...(sidebar?.heading
    ? [{ name: sidebar.heading, url: `${siteOrigin}${sectionPath}` }]
    : []),
  { name: title, url: Astro.url.href },
];

const articleDate = entry?.data?.date ?? null;
const articleAuthor = entry?.data?.author ?? null;
---

<Layout
  title={title}
  description={pageDescription}
  image={image}
  noindex={noindex}
  ogType={articleDate ? "article" : "website"}
>
  <BreadcrumbSchema
    slot="head"
    items={breadcrumbItems}
  />

  {
    articleDate && (
      <ArticleSchema
        slot="head"
        headline={title}
        description={pageDescription}
        image={image}
        datePublished={articleDate}
        author={articleAuthor}
        url={Astro.url.href}
      />
    )
  }

  <MainNavigation {...localizeData(mainNavData, locale)} />

  <BreadcrumbBar
    items={[
      { name: homeLabel, href: "/" },
      ...(sidebar
        ? [{ name: sidebarHeading, href: `/${collection}/${sidebar.links[0]?.href.split("/").pop()}` }]
        : []),
      { name: title },
    ]}
  />

  <main class="collection-layout">
    <CustomSection
      colorScheme="light"
      backgroundColor="base"
      maxContentWidth="3xl"
      paddingHorizontal="xl"
      paddingVertical="3xl"
      class="collection-section"
    >
      <Split
        distributionMode="fixed-flexible"
        fixedWidth={280}
        minSplitWidth={1024}
        gap="6xl"
        class="collection-split"
      >
        {
          sidebar && (
            <aside
              slot="first"
              class="collection-sidebar"
            >
              <SidebarNavBox
                heading={sidebar.heading}
                links={sidebarNavItems}
              >
                <div
                  class="sidebar-blocks"
                  data-editable="component"
                  data-component="utils/main-component"
                  data-prop-sections="sidebarBlocks"
                >
                  <MainComponent sections={sidebarBlocks} />
                </div>
              </SidebarNavBox>
            </aside>
          )
        }
        <div
          slot="second"
          class="collection-content"
        >
          {
            pageHeading ? (
              <Heading
                level="h1"
                size="3xl"
                data-prop="pageHeading"
                text={pageHeading}
                class="collection-title"
              />
            ) : (
              <Heading
                level="h1"
                size="3xl"
                data-prop="title"
                text={title}
                class="collection-title"
              />
            )
          }
          {
            pageSections.length > 0 ? (
              <div
                data-editable="component"
                data-component="utils/main-component"
                data-prop-sections="pageSections"
              >
                <MainComponent sections={pageSections} />
              </div>
            ) : (
              <Text
                size="lg"
                data-prop="@content"
                class="prose"
              >
                {Content ? <Content components={mdxComponents} /> : <slot />}
              </Text>
            )
          }
        </div>
      </Split>
    </CustomSection>
  </main>

  <Footer {...localizeData(footerData, locale)} />
</Layout>

<style is:global>
  .collection-layout {
    min-height: 60vh;
  }

  .collection-section .split {
    margin-top: 0;
  }

  @media (width < 1024px) {
    .collection-section .split > .split-inner,
    .collection-section .split > .split-inner.gap-6xl {
      gap: var(--spacing-3xl) !important;
    }

    .collection-section .collection-content {
      margin-top: 0;
    }

    .collection-section .collection-content > :first-child,
    .collection-section .collection-content .collection-title {
      margin-top: 0 !important;
    }
  }

  .collection-title {
    font-weight: var(--font-weight-semibold);
    margin-top: 0;
  }

  .prose {
    a {
      color: var(--color-link-strong);
      text-decoration: underline;
      transition: color 0.2s ease-in-out;
      &:hover {
        color: var(--color-link-strong-hover);
      }
    }
  }
</style>
