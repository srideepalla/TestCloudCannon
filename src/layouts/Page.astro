---
import Footer from "@components/navigation/footer/Footer.astro";
import MainNavigation from "@components/navigation/main-nav/MainNav.astro";
import MainComponent from "@components/utils/MainComponent.astro";
import footerData from "@data/footer.json";
import mainNavData from "@data/mainNav.json";
import Layout from "@layouts/BaseLayout.astro";
import { getCurrentLocale, localizeData } from "@utils/i18n";

import type { ContentBlock } from "../types";

type Props = {
  frontmatter?: {
    title: string;
    pageHeading?: string | null;
    description?: string | null;
    keywords?: string[];
    image?: string | null;
    canonical?: string;
    pageSections?: ContentBlock[];
  };
  title?: string;
  description?: string;
  keywords?: string[];
  image?: string;
  canonical?: string;
  mainNav?: Record<string, unknown>;
  footer?: Record<string, unknown>;
};

const {
  frontmatter,
  title: titleProp,
  description: descriptionProp,
  keywords: keywordsProp,
  image: imageProp,
  canonical: canonicalProp,
  mainNav = mainNavData,
  footer = footerData,
} = Astro.props as Props;

const title = frontmatter?.title ?? titleProp ?? "";
const description = frontmatter?.description ?? descriptionProp;
const keywords = frontmatter?.keywords ?? keywordsProp;
const image = frontmatter?.image ?? imageProp;
const canonical = frontmatter?.canonical ?? canonicalProp;
const sections = frontmatter?.pageSections ?? [];

// Translate the header/footer labels into the current locale (no-op on English).
const locale = getCurrentLocale(Astro.url.pathname);
const localizedNav = localizeData(mainNav, locale);
const localizedFooter = localizeData(footer, locale);
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  image={image}
  canonical={canonical}
>
  <!-- banner landmark: the logo link, hamburger and button group sit outside the
       <nav> elements, so without this they are page content in no landmark.
       It has to be here rather than inside MainNav, because a <header> nested in
       the <section> MainNav renders would lose the banner role. -->
  <header>
    <!-- First focusable element in the document, so keyboard and screen-reader
         users can bypass the nav and language switcher (WCAG 2.4.1). -->
    <a
      class="skip-link"
      href="#main"
    >
      Skip to main content
    </a>
    <MainNavigation {...localizedNav} />
  </header>

  <!-- tabindex="-1" so the skip link actually moves focus here. Without it the
       browser sets the hash and scrolls, but document.activeElement stays on
       <body>: Chrome then moves only the sequential-focus starting point, and
       some screen readers leave the virtual cursor where it was. Negative, so
       it is never a Tab stop itself. -->
  <main
    id="main"
    tabindex="-1"
  >
    {
      sections.length > 0 && (
        <div
          data-editable="component"
          data-component="utils/main-component"
          data-prop-sections="pageSections"
        >
          <MainComponent sections={sections} />
        </div>
      )
    }
    <slot />
  </main>
  <Footer {...localizedFooter} />
</Layout>

<style is:global>
  :root {
    --nav-height: 3.5rem;
  }
</style>
