---
import StructuredData from "@components/utils/StructuredData.astro";
import QuickActions from "@components/utils/QuickActions.astro";
import seoData from "@data/seo.json";
import themeData from "@data/theme.json";
import "@styles/style.css";
import SiteFonts from "@layouts/SiteFonts.astro";
import { SEO } from "astro-seo";

export interface Props {
  title: string;
  description?: string | null;
  keywords?: string[] | null;
  image?: string | null;
  canonical?: string | null;
  noindex?: boolean;
  ogType?: "website" | "article";
}

const props = Astro.props;
const formattedTitle = seoData.titleFormat.replace("{title}", props.title);
const pageDescription = props.description || seoData.description;
const pageImageRaw = props.image || seoData.logoSource;
// Open Graph requires absolute URLs for images.
const pageImage = pageImageRaw.startsWith("http")
  ? pageImageRaw
  : new URL(pageImageRaw, Astro.site ?? "https://women.stevieawards.com").href;
const pageKeywords = props.keywords?.join(", ") || seoData.keywords;
const ogType = props.ogType ?? "website";
 
// Generate theme CSS from theme.json
function camelToKebab(str: string): string {
  return str.replace(/([a-z])([A-Z])/g, '$1-$2').toLowerCase();
}

function generateThemeCSS(themeColors: Record<string, string>, themeSelector: string): string {
  // Collect explicit per-token values into a map (only non-empty values).
  // Lets brand color fan out to related tokens *as a fallback* — explicit values win.
  const map: Record<string, string> = {};

  for (const [key, value] of Object.entries(themeColors)) {
    if (value && String(value).trim().length > 0) {
      map[camelToKebab(key)] = value;
    }
  }

  const brand = map['color-brand'];
  const brandMuted = map['color-brand-muted'];

  if (brand) {
    // Brand-driven fallbacks: applied only if the editor didn't set an explicit value.
    map['color-bg-brand'] = map['color-bg-brand'] || brand;
    map['color-bg-accent'] = map['color-bg-accent'] || brand;
    map['color-link'] = map['color-link'] || brand;
    map['color-focus-ring'] = map['color-focus-ring'] || brand;
  }

  if (brandMuted) {
    map['color-bg-brand-muted'] = map['color-bg-brand-muted'] || brandMuted;
    map['color-link-hover'] = map['color-link-hover'] || brandMuted;
  }

  const cssVars = Object.entries(map)
    .map(([k, v]) => `--${k}:${v};`)
    .join('');

  return `${themeSelector}{${cssVars}}`;
}

function generateGlobalThemeCSS(): string {
  const vars: string[] = [];
  
  if (themeData.navbarBgColor) {
    vars.push(`--navbar-bg-color:${themeData.navbarBgColor};`);
  }
  
  return vars.length ? `html[data-theme]{${vars.join('')}}` : '';
}

const lightThemeCSS = generateThemeCSS(themeData.light, '[data-theme="light"]');
const darkThemeCSS = generateThemeCSS(themeData.dark, '[data-theme="dark"]');
// Selector deliberately matches [data-theme="light"]/[data-theme="dark"]'s
// specificity (one attribute selector, no type selector) rather than
// "html[data-theme]" -- that extra type selector made this fallback rule
// MORE specific than the theme-specific rules below it, so it always won
// regardless of which theme was actually set: data-theme="light" still
// rendered every dark-theme color, because this rule's dark values beat
// [data-theme="light"]'s light values on specificity, not just source
// order. Equal specificity lets normal cascade order decide instead, and
// this is emitted first (see the concatenation below) so the theme-specific
// rules correctly override it for the tokens they define.
const rootThemeCSS = generateThemeCSS(themeData.dark, '[data-theme]');
const globalThemeCSS = generateGlobalThemeCSS();

const siteOrigin = "https://women.stevieawards.com";

// Supported locales. Keys are the URL prefix / content directory under
// src/content/pages/ (must match LANGUAGE_MAP keys in the translation scripts).
// htmlLang = BCP-47 value for <html lang>, dir = text direction, ogLocale = Open Graph locale.
const LOCALES = {
  ar: { htmlLang: "ar", dir: "rtl", ogLocale: "ar_AR" },
  bg: { htmlLang: "bg", dir: "ltr", ogLocale: "bg_BG" },
  "zh-hans": { htmlLang: "zh-Hans", dir: "ltr", ogLocale: "zh_CN" },
  "zh-hant": { htmlLang: "zh-Hant", dir: "ltr", ogLocale: "zh_TW" },
  fr: { htmlLang: "fr", dir: "ltr", ogLocale: "fr_FR" },
  de: { htmlLang: "de", dir: "ltr", ogLocale: "de_DE" },
  el: { htmlLang: "el", dir: "ltr", ogLocale: "el_GR" },
  hu: { htmlLang: "hu", dir: "ltr", ogLocale: "hu_HU" },
  id: { htmlLang: "id", dir: "ltr", ogLocale: "id_ID" },
  it: { htmlLang: "it", dir: "ltr", ogLocale: "it_IT" },
  ja: { htmlLang: "ja", dir: "ltr", ogLocale: "ja_JP" },
  ko: { htmlLang: "ko", dir: "ltr", ogLocale: "ko_KR" },
  ms: { htmlLang: "ms", dir: "ltr", ogLocale: "ms_MY" },
  fa: { htmlLang: "fa", dir: "rtl", ogLocale: "fa_IR" },
  pl: { htmlLang: "pl", dir: "ltr", ogLocale: "pl_PL" },
  "pt-br": { htmlLang: "pt-BR", dir: "ltr", ogLocale: "pt_BR" },
  "pt-pt": { htmlLang: "pt-PT", dir: "ltr", ogLocale: "pt_PT" },
  es: { htmlLang: "es", dir: "ltr", ogLocale: "es_ES" },
  "es-419": { htmlLang: "es-419", dir: "ltr", ogLocale: "es_419" },
  th: { htmlLang: "th", dir: "ltr", ogLocale: "th_TH" },
  tr: { htmlLang: "tr", dir: "ltr", ogLocale: "tr_TR" },
  vi: { htmlLang: "vi", dir: "ltr", ogLocale: "vi_VN" },
};
const DEFAULT_LOCALE = { htmlLang: "en", dir: "ltr", ogLocale: "en_US" };

const rawPath = Astro.url.pathname;
const segments = rawPath.split("/").filter(Boolean);
// The current locale is the first path segment if it matches a known locale.
const currentLocale = segments.length && LOCALES[segments[0]] ? segments[0] : null;

// The path with the locale prefix stripped (i.e. the English/base path).
let enPath = rawPath;
if (currentLocale) {
  enPath = rawPath.slice(currentLocale.length + 1) || "/";
}

const localeMeta = currentLocale ? LOCALES[currentLocale] : DEFAULT_LOCALE;
const htmlLang = localeMeta.htmlLang;
// Note: we intentionally do NOT set dir="rtl" on <html> — the design keeps the
// layout unmirrored (logo left, nav/actions right) with Arabic/Persian text only.

const ogLocale = localeMeta.ogLocale;
const ogLocaleAlternate = [DEFAULT_LOCALE.ogLocale, ...Object.values(LOCALES).map((l) => l.ogLocale)].filter(
  (l) => l !== ogLocale
);
---

<!doctype html>
<html
  lang={htmlLang}
  data-theme="light"
>
  <head>
    <meta charset="UTF-8" />
    <!-- Charset MUST stay the first element in <head>: it has to fall within the first
         1024 bytes, or the browser picks a default encoding before it and mojibake
         results (e.g. the ellipsis and apostrophe rendered as a-circumflex sequences). -->
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-PDZX3FH');</script>
    <!-- End Google Tag Manager -->
    <!-- Start of HubSpot Embed Code -->
    <script type="text/javascript" id="hs-script-loader" async defer src="//js.hs-scripts.com/35655.js"></script>
    <!-- End of HubSpot Embed Code -->
    <!-- Meta Pixel Code -->
    <script>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '316192473477446');
    fbq('track', 'PageView');
    </script>
    <noscript><img height=""1"" width=""1"" style=""display:none""
    src=""https://www.facebook.com/tr?id=316192473477446&ev=PageView&noscript=1""
    /></noscript>
    <!-- End Meta Pixel Code -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.webp"
    />
    <link
      rel="apple-touch-icon"
      href="/favicon.webp"
    />
    <link
      rel="manifest"
      href="/manifest.webmanifest"
    />
    <meta
      name="theme-color"
      content="#dfba19"
    />

    <!-- Resource hints for third-party origins -->
    <link
      rel="preconnect"
      href="https://www.googletagmanager.com"
    />
    <link
      rel="dns-prefetch"
      href="https://www.googletagmanager.com"
    />
    <link
      rel="dns-prefetch"
      href="https://connect.facebook.net"
    />
    <link
      rel="dns-prefetch"
      href="https://snap.licdn.com"
    />
    <link
      rel="dns-prefetch"
      href="https://js.hsforms.net"
    />

    <style
      is:inline
      set:html={`${globalThemeCSS}${rootThemeCSS}${lightThemeCSS}${darkThemeCSS}`}
    />
    <meta
      name="generator"
      content={Astro.generator}
    />

    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-XXXXXXX");
    </script>
    <!-- End Google Tag Manager -->

    <!-- Google Analytics -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-XXXXXXXXXX");
    </script>
    <!-- End Google Analytics -->

    <!-- Facebook Pixel -->
    <script is:inline>
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = "2.0";
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(window, document, "script", "https://connect.facebook.net/en_US/fbevents.js");
      fbq("init", "XXXXXXXXXXXXXXX");
      fbq("track", "PageView");
    </script>
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        src="https://www.facebook.com/tr?id=XXXXXXXXXXXXXXX&ev=PageView&noscript=1"
      />
    </noscript>
    <!-- End Facebook Pixel -->

    <!-- LinkedIn Insight Tag -->
    <script is:inline>
      _linkedin_partner_id = "XXXXXXX";
      window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || [];
      window._linkedin_data_partner_ids.push(_linkedin_partner_id);
    </script>
    <script is:inline>
      (function (l) {
        if (!l) {
          window.lintrk = function (a, b) {
            window.lintrk.q.push([a, b]);
          };
          window.lintrk.q = [];
        }
        var s = document.getElementsByTagName("script")[0];
        var b = document.createElement("script");
        b.type = "text/javascript";
        b.async = true;
        b.src = "https://snap.licdn.com/li.lms-analytics/insight.min.js";
        s.parentNode.insertBefore(b, s);
      })(window.lintrk);
    </script>
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none;"
        alt=""
        src="https://px.ads.linkedin.com/collect/?pid=XXXXXXX&fmt=gif"
      />
    </noscript>
    <!-- End LinkedIn Insight Tag -->

    <style is:inline>
      @layer reset, base, components, page-sections, utils, overrides;
    </style>

    <SiteFonts />

    {
      import.meta.env.DEV ? (
        <script
          type="module"
          src="/@vite/client"
        />
      ) : null
    }

    <script>
      if (window.inEditorMode) {
        import("../../live-editing");
        import("../../editor-live-sync");
      }
    </script>

    <SEO
      title={formattedTitle}
      description={pageDescription}
      noindex={props.noindex ?? false}
      openGraph={{
        basic: {
          title: formattedTitle,
          type: ogType,
          image: pageImage,
          url: props.canonical || Astro.url.href,
        },
        optional: {
          description: pageDescription,
          siteName: seoData.name,
          locale: ogLocale,
          localeAlternate: ogLocaleAlternate,
        },
        image: {
          alt: formattedTitle,
        },
      }}
      twitter={{
        card: "summary_large_image",
        site: seoData.twitterHandle,
        creator: seoData.twitterHandle,
      }}
      extend={{
        link: [
          {
            rel: "canonical",
            href: props.canonical || Astro.url.href,
          },
        ],
        meta: [
          {
            name: "keywords",
            content: pageKeywords,
          },
        ],
      }}
    />

    <link rel="alternate" hreflang="en" href={`${siteOrigin}${enPath}`} />
    {
      Object.entries(LOCALES).map(([code, meta]) => (
        <link rel="alternate" hreflang={meta.htmlLang} href={`${siteOrigin}/${code}${enPath}`} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={`${siteOrigin}${enPath}`} />

    <StructuredData site={seoData} />

    <link
      rel="sitemap"
      type="application/xml"
      title="Sitemap"
      href="/sitemap-index.xml"
    />

    <slot name="head" />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-PDZX3FH"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <div>
      <slot />
    </div>
    <QuickActions />
    <script>
      import "@choctawnationofoklahoma/lite-vimeo";
      import "@justinribeiro/lite-youtube";
    </script>
    <script
      src="https://js.hsforms.net/forms/embed/35655.js"
      defer
    ></script>
  </body>
</html>
