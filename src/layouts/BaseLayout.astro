---
import StructuredData from "@components/utils/StructuredData.astro";
import QuickActions from "@components/utils/QuickActions.astro";
import seoData from "@data/seo.json";
import themeData from "@data/theme.json";
import "@styles/style.css";
import SiteFonts from "@layouts/SiteFonts.astro";
import { SEO } from "astro-seo";

export interface Props {
  title: string;
  description?: string | null;
  keywords?: string[] | null;
  image?: string | null;
  canonical?: string | null;
  noindex?: boolean;
  ogType?: "website" | "article";
}

const props = Astro.props;
const formattedTitle = seoData.titleFormat.replace("{title}", props.title);
const pageDescription = props.description || seoData.description;
const pageImageRaw = props.image || seoData.logoSource;
// Open Graph requires absolute URLs for images.
const pageImage = pageImageRaw.startsWith("http")
  ? pageImageRaw
  : new URL(pageImageRaw, Astro.site ?? "https://stevieawards.com").href;
const pageKeywords = props.keywords?.join(", ") || seoData.keywords;
const ogType = props.ogType ?? "website";
 
// Generate theme CSS from theme.json
function camelToKebab(str: string): string {
  return str.replace(/([a-z])([A-Z])/g, '$1-$2').toLowerCase();
}

function generateThemeCSS(themeColors: Record<string, string>, themeSelector: string): string {
  // Collect explicit per-token values into a map (only non-empty values).
  // Lets brand color fan out to related tokens *as a fallback* — explicit values win.
  const map: Record<string, string> = {};

  for (const [key, value] of Object.entries(themeColors)) {
    if (value && String(value).trim().length > 0) {
      map[camelToKebab(key)] = value;
    }
  }

  const brand = map['color-brand'];
  const brandMuted = map['color-brand-muted'];

  if (brand) {
    // Brand-driven fallbacks: applied only if the editor didn't set an explicit value.
    map['color-bg-brand'] = map['color-bg-brand'] || brand;
    map['color-bg-accent'] = map['color-bg-accent'] || brand;
    map['color-link'] = map['color-link'] || brand;
    map['color-focus-ring'] = map['color-focus-ring'] || brand;
  }

  if (brandMuted) {
    map['color-bg-brand-muted'] = map['color-bg-brand-muted'] || brandMuted;
    map['color-link-hover'] = map['color-link-hover'] || brandMuted;
  }

  const cssVars = Object.entries(map)
    .map(([k, v]) => `--${k}:${v};`)
    .join('');

  return `${themeSelector}{${cssVars}}`;
}

function generateGlobalThemeCSS(): string {
  const vars: string[] = [];
  
  if (themeData.navbarBgColor) {
    vars.push(`--navbar-bg-color:${themeData.navbarBgColor};`);
  }
  
  return vars.length ? `html[data-theme]{${vars.join('')}}` : '';
}

const lightThemeCSS = generateThemeCSS(themeData.light, '[data-theme="light"]');
const darkThemeCSS = generateThemeCSS(themeData.dark, '[data-theme="dark"]');
const rootThemeCSS = generateThemeCSS(themeData.dark, 'html[data-theme]');
const globalThemeCSS = generateGlobalThemeCSS();

const siteOrigin = "https://stevieawards.com";

// English-only site: one locale, so this is the whole set.
const DEFAULT_LOCALE = { htmlLang: "en", dir: "ltr", ogLocale: "en_US" };

// The site is English-only. The translated locale content was removed, so there
// is no locale prefix to resolve, no alternate to advertise and nothing to point
// an hreflang at — emitting them would advertise URLs that now 404.
const enPath = Astro.url.pathname;
const htmlLang = DEFAULT_LOCALE.htmlLang;
const ogLocale = DEFAULT_LOCALE.ogLocale;
---

<!doctype html>
<html
  lang={htmlLang}
  data-theme="dark"
>
  <head>
    <meta charset="UTF-8" />
    <!-- Charset MUST stay the first element in <head>: it has to fall within the first
         1024 bytes, or the browser picks a default encoding before it and mojibake
         results (e.g. the ellipsis and apostrophe rendered as a-circumflex sequences). -->
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-PDZX3FH');</script>
    <!-- End Google Tag Manager -->
    <!-- Start of HubSpot Embed Code -->
    <script type="text/javascript" id="hs-script-loader" async defer src="//js.hs-scripts.com/35655.js"></script>
    <!-- End of HubSpot Embed Code -->
    <!-- Meta Pixel Code -->
    <script>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '316192473477446');
    fbq('track', 'PageView');
    </script>
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        src="https://www.facebook.com/tr?id=316192473477446&ev=PageView&noscript=1"
        alt=""
      />
    </noscript>
    <!-- End Meta Pixel Code -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <link
      rel="icon"
      type="image/png"
      href="/assets/images/favicon.png"
    />
    <link
      rel="apple-touch-icon"
      href="/assets/images/favicon.png"
    />
    <meta
      name="theme-color"
      content="#dfba19"
    />

    <!-- Resource hints for third-party origins -->
    <link
      rel="preconnect"
      href="https://www.googletagmanager.com"
    />
    <link
      rel="dns-prefetch"
      href="https://www.googletagmanager.com"
    />
    <link
      rel="dns-prefetch"
      href="https://connect.facebook.net"
    />
    <link
      rel="dns-prefetch"
      href="https://snap.licdn.com"
    />
    <link
      rel="dns-prefetch"
      href="https://js.hsforms.net"
    />

    <style
      is:inline
      set:html={`${globalThemeCSS}${rootThemeCSS}${lightThemeCSS}${darkThemeCSS}`}
    />
    <meta
      name="generator"
      content={Astro.generator}
    />

    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-XXXXXXX");
    </script>
    <!-- End Google Tag Manager -->

    <!-- Google Analytics -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-XXXXXXXXXX");
    </script>
    <!-- End Google Analytics -->

    {
      /* A second, unconfigured Meta Pixel used to sit here. It shipped with a
         literal placeholder ID, so it loaded fbevents.js and fired a PageView on
         every one of the 1,301 pages while being incapable of reporting to
         anything. Worse than dead weight: fbq() tracks against every initialised
         pixel, so each page view also attempted a malformed request alongside the
         real pixel (id 316192473477446, still active above).

         Astro comment, not an HTML one, so this note stays in the source instead
         of shipping to every page and showing up in view-source. */
    }

    <!-- LinkedIn Insight Tag -->
    <script is:inline>
      _linkedin_partner_id = "XXXXXXX";
      window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || [];
      window._linkedin_data_partner_ids.push(_linkedin_partner_id);
    </script>
    <script is:inline>
      (function (l) {
        if (!l) {
          window.lintrk = function (a, b) {
            window.lintrk.q.push([a, b]);
          };
          window.lintrk.q = [];
        }
        var s = document.getElementsByTagName("script")[0];
        var b = document.createElement("script");
        b.type = "text/javascript";
        b.async = true;
        b.src = "https://snap.licdn.com/li.lms-analytics/insight.min.js";
        s.parentNode.insertBefore(b, s);
      })(window.lintrk);
    </script>
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none;"
        alt=""
        src="https://px.ads.linkedin.com/collect/?pid=XXXXXXX&fmt=gif"
      />
    </noscript>
    <!-- End LinkedIn Insight Tag -->

    <style is:inline>
      @layer reset, base, components, page-sections, utils, overrides;
    </style>

    <SiteFonts />

    {
      import.meta.env.DEV ? (
        <script
          type="module"
          src="/@vite/client"
        />
      ) : null
    }

    <script>
      if (window.inEditorMode) {
        import("../../live-editing");
        import("../../editor-live-sync");
      }
    </script>

    <SEO
      title={formattedTitle}
      description={pageDescription}
      noindex={props.noindex ?? false}
      {/* astro-seo always emits <link rel="canonical">, so the page-level override
          must go through this prop. Passing it via extend.link produced a second,
          duplicate canonical tag on every page. */}
      canonical={props.canonical || undefined}
      openGraph={{
        basic: {
          title: formattedTitle,
          type: ogType,
          image: pageImage,
          url: props.canonical || Astro.url.href,
        },
        optional: {
          description: pageDescription,
          siteName: seoData.name,
          locale: ogLocale,
        },
        image: {
          alt: formattedTitle,
        },
      }}
      twitter={{
        card: "summary_large_image",
        site: seoData.twitterHandle,
        creator: seoData.twitterHandle,
      }}
      extend={{
        meta: [
          {
            name: "keywords",
            content: pageKeywords,
          },
        ],
      }}
    />

    <link rel="alternate" hreflang="x-default" href={`${siteOrigin}${enPath}`} />

    <StructuredData site={seoData} />

    <link
      rel="sitemap"
      type="application/xml"
      title="Sitemap"
      href="/sitemap-index.xml"
    />

    <slot name="head" />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-PDZX3FH"
        title="Google Tag Manager"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <!-- The skip link now lives inside the <header> banner rendered by Page.astro
         and CollectionLayout.astro (the only two layouts built on this one). It is
         still the first focusable element in the document, but it is no longer page
         content sitting outside every landmark, which axe reports under `region`. -->
    <div>
      <slot />
    </div>
    <QuickActions />
    <script>
      import "@choctawnationofoklahoma/lite-vimeo";
      import "@justinribeiro/lite-youtube";
    </script>
    <script
      src="https://js.hsforms.net/forms/embed/35655.js"
      defer
    ></script>
    <script>
      /**
       * HubSpot injects its form iframes with title="Form" — identical for every
       * form on the page. Two of them on one page is a WCAG 4.1.2 failure
       * (axe: frame-title-unique): a screen-reader user listing frames hears
       * "Form", "Form" with nothing to tell them apart. The homepage embeds two.
       *
       * The title cannot be set at build time because the iframe does not exist
       * until HubSpot's script runs, and it cannot be configured from this repo.
       * So retitle after injection, using the nearest preceding heading as the
       * label — that is the text a sighted user associates with the form.
       *
       * Only ever rewrites HubSpot's own generic title, so a descriptive title
       * (theirs or ours) is never clobbered.
       */
      const GENERIC = /^(form|hubspot form|)$/i;

      function labelFor(container: Element, index: number): string {
        const scope =
          container.closest("section, article, .card, .split, footer") || document.body;
        const heading = scope.querySelector("h1, h2, h3, h4, h5, h6");
        const text = (heading?.textContent || "").replace(/\s+/g, " ").trim();

        // Index suffix only when the heading cannot disambiguate on its own.
        return text ? `${text} — form` : `Form ${index + 1}`;
      }

      function titleHubSpotFrames(): void {
        const containers = [...document.querySelectorAll(".hs-form-frame")];
        const used = new Set<string>();

        containers.forEach((container, i) => {
          const frame = container.querySelector("iframe");

          if (!frame) return;
          if (!GENERIC.test((frame.getAttribute("title") || "").trim())) return;

          let label = labelFor(container, i);

          // Two forms under the same heading would still collide.
          if (used.has(label)) label = `${label} (${i + 1})`;
          used.add(label);

          frame.setAttribute("title", label);
        });
      }

      // The iframe arrives asynchronously, so watch rather than poll. Disconnects
      // once every container on the page has a titled frame.
      function watchHubSpotFrames(): void {
        if (!document.querySelector(".hs-form-frame")) return;

        titleHubSpotFrames();

        const observer = new MutationObserver(() => {
          titleHubSpotFrames();

          const pending = [...document.querySelectorAll(".hs-form-frame")].some(
            (c) => !c.querySelector("iframe")
          );

          if (!pending) observer.disconnect();
        });

        observer.observe(document.body, { childList: true, subtree: true });

        // Backstop: stop watching after 30s even if a form never loads.
        setTimeout(() => observer.disconnect(), 30000);
      }

      watchHubSpotFrames();
    </script>
  </body>
</html>
