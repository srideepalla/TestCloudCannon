---
import Component from "@components/utils/renderBlock.astro";
import type { ContentBlock } from "../../types";
import "@styles/style.css";
import SiteFonts from "@layouts/SiteFonts.astro";
import themeData from "@data/theme.json";

export const prerender = false;

let contentSections: ContentBlock[] = [];

if (Astro.request.url) {
  const requestUrl = new URL(Astro.request.url);
  const treeParam = requestUrl.searchParams.get("tree");

  if (treeParam) {
    try {
      contentSections = JSON.parse(treeParam);
    } catch {
      // Invalid tree data
    }
  }
}

// Generate theme CSS from theme.json
function camelToKebab(str: string): string {
  return str.replace(/([a-z])([A-Z])/g, '$1-$2').toLowerCase();
}

function generateThemeCSS(themeColors: Record<string, string>, themeSelector: string): string {
  const cssVars = Object.entries(themeColors)
    .map(([key, value]) => {
      const cssVar = `--${camelToKebab(key)}`;

      // Handle special cases for brand colors
      if (key === 'colorBrand') {
        return `--color-brand:${value};--color-bg-brand:${value};`;
      }

      if (key === 'colorBrandMuted') {
        return `--color-brand-muted:${value};--color-bg-brand-muted:${value};`;
      }

      return `${cssVar}:${value};`;
    })
    .join('');
  
  return `${themeSelector}{${cssVars}}`;
}

function generateGlobalThemeCSS(): string {
  const vars: string[] = [];
  
  if (themeData.navbarBgColor) {
    vars.push(`--navbar-bg-color:${themeData.navbarBgColor};`);
  }
  
  return vars.length ? `html[data-theme]{${vars.join('')}}` : '';
}

const lightThemeCSS = generateThemeCSS(themeData.light, '[data-theme="light"]');
const darkThemeCSS = generateThemeCSS(themeData.dark, '[data-theme="dark"]');
const rootThemeCSS = generateThemeCSS(themeData.light, 'html[data-theme]');
const globalThemeCSS = generateGlobalThemeCSS();
---

<html
  lang="en"
  data-theme="light"
>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <title>Builder Preview</title>
    <style is:inline>
      @layer reset, base, components, page-sections, utils, overrides;
    </style>
    <style
      is:inline
      set:html={`${globalThemeCSS}${rootThemeCSS}${lightThemeCSS}${darkThemeCSS}`}
    />
    <SiteFonts />
  </head>
  <body style="margin: 0;">
    {
      contentSections.length > 0 ? (
        <Component
          contentSections={contentSections}
          useDefaultEditableBinding={false}
        />
      ) : (
        <p style="color: #94a3b8; padding: 2rem; text-align: center;">
          Preview will appear here when you add components.
        </p>
      )
    }
  </body>
</html>
