---
import Icon from "@core-elements/icon/Icon.astro";
import { localizePath } from "@utils/i18n";

const {
  text,
  iconName,
  iconPosition = "before",
  hideText = false,
  variant = "primary",
  size = "md",
  uppercase = true,
  link,
  openInNewTab = false,
  element = "a",
  class: className,
  useDefaultEditableBinding = false,
  "data-prop": customDataProp,
  popovertarget,
  popovertargetaction,
  _component,
  ...htmlAttributes
} = Astro.props;

const effectiveDataProp = customDataProp ?? (useDefaultEditableBinding ? "text" : null);
const textDataAttributes = effectiveDataProp
  ? { "data-editable": "text", "data-prop": effectiveDataProp }
  : {};

const Tag = element as any;

const tagProps: Record<string, any> =
  Tag === "a" && link
    ? { href: localizePath(link, Astro.url?.pathname ?? "/") }
    : Tag === "button"
      ? { type: "button" }
      : {};

// Links that open a new tab must say so, or a screen-reader or magnifier user
// gets no signal that their context changed (WCAG 3.2.5). The MDX rehype plugin
// covers content links; this covers every link rendered through a component —
// footer, nav and anything else using Button.
const NEW_TAB_CUE = " (opens in new tab)";
const opensInNewTab = openInNewTab && Tag === "a";

if (opensInNewTab) {
  tagProps.target = "_blank";
  tagProps.rel = "noopener noreferrer";
}

if (popovertarget) {
  tagProps.popovertarget = popovertarget;
  if (popovertargetaction) tagProps.popovertargetaction = popovertargetaction;
}

if (hideText) {
  // An aria-label replaces the accessible name outright, so for icon-only links
  // the cue has to go into the label itself — a hidden span inside the anchor
  // would never be announced.
  const baseLabel = htmlAttributes["aria-label"] || text;

  tagProps["aria-label"] = opensInNewTab ? `${baseLabel}${NEW_TAB_CUE}` : baseLabel;
  delete htmlAttributes["aria-label"];
}

// Text links keep their visible label and get the cue as hidden text, so nothing
// changes visually.
const needsInlineNewTabCue = opensInNewTab && !hideText;

const hasText = text?.trim().length > 0;
const hasSlotContent = Astro.slots.has("default");
const hasIcon = iconName?.trim().length > 0;

if (!_component && !hasText && !hasSlotContent && !hasIcon) return;
---

<span
  class:list={["button", className]}
  {...htmlAttributes}
>
  <Tag
    class:list={[
      "button-inner",
      `variant-${variant}`,
      `size-${size}`,
      iconPosition === "after" && "icon-after",
      hideText && "icon-only",
      uppercase && "uppercase",
    ]}
    {...tagProps}
  >
    <Icon
      name={iconName}
      size="none"
    />
    {
      !hideText && (
        <span
          class="label-text"
          {...textDataAttributes}
        >
          <slot>{text}</slot>
        </span>
      )
    }
    {needsInlineNewTabCue && <span class="visually-hidden">{NEW_TAB_CUE}</span>}
  </Tag>
</span>

<style>
  @layer components {
    .button {
      display: inline-flex;
      max-width: 100%;
      vertical-align: middle;

      > .button-inner {
        align-items: center;
        background-color: var(--color-bg-surface);

        /* border-inputs, not border: the surface fill is nearly invisible against
           the page (1.05:1 in light), so this border is the only thing marking the
           control's boundary and needs 3:1 (WCAG 1.4.11). --color-border is
           1.47:1 on white; --color-border-inputs is 4.90:1 light / 4.29:1 dark and
           is already the token used for exactly this job on form fields.
           Decorative borders — cards, blockquotes, dividers — keep --color-border. */
        border: 1px solid var(--color-border-inputs, var(--color-border));
        border-radius: var(--radius-none);
        color: var(--color-text-strong);
        display: inline-flex;
        flex-shrink: 0;
        gap: 0.15em;
        justify-content: center;
        min-height: 10px;
        min-width: 10px;
        padding-block: var(--spacing-em-sm);
        padding-inline: var(--spacing-em-lg);
        text-align: center;
        text-decoration: none;
        transition-duration: var(--animation-normal);
        transition-property: background-color, color, border-color;
        transition-timing-function: ease-in-out;
        font-family: var(--font-headings);

        &.uppercase {
          text-transform: uppercase;
        }

        &:hover {
          background-color: var(--color-bg-muted);
          border-color: var(--color-border-strong);
          color: var(--color-text-strong);
          cursor: pointer;
        }

        &:focus-visible {
          box-shadow: none;
          outline: 3px solid var(--color-focus-ring);
          outline-offset: 3px;
        }

        &.icon-only {
          padding: var(--spacing-em-xs);
        }

        &.icon-after {
          flex-direction: row-reverse;
        }

        &.variant-primary {
          background-color: var(--color-bg-brand);
          border-color: var(--color-bg-brand);
          color: var(--color-text-on-brand);

          &:hover,
          &:focus {
            background-color: transparent;
            border-color: var(--color-border-strong);
            color: var(--color-text-strong);
          }
        }

        &.variant-secondary {
          background-color: var(--color-bg-inverse);
          border-color: var(--color-bg-inverse);
          color: var(--color-text-on-brand);

          &:hover,
          &:focus {
            background-color: var(--color-bg-brand-muted);
            border-color: var(--color-bg-brand-muted);
            color: var(--color-brand);
          }
        }

        &.variant-tertiary {
          background-color: transparent;
          border-color: var(--color-border-strong);
          color: var(--color-text-strong);

          &:hover,
          &:focus {
            background-color: var(--color-bg-brand);
            border-color: var(--color-bg-brand);
            color: var(--color-text-on-brand);
          }
        }

        &.variant-ghost {
          background-color: color-mix(in srgb, var(--gray-1) 10%, transparent);
          border-color: color-mix(in srgb, var(--gray-3) 30%, transparent);
          color: var(--color-text-strong);

          &:hover,
          &:focus {
            background-color: var(--color-bg-brand);
            border-color: var(--color-bg-brand);
            color: var(--color-text-strong);
          }
        }

        &.variant-text {
          background-color: transparent;
          border-color: transparent;
          color: var(--color-link);
          font-size: var(--font-size-lg);
          font-family: var(--font-body);
          font-weight: var(--font-weight-bold);
          padding: 0;

          &:hover,
          &:focus {
            color: var(--color-link-hover);
            text-decoration: underline;
          }
        }

        &.variant-text-brand {
          background-color: transparent;
          border-color: transparent;
          color: var(--color-brand);
          font-size: var(--font-size-lg);
          font-family: var(--font-body);
          font-weight: var(--font-weight-bold);
          padding: 0;

          &:hover,
          &:focus {
            color: var(--color-link-hover);
            text-decoration: underline;
          }
        }

        &.variant-text-brand-muted {
          background-color: transparent;
          border-color: transparent;
          color: var(--color-brand-muted);
          font-family: var(--font-body);
          font-weight: var(--font-weight-bold);
          padding: 0;

          &:hover,
          &:focus {
            text-decoration: underline;
          }
        }

        &.variant-text-strong {
          background-color: transparent;
          border-color: transparent;
          color: var(--color-text-strong);
          font-family: var(--font-body);
          font-weight: var(--font-weight-bold);
          padding: 0;

          &:hover,
          &:focus {
            color: var(--color-brand);
            text-decoration: underline;
          }
        }

        &.size-sm {
          font-size: var(--font-size-sm);
        }

        &.size-md {
          font-size: var(--font-size-md);
        }

        &.size-lg {
          font-size: var(--font-size-xl);
        }
      }
    }
  }
</style>
