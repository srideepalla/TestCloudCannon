---
const {
  html,
  aspectRatio = "landscape",
  placeholderText = "Embed Placeholder - visible on the live site",
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const slot = await Astro.slots.render("default");
const content = slot || html;
---

<div
  class:list={["embed-wrapper", className]}
  {...htmlAttributes}
>
  <div
    class:list={["embed-content", `ratio-${aspectRatio}`]}
    set:html={content}
  />
  <div class="embed-placeholder">
    <span>{placeholderText}</span>
  </div>
</div>

<script>
  if ((window as any).inEditorMode) {
    document.documentElement.classList.add("cc-editor");
  }
</script>

<style is:global>
  @layer components {
    .embed-wrapper {
      margin-top: var(--spacing-lg);

      > .embed-placeholder {
        display: none;
        align-items: center;
        justify-content: center;
        background: var(--color-bg-surface);
        border-radius: var(--radius-sm);
        color: var(--color-text-muted);
        font-size: var(--font-size-md);
        min-height: 120px;
        padding: var(--spacing-xl);
      }

      > .embed-content {
        > iframe {
          border: none;
          display: block;
          height: 100%;
          width: 100%;
        }

        &.ratio-square {
          aspect-ratio: var(--ratio-square);
        }

        &.ratio-landscape {
          aspect-ratio: var(--ratio-landscape);
        }

        &.ratio-portrait {
          aspect-ratio: var(--ratio-portrait);
        }

        &.ratio-widescreen {
          aspect-ratio: var(--ratio-widescreen);
        }
      }
    }

    .cc-editor .embed-wrapper > .embed-content {
      display: none;
    }

    .cc-editor .embed-wrapper > .embed-placeholder {
      display: flex;
    }
  }
</style>
