---
import Button from "@core-elements/button/Button.astro";
import CarouselSlide from "./CarouselSlide.astro";
import Image from "@core-elements/image/Image.astro";
import { slugifyLabel } from "@components/utils/slugify";

type SlideProps = Record<string, unknown>;

interface ThumbnailItem {
  src: string;
  alt: string;
}

const {
  slides = [],
  thumbnails = [] as ThumbnailItem[],
  autoPlay = false,
  autoScroll = false,
  showIndicators = true,
  controlsPosition = "bottom",
  showArrows = true,
  loop = true,
  align = "center",
  slidesToScroll = "auto",
  slideWidthPercent = 100,
  minSlideWidth = 0,
  style = "",
  label,
  "data-children-prop": childrenDataProp,
  useDefaultEditableBinding = false,
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;

if (!htmlAttributes.id && label) {
  htmlAttributes.id = slugifyLabel(label);
}

const typedThumbnails = thumbnails as ThumbnailItem[];
const hasThumbnails = typedThumbnails.length > 0;

const dataAttributes: Record<string, string> = {};

dataAttributes["data-show-indicators"] = String(showIndicators);
dataAttributes["data-controls-position"] = controlsPosition;
dataAttributes["data-show-arrows"] = String(showArrows);
dataAttributes["data-loop"] = String(loop);
dataAttributes["data-align"] = String(align);
dataAttributes["data-slides-to-scroll"] = String(slidesToScroll);

if (hasThumbnails) {
  dataAttributes["data-thumbnails"] = "true";
}

if (autoPlay) {
  dataAttributes["data-autoplay"] = "3";
}

if (autoScroll) {
  dataAttributes["data-autoscroll"] = "1";
  dataAttributes["data-show-indicators"] = "false";
  dataAttributes["data-show-arrows"] = "false";
}

const effectiveChildrenProp = childrenDataProp ?? (useDefaultEditableBinding ? "slides" : null);
const arrayDataAttributes = effectiveChildrenProp
  ? { "data-editable": "array", "data-prop": effectiveChildrenProp }
  : {};

const carouselClasses = "carousel";

const carouselStyles = `
  --slide-width: ${slideWidthPercent}%;
  --min-slide-width: ${minSlideWidth}px;
  ${style}
`.trim();

const hasSlides = slides?.length > 0;
const hasSlotContent = Astro.slots.has("default");

if (!_component && !hasSlides && !hasSlotContent) return;
---

<section
  class:list={[carouselClasses, className]}
  role="region"
  aria-label="Carousel"
  {...htmlAttributes}
>
  <div
    class="carousel-inner"
    style={carouselStyles}
    {...dataAttributes}
  >
    <div class="viewport">
      <div
        class="track"
        {...arrayDataAttributes}
      >
        <slot>
          {
            slides?.map((slide: SlideProps, index: number) => (
              <CarouselSlide
                {...slide}
                data-editable="array-item"
                data-id="building-blocks/wrappers/carousel/carousel-slide"
                useDefaultEditableBinding={!!effectiveChildrenProp}
                aria-label={`Slide ${index + 1} of ${slides.length}`}
              />
            ))
          }
        </slot>
      </div>
    </div>

    <div class="controls-wrapper">
      <Button
        iconName="arrow-left"
        size="md"
        variant="tertiary"
        hideText={true}
        aria-label="Previous slide"
        class="prev"
        element="button"
      />

      <div class="indicators">
        {
          hasThumbnails && (
            <div class="thumb-viewport">
              <div class="thumb-track">
                {typedThumbnails.map((thumb, i) => (
                  <div class="thumb-slide">
                    <button
                      class="indicator indicator--thumb"
                      type="button"
                      data-thumb-index={i}
                      aria-label={`Go to image ${i + 1}`}
                    >
                      <Image
                        source={thumb.src}
                        alt={thumb.alt}
                        loading="lazy"
                        decoding="async"
                      />
                    </button>
                  </div>
                ))}
              </div>
            </div>
          )
        }
      </div>

      <Button
        iconName="arrow-right"
        size="md"
        variant="tertiary"
        hideText={true}
        aria-label="Next slide"
        class="next"
        element="button"
      />
    </div>
  </div>
</section>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { setupAllCarousels } from "./setup";

  onPageLoad(setupAllCarousels);
</script>

<style>
  @layer components {
    .carousel {
      margin-top: var(--spacing-lg);
      width: 100%;

      > .carousel-inner {
        display: flex;
        flex-direction: column;
        position: relative;
        --slide-width: 100%;
        --min-slide-width: 0px;

        > .viewport {
          order: 1;
          overflow: hidden;
          position: relative;
          width: 100%;
        }

        > .viewport > .track {
          display: flex;
          flex-wrap: nowrap;

          > :global(.slide) {
            flex-basis: calc(max(var(--slide-width, 100%), var(--min-slide-width, 0px)));
            flex-shrink: 0;
            width: 100%;
          }
        }

        > .controls-wrapper {
          align-items: center;
          display: flex;
          gap: var(--spacing-md);
          justify-content: center;
          margin-bottom: var(--spacing-sm);
          margin-top: var(--spacing-sm);
          order: 2;
        }

        &[data-controls-position="before"] > .controls-wrapper {
          order: 0;
        }

        > .controls-wrapper :global(button) {
          border-radius: var(--radius-full);
        }

        > .controls-wrapper > :global(.prev) > :global(.button-inner),
        > .controls-wrapper > :global(.next) > :global(.button-inner) {
          background-color: var(--color-bg);
          flex-shrink: 0;
          pointer-events: auto;

          &:hover {
            background-color: var(--color-bg-surface);
          }
        }

        > .controls-wrapper > .indicators {
          display: flex;
          gap: var(--spacing-sm);
          justify-content: center;
        }

        > .controls-wrapper > .indicators > :global(.indicator) {
          aspect-ratio: 1/1;
          border: none;
          border-radius: var(--radius-full);
          cursor: pointer;
          min-height: 0;
          min-width: 0;
          padding: 0;
          transition:
            transform var(--animation-normal) ease,
            background-color var(--animation-normal) ease;
          width: 8px;

          &[data-selected="true"] {
            background-color: var(--color-brand-muted);
            transform: scale(1.2);
          }
        }

        &[data-thumbnails="true"] {
          > .controls-wrapper > .indicators {
            align-items: center;
            flex: 1;
            gap: var(--spacing-xs);
            justify-content: initial;
            min-width: 0;
          }

          > .controls-wrapper > .indicators > .thumb-viewport {
            flex: 1;
            min-width: 0;
            overflow: hidden;
          }

          > .controls-wrapper > .indicators > .thumb-viewport > .thumb-track {
            display: flex;
          }

          > .controls-wrapper > .indicators > .thumb-viewport > .thumb-track > .thumb-slide {
            flex: 0 0 var(--thumb-indicator-width, 12%);
            min-width: var(--thumb-indicator-min-width, 80px);
            padding: 0 2px;
          }

          > .controls-wrapper > .indicators .indicator--thumb {
            aspect-ratio: 3 / 2;
            background: none;
            border: 2px solid transparent;
            border-radius: 4px;
            cursor: pointer;
            display: block;
            opacity: 0.5;
            padding: 2px;
            transition:
              border-color 0.2s ease,
              opacity 0.2s ease;
            width: 100%;

            & > .image {
              margin-top: 0;
            }

            &:hover {
              opacity: 0.8;
            }

            &.is-active {
              opacity: 1;
            }
          }
        }

        &[data-show-indicators="false"] {
          > .controls-wrapper > .indicators {
            display: none;
          }
        }

        &[data-show-arrows="false"] {
          > .controls-wrapper > .prev,
          > .controls-wrapper > .next {
            display: none;
          }
        }
      }
    }
  }
</style>
