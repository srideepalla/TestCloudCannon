---
import RenderBlock from "@components/utils/renderBlock.astro";
import Heading from "@core-elements/heading/Heading.astro";

const {
  title,
  subtext,
  iconName,
  contentSections,
  useDefaultEditableBinding = false,
  checked = false,
  groupName = "content-selector-tabs",
  navigationPosition = "start",
  _component,
  "data-children-prop": childrenDataProp,
  ...htmlAttributes
} = Astro.props;

const uniqueId = crypto.randomUUID();
const tabId = `tab-${uniqueId}`;
const panelId = `panel-${uniqueId}`;
const tabLabelId = `tablabel-${uniqueId}`;

const effectiveChildrenProp =
  childrenDataProp ?? (useDefaultEditableBinding ? "contentSections" : null);
const arrayDataAttributes = effectiveChildrenProp
  ? { "data-editable": "array", "data-prop": effectiveChildrenProp }
  : {};
---

<div
  class="content-selector-item"
  {...htmlAttributes}
>
  <input
    type="radio"
    name={groupName}
    id={tabId}
    class="content-selector-input"
    checked={checked}
    autocomplete="off"
  />
  {
    /*
    No role="tab"/tabindex here, and no role="tabpanel" below. This control is a
    native radio group, and the ARIA tabs overlay on top of it was invalid three
    ways: the tabpanel sat inside the tablist (.content-selector-item is
    display:contents, so it vanishes from the a11y tree and the panel became a
    direct child of role="tablist", which only permits tabs); every label was in
    the tab sequence rather than just the active one; and arrow keys did nothing.

    Exposing the radio group instead fixes all three at once, natively — arrow
    keys move between options, and only the checked radio is in the tab sequence.
  */
  }
  <label
    class="content-selector-tab"
    id={tabLabelId}
    for={tabId}
  >
    <Heading
      text={title}
      level="h3"
      size="h3"
      iconName={iconName}
      alignX={navigationPosition === "top" ? "center" : "start"}
      class="content-selector-tab-heading"
    />
    {
      subtext && (
        <span
          class:list={[
            "content-selector-tab-subtext",
            `align-${navigationPosition === "top" ? "center" : "start"}`,
          ]}
        >
          {subtext}
        </span>
      )
    }
  </label>
  {
    /* No aria-hidden: an unchecked panel is display:none, which already removes it
      from the accessibility tree, and the old JS-managed value went stale. */
  }
  <div
    class="content-selector-panel"
    id={panelId}
  >
    <div
      class="content-selector-panel-content"
      {...arrayDataAttributes}
    >
      <slot>
        {
          contentSections && (
            <RenderBlock
              contentSections={contentSections}
              useDefaultEditableBinding={!!effectiveChildrenProp}
            />
          )
        }
      </slot>
    </div>
  </div>
</div>

<style>
  @layer components {
    .content-selector-item {
      display: contents;
    }

    /* Visually hidden but still focusable. display:none removed the radio from
       the tab sequence entirely, which left the whole control unreachable by
       keyboard except through the label's tabindex hack. position:absolute keeps
       a zero-size radio from taking a grid/flex slot in .content-selector-items. */
    .content-selector-input {
      height: 0;
      opacity: 0;
      position: absolute;
      width: 0;
    }

    /* The radio is invisible, so its focus ring has to show on the label. */
    .content-selector-input:focus-visible + .content-selector-tab {
      outline: 2px solid var(--color-brand);
      outline-offset: -2px;
    }

    .content-selector-tab {
      background: transparent;
      border: none;
      cursor: pointer;
      display: block;
      padding: var(--spacing-md);
      position: relative;
      transition: background-color var(--animation-normal) ease-in-out;

      &::before {
        background: transparent;
        content: "";
        position: absolute;
        transition:
          transform var(--animation-normal),
          background var(--animation-normal);
      }

      &:hover {
        background: var(--color-state-hover);
      }

      > :global(.content-selector-tab-heading) {
        margin: 0;
      }
    }

    .content-selector-tab-subtext {
      color: var(--color-text-muted);
      display: block;
      font-size: var(--font-size-body-sm);
      margin-top: var(--spacing-2xs);

      &.align-center {
        text-align: center;
      }

      &.align-start {
        text-align: start;
      }
    }

    .content-selector-input:checked + .content-selector-tab::before {
      background: var(--color-border-strong);
    }

    .content-selector-input:checked + .content-selector-tab + .content-selector-panel {
      display: block;
    }

    .content-selector-panel {
      animation: fade-in var(--animation-slow) ease-in-out forwards;
      container-type: inline-size;
      display: none;
    }

    .content-selector-panel-content > :global(*:first-child) {
      margin-top: 0 !important;
    }
  }
</style>
