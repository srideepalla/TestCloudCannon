---
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import Text from "@core-elements/text/Text.astro";
import Card from "@wrappers/card/Card.astro";
import Split from "@wrappers/split/Split.astro";

const {
  index,
  photo = { source: "", alt: "" },
  heading = "",
  jobTitle = "",
  description = "",
  colorScheme = "inherit",
  backgroundColor = "surface",
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;

// Position in the grid, not the name. Deriving it from the name collapsed to a run
// of hyphens for any non-Latin script — every character failed [a-z0-9] — so two
// names of equal length collided. That was a duplicate-id-aria failure, and worse,
// it broke the control: <label for> binds to the first match, so "Read More" on one
// card expanded a different person's biography on every non-Latin locale.
//
// An index rather than a random id because these values land in the DOM: a random
// one changes on every build, which churns the output and breaks any deep link to
// a card. StaffGrid is the only caller and a page carries at most one grid, so the
// index is unique per page and stable across builds. The random fallback only
// applies if the component is ever used standalone.
const uid = `staff-bio-${index ?? crypto.randomUUID()}`;
---

<Card
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  class:list={["staff-card", className]}
  {...htmlAttributes}
>
  <Split
    distributionMode="fixed-flexible"
    fixedWidth={180}
    verticalAlignment="top"
    minSplitWidth={300}
    gap="md"
  >
    <Fragment slot="first">
      <Image
        source={photo?.source || ""}
        alt={photo?.alt || heading}
        data-prop-src="photo.source"
        data-prop-alt="photo.alt"
      />
    </Fragment>
    <Fragment slot="second">
      <div class="staff-card-content">
        <!-- h2, not h3: these cards sit directly under the page <h1>, so h3 skips a
             level. h2 is also safe under a section h2 — heading-order only fails on
             skips, not on repeats. -->
        <Heading
          level="h2"
          size="md"
          text={heading}
          data-prop="heading"
        />
        <Text
          class="staff-card-job-title"
          data-prop="jobTitle"
          size="sm"
        >
          {jobTitle}
        </Text>
        <div class="staff-card-bio-wrapper">
          <Text
            id={uid}
            text={description}
            data-prop="description"
            class="staff-card-description"
          />
          <button
            type="button"
            class="staff-card-read-more"
            aria-controls={uid}
            aria-expanded="false"
            aria-label={`Read more about ${heading}`}
          >
            <span class="read-more-label">Read More</span>
            <span class="read-less-label">Read Less</span>
          </button>
        </div>
      </div>
    </Fragment>
  </Split>
</Card>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";

  onPageLoad(() => {
    document.querySelectorAll<HTMLButtonElement>(".staff-card-read-more").forEach((button) => {
      if (button.dataset.initialized) return;
      button.dataset.initialized = "true";
      button.addEventListener("click", () => {
        const expanded = button.getAttribute("aria-expanded") !== "true";
        const name = button.closest(".staff-card")?.querySelector("h2")?.textContent?.trim() || "this person";
        button.setAttribute("aria-expanded", String(expanded));
        button.setAttribute("aria-label", `${expanded ? "Read less" : "Read more"} about ${name}`);
      });
    });
  });
</script>

<style is:global>
  @layer building-blocks {
    .staff-card .split .split-inner {
      gap: 0;
    }

    .staff-card .image,
    .staff-card .image .image-inner,
    .staff-card .image picture {
      height: 100%;
      width: 100%;
    }

    .staff-card .image img {
      height: 100%;
      object-fit: cover;
      object-position: center top;
      width: 100%;
    }

    .staff-card-content {
      padding: var(--spacing-lg);
    }

    .staff-card-content .heading {
      text-transform: uppercase;
      margin: 0;
    }

    .staff-card-job-title {
      margin: 0;
      color: var(--color-text);

      /* 0.6 composited to #767c85 on the card surface — 4.01:1, under the 4.5:1
         minimum. 0.7 keeps the muted look and clears it on every surface the card
         is used on (light/dark × bg, bg-surface, bg-muted): lowest measured 4.99:1. */
      opacity: 0.7;
    }

    .staff-card-bio-wrapper {
      margin-top: var(--spacing-sm);
      position: relative;
    }

    .staff-card-description .text-inner {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 4;
      overflow: hidden;
    }

    .staff-card-description .text-inner p {
      margin: 0;
    }

    .staff-card-bio-wrapper:has(.staff-card-read-more[aria-expanded="true"])
      .staff-card-description
      .text-inner {
      display: block;
      overflow: visible;
    }

    .staff-card-read-more {
      appearance: none;
      background: none;
      border: 0;
      color: var(--color-link-strong);
      cursor: pointer;
      display: inline-block;
      font: inherit;
      font-size: var(--font-size-sm);
      padding: var(--spacing-xs) 0;
      text-decoration: underline;

      &:focus-visible {
        outline: 3px solid var(--color-focus-ring);
        outline-offset: 3px;
      }
    }

    .staff-card-read-more .read-less-label {
      display: none;
    }

    .staff-card-read-more[aria-expanded="true"] .read-more-label {
      display: none;
    }

    .staff-card-read-more[aria-expanded="true"] .read-less-label {
      display: inline;
    }
  }
</style>
