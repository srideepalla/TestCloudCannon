---
interface Props {
  items: { title: string; url?: string; note?: string }[];
}
const { items } = Astro.props;
---

<ul class="attachments">
  {
    items.map((item) => (
      <li class="attachment">
        {item.url ? <a href={item.url}>{item.title}</a> : <span>{item.title}</span>}
        {item.note && <span class="tag">{item.note}</span>}
      </li>
    ))
  }
</ul>
