---
/**
 * NominationAssistant -- a conversational assistant that helps a prospective
 * entrant find the right Stevie Awards for Women in Business categories.
 *
 * V1 SCOPE (see StevieIntel/nomination_assistant.py for the full reasoning):
 * Discovery (a few clarifying questions) + Category Matching (2-5 real
 * categories, with fee and a short evidence checklist), scoped to the Women
 * in Business program only. No evidence upload, no draft generation, no
 * "similar past winners" -- all later-phase per the product requirements doc,
 * and the winner-precedent claim specifically is one this assistant is
 * instructed never to make (no verified winner corpus exists to check it
 * against, the same reason blog_writer.py never invents a historical claim).
 *
 * WHY A REAL CHAT UI, BUILT FRESH
 * Neither BlogGenerator.astro nor SearchPastWinners.astro has a multi-turn
 * message-thread pattern to adapt -- SearchPastWinners' "overview" panel is a
 * single-shot summary re-rendered whole on every new search, not a
 * conversation. This borrows their SURROUNDING conventions instead: the
 * onPageLoad re-init guard, the log()/debug-panel pattern, a seq-guarded
 * fetch so a slow reply can never land after a newer one, esc() escaping, and
 * the three-file CloudCannon config convention -- but the message-bubble
 * list, bottom-pinned input, and "thinking" indicator are new.
 */
import CustomSection from "@builders/custom-section/CustomSection.astro";

const {
  heading = "Find Your Stevie Awards Category",
  description = "Tell the assistant about your company, product, or achievement, and it will recommend real categories from the Stevie Awards for Women in Business catalog.",
  apiEndpoint = "",
  emptyStateText = "Tell me about your company, your role, and what you'd like to nominate -- I'll help you find the right categories.",
  debug = false,
  colorScheme = "light",
  backgroundColor = "base",
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const config = {
  endpoint: (apiEndpoint || "").replace(/\/$/, ""),
  emptyStateText,
  debug: !!debug,
};
---

<CustomSection
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical="3xl"
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  class:list={["nomination-assistant", className]}
  useDefaultEditableBinding={false}
  {...htmlAttributes}
>
  <div
    class="na"
    data-na-root
    data-config={JSON.stringify(config)}
  >
    <header class="na__head">
      <p class="na__kicker">Nomination Assistant &middot; Women in Business</p>
      {heading && <h2 class="na__heading">{heading}</h2>}
      {description && <p class="na__desc">{description}</p>}
    </header>

    <div class="na__layout">
      <!-- Category browser: real catalog entries from the backend, not a
           static list -- clicking one drops a starter question into the
           chat input rather than trying to short-circuit the conversation. -->
      <aside class="na__categories" aria-label="Browse categories">
        <div class="na__categories-head">
          <h3 class="na__categories-title">Categories</h3>
          <input
            type="search"
            class="na__categories-search"
            data-na-cat-search
            placeholder="Filter categories&hellip;"
            autocomplete="off"
          />
        </div>
        <div class="na__categories-list" data-na-categories>
          <p class="na__status">Loading categories&hellip;</p>
        </div>
      </aside>

      <!-- Chat thread -->
      <div class="na__chat">
        <div
          class="na__messages"
          data-na-messages
          role="log"
          aria-live="polite"
        >
          <div class="na__empty" data-na-empty>
            <p>{emptyStateText}</p>
          </div>
        </div>

        <p
          class="na__status na__status--error"
          data-na-error
          role="status"
          hidden
        ></p>

        <form class="na__composer" data-na-form>
          <textarea
            class="na__input"
            data-na-input
            rows="1"
            placeholder="Describe your company, role, and what you'd like to nominate&hellip;"
            required
          ></textarea>
          <button
            type="submit"
            class="na__send"
            data-na-send
          >Send</button>
        </form>
      </div>
    </div>

    {
      debug && (
        <pre class="na__debug" data-na-debug>
          {"Debug: waiting for the client script to start…"}
        </pre>
      )
    }
  </div>
</CustomSection>

<script>
  type ChatTurn = { role: "user" | "assistant"; content: string };
  type Category = { code: string; name: string; fees: string };

  const NS = "[nomination-assistant]";

  const onPageLoad = (fn: () => void) => {
    fn();
    document.addEventListener("astro:page-load", fn);
  };

  const initNominationAssistant = () => {
    document.querySelectorAll<HTMLElement>("[data-na-root]").forEach((root) => {
      if (root.dataset.naReady === "true") return;
      root.dataset.naReady = "true";

      let config: { endpoint: string; emptyStateText: string; debug: boolean };
      try {
        config = JSON.parse(root.dataset.config || "{}");
      } catch {
        config = { endpoint: "", emptyStateText: "", debug: false };
      }
      const { endpoint, debug } = config;

      const debugEl = root.querySelector<HTMLElement>("[data-na-debug]");
      const log = (msg: string, ...rest: unknown[]) => {
        // eslint-disable-next-line no-console
        console.log(NS, msg, ...rest);
        if (!debugEl) return;
        const line = `[${new Date().toLocaleTimeString()}] ${msg}`;
        debugEl.textContent = `${(debugEl.textContent || "").split("\n").slice(-40).join("\n")}\n${line}`;
      };

      if (!endpoint) {
        log("STOPPING: no API endpoint configured (apiEndpoint field is empty)");
        return;
      }

      const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel);
      const messagesEl = $("[data-na-messages]");
      const emptyEl = $("[data-na-empty]");
      const errorEl = $("[data-na-error]");
      const form = $<HTMLFormElement>("[data-na-form]");
      const input = $<HTMLTextAreaElement>("[data-na-input]");
      const sendBtn = $<HTMLButtonElement>("[data-na-send]");
      const catsEl = $("[data-na-categories]");
      const catSearch = $<HTMLInputElement>("[data-na-cat-search]");
      if (!messagesEl || !form || !input || !sendBtn) return;

      const esc = (s: unknown) =>
        String(s ?? "").replace(/[&<>"']/g, (c) =>
          ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] || c);

      // Rendered as markdown-lite: the assistant writes plain prose with
      // numbered/bulleted lists (see the system prompt), never real Markdown
      // emphasis -- so line breaks and list markers are all this needs to turn
      // into readable HTML, unlike blog_writer's full Markdown body.
      const toHtml = (text: string) =>
        esc(text)
          .split(/\n{2,}/)
          .map((para) => `<p>${para.replace(/\n/g, "<br>")}</p>`)
          .join("");

      const url = (path: string) => `${endpoint}${path}`;

      // ---------- conversation state ----------
      const history: ChatTurn[] = [];
      let seq = 0;

      const scrollToBottom = () => {
        messagesEl.scrollTo({ top: messagesEl.scrollHeight, behavior: "smooth" });
      };

      const addBubble = (role: ChatTurn["role"], html: string, opts: { pending?: boolean } = {}) => {
        if (emptyEl) emptyEl.hidden = true;
        const bubble = document.createElement("div");
        bubble.className = `na__bubble na__bubble--${role}${opts.pending ? " is-pending" : ""}`;
        bubble.innerHTML = html;
        messagesEl.appendChild(bubble);
        scrollToBottom();
        return bubble;
      };

      const send = async (message: string) => {
        const mine = ++seq;
        if (errorEl) errorEl.hidden = true;
        addBubble("user", `<p>${esc(message)}</p>`);
        history.push({ role: "user", content: message });
        input.value = "";
        input.style.height = "auto";
        sendBtn.disabled = true;
        const thinking = addBubble("assistant", `<span class="na__thinking">Thinking&hellip;</span>`, { pending: true });

        log(`sending: ${message.slice(0, 80)}`);
        try {
          const res = await fetch(url("/api/nomination-assistant/chat"), {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ message, history: history.slice(0, -1) }),
          });
          const d = await res.json();
          if (mine !== seq) return; // superseded by a newer message
          if (!res.ok) throw new Error(d.detail || `HTTP ${res.status}`);
          thinking.remove();
          addBubble("assistant", toHtml(d.reply || ""));
          history.push({ role: "assistant", content: d.reply || "" });
          log(`reply ok (verified: ${d.verified}, flagged: ${(d.flagged || []).length})`,
            d.flagged || []);
        } catch (err) {
          if (mine !== seq) return;
          const detail = err instanceof Error ? err.message : String(err);
          log(`SEND FAILED: ${detail}`);
          thinking.remove();
          if (errorEl) {
            errorEl.hidden = false;
            errorEl.textContent = "Could not reach the assistant: " + detail;
          }
        } finally {
          if (mine === seq) sendBtn.disabled = false;
        }
      };

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const message = input.value.trim();
        if (message) void send(message);
      });
      // Enter sends, Shift+Enter inserts a newline -- the one keyboard
      // convention every chat input shares.
      input.addEventListener("keydown", (e) => {
        if (e.key === "Enter" && !e.shiftKey) {
          e.preventDefault();
          form.requestSubmit();
        }
      });
      input.addEventListener("input", () => {
        input.style.height = "auto";
        input.style.height = `${Math.min(input.scrollHeight, 160)}px`;
      });

      // ---------- category browser ----------
      let allCategories: Category[] = [];

      const renderCategories = (cats: Category[]) => {
        if (!catsEl) return;
        if (!cats.length) {
          catsEl.innerHTML = `<p class="na__status">No categories match.</p>`;
          return;
        }
        catsEl.innerHTML = cats.map((c) => `
          <button type="button" class="na__cat" data-code="${esc(c.code)}" data-name="${esc(c.name)}">
            <span class="na__cat-code">${esc(c.code)}</span>
            <span class="na__cat-name">${esc(c.name)}</span>
            <span class="na__cat-fee">${esc(c.fees)}</span>
          </button>
        `).join("");
      };

      const loadCategories = async () => {
        try {
          const res = await fetch(url("/api/nomination-assistant/categories"));
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const d = await res.json();
          allCategories = d.categories || [];
          renderCategories(allCategories);
          log(`loaded ${allCategories.length} categories`);
        } catch (err) {
          const detail = err instanceof Error ? err.message : String(err);
          log(`CATEGORIES FAILED: ${detail}`);
          if (catsEl) catsEl.innerHTML = `<p class="na__status na__status--error">Could not load categories.</p>`;
        }
      };

      catSearch?.addEventListener("input", () => {
        const q = catSearch.value.trim().toLowerCase();
        renderCategories(
          q ? allCategories.filter((c) => c.name.toLowerCase().includes(q) || c.code.toLowerCase() === q)
            : allCategories
        );
      });

      catsEl?.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement)?.closest<HTMLButtonElement>("[data-code]");
        if (!btn) return;
        input.value = `Tell me more about ${btn.dataset.name} (${btn.dataset.code}) -- does it fit what I'm nominating?`;
        input.focus();
      });

      void loadCategories();
    });
  };

  onPageLoad(initNominationAssistant);
</script>

<style>
  @layer page-sections {
    .nomination-assistant {
      --nax-gold: #b8941a;
      --nax-line: var(--color-border, rgba(0, 0, 0, 0.12));
      --nax-radius: 14px;
    }

    .nomination-assistant .na__head {
      margin-bottom: 1.5rem;
    }
    .nomination-assistant .na__kicker {
      margin: 0 0 0.4rem;
      color: var(--nax-gold);
      font-family: var(--font-body);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .nomination-assistant .na__heading {
      margin: 0 0 0.5rem;
      font-family: var(--font-headings);
    }
    .nomination-assistant .na__desc {
      margin: 0;
      max-width: 60ch;
      color: var(--color-text-muted);
    }

    .nomination-assistant .na__layout {
      display: grid;
      grid-template-columns: minmax(0, 280px) minmax(0, 1fr);
      gap: 1.25rem;
      align-items: start;
    }
    @media (width < 860px) {
      .nomination-assistant .na__layout {
        grid-template-columns: 1fr;
      }
    }

    /* ---------- category browser ---------- */
    .nomination-assistant .na__categories {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      max-height: 560px;
      padding: 1rem;
      border: 1px solid var(--nax-line);
      border-radius: var(--nax-radius);
      background-color: var(--color-bg-surface, var(--color-bg));
    }
    .nomination-assistant .na__categories-head {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .nomination-assistant .na__categories-title {
      margin: 0;
      font-size: 0.95rem;
      font-weight: 700;
    }
    .nomination-assistant .na__categories-search {
      padding: 0.45rem 0.7rem;
      border: 1px solid var(--nax-line);
      border-radius: 8px;
      background-color: var(--color-bg);
      color: var(--color-text);
      font-family: var(--font-body);
      font-size: 0.85rem;
    }
    .nomination-assistant .na__categories-list {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      overflow-y: auto;
    }
    .nomination-assistant .na__cat {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
      padding: 0.5rem 0.6rem;
      border: 1px solid transparent;
      border-radius: 8px;
      background: none;
      color: var(--color-text);
      font-family: var(--font-body);
      text-align: left;
      cursor: pointer;
    }
    .nomination-assistant .na__cat:hover {
      border-color: var(--nax-gold);
      background-color: rgba(184, 148, 26, 0.06);
    }
    .nomination-assistant .na__cat-code {
      font-size: 0.68rem;
      font-weight: 700;
      color: var(--nax-gold);
      letter-spacing: 0.04em;
    }
    .nomination-assistant .na__cat-name {
      font-size: 0.85rem;
      font-weight: 600;
      line-height: 1.3;
    }
    .nomination-assistant .na__cat-fee {
      font-size: 0.75rem;
      color: var(--color-text-muted);
      font-variant-numeric: tabular-nums;
    }

    /* ---------- chat ---------- */
    .nomination-assistant .na__chat {
      display: flex;
      flex-direction: column;
      border: 1px solid var(--nax-line);
      border-radius: var(--nax-radius);
      background-color: var(--color-bg);
      overflow: hidden;
    }
    .nomination-assistant .na__messages {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      min-height: 320px;
      max-height: 560px;
      padding: 1.1rem;
      overflow-y: auto;
    }
    .nomination-assistant .na__empty {
      margin: auto;
      max-width: 32ch;
      color: var(--color-text-muted);
      text-align: center;
    }
    .nomination-assistant .na__empty p {
      margin: 0;
    }

    .nomination-assistant .na__bubble {
      max-width: 80%;
      padding: 0.65rem 0.9rem;
      border-radius: 14px;
      font-size: 0.92rem;
      line-height: 1.5;
      animation: na-in 160ms ease;
    }
    .nomination-assistant .na__bubble :global(p) {
      margin: 0 0 0.6em;
    }
    .nomination-assistant .na__bubble :global(p:last-child) {
      margin-bottom: 0;
    }
    .nomination-assistant .na__bubble--user {
      align-self: flex-end;
      background-color: var(--nax-gold);
      color: #fff;
      border-bottom-right-radius: 4px;
    }
    .nomination-assistant .na__bubble--assistant {
      align-self: flex-start;
      background-color: var(--color-bg-surface, var(--color-bg-muted));
      color: var(--color-text);
      border-bottom-left-radius: 4px;
    }
    .nomination-assistant .na__bubble.is-pending {
      opacity: 0.75;
    }
    .nomination-assistant .na__thinking::after {
      content: "";
      display: inline-block;
      width: 0.5em;
      animation: na-dots 1.2s steps(4, end) infinite;
      overflow: hidden;
      vertical-align: bottom;
    }

    @keyframes na-in {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes na-dots {
      to { width: 1.2em; }
    }

    .nomination-assistant .na__status {
      margin: 0;
      color: var(--color-text-muted);
      font-size: 0.85rem;
    }
    .nomination-assistant .na__status--error {
      padding: 0.6rem 1.1rem;
      color: #b3261e;
      background-color: rgba(179, 38, 30, 0.07);
      border-top: 1px solid var(--nax-line);
    }

    .nomination-assistant .na__composer {
      display: flex;
      gap: 0.6rem;
      align-items: flex-end;
      padding: 0.75rem;
      border-top: 1px solid var(--nax-line);
    }
    .nomination-assistant .na__input {
      flex: 1;
      resize: none;
      max-height: 160px;
      padding: 0.6rem 0.8rem;
      border: 1px solid var(--nax-line);
      border-radius: 10px;
      background-color: var(--color-bg);
      color: var(--color-text);
      font-family: var(--font-body);
      font-size: 0.92rem;
      line-height: 1.4;
    }
    .nomination-assistant .na__input:focus {
      outline: none;
      border-color: var(--nax-gold);
      box-shadow: 0 0 0 3px rgba(184, 148, 26, 0.15);
    }
    .nomination-assistant .na__send {
      padding: 0.65rem 1.2rem;
      border: 1px solid var(--nax-gold);
      border-radius: 9px;
      background-color: var(--nax-gold);
      color: #fff;
      font-family: var(--font-body);
      font-size: 0.9rem;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
    }
    .nomination-assistant .na__send:hover:not(:disabled) {
      filter: brightness(1.08);
    }
    .nomination-assistant .na__send:disabled {
      opacity: 0.6;
      cursor: progress;
    }

    .nomination-assistant .na__debug {
      margin-top: 1.5rem;
      max-height: 220px;
      padding: 0.85rem;
      overflow-y: auto;
      border: 1px dashed var(--nax-line);
      border-radius: 10px;
      background-color: var(--color-bg-surface, var(--color-bg-muted));
      color: var(--color-text-muted);
      font-family: var(--font-mono, monospace);
      font-size: 0.75rem;
      white-space: pre-wrap;
    }
  }
</style>
