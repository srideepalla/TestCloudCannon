      border: 0;
      background: none;
      padding: 0;
      color: var(--spw-text);
      font-family: inherit;
      font-size: 0.94rem;
      font-weight: 700;
      text-align: left;
      cursor: pointer;
      transition: color 0.15s ease;
      line-height: 1.35;
    }

    .search-past-winners .spw__profile-link:hover {
      color: #a16207;
      text-decoration: underline;
    }

    .search-past-winners .spw__type-badge {
      display: inline-block;
      padding: 0.2rem 0.55rem;
      border-radius: 9999px;
      font-size: 0.7rem;
      font-weight: 700;
      white-space: nowrap;
      line-height: 1.2;
    }

    .search-past-winners .spw__type-badge--org {
      background-color: #f1f5f9;
      border: 1px solid #cbd5e1;
      color: #475569;
    }

    .search-past-winners .spw__type-badge--person {
      background-color: #f5f3ff;
      border: 1px solid #ddd6fe;
      color: #6d28d9;
    }

    .search-past-winners .spw__cell-muted {
      color: var(--spw-text-muted);
    }

    .search-past-winners .spw__num {
      font-variant-numeric: tabular-nums;
      font-weight: 700;
      color: var(--spw-text);
      text-align: right;
    }

    .search-past-winners .spw__medal-group {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      align-items: center;
      min-width: 11rem;
    }

    .search-past-winners .spw__medal {
      display: inline-flex;
      align-items: center;
      gap: 0.3em;
      padding: 0.22em 0.6em;
      border-radius: 9999px;
      font-size: 0.72rem;
      font-weight: 700;
      white-space: nowrap;
      line-height: 1.2;
    }

    .search-past-winners .spw__medal--other {
      color: #57534e !important;
      border: 1px solid #e7e5e4 !important;
      background-color: #f5f5f4 !important;
      font-weight: 500;
    }

    .search-past-winners .spw__medal--other i {
      background: currentColor !important;
    }

    /* Section group labels for Exact / Related */
    .search-past-winners .spw__group-label {
      margin: 1.75rem 0 0.75rem;
      color: #a16207;
      font-size: 0.78rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }

    .search-past-winners .spw__group-label::after {
      content: "";
      flex: 1;
      height: 1px;
      background-color: var(--spw-border);
    }

    /* Empty state card */
    .search-past-winners .spw__empty {
      padding: 3.5rem 1.5rem;
      text-align: center;
      background-color: var(--spw-surface);
      border-radius: var(--spw-radius-lg);
      border: 1px solid var(--spw-border);
      box-shadow: var(--spw-shadow-sm);
      margin-top: 1.75rem;
    }

    .search-past-winners .spw__empty p {
      margin: 0;
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--spw-text);
    }

    /* Pagination */
    .search-past-winners .spw__pager {
      display: flex;
      gap: 1rem;
      align-items: center;
      justify-content: center;
      margin-top: 1.75rem;
    }

    .search-past-winners .spw__pager[hidden] {
      display: none !important;
    }

    .search-past-winners .spw__page-btn {
      padding: 0.6rem 1.25rem;
      border: 1px solid var(--spw-border);
      border-radius: var(--spw-radius-md);
      background-color: var(--spw-surface);
      color: var(--spw-text);
      font-family: var(--font-body);
      font-size: 0.86rem;
      font-weight: 600;
      cursor: pointer;
      box-shadow: var(--spw-shadow-xs);
      transition: all 0.15s ease;
    }

    .search-past-winners .spw__page-btn:hover:not(:disabled) {
      background-color: var(--spw-surface-alt);
      border-color: var(--spw-gold-border);
      color: var(--spw-gold-dark);
    }

    .search-past-winners .spw__page-btn:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }

    .search-past-winners .spw__page-info {
      color: var(--spw-text-muted);
      font-size: 0.86rem;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
    }

    /* --- Profile Detail Modal / Drawer --- */
    .search-past-winners .spw__scrim,
    .search-past-winners .spw__scrim[popover],
    [data-spw-scrim] {
      position: fixed !important;
      inset: 0 !important;
      top: 0 !important;
      left: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      width: 100vw !important;
      height: 100vh !important;
      height: 100dvh !important;
      max-width: none !important;
      max-height: none !important;
      margin: 0 !important;
      padding: 0 !important;
      border: 0 !important;
      z-index: 9999990 !important;
      background: rgba(15, 23, 42, 0.65) !important;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      cursor: pointer;
    }

    .search-past-winners .spw__scrim[hidden],
    [data-spw-scrim][hidden] {
      display: none !important;
    }

    .search-past-winners .spw__drawer {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 9999995;
      display: flex;
      flex-direction: column;
      width: min(58rem, calc(100vw - 2.5rem));
      max-height: min(88vh, 58rem);
      background-color: var(--spw-surface);
      border: 1px solid var(--spw-border);
      border-radius: var(--spw-radius-xl);
      box-shadow: var(--spw-shadow-modal);
      overflow-y: auto;
      animation: spw-pop 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .search-past-winners .spw__drawer[hidden] {
      display: none !important;
    }

    .search-past-winners .spw__drawer[popover]:not(:popover-open),
    .search-past-winners .spw__scrim[popover]:not(:popover-open) {
      display: none !important;
    }

    .search-past-winners .spw__drawer[popover] {
      margin: 0;
      padding: 0;
      border: 1px solid var(--spw-border);
      border-radius: var(--spw-radius-xl);
      overflow-y: auto;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      max-height: min(88vh, 58rem);
      box-shadow: var(--spw-shadow-modal);
    }

    .search-past-winners .spw__drawer[popover]:popover-open {
      animation: spw-pop 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .search-past-winners .spw__scrim[popover]:popover-open {
      animation: spw-scrim-in 0.18s ease;
    }

    .search-past-winners .spw__drawer-head {
      display: flex;
      gap: 1.25rem;
      align-items: flex-start;
      justify-content: space-between;
      padding: 1.35rem 1.75rem;
      border-bottom: 1px solid var(--spw-border);
      position: sticky;
      top: 0;
      background-color: var(--spw-surface);
      z-index: 10;
    }

    .search-past-winners .spw__drawer-name {
      margin: 0;
      font-size: 1.35rem;
      font-weight: 800;
      letter-spacing: -0.015em;
      color: var(--spw-text);
    }

    .search-past-winners .spw__drawer-sub {
      margin: 0.3rem 0 0;
      color: var(--spw-text-muted);
      font-size: 0.88rem;
      font-weight: 500;
    }

    .search-past-winners .spw__drawer-close {
      border: 1px solid var(--spw-border);
      background: var(--spw-surface-alt);
      border-radius: 9999px;
      padding: 0.38rem 0.95rem;
      width: auto;
      height: auto;
      min-height: 2rem;
      color: var(--spw-text-muted);
      font-family: var(--font-body);
      font-size: 0.82rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.35rem;
      cursor: pointer;
      flex-shrink: 0;
      box-shadow: var(--spw-shadow-xs);
      transition: all 0.15s ease;
    }

    .search-past-winners .spw__drawer-close:hover {
      background-color: #fee2e2;
      border-color: #fca5a5;
      color: #b91c1c;
      transform: translateY(-1px);
    }

    .search-past-winners .spw__drawer-body {
      padding: 1.65rem 1.75rem;
    }

    .search-past-winners .spw__drawer-loading {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      min-height: 12rem;
      color: var(--spw-text-muted);
      font-size: 0.92rem;
    }

    .search-past-winners .spw__drawer-note {
      color: var(--spw-text-muted);
      font-size: 0.85rem;
      line-height: 1.5;
    }

    /* Metric KPI Tiles */
    .search-past-winners .spw__tiles {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
      gap: 0.85rem;
      margin-bottom: 1.65rem;
    }

    .search-past-winners .spw__tile {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      padding: 0.95rem 1.15rem;
      border: 1px solid var(--spw-border);
      border-radius: var(--spw-radius-md);
      background-color: var(--spw-surface-alt);
    }

    .search-past-winners .spw__tile b {
      font-size: 1.55rem;
      font-weight: 800;
      font-variant-numeric: tabular-nums;
      line-height: 1.1;
      color: var(--spw-text);
    }

    .search-past-winners .spw__tile span {
      font-size: 0.68rem;
      color: var(--spw-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-weight: 700;
    }

    .search-past-winners .spw__tile--gold b,
    .search-past-winners .spw__tile--silver b,
    .search-past-winners .spw__tile--bronze b {
      color: #ffffff !important;
    }

    .search-past-winners .spw__tile--gold span,
    .search-past-winners .spw__tile--silver span,
    .search-past-winners .spw__tile--bronze span {
      color: rgba(255, 255, 255, 0.85) !important;
    }

    /* Facts Grid */
    .search-past-winners .spw__facts {
      display: grid;
      gap: 1rem;
      margin-bottom: 1.65rem;
      padding-bottom: 1.35rem;
      border-bottom: 1px solid var(--spw-border);
    }

    .search-past-winners .spw__fact-row {
      display: grid;
      grid-template-columns: 8rem minmax(0, 1fr);
      gap: 0.4rem 1rem;
      align-items: start;
    }

    .search-past-winners .spw__fact-label {
      padding-top: 0.35rem;
      color: var(--spw-text-muted);
      font-size: 0.74rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      line-height: 1.3;
    }

    .search-past-winners .spw__fact-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      min-width: 0;
    }

    .search-past-winners .spw__fact-chips .spw__chip {
      background-color: var(--spw-surface-alt);
      border: 1px solid var(--spw-border);
      color: var(--spw-text) !important;
      font-size: 0.78rem;
      font-weight: 500;
      padding: 0.3rem 0.75rem;
    }

    .search-past-winners .spw__fact-row[data-collapsed] .spw__chip.is-extra {
      display: none !important;
    }

    .search-past-winners .spw__drawer-heading {
      margin: 1.25rem 0 0.75rem;
      font-size: 0.8rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--spw-text-muted);
    }

    /* History Table */
    .search-past-winners .spw__table-scroll {
      max-width: 100%;
      overflow-x: auto;
      border-radius: var(--spw-radius-md);
      border: 1px solid var(--spw-border);
      background-color: var(--spw-surface);
    }

    .search-past-winners .spw__table--history {
      font-size: 0.82rem;
    }

    .search-past-winners .spw__table--history th {
      padding: 0.75rem 0.95rem;
      background-color: var(--spw-surface-alt);
    }

    .search-past-winners .spw__table--history td {
      padding: 0.75rem 0.95rem;
    }

    .search-past-winners .spw__table--history th:nth-child(1),
    .search-past-winners .spw__table--history td:nth-child(1) {
      white-space: nowrap;
      width: 4rem;
      font-variant-numeric: tabular-nums;
      font-weight: 600;
    }

    .search-past-winners .spw__table--history th:nth-child(2),
    .search-past-winners .spw__table--history td:nth-child(2) {
      white-space: nowrap;
      width: 5.5rem;
    }

    .search-past-winners .spw__history-cards {
      display: none;
    }

    /* --- Diagnostic Debug Panel --- */
    .search-past-winners .spw__debug {
      margin-top: 1.25rem;
      padding: 0.85rem 1.15rem;
      max-height: 220px;
      overflow-y: auto;
      border: 1px dashed #b3261e;
      border-radius: var(--spw-radius-sm);
      background-color: #0b0f19;
      color: #7ee787;
      font-family: var(--font-mono, monospace);
      font-size: 0.76rem;
      line-height: 1.5;
      white-space: pre-wrap;
      word-break: break-all;
    }

    /* --- Mobile Responsiveness (@media width < 768px) --- */
    @media (width < 768px) {
      .search-past-winners .spw__field--narrow {
        flex: 1 1 6.5rem;
      }

      .search-past-winners .spw__drawer,
      .search-past-winners .spw__drawer[popover] {
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        height: 100%;
        max-height: 100dvh;
        transform: none;
        border: 0;
        border-radius: 0;
        box-shadow: none;
      }

      .search-past-winners .spw__drawer-head {
        padding: 1rem 1.25rem;
      }

      .search-past-winners .spw__drawer-body {
        padding: 1rem 1.25rem;
      }

      .search-past-winners .spw__tiles {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.65rem;
      }

      .search-past-winners .spw__fact-row {
        grid-template-columns: 1fr;
        gap: 0.35rem;
      }

      .search-past-winners .spw__fact-label {
        padding-top: 0;
      }

      .search-past-winners .spw__org-meta {
        grid-template-columns: minmax(0, 1fr) 2.8rem 2.8rem 2.8rem 4.8rem;
        column-gap: 0.35rem;
      }

      .search-past-winners .spw__table-scroll {
        display: none !important;
      }

      .search-past-winners .spw__history-cards {
        display: flex !important;
        flex-direction: column;
        gap: 0.75rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .search-past-winners .spw__history-card {
        padding: 0.85rem 1rem;
        border: 1px solid var(--spw-border);
        border-radius: var(--spw-radius-md);
        background-color: var(--spw-surface);
      }

      .search-past-winners .spw__history-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        margin-bottom: 0.35rem;
      }

      .search-past-winners .spw__history-year {
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        font-size: 0.9rem;
      }

      .search-past-winners .spw__history-cat,
      .search-past-winners .spw__history-nom,
      .search-past-winners .spw__history-place {
        margin: 0.2rem 0 0;
        overflow-wrap: anywhere;
      }

      .search-past-winners .spw__history-cat,
      .search-past-winners .spw__history-place {
        color: var(--spw-text-muted);
        font-size: 0.76rem;
      }

      .search-past-winners .spw__history-nom {
        font-size: 0.88rem;
        font-weight: 500;
      }

      .search-past-winners .spw__medal-group {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        min-width: 0;
        width: 100%;
      }

      /* Stacked mobile cards transformation for results data table */
      .search-past-winners .spw__results {
        overflow-x: visible;
        background: transparent;
        border: none;
        box-shadow: none;
      }

      .search-past-winners .spw__table thead {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }

      .search-past-winners .spw__table,
      .search-past-winners .spw__table tbody,
      .search-past-winners .spw__table tr,
      .search-past-winners .spw__table td {
        display: block;
        width: auto;
      }

      .search-past-winners .spw__table tr {
        margin-bottom: 1rem;
        padding: 1.15rem;
        border: 1px solid var(--spw-border);
        border-radius: var(--spw-radius-lg);
        background-color: var(--spw-surface);
        box-shadow: var(--spw-shadow-sm);
      }

      .search-past-winners .spw__table td {
        display: grid;
        grid-template-columns: 6.5rem 1fr;
        gap: 0.5rem;
        align-items: baseline;
        padding: 0.35rem 0;
        border: 0;
      }

      .search-past-winners .spw__table td::before {
        content: attr(data-label);
        color: var(--spw-text-muted);
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-weight: 700;
        line-height: 1.4;
      }

      .search-past-winners .spw__table td.spw__cell-org {
        display: block;
        margin-bottom: 0.65rem;
        padding-bottom: 0.65rem;
        border-bottom: 1px solid var(--spw-border-subtle);
      }

      .search-past-winners .spw__table td.spw__cell-org .spw__profile-link {
        font-size: 1.08rem;
        font-weight: 800;
      }

      .search-past-winners .spw__table td.spw__cell-org::before {
        content: none;
      }

      .search-past-winners .spw__table td.spw__num {
        text-align: left;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .search-past-winners .spw__overview,
      .search-past-winners .spw__org-row,
      .search-past-winners .spw__drawer,
      .search-past-winners .spw__drawer[popover]:popover-open,
      .search-past-winners .spw__scrim[popover]:popover-open,
      .search-past-winners .spw__skel-row,
      .search-past-winners .spw__spinner,
      .search-past-winners .spw__inline-spin {
        animation: none !important;
      }
    }
  }

  /* ==========================================
     SPW FEEDBACK WIDGET & MODAL STYLING
     ========================================== */
  .spw__feedback {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    color: var(--spw-text-muted, #64748b);
  }

  .spw__feedback-label {
    font-weight: 600;
  }

  .spw__feedback-actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .spw__feedback-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    color: #64748b;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .spw__feedback-btn:hover:not(:disabled) {
    background: #f8fafc;
    border-color: #94a3b8;
    color: #0f172a;
  }

  .spw__feedback-btn.is-up:hover:not(:disabled),
  .spw__feedback-btn.is-up.is-selected {
    background: #ecfdf5;
    border-color: #10b981;
    color: #059669;
  }

  .spw__feedback-btn.is-down:hover:not(:disabled),
  .spw__feedback-btn.is-down.is-selected {
    background: #fef2f2;
    border-color: #ef4444;
    color: #dc2626;
  }

  .spw__feedback-btn:disabled {
    cursor: default;
    opacity: 0.8;
  }

  .spw__feedback-status {
    font-size: 0.74rem;
    font-weight: 700;
    color: #0f766e;
  }

  /* SPW Feedback Modal Dialog */
  .spw-modal-backdrop {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    height: 100dvh !important;
    z-index: 9999999 !important;
    background: rgba(15, 23, 42, 0.65) !important;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    box-sizing: border-box;
    animation: spw-scrim-in 0.2s ease;
  }

  .spw-modal-backdrop[hidden] {
    display: none !important;
  }

  .spw-modal-dialog {
    background: #ffffff;
    border-radius: 16px;
    box-shadow:
      0 25px 50px -12px rgba(15, 23, 42, 0.25),
      0 0 0 1px rgba(15, 23, 42, 0.05);
    width: 100%;
    max-width: 520px;
    overflow: hidden;
    animation: spw-pop 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .spw-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.6rem;
    border-bottom: 1px solid #f1f5f9;
    background: #f8fafc;
  }

  .spw-modal-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .spw-modal-icon {
    color: #0f766e;
    display: flex;
  }

  .spw-modal-title {
    margin: 0;
    font-size: 1.05rem;
