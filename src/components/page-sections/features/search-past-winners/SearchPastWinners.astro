              <circle
                cx="11"
                cy="11"
                r="8"
              ></circle>
              <line
                x1="21"
                y1="21"
                x2="16.65"
                y2="16.65"
              ></line>
            </svg>
            <input
              type="search"
              name="q"
              class="spw__input"
              data-spw-q
              placeholder="e.g. IBM, customer service team, gold winners in 2024"
              autocomplete="off"
