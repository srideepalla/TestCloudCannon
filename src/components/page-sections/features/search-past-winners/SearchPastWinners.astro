        </svg>
        Stevie® Awards Intelligence
      </span>
      <span class="spw__eyebrow-stat">83,000+ Verified Winners Archive</span>
    </div>
    <Heading
      level="h2"
      size="lg"
      text={heading}
      data-prop="heading"
    />
    <Text
      text={description}
      data-prop="description"
    />

    <form
      class="spw__form"
      data-spw-form
      novalidate
    >
      <div class="spw__row">
        <label class="spw__field spw__field--grow">
          <span class="spw__label">Search</span>
          <div class="spw__input-wrap">
            <svg
