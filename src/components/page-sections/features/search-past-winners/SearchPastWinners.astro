---
/**
 * SearchPastWinners — search the scraped Stevie Awards winner records.
 *
 * WHY THE FETCH IS CLIENT-SIDE
 * This site builds static (no `output: "server"`, no active adapter), so
 * frontmatter runs once at build time. A frontmatter fetch would bake one set of
 * results into the HTML and could never respond to what a visitor types. So the
 * search runs in the browser against the winners API, the same way
 * EnquiryForm.astro posts to Zendesk from the browser.
 *
 * WHY THE ENDPOINT IS A `PUBLIC_` ENV VAR
 * It is baked into the client bundle and therefore visible to anyone. That is
 * fine and intended: the API is read-only and unauthenticated by design (see
 * public_api.py). Never put a token here — there is nowhere private to hide it
 * in a static build.
 *
 * CSS-FIRST, PER THE COMPONENT SKILL
 * The form is a real <form> with real inputs and a real submit button, so it is
 * legible and focusable with JavaScript disabled; the results panel simply
 * stays in its empty state. JS is the enhancement that fills it in.
 */
import Heading from "@core-elements/heading/Heading.astro";
import Text from "@core-elements/text/Text.astro";
import CustomSection from "@builders/custom-section/CustomSection.astro";

const WINNERS_API_ENDPOINT = "http://127.0.0.1:8010";

const {
  heading = "Search Past Stevie Award Winners",
  description = "Search every past winner by company, person, category, country or year.",
  // Overridable in CloudCannon so an editor can repoint the component at a
  // tunnel URL without a code change, and by env for per-environment builds.
  apiEndpoint = "",
  pageSize = 24,
  showFilters = true,
  showOverview = true,
  initialQuery = "",
  emptyStateText = "Enter a search above, or browse every record.",
  // Prints every step (config read, each fetch, each error) into a visible
  // on-page panel, not just the browser console. Needed because the CMS
  // editor's live-preview iframe is awkward to open devtools against, and
  // "records are not loading" with no visible error is otherwise a guess.
  // Default true while this component is new; turn off once trusted.
  debug = true,

  colorScheme = "inherit",
  backgroundColor,
  paddingVertical = "4xl",
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const endpoint = (
  apiEndpoint ||
  import.meta.env.PUBLIC_WINNERS_API_ENDPOINT ||
  WINNERS_API_ENDPOINT
).replace(/\/+$/, "");

// Clamped: the API caps `limit` at 50, and a request over that is rejected
// rather than quietly truncated, which would silently break paging.
const perPage = Math.max(1, Math.min(Number(pageSize) || 24, 50));

const config = {
  endpoint,
  perPage,
  showOverview: !!showOverview,
  initialQuery: String(initialQuery || ""),
  debug: !!debug,
};
---

<CustomSection
  class:list={["search-past-winners", className]}
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <div
    class="spw"
    data-spw
    data-config={JSON.stringify(config)}
  >
    <Heading
      level="h2"
      size="lg"
      text={heading}
      data-prop="heading"
    />
    <Text
      text={description}
      data-prop="description"
    />

    <form
      class="spw__form"
      data-spw-form
      novalidate
    >
      <div class="spw__row">
        <label class="spw__field spw__field--grow">
          <span class="spw__label">Search</span>
          <input
            type="search"
            name="q"
            class="spw__input"
            data-spw-q
            placeholder="e.g. IBM, customer service team, gold winners in 2024"
            autocomplete="off"
          />
        </label>
        <button
          type="submit"
          class="spw__submit"
          data-spw-submit
          >Search</button
        >
      </div>

      {
        showFilters && (
          <div
            class="spw__row spw__row--filters"
            data-spw-filters
          >
            <label class="spw__field">
              <span class="spw__label">Profile type</span>
              <select
                name="profile_type"
                class="spw__select"
                data-spw-filter="profile_type"
              >
                <option value="all">All</option>
                <option value="org" selected>
                  Organizations
                </option>
                <option value="person">People</option>
              </select>
            </label>
            <label class="spw__field">
              <span class="spw__label">Award level</span>
              <select
                name="award"
                class="spw__select"
                data-spw-filter="award"
              >
                <option value="">All levels</option>
              </select>
            </label>
            <label class="spw__field">
              <span class="spw__label">Country</span>
              <select
                name="country"
                class="spw__select"
                data-spw-filter="country"
              >
                <option value="">All countries</option>
              </select>
            </label>
            <label class="spw__field">
              <span class="spw__label">Sector</span>
              <select
                name="category"
                class="spw__select"
                data-spw-filter="category"
              >
                <option value="">All sectors</option>
              </select>
            </label>
            <label class="spw__field spw__field--narrow">
              <span class="spw__label">Year from</span>
              <input
                type="number"
                name="year_from"
                class="spw__input"
                data-spw-filter="year_from"
                min="1990"
                max="2100"
                placeholder="1996"
              />
            </label>
            <label class="spw__field spw__field--narrow">
              <span class="spw__label">Year to</span>
              <input
                type="number"
                name="year_to"
                class="spw__input"
                data-spw-filter="year_to"
                min="1990"
                max="2100"
                placeholder="2026"
              />
            </label>
            <button
              type="reset"
              class="spw__reset"
              data-spw-reset
            >
              Clear
            </button>
          </div>
        )
      }
    </form>

    <p
      class="spw__status"
      data-spw-status
      role="status"
      aria-live="polite"
    >
      {emptyStateText}
    </p>

    {
      showOverview && (
        <section
          class="spw__overview"
          data-spw-overview
          hidden
        >
          <div class="spw__overview-head">
            <span class="spw__overview-title">Overview</span>
            <span
              class="spw__overview-source"
              data-spw-overview-source
            />
          </div>
          <p
            class="spw__answer"
            data-spw-answer
          />
          <p
            class="spw__detail"
            data-spw-detail
          />
          <div
            class="spw__chips"
            data-spw-levels
          />
          <div
            class="spw__orgs"
            data-spw-orgs
          />
        </section>
      )
    }

    {
      debug && (
        <pre class="spw__debug" data-spw-debug>
          {"Debug: waiting for the client script to start…\n" +
            "(if this line never changes, the <script> below never ran " +
            "in this preview — that is itself the finding)"}
        </pre>
      )
    }

    <div
      class="spw__results"
      data-spw-results
    >
    </div>

    <nav
      class="spw__pager"
      data-spw-pager
      hidden
      aria-label="Search results pages"
    >
      <button
        type="button"
        class="spw__page-btn"
        data-spw-prev
        >Previous</button
      >
      <span
        class="spw__page-info"
        data-spw-page-info
      ></span>
      <button
        type="button"
        class="spw__page-btn"
        data-spw-next
        >Next</button
      >
    </nav>

    <!-- Profile detail overlay. Hidden until a row is clicked; closed by the
         close button, the scrim, or Escape. Built once in markup rather than
         injected on demand, so there is a stable element for the script to
         attach listeners to regardless of how many times results re-render. -->
    <div
      class="spw__scrim"
      data-spw-scrim
      hidden
    >
    </div>
    <aside
      class="spw__drawer"
      data-spw-drawer
      hidden
      role="dialog"
      aria-modal="true"
      aria-labelledby="spw-drawer-name"
    >
      <div class="spw__drawer-head">
        <div>
          <h3
            class="spw__drawer-name"
            id="spw-drawer-name"
            data-spw-drawer-name
          >
            —
          </h3>
          <p
            class="spw__drawer-sub"
            data-spw-drawer-sub
          />
        </div>
        <button
          type="button"
          class="spw__drawer-close"
          data-spw-drawer-close
          aria-label="Close"
          >✕</button
        >
      </div>
      <div
        class="spw__drawer-body"
        data-spw-drawer-body
      >
      </div>
    </aside>
  </div>
</CustomSection>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";

  const NS = "[search-past-winners]";

  // One row per ORGANIZATION or PERSON (a rolled-up profile), not one row per
  // award -- so IBM's 894 nominations are one clickable row with a total, the
  // same shape the dashboard's own Explorer settled on after the same
  // question came up there ("why are there two different result tables for
  // one search").
  type ProfileRow = {
    profile_key?: string;
    display_name?: string;
    profile_type?: "org" | "person";
    category?: string; // sector (orgs) or role (people)
    country?: string;
    city?: string;
    award_count?: number;
    gold?: number;
    silver?: number;
    bronze?: number;
    first_year?: string;
    last_year?: string;
    programs?: string;
  };

  type AwardRow = {
    year?: string;
    award?: string;
    award_programs?: string;
    category?: string;
    category_group?: string;
    nomination_title?: string;
    industry?: string;
    city?: string;
    country?: string;
    organization_name?: string;
    role?: string;
    org_name?: string;
  };

  const esc = (value: unknown): string =>
    String(value ?? "").replace(
      /[&<>"']/g,
      (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] ?? c
    );

  const num = (value: unknown): string => Number(value ?? 0).toLocaleString("en-US");

  /** The stored award string is "Gold Stevie® Award"; the chip wants "Gold". */
  const levelOf = (award: unknown): string => {
    const text = String(award ?? "");
    const hit = ["Grand", "Gold", "Silver", "Bronze", "Finalist", "People's Choice"].find((label) =>
      text.toLowerCase().includes(label.toLowerCase())
    );
    return hit || (text.trim() ? "Other" : "");
  };

  const initSearchPastWinners = () => {
    const roots = document.querySelectorAll<HTMLElement>("[data-spw]");
    if (!roots.length) return;

    roots.forEach((root) => {
      // Astro re-runs module scripts on view transitions; without this a second
      // set of listeners would fire one request per past navigation.
      if (root.dataset.spwReady === "true") return;
      root.dataset.spwReady = "true";

      const debugEl = root.querySelector<HTMLElement>("[data-spw-debug]");
      // Writes to BOTH the browser console and a visible on-page panel, so a
      // CMS preview iframe that is awkward to open devtools against still
      // shows exactly where this broke. debugEl is null when the `debug` prop
      // is off, so this degrades to console-only with no extra cost.
      const log = (msg: string, ...rest: unknown[]) => {
        const line = `[${new Date().toLocaleTimeString()}] ${msg}`;
        console.log(NS, msg, ...rest);
        if (debugEl) {
          debugEl.textContent += "\n" + line + (rest.length ? " " + JSON.stringify(rest[0]) : "");
        }
      };

      log("component script started");

      let config: {
        endpoint: string;
        perPage: number;
        showOverview: boolean;
        initialQuery: string;
        debug: boolean;
      };
      try {
        config = JSON.parse(root.dataset.config || "{}");
      } catch (err) {
        log("FAILED to parse config JSON", String(err));
        return;
      }
      const { endpoint, perPage, showOverview } = config;
      log(`config parsed: endpoint="${endpoint}" perPage=${perPage} showOverview=${showOverview}`);
      if (!endpoint) {
        log("STOPPING: no API endpoint configured (apiEndpoint field is empty)");
        return;
      }

      const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel);
      const form = $<HTMLFormElement>("[data-spw-form]");
      const qInput = $<HTMLInputElement>("[data-spw-q]");
      const statusEl = $("[data-spw-status]");
      const resultsEl = $("[data-spw-results]");
      const pagerEl = $("[data-spw-pager]");
      const pageInfoEl = $("[data-spw-page-info]");
      const prevBtn = $<HTMLButtonElement>("[data-spw-prev]");
      const nextBtn = $<HTMLButtonElement>("[data-spw-next]");
      const submitBtn = $<HTMLButtonElement>("[data-spw-submit]");
      const overviewEl = $("[data-spw-overview]");
      const scrimEl = $("[data-spw-scrim]");
      const drawerEl = $("[data-spw-drawer]");
      const drawerNameEl = $("[data-spw-drawer-name]");
      const drawerSubEl = $("[data-spw-drawer-sub]");
      const drawerBodyEl = $("[data-spw-drawer-body]");
      const drawerCloseBtn = $<HTMLButtonElement>("[data-spw-drawer-close]");
      if (!form || !qInput || !statusEl || !resultsEl) return;

      const filterEls = Array.from(
        root.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-spw-filter]")
      );

      let offset = 0;
      let total = 0;
      // Only the newest request may paint. Without this, a slow early request
      // can land after a newer one and repaint the grid with stale rows — the
      // exact fault this project already hit on its internal search page.
      let seq = 0;

      const filters = (): Record<string, string> => {
        const out: Record<string, string> = {};
        filterEls.forEach((el) => {
          const key = el.dataset.spwFilter;
          const value = el.value.trim();
          if (key && value) out[key] = value;
        });
        return out;
      };

      const url = (path: string, params: Record<string, string | number>) => {
        const qs = new URLSearchParams();
        Object.entries(params).forEach(([k, v]) => {
          if (v !== "" && v !== undefined && v !== null) qs.set(k, String(v));
        });
        return `${endpoint}${path}?${qs.toString()}`;
      };

      /** "2003–2026", or a single year, or "" when neither is known. */
      const spanOf = (first?: string, last?: string): string =>
        first && last ? (first === last ? first : `${first}–${last}`) : first || last || "";

      /** A pipe-separated field ("Brazil | Germany | India | ...", up to 11 for
       *  a global company) truncated to `keep` items plus a "+N" count, with the
       *  full list in the returned title for hover. Same convention the
       *  dashboard's own Explorer uses (see pipes() in explorer.html) --
       *  without it a table cell can be a single 200-character unbroken run
       *  that forces its whole column wider than the page rather than wrapping,
       *  since a table in the default auto layout sizes columns to fit content
       *  first and only wraps once nothing else can shrink further. */
      const pipes = (value: unknown, keep = 2): { text: string; title: string } => {
        const parts = String(value ?? "")
          .split("|")
          .map((s) => s.trim())
          .filter(Boolean);
        if (!parts.length) return { text: "—", title: "" };
        const head = parts.slice(0, keep).join(", ");
        const extra = parts.length - keep;
        return { text: extra > 0 ? `${head} +${extra}` : head, title: parts.join(", ") };
      };

      const renderRows = (rows: ProfileRow[]) => {
        if (!rows.length) {
          resultsEl.innerHTML = "";
          return;
        }
        const showType = (filters().profile_type || "org") === "all";
        resultsEl.innerHTML = `
          <table class="spw__table">
            <thead>
              <tr>
                <th scope="col">Profile</th>
                ${showType ? '<th scope="col">Type</th>' : ""}
                <th scope="col">Sector / role</th>
                <th scope="col">Country</th>
                <th scope="col" class="spw__num">Awards</th>
                <th scope="col">Medals</th>
                <th scope="col">Span</th>
              </tr>
            </thead>
            <tbody>
              ${rows
                .map((r) => {
                  const key = r.profile_key || r.display_name || "";
                  const ptype = r.profile_type === "person" ? "person" : "org";
                  const cat = pipes(r.category, 2);
                  const ctry = pipes(r.country, 2);
                  const medals = [
                    r.gold ? `<span class="spw__medal spw__medal--gold">${num(r.gold)}G</span>` : "",
                    r.silver ? `<span class="spw__medal spw__medal--silver">${num(r.silver)}S</span>` : "",
                    r.bronze ? `<span class="spw__medal spw__medal--bronze">${num(r.bronze)}B</span>` : "",
                  ]
                    .filter(Boolean)
                    .join(" ");
                  return `<tr>
                    <td class="spw__cell-org">
                      <button
                        type="button"
                        class="spw__profile-link"
                        data-profile-type="${esc(ptype)}"
                        data-profile-key="${esc(key)}"
                      >${esc(r.display_name || key)}</button>
                    </td>
                    ${showType ? `<td><span class="spw__type-badge spw__type-badge--${ptype}">${ptype === "org" ? "Org" : "Person"}</span></td>` : ""}
                    <td class="spw__cell-muted" title="${esc(cat.title)}">${esc(cat.text)}</td>
                    <td class="spw__cell-muted" title="${esc(ctry.title)}">${esc(ctry.text)}</td>
                    <td class="spw__num">${num(r.award_count)}</td>
                    <td>${medals}</td>
                    <td class="spw__cell-muted">${esc(spanOf(r.first_year, r.last_year))}</td>
                  </tr>`;
                })
                .join("")}
            </tbody>
          </table>`;
      };

      const renderPager = () => {
        if (!pagerEl || !pageInfoEl || !prevBtn || !nextBtn) return;
        const pages = Math.max(1, Math.ceil(total / perPage));
        const page = Math.floor(offset / perPage) + 1;
        pagerEl.hidden = total <= perPage;
        pageInfoEl.textContent = `Page ${num(page)} of ${num(pages)}`;
        prevBtn.disabled = offset <= 0;
        nextBtn.disabled = offset + perPage >= total;
      };

      const renderOverview = (data: Record<string, unknown> | null) => {
        if (!overviewEl) return;
        if (!data || !data.available || !data.total) {
          overviewEl.hidden = true;
          return;
        }
        overviewEl.hidden = false;

        const answerEl = $("[data-spw-answer]");
        const detailEl = $("[data-spw-detail]");
        const sourceEl = $("[data-spw-overview-source]");
        const levelsEl = $("[data-spw-levels]");
        const orgsEl = $("[data-spw-orgs]");

        if (answerEl) answerEl.textContent = String(data.answer ?? "");
        if (detailEl) detailEl.textContent = String(data.headline ?? "");
        if (sourceEl) {
          // Says plainly whether a model wrote the sentence. The NUMBERS are
          // SQL-counted either way; claiming "not generated" unconditionally
          // would be false as soon as generated_by is "ai".
          const byAi = data.generated_by === "ai";
          const provider = String(data.ai_provider || "ai").toUpperCase();
          sourceEl.textContent = byAi
            ? `Counted from all ${num(data.total)} matches · sentence by ${provider}`
            : `Counted from all ${num(data.total)} matches`;
        }
        if (levelsEl) {
          const levels = (data.levels as { level: string; count: number }[]) || [];
          levelsEl.innerHTML = levels
            .map(
              (l) =>
                `<span class="spw__chip spw__level--${esc(
                  String(l.level)
                    .toLowerCase()
                    .replace(/[^a-z]+/g, "-")
                )}">${esc(l.level)} <b>${num(l.count)}</b></span>`
            )
            .join("");
        }
        if (orgsEl) {
          type TopOrg = {
            name: string;
            awards: number;
            gold?: number;
            silver?: number;
            bronze?: number;
            first_year?: string;
            last_year?: string;
          };
          const orgs = ((data.top_orgs as TopOrg[]) || []).slice(0, 10);
          // Proportional to the LEADER within this visible list, not to some
          // fixed scale -- the same convention the main dashboard's search
          // page uses, so a bar reads the same way everywhere in the project.
          const max = orgs.reduce((m, o) => Math.max(m, o.awards || 0), 0);
          orgsEl.innerHTML = orgs.length
            ? `<span class="spw__orgs-label">Top organizations</span>${orgs
                .map((o) => {
                  const pct = max ? Math.round(((o.awards || 0) / max) * 100) : 0;
                  const span = spanOf(o.first_year, o.last_year);
                  const mix = [
                    o.gold ? `${num(o.gold)}G` : "",
                    o.silver ? `${num(o.silver)}S` : "",
                    o.bronze ? `${num(o.bronze)}B` : "",
                  ]
                    .filter(Boolean)
                    .join(" · ");
                  return `<div class="spw__org-row">
                    <div class="spw__org-head">
                      <span class="spw__org-name">${esc(o.name)}</span>
                      <span class="spw__org-count">${num(o.awards)}</span>
                    </div>
                    <div class="spw__org-meta">
                      <span class="spw__org-bar"><i style="width:${pct}%"></i></span>
                      <span class="spw__org-sub">${esc(mix)}${span ? ` · ${esc(span)}` : ""}</span>
                    </div>
                  </div>`;
                })
                .join("")}`
            : "";
        }
      };

      const run = async (nextOffset = 0) => {
        const mine = ++seq;
        offset = nextOffset;
        const q = qInput.value.trim();
        const params = { q, limit: perPage, offset, ...filters() };

        statusEl.textContent = "Searching…";
        statusEl.dataset.kind = "";
        if (submitBtn) submitBtn.disabled = true;

        // One results table: PROFILES (one row per organization/person), not
        // one row per award. `q` runs through the same natural-language parser
        // the search API uses, applied to profiles instead of award rows, so
        // "which companies from Germany won gold" answers with the companies
        // themselves rather than their individual nomination records.
        const searchUrl = url("/v1/profiles", params);
        log(`fetching profiles: ${searchUrl}`);

        try {
          const res = await fetch(searchUrl);
          log(`profiles response: HTTP ${res.status}`);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();
          if (data.error) throw new Error(data.error);
          log(`profiles parsed OK: total=${data.total} rows=${(data.results || []).length}`);
          if (mine !== seq) return; // superseded by a newer search

          total = Number(data.total || 0);
          const rows: ProfileRow[] = data.results || [];
          renderRows(rows);
          renderPager();

          const noun = (filters().profile_type || "org") === "person" ? "people" : "profiles";
          const from = total ? offset + 1 : 0;
          const to = offset + rows.length;
          statusEl.textContent = total
            ? `${num(from)}–${num(to)} of ${num(total)} ${noun}`
            : `No matching ${noun}.`;
        } catch (err) {
          if (mine !== seq) return;
          // "Failed to fetch" / TypeError with no HTTP status is the classic
          // signature of CORS being blocked or the tunnel being unreachable --
          // called out explicitly because that distinction is exactly what
          // determines the fix, and the browser's own message is too generic
          // to read at a glance.
          const detail = err instanceof Error ? err.message : String(err);
          const looksLikeCorsOrNetwork = err instanceof TypeError;
          log(
            `SEARCH FAILED: ${detail}` +
              (looksLikeCorsOrNetwork
                ? " -- likely CORS blocked, tunnel down, or wrong URL (no HTTP status reached)"
                : "")
          );
          statusEl.textContent = "Search is unavailable right now. Please try again.";
          statusEl.dataset.kind = "error";
          resultsEl.innerHTML = "";
          if (pagerEl) pagerEl.hidden = true;
        } finally {
          if (mine === seq && submitBtn) submitBtn.disabled = false;
        }

        if (!showOverview || !overviewEl) return;
        const overviewUrl = url("/v1/overview", { q, ...filters() });
        log(`fetching overview: ${overviewUrl}`);
        try {
          const res = await fetch(overviewUrl);
          log(`overview response: HTTP ${res.status}`);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();
          if (mine !== seq) return;
          renderOverview(data);
        } catch (err) {
          // The results grid is the product; a failed summary must never look
          // like a failed search.
          const detail = err instanceof Error ? err.message : String(err);
          log(`overview unavailable (non-fatal): ${detail}`);
          overviewEl.hidden = true;
        }
      };

      /** Populate the dropdowns from the real data, so a re-scrape that adds a
       *  country shows up without a code change. */
      const loadFacets = async () => {
        if (!filterEls.length) return;
        const facetsUrl = url("/v1/facets", { limit: 250 });
        log(`fetching facets: ${facetsUrl}`);
        try {
          const res = await fetch(facetsUrl);
          log(`facets response: HTTP ${res.status}`);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();
          const fill = (key: string, items: { name: string; count: number }[]) => {
            const sel = filterEls.find(
              (el) => el.dataset.spwFilter === key && el.tagName === "SELECT"
            ) as HTMLSelectElement | undefined;
            if (!sel || !items) return;
            items.forEach((item) => {
              if (!item.name) return;
              const opt = document.createElement("option");
              opt.value = item.name;
              opt.textContent = `${item.name} (${num(item.count)})`;
              sel.appendChild(opt);
            });
          };
          fill("award", data.awards);
          fill("country", data.countries);
          // The curated ~21-value organization taxonomy, not `industries`
          // (which is `winners.industry` -- 1,175 free-text scrape values,
          // not a real filter vocabulary). See public_api.py's /v1/facets.
          fill("category", data.sectors);
        } catch (err) {
          // Filters degrade to "All" only; free-text search still works.
          const detail = err instanceof Error ? err.message : String(err);
          log(`facets unavailable (non-fatal): ${detail}`);
        }
      };

      /** Full profile: rollup stats plus every award in its history. Fetched
       *  on click rather than bundled into the list response, because a list
       *  page of 50 profiles would otherwise carry 50 full award histories
       *  (some organizations have 700+) whether or not any of them get opened. */
      const openProfile = async (profileType: string, profileKey: string) => {
        if (!scrimEl || !drawerEl || !drawerNameEl || !drawerBodyEl) return;
        scrimEl.hidden = false;
        drawerEl.hidden = false;
        drawerNameEl.textContent = profileKey;
        if (drawerSubEl) drawerSubEl.textContent = profileType === "person" ? "Person" : "Organization";
        drawerBodyEl.innerHTML = `<p class="spw__drawer-loading">Loading profile…</p>`;

        const detailUrl = `${endpoint}/v1/profile/${encodeURIComponent(profileType)}/${encodeURIComponent(profileKey)}`;
        log(`fetching profile detail: ${detailUrl}`);
        try {
          const res = await fetch(detailUrl);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();
          if (data.error) throw new Error(data.error);
          log(`profile detail parsed OK: awards=${data.award_history_count}`);

          drawerNameEl.textContent = data.display_name || profileKey;
          const p = data.profile || {};
          const awards: AwardRow[] = data.awards || [];
          const tiles = [
            ["Total awards", num(data.award_count)],
            ["Gold", num(p.gold)],
            ["Silver", num(p.silver)],
            ["Bronze", num(p.bronze)],
            ["Active", spanOf(p.first_year, p.last_year)],
          ]
            .filter(([, v]) => v && v !== "0")
            .map(([label, value]) => `<div class="spw__tile"><b>${esc(value)}</b><span>${esc(label)}</span></div>`)
            .join("");

          // Multi-value fields are stored pipe-separated ("Brazil | Germany |
          // India"); render each as its own chip rather than one long string.
          const chipRow = (label: string, raw: unknown, limit = 8) => {
            const items = String(raw ?? "")
              .split("|")
              .map((s) => s.trim())
              .filter(Boolean);
            if (!items.length) return "";
            const shown = items.slice(0, limit);
            const more = items.length > limit ? ` +${items.length - limit}` : "";
            return `<div class="spw__fact-row">
              <span class="spw__fact-label">${esc(label)}</span>
              <span class="spw__fact-chips">${shown.map((v) => `<span class="spw__chip">${esc(v)}</span>`).join("")}${more ? `<span class="spw__chip">${esc(more.trim())}</span>` : ""}</span>
            </div>`;
          };

          const facts = profileType === "person"
            ? chipRow("Roles", p.roles) + chipRow("Organizations", p.orgs) + chipRow("Programs", p.programs) + chipRow("Countries", p.countries)
            : chipRow("Sector", p.industry_sector, 1) +
              chipRow("Programs", p.programs) +
              chipRow("Categories", p.categories, 6) +
              chipRow("Country", p.country);

          // domain/employee_count/linkedin_url come from an earlier, less
          // rigorous enrichment pass than the isolated/verified pipeline this
          // project settled on -- the internal Explorer never presents them as
          // confirmed, and this drawer shouldn't either. Shown, but labelled.
          const companyBits = [
            p.domain ? `<a href="https://${esc(p.domain)}" target="_blank" rel="noopener noreferrer">${esc(p.domain)}</a>` : "",
            p.employee_count ? `${esc(p.employee_count)} employees` : "",
            p.linkedin_url ? `<a href="${esc(p.linkedin_url)}" target="_blank" rel="noopener noreferrer">LinkedIn</a>` : "",
          ].filter(Boolean);
          const companyInfo = companyBits.length
            ? `<p class="spw__drawer-note">${companyBits.join(" · ")} <em>(unverified, from an earlier research pass)</em></p>`
            : "";

          const historyRows = awards
            .slice(0, 200)
            .map((a) => {
              const level = levelOf(a.award);
              const place = [a.city, a.country].filter(Boolean).join(", ");
              return `<tr>
                <td>${esc(a.year)}</td>
                <td>${level ? `<span class="spw__level spw__level--${esc(level.toLowerCase().replace(/[^a-z]+/g, "-"))}">${esc(level)}</span>` : ""}</td>
                <td class="spw__cell-muted">${esc(a.category || a.category_group)}</td>
                <td>${esc(a.nomination_title)}</td>
                <td class="spw__cell-muted">${esc(place)}</td>
              </tr>`;
            })
            .join("");

          drawerBodyEl.innerHTML = `
            ${tiles ? `<div class="spw__tiles">${tiles}</div>` : ""}
            ${facts ? `<div class="spw__facts">${facts}</div>` : ""}
            ${companyInfo}
            <h4 class="spw__drawer-heading">Award history</h4>
            ${
              awards.length
                ? `<table class="spw__table spw__table--history">
                    <thead><tr><th>Year</th><th>Level</th><th>Category</th><th>Nomination</th><th>Location</th></tr></thead>
                    <tbody>${historyRows}</tbody>
                  </table>
                  ${awards.length > 200 ? `<p class="spw__drawer-note">Showing the first 200 of ${num(awards.length)} awards.</p>` : ""}`
                : `<p class="spw__drawer-note">No award history on file for this profile.</p>`
            }`;
        } catch (err) {
          const detail = err instanceof Error ? err.message : String(err);
          log(`profile detail FAILED: ${detail}`);
          drawerBodyEl.innerHTML = `<p class="spw__drawer-note">Could not load this profile right now.</p>`;
        }
      };

      const closeDrawer = () => {
        if (scrimEl) scrimEl.hidden = true;
        if (drawerEl) drawerEl.hidden = true;
      };

      // Delegated: rows are replaced wholesale on every search/page, so a
      // listener bound to each button at render time would be discarded along
      // with it. One listener on the results container outlives every re-render.
      resultsEl.addEventListener("click", (event) => {
        const btn = (event.target as HTMLElement)?.closest<HTMLElement>("[data-profile-key]");
        if (!btn) return;
        const key = btn.dataset.profileKey;
        const type = btn.dataset.profileType || "org";
        if (key) openProfile(type, key);
      });
      scrimEl?.addEventListener("click", closeDrawer);
      drawerCloseBtn?.addEventListener("click", closeDrawer);
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && drawerEl && !drawerEl.hidden) closeDrawer();
      });

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        run(0);
      });
      filterEls.forEach((el) => el.addEventListener("change", () => run(0)));
      form.addEventListener("reset", () => {
        // The reset lands after this handler, so defer past it.
        window.setTimeout(() => run(0), 0);
      });
      prevBtn?.addEventListener("click", () => run(Math.max(0, offset - perPage)));
      nextBtn?.addEventListener("click", () => run(offset + perPage));

      qInput.value = config.initialQuery || "";
      void loadFacets();
      void run(0); // land on the full record list rather than an empty panel
    });
  };

  onPageLoad(initSearchPastWinners);
</script>

