---
/**
 * SearchPastWinners — search the scraped Stevie Awards winner records.
 *
 * WHY THE FETCH IS CLIENT-SIDE
 * This site builds static (no `output: "server"`, no active adapter), so
 * frontmatter runs once at build time. A frontmatter fetch would bake one set of
 * results into the HTML and could never respond to what a visitor types. So the
 * search runs in the browser against the winners API, the same way
 * EnquiryForm.astro posts to Zendesk from the browser.
 *
 * WHY THE ENDPOINT IS A `PUBLIC_` ENV VAR
 * It is baked into the client bundle and therefore visible to anyone. That is
 * fine and intended: the API is read-only and unauthenticated by design (see
 * public_api.py). Never put a token here — there is nowhere private to hide it
 * in a static build.
 *
 * CSS-FIRST, PER THE COMPONENT SKILL
 * The form is a real <form> with real inputs and a real submit button, so it is
 * legible and focusable with JavaScript disabled; the results panel simply
 * stays in its empty state. JS is the enhancement that fills it in.
 */
import Heading from "@core-elements/heading/Heading.astro";
import Text from "@core-elements/text/Text.astro";
import CustomSection from "@builders/custom-section/CustomSection.astro";

const WINNERS_API_ENDPOINT = "http://127.0.0.1:8010";

const {
  heading = "Search Past Stevie Award Winners",
  description = "Search every past winner by company, person, category, country or year.",
  // Overridable in CloudCannon so an editor can repoint the component at a
  // tunnel URL without a code change, and by env for per-environment builds.
  apiEndpoint = "",
  pageSize = 24,
  showFilters = true,
  showOverview = true,
  initialQuery = "",
  emptyStateText = "Enter a search above, or browse every record.",
  // Prints every step (config read, each fetch, each error) into a visible
  // on-page panel, not just the browser console. Needed because the CMS
  // editor's live-preview iframe is awkward to open devtools against, and
  // "records are not loading" with no visible error is otherwise a guess.
  // Default true while this component is new; turn off once trusted.
  debug = true,

  colorScheme = "inherit",
  backgroundColor,
  paddingVertical = "4xl",
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const endpoint = (
  apiEndpoint ||
  import.meta.env.PUBLIC_WINNERS_API_ENDPOINT ||
  WINNERS_API_ENDPOINT
).replace(/\/+$/, "");

// Clamped: the API caps `limit` at 50, and a request over that is rejected
// rather than quietly truncated, which would silently break paging.
const perPage = Math.max(1, Math.min(Number(pageSize) || 24, 50));

const config = {
  endpoint,
  perPage,
  showOverview: !!showOverview,
  initialQuery: String(initialQuery || ""),
  debug: !!debug,
};
---

<CustomSection
  class:list={["search-past-winners", className]}
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <div
    class="spw"
    data-spw
    data-config={JSON.stringify(config)}
  >
    <Heading
      level="h2"
      size="lg"
      text={heading}
      data-prop="heading"
    />
    <Text
      text={description}
      data-prop="description"
    />

    <form
      class="spw__form"
      data-spw-form
      novalidate
    >
      <div class="spw__row">
        <label class="spw__field spw__field--grow">
          <span class="spw__label">Search</span>
          <input
            type="search"
            name="q"
            class="spw__input"
            data-spw-q
            placeholder="e.g. IBM, customer service team, gold winners in 2024"
            autocomplete="off"
          />
        </label>
        <button
          type="submit"
          class="spw__submit"
          data-spw-submit
          >Search</button
        >
        {
          showFilters && (
            <button
              type="button"
              class="spw__filters-toggle"
              data-spw-filters-toggle
              aria-expanded="false"
              aria-controls="spw-filters-panel"
            >
              <svg
                class="spw__filters-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <line x1="4" y1="6" x2="20" y2="6" />
                <circle cx="9" cy="6" r="2" fill="currentColor" stroke="none" />
                <line x1="4" y1="12" x2="20" y2="12" />
                <circle cx="15" cy="12" r="2" fill="currentColor" stroke="none" />
                <line x1="4" y1="18" x2="20" y2="18" />
                <circle cx="9" cy="18" r="2" fill="currentColor" stroke="none" />
              </svg>
              Filters
              <span
                class="spw__filters-count"
                data-spw-filters-count
                hidden
              />
            </button>
          )
        }
      </div>

      {
        showFilters && (
          <div
            class="spw__row spw__row--filters"
            data-spw-filters
            id="spw-filters-panel"
            hidden
          >
            <label class="spw__field">
              <span class="spw__label">Profile type</span>
              <select
                name="profile_type"
                class="spw__select"
                data-spw-filter="profile_type"
              >
                <option value="all" selected>
                  All
                </option>
                <option value="org">
                  Organizations
                </option>
                <option value="person">People</option>
              </select>
            </label>
            <label class="spw__field">
              <span class="spw__label">Award level</span>
              <select
                name="award"
                class="spw__select"
                data-spw-filter="award"
              >
                <option value="">All levels</option>
              </select>
            </label>
            <label class="spw__field">
              <span class="spw__label">Country</span>
              <select
                name="country"
                class="spw__select"
                data-spw-filter="country"
              >
                <option value="">All countries</option>
              </select>
            </label>
            <label class="spw__field">
              <span class="spw__label">Sector</span>
              <select
                name="category"
                class="spw__select"
                data-spw-filter="category"
              >
                <option value="">All sectors</option>
              </select>
            </label>
            <label class="spw__field spw__field--narrow">
              <span class="spw__label">Year from</span>
              <input
                type="number"
                name="year_from"
                class="spw__input"
                data-spw-filter="year_from"
                min="1990"
                max="2100"
                placeholder="1996"
              />
            </label>
            <label class="spw__field spw__field--narrow">
              <span class="spw__label">Year to</span>
              <input
                type="number"
                name="year_to"
                class="spw__input"
                data-spw-filter="year_to"
                min="1990"
                max="2100"
                placeholder="2026"
              />
            </label>
            <button
              type="reset"
              class="spw__reset"
              data-spw-reset
            >
              Clear
            </button>
          </div>
        )
      }
    </form>

    <p
      class="spw__status"
      data-spw-status
      role="status"
      aria-live="polite"
    >
      {emptyStateText}
    </p>

    {
      showOverview && (
        <section
          class="spw__overview"
          data-spw-overview
          data-state="idle"
          hidden
        >
          <div
            class="spw__overview-loading"
            data-spw-overview-loading
            hidden
          >
            <span class="spw__spinner" aria-hidden="true" />
            <div>
              <p class="spw__overview-loading-title">Preparing overview</p>
              <p class="spw__overview-loading-copy">
                Counting every matching award and writing the summary…
              </p>
            </div>
          </div>
          <div
            class="spw__overview-ready"
            data-spw-overview-ready
          >
            <div class="spw__overview-head">
              <span class="spw__overview-title">Overview</span>
              <span
                class="spw__overview-source"
                data-spw-overview-source
              />
            </div>
            <p
              class="spw__answer"
              data-spw-answer
            />
            <p
              class="spw__detail"
              data-spw-detail
            />
            <div
              class="spw__chips"
              data-spw-levels
            />
            <div
              class="spw__orgs"
              data-spw-orgs
            />
          </div>
        </section>
      )
    }

    {
      debug && (
        <pre class="spw__debug" data-spw-debug>
          {"Debug: waiting for the client script to start…\n" +
            "(if this line never changes, the <script> below never ran " +
            "in this preview — that is itself the finding)"}
        </pre>
      )
    }

    <div
      class="spw__results"
      data-spw-results
    >
    </div>

    <nav
      class="spw__pager"
      data-spw-pager
      hidden
      aria-label="Search results pages"
    >
      <button
        type="button"
        class="spw__page-btn"
        data-spw-prev
        >Previous</button
      >
      <span
        class="spw__page-info"
        data-spw-page-info
      ></span>
      <button
        type="button"
        class="spw__page-btn"
        data-spw-next
        >Next</button
      >
    </nav>

    <!-- Profile detail: centered floating window. Hidden until a row is
         clicked; closed by the close button, the scrim, or Escape. Markup
         is stable so listeners survive result re-renders. -->
    <div
      class="spw__scrim"
      data-spw-scrim
      hidden
    >
    </div>
    <aside
      class="spw__drawer"
      data-spw-drawer
      hidden
      role="dialog"
      aria-modal="true"
      aria-labelledby="spw-drawer-name"
    >
      <div class="spw__drawer-head">
        <div>
          <h3
            class="spw__drawer-name"
            id="spw-drawer-name"
            data-spw-drawer-name
          >
            —
          </h3>
          <p
            class="spw__drawer-sub"
            data-spw-drawer-sub
          />
        </div>
        <button
          type="button"
          class="spw__drawer-close"
          data-spw-drawer-close
        >
          Close
        </button>
      </div>
      <div
        class="spw__drawer-body"
        data-spw-drawer-body
      >
      </div>
    </aside>
  </div>
</CustomSection>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";

  const NS = "[search-past-winners]";

  // One row per ORGANIZATION or PERSON (a rolled-up profile), not one row per
  // award -- so IBM's 894 nominations are one clickable row with a total, the
  // same shape the dashboard's own Explorer settled on after the same
  // question came up there ("why are there two different result tables for
  // one search").
  type ProfileRow = {
    profile_key?: string;
    display_name?: string;
    profile_type?: "org" | "person";
    category?: string; // sector (orgs) or role (people)
    country?: string;
    city?: string;
    award_count?: number;
    gold?: number;
    silver?: number;
    bronze?: number;
    first_year?: string;
    last_year?: string;
    programs?: string;
    match_kind?: "exact" | "related";
  };

  type AwardRow = {
    year?: string;
    award?: string;
    award_programs?: string;
    category?: string;
    category_group?: string;
    nomination_title?: string;
    industry?: string;
    city?: string;
    country?: string;
    organization_name?: string;
    role?: string;
    org_name?: string;
  };

  const esc = (value: unknown): string =>
    String(value ?? "").replace(
      /[&<>"']/g,
      (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] ?? c
    );

  const num = (value: unknown): string => Number(value ?? 0).toLocaleString("en-US");

  /** The stored award string is "Gold Stevie® Award"; the chip wants "Gold". */
  const levelOf = (award: unknown): string => {
    const text = String(award ?? "");
    const hit = ["Grand", "Gold", "Silver", "Bronze", "Finalist", "People's Choice"].find((label) =>
      text.toLowerCase().includes(label.toLowerCase())
    );
    return hit || (text.trim() ? "Other" : "");
  };

  const initSearchPastWinners = () => {
    const roots = document.querySelectorAll<HTMLElement>("[data-spw]");
    if (!roots.length) return;

    roots.forEach((root) => {
      // Astro re-runs module scripts on view transitions; without this a second
      // set of listeners would fire one request per past navigation.
      if (root.dataset.spwReady === "true") return;
      root.dataset.spwReady = "true";

      const debugEl = root.querySelector<HTMLElement>("[data-spw-debug]");
      // Writes to BOTH the browser console and a visible on-page panel, so a
      // CMS preview iframe that is awkward to open devtools against still
      // shows exactly where this broke. debugEl is null when the `debug` prop
      // is off, so this degrades to console-only with no extra cost.
      const log = (msg: string, ...rest: unknown[]) => {
        const line = `[${new Date().toLocaleTimeString()}] ${msg}`;
        console.log(NS, msg, ...rest);
        if (debugEl) {
          debugEl.textContent += "\n" + line + (rest.length ? " " + JSON.stringify(rest[0]) : "");
        }
      };

      log("component script started");

      let config: {
        endpoint: string;
        perPage: number;
        showOverview: boolean;
        initialQuery: string;
        debug: boolean;
      };
      try {
        config = JSON.parse(root.dataset.config || "{}");
      } catch (err) {
        log("FAILED to parse config JSON", String(err));
        return;
      }
      const { endpoint, perPage, showOverview } = config;
      log(`config parsed: endpoint="${endpoint}" perPage=${perPage} showOverview=${showOverview}`);
      if (!endpoint) {
        log("STOPPING: no API endpoint configured (apiEndpoint field is empty)");
        return;
      }

      const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel);
      const form = $<HTMLFormElement>("[data-spw-form]");
      const qInput = $<HTMLInputElement>("[data-spw-q]");
      const statusEl = $("[data-spw-status]");
      const resultsEl = $("[data-spw-results]");
      const pagerEl = $("[data-spw-pager]");
      const pageInfoEl = $("[data-spw-page-info]");
      const prevBtn = $<HTMLButtonElement>("[data-spw-prev]");
      const nextBtn = $<HTMLButtonElement>("[data-spw-next]");
      const submitBtn = $<HTMLButtonElement>("[data-spw-submit]");
      const filtersToggleBtn = $<HTMLButtonElement>("[data-spw-filters-toggle]");
      const filtersPanel = $("[data-spw-filters]");
      const filtersCountEl = $("[data-spw-filters-count]");
      const overviewEl = $("[data-spw-overview]");
      const scrimEl = $("[data-spw-scrim]");
      const drawerEl = $("[data-spw-drawer]");
      const drawerNameEl = $("[data-spw-drawer-name]");
      const drawerSubEl = $("[data-spw-drawer-sub]");
      const drawerBodyEl = $("[data-spw-drawer-body]");
      const drawerCloseBtn = $<HTMLButtonElement>("[data-spw-drawer-close]");
      if (!form || !qInput || !statusEl || !resultsEl) return;

      const filterEls = Array.from(
        root.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-spw-filter]")
      );

      // Captured before loadFacets() appends any option and before the user
      // can touch a control, so it's each field's true rest state -- "org" for
      // profile_type (its only pre-selected option), "" for everything else.
      // Filters live behind an icon now instead of an always-visible row, so
      // the button needs to say how many are actually narrowing the search
      // without the panel being open to show it.
      const filterDefaults = new Map(filterEls.map((el) => [el, el.value]));

      const updateFiltersCount = () => {
        if (!filtersCountEl) return;
        const active = filterEls.filter(
          (el) => el.value.trim() !== (filterDefaults.get(el) ?? "").trim()
        ).length;
        filtersCountEl.textContent = String(active);
        filtersCountEl.hidden = active === 0;
      };

      let offset = 0;
      let total = 0;
      // Only the newest request may paint. Without this, a slow early request
      // can land after a newer one and repaint the grid with stale rows — the
      // exact fault this project already hit on its internal search page.
      let seq = 0;

      const filters = (): Record<string, string> => {
        const out: Record<string, string> = {};
        filterEls.forEach((el) => {
          const key = el.dataset.spwFilter;
          const value = el.value.trim();
          if (key && value) out[key] = value;
        });
        return out;
      };

      const url = (path: string, params: Record<string, string | number>) => {
        const qs = new URLSearchParams();
        Object.entries(params).forEach(([k, v]) => {
          if (v !== "" && v !== undefined && v !== null) qs.set(k, String(v));
        });
        return `${endpoint}${path}?${qs.toString()}`;
      };

      /** "2003–2026", or a single year, or "" when neither is known. */
      const spanOf = (first?: string, last?: string): string =>
        first && last ? (first === last ? first : `${first}–${last}`) : first || last || "";

      /** A pipe-separated field ("Brazil | Germany | India | ...", up to 11 for
       *  a global company) truncated to `keep` items plus a "+N" count, with the
       *  full list in the returned title for hover. Same convention the
       *  dashboard's own Explorer uses (see pipes() in explorer.html) --
       *  without it a table cell can be a single 200-character unbroken run
       *  that forces its whole column wider than the page rather than wrapping,
       *  since a table in the default auto layout sizes columns to fit content
       *  first and only wraps once nothing else can shrink further. */
      const pipes = (value: unknown, keep = 2): { text: string; title: string } => {
        const parts = String(value ?? "")
          .split("|")
          .map((s) => s.trim())
          .filter(Boolean);
        if (!parts.length) return { text: "—", title: "" };
        const head = parts.slice(0, keep).join(", ");
        const extra = parts.length - keep;
        return { text: extra > 0 ? `${head} +${extra}` : head, title: parts.join(", ") };
      };

      const renderTable = (rows: ProfileRow[]) => {
        const showType = (filters().profile_type || "all") === "all";
        return `
          <table class="spw__table">
            <thead>
              <tr>
                <th scope="col">Profile</th>
                ${showType ? '<th scope="col">Type</th>' : ""}
                <th scope="col">Sector / role</th>
                <th scope="col">Country</th>
                <th scope="col" class="spw__num">Awards</th>
                <th scope="col">Medals</th>
                <th scope="col">Span</th>
              </tr>
            </thead>
            <tbody>
              ${rows
                .map((r) => {
                  const key = r.profile_key || r.display_name || "";
                  const ptype = r.profile_type === "person" ? "person" : "org";
                  const cat = pipes(r.category, 2);
                  const ctry = pipes(r.country, 2);
                  // Gold+Silver+Bronze do not have to sum to Awards, and for
                  // roughly 3 in 10 organizations they genuinely don't: the
                  // raw data also carries Finalist (9,796 records), People's
                  // Choice, Grand Stevie and Distinguished Honoree awards --
                  // real wins, just not medal tiers, and the source rollup
                  // never kept a count for them beyond the lifetime total.
                  // Reported live: "5G 5S 9B" beside an Awards value of 20
                  // reads as a counting error (14+5=19, not 20) when it's
                  // really an omission -- the 20th award exists, it simply
                  // isn't Gold, Silver or Bronze. This chip is the reconciling
                  // remainder (award_count minus the three shown tiers), not a
                  // fourth medal tier the data actually distinguishes.
                  const other = Math.max(0, (r.award_count || 0) - (r.gold || 0) - (r.silver || 0) - (r.bronze || 0));
                  const medals = [
                    r.gold ? `<span class="spw__medal spw__medal--gold"><i></i>${num(r.gold)} Gold</span>` : "",
                    r.silver ? `<span class="spw__medal spw__medal--silver"><i></i>${num(r.silver)} Silver</span>` : "",
                    r.bronze ? `<span class="spw__medal spw__medal--bronze"><i></i>${num(r.bronze)} Bronze</span>` : "",
                    other
                      ? `<span class="spw__medal spw__medal--other" title="Awards at a level other than Gold/Silver/Bronze -- Finalist, People's Choice, Grand Stevie, or Distinguished Honoree">+${num(other)} other</span>`
                      : "",
                  ]
                    .filter(Boolean)
                    .join(" ");
                  // data-label carries each cell's column name so the narrow
                  // -screen layout can print it via ::before. Below 768px the
                  // header row is hidden and every row becomes a stacked card,
                  // because six columns in ~360px left each one so narrow that
                  // the browser broke words -- and worse, NUMBERS -- mid
                  // character: an award count of 772 rendered as "77" above a
                  // lone "2", which reads as a different figure entirely.
                  return `<tr class="spw__hit" data-profile-type="${esc(ptype)}" data-profile-key="${esc(key)}">
                    <td class="spw__cell-org">
                      <button
                        type="button"
                        class="spw__profile-link"
                        data-profile-type="${esc(ptype)}"
                        data-profile-key="${esc(key)}"
                      >${esc(r.display_name || key)}</button>
                    </td>
                    ${showType ? `<td data-label="Type"><span class="spw__type-badge spw__type-badge--${ptype}">${ptype === "org" ? "Org" : "Person"}</span></td>` : ""}
                    <td class="spw__cell-muted" data-label="${showType ? "Sector / role" : "Sector"}" title="${esc(cat.title)}">${esc(cat.text)}</td>
                    <td class="spw__cell-muted" data-label="Country" title="${esc(ctry.title)}">${esc(ctry.text)}</td>
                    <td class="spw__num" data-label="Awards">${num(r.award_count)}</td>
                    <td data-label="Medals"><span class="spw__medal-group">${medals || "—"}</span></td>
                    <td class="spw__cell-muted" data-label="Span">${esc(spanOf(r.first_year, r.last_year)) || "—"}</td>
                  </tr>`;
                })
                .join("")}
            </tbody>
          </table>`;
      };

      const renderRows = (rows: ProfileRow[]) => {
        if (!rows.length) {
          resultsEl.innerHTML = "";
          return;
        }
        const exact = rows.filter((r) => r.match_kind === "exact");
        const related = rows.filter((r) => r.match_kind === "related");
        if (exact.length && related.length) {
          resultsEl.innerHTML =
            `<p class="spw__group-label">Exact matches</p>${renderTable(exact)}` +
            `<p class="spw__group-label">Related</p>${renderTable(related)}`;
          return;
        }
        resultsEl.innerHTML = renderTable(rows);
      };

      const renderPager = () => {
        if (!pagerEl || !pageInfoEl || !prevBtn || !nextBtn) return;
        const pages = Math.max(1, Math.ceil(total / perPage));
        const page = Math.floor(offset / perPage) + 1;
        pagerEl.hidden = total <= perPage;
        pageInfoEl.textContent = `Page ${num(page)} of ${num(pages)}`;
        prevBtn.disabled = offset <= 0;
        nextBtn.disabled = offset + perPage >= total;
      };

      const setOverviewState = (state: "idle" | "loading" | "ready") => {
        if (!overviewEl) return;
        overviewEl.dataset.state = state;
        overviewEl.hidden = state === "idle";
        const loadingEl = $("[data-spw-overview-loading]");
        if (loadingEl) loadingEl.hidden = state !== "loading";
      };

      const renderOverview = (data: Record<string, unknown> | null) => {
        if (!overviewEl) return;
        if (!data || !data.available || !data.total) {
          setOverviewState("idle");
          return;
        }
        setOverviewState("ready");

        const answerEl = $("[data-spw-answer]");
        const detailEl = $("[data-spw-detail]");
        const sourceEl = $("[data-spw-overview-source]");
        const levelsEl = $("[data-spw-levels]");
        const orgsEl = $("[data-spw-orgs]");

        if (answerEl) answerEl.textContent = String(data.answer ?? "");
        if (detailEl) detailEl.textContent = String(data.headline ?? "");
        if (sourceEl) {
          sourceEl.textContent = `Counted from all ${num(data.total)} matches`;
        }
        if (levelsEl) {
          const levels = (data.levels as { level: string; count: number }[]) || [];
          levelsEl.innerHTML = levels
            .map((l) => {
              const slug = String(l.level)
                .toLowerCase()
                .replace(/[^a-z]+/g, "-");
              return `<span class="spw__chip spw__level--${esc(slug)}"><i></i>${esc(l.level)} <b>${num(l.count)}</b></span>`;
            })
            .join("");
        }
        if (orgsEl) {
          type TopOrg = {
            name: string;
            awards: number;
            gold?: number;
            silver?: number;
            bronze?: number;
            first_year?: string;
            last_year?: string;
            profile_type?: string;
          };
          const orgs = ((data.top_orgs as TopOrg[]) || []).slice(0, 10);
          // Proportional to the LEADER within this visible list, not to some
          // fixed scale -- the same convention the main dashboard's search
          // page uses, so a bar reads the same way everywhere in the project.
          const max = orgs.reduce((m, o) => Math.max(m, o.awards || 0), 0);
          const extra = Math.max(0, orgs.length - 3);
          orgsEl.innerHTML = orgs.length
            ? `<span class="spw__orgs-label">Top results</span><div class="spw__orgs-list"${extra ? " data-collapsed" : ""}>${orgs
                .map((o, i) => {
                  const pct = max ? Math.round(((o.awards || 0) / max) * 100) : 0;
                  const span = spanOf(o.first_year, o.last_year);
                  const slot = (tone: string, n: number | undefined) =>
                    n
                      ? `<span class="spw__medal spw__medal--${tone}"><i></i>${num(n)}</span>`
                      : `<span class="spw__medal spw__medal--${tone} is-empty" aria-hidden="true"></span>`;
                  return `<div class="spw__org-row" style="--spw-i:${i}">
                    <div class="spw__org-head">
                      <span class="spw__org-rank">${i + 1}</span>
                      <span class="spw__org-name">${esc(o.name)}</span>
                      <span class="spw__org-count">${num(o.awards)}</span>
                    </div>
                    <div class="spw__org-meta">
                      <span class="spw__org-bar"><i style="width:${pct}%"></i></span>
                      ${slot("gold", o.gold)}
                      ${slot("silver", o.silver)}
                      ${slot("bronze", o.bronze)}
                      <span class="spw__org-span">${esc(span) || "—"}</span>
                    </div>
                  </div>`;
                })
                .join("")}</div>${
                  extra
                    ? `<button type="button" class="spw__chip-more" data-spw-top-more data-extra="${extra}" aria-expanded="false">+${extra} more</button>`
                    : ""
                }`
            : "";
        }
      };

      const run = async (nextOffset = 0) => {
        const mine = ++seq;
        offset = nextOffset;
        const q = qInput.value.trim();
        const params = { q, limit: perPage, offset, ...filters() };

        statusEl.innerHTML = `<span class="spw__inline-spin" aria-hidden="true"></span> Searching…`;
        statusEl.dataset.kind = "";
        if (submitBtn) submitBtn.disabled = true;
        resultsEl.innerHTML = `<div class="spw__skel" aria-hidden="true">${"<div class='spw__skel-row'></div>".repeat(6)}</div>`;
        if (showOverview && overviewEl) setOverviewState("loading");

        // One results table: PROFILES (one row per organization/person), not
        // one row per award. `q` runs through the same natural-language parser
        // the search API uses, applied to profiles instead of award rows, so
        // "which companies from Germany won gold" answers with the companies
        // themselves rather than their individual nomination records.
        const searchUrl = url("/v1/profiles", params);
        log(`fetching profiles: ${searchUrl}`);

        try {
          const res = await fetch(searchUrl);
          log(`profiles response: HTTP ${res.status}`);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();
          if (data.error) throw new Error(data.error);
          log(`profiles parsed OK: total=${data.total} rows=${(data.results || []).length}`);
          if (mine !== seq) return; // superseded by a newer search

          total = Number(data.total || 0);
          const rows: ProfileRow[] = data.results || [];
          renderRows(rows);
          renderPager();

          // Name the thing actually being counted. "23,369 profiles" reads as
          // the whole dataset, so the count looked wrong to anyone who knew
          // there are also 11,429 people -- the filter defaults to
          // Organizations and, with the filter panel collapsed, nothing on
          // screen said so. "organizations" makes the scope self-evident and
          // "of 34,798 profiles" stays accurate for the combined view.
          const ptypeNow = data.profile_type || filters().profile_type || "all";
          const noun = ptypeNow === "person" ? "people"
            : ptypeNow === "org" ? "organizations" : "profiles";
          const from = total ? offset + 1 : 0;
          const to = offset + rows.length;
          statusEl.textContent = total
            ? `${num(from)}–${num(to)} of ${num(total)} ${noun}`
            : `No matching ${noun}.`;
        } catch (err) {
          if (mine !== seq) return;
          // "Failed to fetch" / TypeError with no HTTP status is the classic
          // signature of CORS being blocked or the tunnel being unreachable --
          // called out explicitly because that distinction is exactly what
          // determines the fix, and the browser's own message is too generic
          // to read at a glance.
          const detail = err instanceof Error ? err.message : String(err);
          const looksLikeCorsOrNetwork = err instanceof TypeError;
          log(
            `SEARCH FAILED: ${detail}` +
              (looksLikeCorsOrNetwork
                ? " -- likely CORS blocked, tunnel down, or wrong URL (no HTTP status reached)"
                : "")
          );
          statusEl.textContent = "Search is unavailable right now. Please try again.";
          statusEl.dataset.kind = "error";
          resultsEl.innerHTML = "";
          if (pagerEl) pagerEl.hidden = true;
        } finally {
          if (mine === seq && submitBtn) submitBtn.disabled = false;
        }

        if (!showOverview || !overviewEl) return;
        setOverviewState("loading");
        const overviewUrl = url("/v1/overview", { q, ...filters() });
        log(`fetching overview: ${overviewUrl}`);
        try {
          const res = await fetch(overviewUrl);
          log(`overview response: HTTP ${res.status}`);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();
          if (mine !== seq) return;
          renderOverview(data);
        } catch (err) {
          // The results grid is the product; a failed summary must never look
          // like a failed search.
          const detail = err instanceof Error ? err.message : String(err);
          log(`overview unavailable (non-fatal): ${detail}`);
          setOverviewState("idle");
        }
      };

      /** Populate the dropdowns from the real data, so a re-scrape that adds a
       *  country shows up without a code change. */
      const loadFacets = async () => {
        if (!filterEls.length) return;
        const facetsUrl = url("/v1/facets", { limit: 250 });
        log(`fetching facets: ${facetsUrl}`);
        try {
          const res = await fetch(facetsUrl);
          log(`facets response: HTTP ${res.status}`);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();
          const fill = (key: string, items: { name: string; count: number }[]) => {
            const sel = filterEls.find(
              (el) => el.dataset.spwFilter === key && el.tagName === "SELECT"
            ) as HTMLSelectElement | undefined;
            if (!sel || !items) return;
            items.forEach((item) => {
              if (!item.name) return;
              const opt = document.createElement("option");
              opt.value = item.name;
              opt.textContent = `${item.name} (${num(item.count)})`;
              sel.appendChild(opt);
            });
          };
          fill("award", data.awards);
          fill("country", data.countries);
          // The curated ~21-value organization taxonomy, not `industries`
          // (which is `winners.industry` -- 1,175 free-text scrape values,
          // not a real filter vocabulary). See public_api.py's /v1/facets.
          fill("category", data.sectors);
        } catch (err) {
          // Filters degrade to "All" only; free-text search still works.
          const detail = err instanceof Error ? err.message : String(err);
          log(`facets unavailable (non-fatal): ${detail}`);
        }
      };

      /** Full profile: rollup stats plus every award in its history. Fetched
       *  on click rather than bundled into the list response, because a list
       *  page of 50 profiles would otherwise carry 50 full award histories
       *  (some organizations have 700+) whether or not any of them get opened. */
      // Measured fresh on every open rather than cached: the nav's height can
      // change between opens (responsive breakpoint, promo banner, etc.), and
      // there's no --header-height design token to read instead.
      const getNavOffset = () => {
        const nav = document.querySelector<HTMLElement>(".main-nav");
        return nav ? Math.ceil(nav.getBoundingClientRect().height) : 0;
      };

      /* THE overlay problem, and its actual cause.
         This component is rendered inside CustomSection's
         `.content` wrapper, which sets BOTH `position: relative; z-index: 10`
         and `container-type: inline-size`. Either alone establishes a stacking
         context, so the drawer's own z-index only orders it WITHIN that
         wrapper -- it can never outrank anything painted above the wrapper
         itself, whatever number it uses. Confirmed live: with the drawer at
         z-index 1000, elementFromPoint() over the drawer returned a plain
         static <p> from the site footer, and earlier the sticky nav won the
         same way.

         The top layer is the one place that is immune: a shown popover paints
         above the whole page regardless of ancestor stacking contexts, so it
         fixes the footer and the nav together and needs no z-index tuning at
         all. `manual` (not `auto`) because this drawer already implements its
         own dismissal -- scrim click, Close button, Escape -- and `auto` would
         add light-dismiss on top of that, closing the panel on interactions
         inside it that bubble oddly.

         Feature-detected, with the previous hidden-attribute path kept intact
         as the fallback: on a browser without the API the drawer still opens,
         just back to competing on z-index, which is why the nav offset below
         is still applied in that branch. */
      const topLayerOK = typeof HTMLElement !== "undefined"
        && typeof HTMLElement.prototype.showPopover === "function";
      if (topLayerOK && scrimEl && drawerEl) {
        scrimEl.setAttribute("popover", "manual");
        drawerEl.setAttribute("popover", "manual");
        // The popover attribute itself governs visibility from here on; leaving
        // `hidden` set as well would keep display:none after showPopover().
        scrimEl.removeAttribute("hidden");
        drawerEl.removeAttribute("hidden");
      }

      const isDrawerOpen = () => {
        if (!drawerEl) return false;
        return topLayerOK ? drawerEl.matches(":popover-open") : !drawerEl.hidden;
      };

      const showOverlay = () => {
        if (!scrimEl || !drawerEl) return;
        document.documentElement.classList.add("spw-modal-open");
        if (topLayerOK) {
          // Scrim first: top-layer paint order follows the order things were
          // shown, so this puts the dimming behind the panel.
          try {
            if (!scrimEl.matches(":popover-open")) scrimEl.showPopover();
            if (!drawerEl.matches(":popover-open")) drawerEl.showPopover();
            return;
          } catch {
            /* fall through to the attribute path */
          }
        }
        drawerEl.style.setProperty("--spw-nav-offset", `${getNavOffset()}px`);
        scrimEl.hidden = false;
        drawerEl.hidden = false;
      };

      const hideOverlay = () => {
        document.documentElement.classList.remove("spw-modal-open");
        if (topLayerOK) {
          try {
            if (drawerEl?.matches(":popover-open")) drawerEl.hidePopover();
            if (scrimEl?.matches(":popover-open")) scrimEl.hidePopover();
            return;
          } catch {
            /* fall through to the attribute path */
          }
        }
        if (scrimEl) scrimEl.hidden = true;
        if (drawerEl) drawerEl.hidden = true;
      };

      const openProfile = async (profileType: string, profileKey: string) => {
        if (!scrimEl || !drawerEl || !drawerNameEl || !drawerBodyEl) return;
        showOverlay();
        drawerNameEl.textContent = profileKey;
        if (drawerSubEl) drawerSubEl.textContent = profileType === "person" ? "Person" : "Organization";
        drawerBodyEl.innerHTML = `<div class="spw__drawer-loading"><span class="spw__spinner" aria-hidden="true"></span><p>Loading this profile…</p></div>`;

        // Query parameters, not path segments. AWS API Gateway URL-decodes the PATH before
        // forwarding to the origin, so a profile key containing a space -- "DHL Express",
        // "IBM Corporation", "Tata Consultancy Services", most organisation names -- reached the
        // server as a literal space in the HTTP request line. That is malformed, so it was
        // rejected with 400 "Invalid HTTP request received" and every such profile opened as
        // "Could not load this profile right now." Single-word keys like "Ooredoo" worked, which
        // is why it looked intermittent. Query strings are not rewritten that way, and the API
        // serves the identical payload from /v1/profile_lookup.
        const detailUrl = url("/v1/profile_lookup", {
          profile_type: profileType,
          profile_key: profileKey,
        });
        log(`fetching profile detail: ${detailUrl}`);
        try {
          const res = await fetch(detailUrl);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();
          if (data.error) throw new Error(data.error);
          log(`profile detail parsed OK: awards=${data.award_history_count}`);

          drawerNameEl.textContent = data.display_name || profileKey;
          const p = data.profile || {};
          const awards: AwardRow[] = data.awards || [];
          // Same reconciling remainder as the results table's Medals column
          // (see renderRows): Gold+Silver+Bronze do not have to sum to Total
          // awards -- Finalist/People's Choice/Grand Stevie/Distinguished
          // Honoree wins are real awards with no medal-tier count of their
          // own. Shown as "Other" rather than omitted so the tiles always add
          // up to Total awards instead of looking like an undercount.
          const otherAwards = Math.max(0, (Number(data.award_count) || 0)
            - (Number(p.gold) || 0) - (Number(p.silver) || 0) - (Number(p.bronze) || 0));
          const tiles = [
            ["Total awards", num(data.award_count), ""],
            ["Gold", num(p.gold), "gold"],
            ["Silver", num(p.silver), "silver"],
            ["Bronze", num(p.bronze), "bronze"],
            ["Other", num(otherAwards), "other"],
            ["Active", spanOf(p.first_year, p.last_year), ""],
          ]
            .filter(([, v]) => v && v !== "0")
            .map(
              ([label, value, tone]) =>
                `<div class="spw__tile${tone ? ` spw__tile--${tone}` : ""}"><b>${esc(value)}</b><span>${esc(label)}</span></div>`
            )
            .join("");

          // Multi-value fields are stored pipe-separated ("Brazil | Germany |
          // India"); render each as its own chip rather than one long string.
          // Extra chips stay in the DOM so "+N more" can reveal them without
          // another fetch.
          const chipRow = (label: string, raw: unknown, limit = 8) => {
            const items = String(raw ?? "")
              .split("|")
              .map((s) => s.trim())
              .filter(Boolean);
            if (!items.length) return "";
            const extra = Math.max(0, items.length - limit);
            const chips = items
              .map(
                (v, i) =>
                  `<span class="spw__chip${i >= limit ? " is-extra" : ""}">${esc(v)}</span>`
              )
              .join("");
            const more = extra
              ? `<button type="button" class="spw__chip-more" data-spw-more data-extra="${extra}" aria-expanded="false">+${extra} more</button>`
              : "";
            return `<div class="spw__fact-row"${extra ? " data-collapsed" : ""}>
              <span class="spw__fact-label">${esc(label)}</span>
              <span class="spw__fact-chips">${chips}${more}</span>
            </div>`;
          };

          const facts = profileType === "person"
            ? chipRow("Roles", p.roles) + chipRow("Organizations", p.orgs) + chipRow("Programs", p.programs) + chipRow("Countries", p.countries)
            : chipRow("Sector", p.industry_sector, 1) +
              chipRow("Programs", p.programs) +
              chipRow("Categories", p.categories, 6) +
              chipRow("Country", p.country);

          // domain/employee_count/linkedin_url come from an earlier, less
          // rigorous enrichment pass than the isolated/verified pipeline this
          // project settled on -- the internal Explorer never presents them as
          // confirmed, and this drawer shouldn't either. Shown, but labelled.
          const companyBits = [
            p.domain ? `<a href="https://${esc(p.domain)}" target="_blank" rel="noopener noreferrer">${esc(p.domain)}</a>` : "",
            p.employee_count ? `${esc(p.employee_count)} employees` : "",
            p.linkedin_url ? `<a href="${esc(p.linkedin_url)}" target="_blank" rel="noopener noreferrer">LinkedIn</a>` : "",
          ].filter(Boolean);
          const companyInfo = companyBits.length
            ? `<p class="spw__drawer-note">${companyBits.join(" · ")} <em>(unverified, from an earlier research pass)</em></p>`
            : "";

          const historySlice = awards.slice(0, 200);
          const historyRows = historySlice
            .map((a) => {
              const level = levelOf(a.award);
              const place = [a.city, a.country].filter(Boolean).join(", ");
              const slug = level.toLowerCase().replace(/[^a-z]+/g, "-");
              return `<tr>
                <td>${esc(a.year)}</td>
                <td>${level ? `<span class="spw__level spw__level--${esc(slug)}">${esc(level)}</span>` : ""}</td>
                <td class="spw__cell-muted">${esc(a.category || a.category_group)}</td>
                <td>${esc(a.nomination_title)}</td>
                <td class="spw__cell-muted">${esc(place)}</td>
              </tr>`;
            })
            .join("");
          const historyCards = historySlice
            .map((a) => {
              const level = levelOf(a.award);
              const place = [a.city, a.country].filter(Boolean).join(", ");
              const slug = level.toLowerCase().replace(/[^a-z]+/g, "-");
              return `<li class="spw__history-card">
                <div class="spw__history-card-top">
                  <span class="spw__history-year">${esc(a.year)}</span>
                  ${level ? `<span class="spw__level spw__level--${esc(slug)}">${esc(level)}</span>` : ""}
                </div>
                <p class="spw__history-cat">${esc(a.category || a.category_group || "")}</p>
                <p class="spw__history-nom">${esc(a.nomination_title || "")}</p>
                ${place ? `<p class="spw__history-place">${esc(place)}</p>` : ""}
              </li>`;
            })
            .join("");

          drawerBodyEl.innerHTML = `
            ${tiles ? `<div class="spw__tiles">${tiles}</div>` : ""}
            ${facts ? `<div class="spw__facts">${facts}</div>` : ""}
            ${companyInfo}
            <h4 class="spw__drawer-heading">Award history</h4>
            ${
              awards.length
                ? `<div class="spw__table-scroll">
                    <table class="spw__table spw__table--history">
                      <thead><tr><th>Year</th><th>Level</th><th>Category</th><th>Nomination</th><th>Location</th></tr></thead>
                      <tbody>${historyRows}</tbody>
                    </table>
                  </div>
                  <ol class="spw__history-cards">${historyCards}</ol>
                  ${awards.length > 200 ? `<p class="spw__drawer-note">Showing the first 200 of ${num(awards.length)} awards.</p>` : ""}`
                : `<p class="spw__drawer-note">No award history on file for this profile.</p>`
            }`;
        } catch (err) {
          const detail = err instanceof Error ? err.message : String(err);
          log(`profile detail FAILED: ${detail}`);
          drawerBodyEl.innerHTML = `<p class="spw__drawer-note">Could not load this profile right now.</p>`;
        }
      };

      const closeDrawer = () => {
        hideOverlay();
      };

      // Delegated: rows are replaced wholesale on every search/page, so a
      // listener bound to each button at render time would be discarded along
      // with it. One listener on the results container outlives every re-render.
      resultsEl.addEventListener("click", (event) => {
        const btn = (event.target as HTMLElement)?.closest<HTMLElement>("[data-profile-key]");
        if (!btn) return;
        const key = btn.dataset.profileKey;
        const type = btn.dataset.profileType || "org";
        if (key) openProfile(type, key);
      });
      overviewEl?.addEventListener("click", (event) => {
        const btn = (event.target as HTMLElement)?.closest<HTMLButtonElement>("[data-spw-top-more]");
        if (!btn || !overviewEl) return;
        const list = overviewEl.querySelector(".spw__orgs-list");
        if (!list) return;
        const extra = btn.dataset.extra || "0";
        const open = list.hasAttribute("data-collapsed");
        if (open) {
          list.removeAttribute("data-collapsed");
          btn.setAttribute("aria-expanded", "true");
          btn.textContent = "Show less";
        } else {
          list.setAttribute("data-collapsed", "");
          btn.setAttribute("aria-expanded", "false");
          btn.textContent = `+${extra} more`;
        }
      });
      drawerBodyEl.addEventListener("click", (event) => {
        const btn = (event.target as HTMLElement)?.closest<HTMLButtonElement>("[data-spw-more]");
        if (!btn) return;
        const row = btn.closest(".spw__fact-row");
        if (!row) return;
        const extra = btn.dataset.extra || "0";
        const open = row.hasAttribute("data-collapsed");
        if (open) {
          row.removeAttribute("data-collapsed");
          btn.setAttribute("aria-expanded", "true");
          btn.textContent = "Show less";
        } else {
          row.setAttribute("data-collapsed", "");
          btn.setAttribute("aria-expanded", "false");
          btn.textContent = `+${extra} more`;
        }
      });
      scrimEl?.addEventListener("click", closeDrawer);
      drawerCloseBtn?.addEventListener("click", closeDrawer);
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && isDrawerOpen()) closeDrawer();
      });

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        run(0);
      });
      filterEls.forEach((el) =>
        el.addEventListener("change", () => {
          updateFiltersCount();
          run(0);
        })
      );
      form.addEventListener("reset", () => {
        // The reset lands after this handler, so defer past both it and the
        // count update to the same tick run() already waits for.
        window.setTimeout(() => {
          updateFiltersCount();
          run(0);
        }, 0);
      });
      prevBtn?.addEventListener("click", () => run(Math.max(0, offset - perPage)));
      nextBtn?.addEventListener("click", () => run(offset + perPage));

      // Filters live in a collapsed panel behind this button rather than an
      // always-visible row -- six fields plus Clear were pushing the actual
      // results below the fold on a phone screen before a visitor had typed
      // anything. aria-expanded (not just [hidden]) so a screen reader
      // announces the toggle state, not just a DOM node appearing.
      filtersToggleBtn?.addEventListener("click", () => {
        if (!filtersPanel) return;
        const open = filtersPanel.hidden;
        filtersPanel.hidden = !open;
        filtersToggleBtn.setAttribute("aria-expanded", String(open));
      });

      qInput.value = config.initialQuery || "";
      updateFiltersCount();
      void loadFacets();
      void run(0); // land on the full record list rather than an empty panel
    });
  };

  onPageLoad(initSearchPastWinners);
</script>

<style is:global>
  @layer page-sections {
    .search-past-winners {
      --spw-gold: #dfba19;
      --spw-gold-soft: rgba(223, 186, 25, 0.16);
      --spw-silver: #c5ccd6;
      --spw-silver-soft: rgba(197, 204, 214, 0.16);
      --spw-bronze: #c67b3e;
      --spw-bronze-soft: rgba(198, 123, 62, 0.18);
      --spw-teal: #2d7272;
    }

    @keyframes spw-spin {
      to { transform: rotate(360deg); }
    }

    @keyframes spw-shimmer {
      0% { background-position: 100% 0; }
      100% { background-position: -100% 0; }
    }

    @keyframes spw-fade-up {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: none; }
    }

    @keyframes spw-pop {
      from { opacity: 0; transform: translate(-50%, -46%) scale(0.96); }
      to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    }

    @keyframes spw-scrim-in {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    html.spw-modal-open,
    html.spw-modal-open body {
      overflow: hidden;
    }

    .search-past-winners .spw__form {
      margin-top: var(--spacing-lg);
    }

    .search-past-winners .spw__row {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-md);
      align-items: flex-end;
    }

    .search-past-winners .spw__row--filters {
      margin-top: var(--spacing-md);
      padding-top: var(--spacing-md);
      border-top: 1px solid var(--color-border-subtle, var(--color-border));
    }

    /* Same specificity trap the drawer already hit (see the [hidden] note
       further down): .spw__row's own `display: flex` is an author rule, and
       an author rule beats the browser default [hidden]{display:none} at
       equal specificity regardless of source order, so the panel would
       otherwise stay visibly flexed even while hidden. */
    .search-past-winners .spw__row--filters[hidden] {
      display: none;
    }

    .search-past-winners .spw__filters-toggle {
      position: relative;
      display: inline-flex;
      flex-shrink: 0;
      align-items: center;
      gap: var(--spacing-xs);
      padding: var(--spacing-sm) var(--spacing-lg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      background-color: transparent;
      color: var(--color-text);
      font-family: var(--font-body);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-semibold);
      cursor: pointer;
      transition: background-color var(--animation-fast) ease, border-color var(--animation-fast) ease,
        color var(--animation-fast) ease;
    }

    .search-past-winners .spw__filters-toggle:hover {
      background-color: var(--color-state-hover, var(--color-bg-muted));
    }

    /* Set by the script, not :focus/:hover -- this is "the panel this button
       controls is currently open", so it needs to persist while focus and the
       pointer move elsewhere into the panel itself. */
    .search-past-winners .spw__filters-toggle[aria-expanded="true"] {
      border-color: var(--color-brand);
      color: var(--color-brand);
    }

    .search-past-winners .spw__filters-icon {
      width: 1.1em;
      height: 1.1em;
      flex-shrink: 0;
    }

    .search-past-winners .spw__filters-count {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 1.3em;
      height: 1.3em;
      padding: 0 0.3em;
      border-radius: var(--radius-full);
      background-color: var(--color-brand);
      color: var(--color-text-on-brand, #000);
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-bold);
      font-variant-numeric: tabular-nums;
      line-height: 1;
    }

    .search-past-winners .spw__field {
      display: flex;
      flex: 1 1 12rem;
      flex-direction: column;
      gap: var(--spacing-xs);
      min-width: 0;
    }

    .search-past-winners .spw__field--grow {
      flex: 4 1 20rem;
    }

    .search-past-winners .spw__field--narrow {
      flex: 0 1 7rem;
    }

    .search-past-winners .spw__label {
      font-size: var(--font-size-xs);
      color: var(--color-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .search-past-winners .spw__input,
    .search-past-winners .spw__select {
      width: 100%;
      padding: var(--spacing-sm);
      border: 1px solid var(--color-border-inputs, var(--color-border));
      border-radius: var(--radius-sm);
      background-color: var(--color-bg);
      color: var(--color-text);
      font-family: var(--font-body);
      font-size: var(--font-size-sm);
    }

    .search-past-winners .spw__input:focus-visible,
    .search-past-winners .spw__select:focus-visible {
      outline: 2px solid var(--color-focus-ring, var(--color-brand));
      outline-offset: 2px;
    }

    .search-past-winners .spw__submit,
    .search-past-winners .spw__reset,
    .search-past-winners .spw__page-btn {
      padding: var(--spacing-sm) var(--spacing-lg);
      border: 1px solid var(--color-brand);
      border-radius: var(--radius-sm);
      background-color: var(--color-bg-brand, var(--color-brand));
      color: var(--color-text-on-brand, var(--color-text-strong));
      font-family: var(--font-body);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-semibold);
      cursor: pointer;
      transition: background-color var(--animation-fast) ease, color var(--animation-fast) ease,
        border-color var(--animation-fast) ease;
    }

    .search-past-winners .spw__reset,
    .search-past-winners .spw__page-btn {
      border-color: var(--color-border);
      background-color: transparent;
      color: var(--color-text);
    }

    /* .spw__submit needs its own rule, not the shared one below: its default
       state is a solid brand-colored fill with BLACK text
       (--color-text-on-brand), so swapping only the background to
       --color-state-hover (a ~4%-opacity white tint) left the button nearly
       black -- the tint barely lightens a dark page background at all -- with
       black text on top of it, i.e. invisible. Confirmed live via
       getComputedStyle: background rgba(255,255,255,0.04) over this page's
       black section background rendered as black, text stayed rgb(0,0,0).
       Fixed by flipping to the same transparent+light-text pair the site's
       own Button.astro uses for its primary-variant hover, instead of only
       touching one half of the pairing. */
    .search-past-winners .spw__submit:hover:not(:disabled) {
      background-color: transparent;
      border-color: var(--color-border-strong, var(--color-border));
      color: var(--color-text-strong, var(--color-text));
    }

    .search-past-winners .spw__reset:hover:not(:disabled),
    .search-past-winners .spw__page-btn:hover:not(:disabled) {
      background-color: var(--color-state-hover, var(--color-bg-muted));
    }

    .search-past-winners .spw__submit:disabled,
    .search-past-winners .spw__page-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .search-past-winners .spw__status {
      margin-top: var(--spacing-md);
      color: var(--color-text-muted);
      font-size: var(--font-size-sm);
    }

    .search-past-winners .spw__status[data-kind="error"] {
      color: var(--color-error, #b3261e);
    }

    .search-past-winners .spw__overview {
      margin-top: var(--spacing-lg);
      padding: var(--spacing-lg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      background-color: var(--color-bg-surface, var(--color-bg-muted));
      animation: spw-fade-up var(--animation-normal) ease;
    }

    .search-past-winners .spw__overview-loading {
      display: flex;
      align-items: center;
      gap: var(--spacing-md);
      min-height: 5.5rem;
    }

    .search-past-winners .spw__overview[data-state="loading"] .spw__overview-ready {
      display: none;
    }

    .search-past-winners .spw__overview[data-state="ready"] .spw__overview-loading,
    .search-past-winners .spw__overview-loading[hidden] {
      display: none;
    }

    .search-past-winners .spw__overview-loading-title {
      margin: 0;
      font-weight: var(--font-weight-semibold);
      color: var(--color-text-strong);
    }

    .search-past-winners .spw__overview-loading-copy {
      margin: 0.2rem 0 0;
      color: var(--color-text-muted);
      font-size: var(--font-size-sm);
    }

    .search-past-winners .spw__spinner,
    .search-past-winners .spw__inline-spin {
      display: inline-block;
      width: 1.6rem;
      height: 1.6rem;
      border: 2px solid var(--color-border);
      border-top-color: var(--spw-gold);
      border-radius: 50%;
      animation: spw-spin 0.7s linear infinite;
      flex-shrink: 0;
    }

    .search-past-winners .spw__inline-spin {
      width: 0.9rem;
      height: 0.9rem;
      border-width: 2px;
      vertical-align: -0.1em;
      margin-right: 0.4em;
    }

    .search-past-winners .spw__skel {
      display: grid;
      gap: 0.6rem;
      margin-top: var(--spacing-lg);
    }

    .search-past-winners .spw__skel-row {
      height: 3rem;
      border-radius: var(--radius-sm);
      background: linear-gradient(
        90deg,
        var(--color-bg-muted) 0%,
        var(--color-bg-surface) 45%,
        var(--color-bg-muted) 100%
      );
      background-size: 200% 100%;
      animation: spw-shimmer 1.2s ease-in-out infinite;
    }

    .search-past-winners .spw__overview-head {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-sm);
      align-items: baseline;
      justify-content: space-between;
    }

    .search-past-winners .spw__overview-title {
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-bold);
      text-transform: uppercase;
      letter-spacing: 0.12em;
    }

    .search-past-winners .spw__overview-source {
      color: var(--color-text-muted);
      font-size: var(--font-size-xs);
    }

    .search-past-winners .spw__answer {
      margin-top: var(--spacing-sm);
      padding: var(--spacing-sm) var(--spacing-md);
      border-left: 3px solid var(--color-brand);
      background-color: var(--color-bg-accent, transparent);
      color: var(--color-text-strong);
      font-size: var(--font-size-md);
      font-weight: var(--font-weight-semibold);
      line-height: 1.4;
      overflow-wrap: anywhere;
    }

    .search-past-winners .spw__answer:empty,
    .search-past-winners .spw__detail:empty,
    .search-past-winners .spw__orgs:empty,
    .search-past-winners .spw__chips:empty {
      display: none;
    }

    .search-past-winners .spw__detail {
      margin-top: var(--spacing-sm);
      color: var(--color-text);
      font-size: var(--font-size-sm);
      line-height: 1.6;
      overflow-wrap: anywhere;
    }

    .search-past-winners .spw__chips {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-xs);
      align-items: center;
      margin-top: var(--spacing-md);
    }

    /* A vertical list, not a chip wrap -- each row carries its own bar, which
       needs the full row width to be proportional against the leader. */
    .search-past-winners .spw__orgs {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-sm);
      margin-top: var(--spacing-md);
    }

    .search-past-winners .spw__orgs-label,
    .search-past-winners .spw__chip {
      font-size: var(--font-size-xs);
    }

    .search-past-winners .spw__orgs-label {
      margin-bottom: var(--spacing-xs);
      color: var(--color-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .search-past-winners .spw__chip {
      display: inline-flex;
      align-items: center;
      gap: 0.35em;
      padding: var(--spacing-xs) var(--spacing-sm);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-full);
      background-color: var(--color-bg);
    }

    .search-past-winners .spw__chip i,
    .search-past-winners .spw__medal i {
      display: inline-block;
      width: 0.55em;
      height: 0.55em;
      border-radius: 50%;
      background: currentColor;
    }

    .search-past-winners .spw__level--gold,
    .search-past-winners .spw__chip.spw__level--gold {
      color: var(--spw-gold);
      border-color: var(--spw-gold);
      background: var(--spw-gold-soft);
    }

    .search-past-winners .spw__level--silver,
    .search-past-winners .spw__chip.spw__level--silver {
      color: var(--spw-silver);
      border-color: var(--spw-silver);
      background: var(--spw-silver-soft);
    }

    .search-past-winners .spw__level--bronze,
    .search-past-winners .spw__chip.spw__level--bronze {
      color: var(--spw-bronze);
      border-color: var(--spw-bronze);
      background: var(--spw-bronze-soft);
    }

    .search-past-winners .spw__level--grand-stevie,
    .search-past-winners .spw__chip.spw__level--grand-stevie {
      color: var(--spw-gold);
      border-color: var(--spw-gold);
    }

    /* One organization's bar, same convention as the main dashboard's search
       page (index.html ovOrgRow): proportional to the leader of THIS visible
       list, not a fixed scale, so the longest bar is always the top result. */
    .search-past-winners .spw__org-row + .spw__org-row {
      padding-top: var(--spacing-sm);
      border-top: 1px solid var(--color-border-subtle, var(--color-border));
    }

    .search-past-winners .spw__org-row {
      animation: spw-fade-up var(--animation-normal) ease both;
      animation-delay: calc(var(--spw-i, 0) * 40ms);
    }

    .search-past-winners .spw__orgs-list[data-collapsed] .spw__org-row:nth-child(n + 4) {
      display: none;
    }

    .search-past-winners .spw__orgs .spw__chip-more {
      margin-top: var(--spacing-sm);
    }

    .search-past-winners .spw__group-label {
      margin: var(--spacing-lg) 0 var(--spacing-sm);
      color: var(--color-text-muted);
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-bold);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .search-past-winners .spw__org-head {
      display: flex;
      align-items: baseline;
      gap: var(--spacing-sm);
    }

    .search-past-winners .spw__org-rank {
      flex: 0 0 1.4rem;
      color: var(--color-text-muted);
      font-variant-numeric: tabular-nums;
      font-size: var(--font-size-xs);
    }

    .search-past-winners .spw__org-name {
      flex: 1;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-weight: var(--font-weight-semibold);
      font-size: var(--font-size-sm);
    }

    .search-past-winners .spw__org-count {
      font-weight: var(--font-weight-bold);
      font-variant-numeric: tabular-nums;
      color: var(--color-brand);
      font-size: var(--font-size-sm);
    }

    .search-past-winners .spw__org-meta {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 3.4rem 3.4rem 3.4rem 5.6rem;
      align-items: center;
      column-gap: 0.45rem;
      margin-top: 4px;
    }

    .search-past-winners .spw__org-bar {
      display: block;
      height: 4px;
      border-radius: var(--radius-full);
      background-color: var(--color-bg-muted);
      overflow: hidden;
      min-width: 0;
    }

    .search-past-winners .spw__org-bar i {
      display: block;
      height: 100%;
      border-radius: var(--radius-full);
      background-color: var(--color-brand);
    }

    .search-past-winners .spw__org-meta > .spw__medal {
      justify-content: center;
      min-width: 0;
      padding: 0.12em 0.2em;
    }

    .search-past-winners .spw__org-span {
      color: var(--color-text-muted);
      font-size: var(--font-size-xs);
      text-align: right;
      white-space: nowrap;
    }

    .search-past-winners .spw__medal.is-empty {
      visibility: hidden;
      pointer-events: none;
    }

    .search-past-winners .spw__chip b {
      font-weight: var(--font-weight-bold);
    }

    /* Deliberately loud (dark, monospace, high-contrast) rather than matching
       the theme -- this panel is a troubleshooting tool, not part of the
       page's design, and should look like one so nobody mistakes it for a
       finished feature if the `debug` prop gets left on by accident. */
    .search-past-winners .spw__debug {
      margin-top: var(--spacing-md);
      padding: var(--spacing-sm) var(--spacing-md);
      max-height: 220px;
      overflow-y: auto;
      border: 1px dashed var(--color-error, #b3261e);
      border-radius: var(--radius-sm);
      background-color: #0b0f19;
      color: #7ee787;
      font-family: var(--font-mono, monospace);
      font-size: var(--font-size-xs);
      line-height: 1.5;
      white-space: pre-wrap;
      word-break: break-all;
    }

    /* Results table leans on the site's global table styles in
       styles/base/_tables.css; only the overflow guard and cell tone are local.
       max-width (not just overflow-x) matters here: without it, a table whose
       auto layout wants more room than the page can still push the CONTAINER
       wider first and only then scroll, widening the whole page along with it
       rather than scrolling in place. */
    .search-past-winners .spw__results {
      max-width: 100%;
      overflow-x: auto;
      margin-top: var(--spacing-lg);
    }

    .search-past-winners .spw__table {
      width: 100%;
      font-size: var(--font-size-sm);
    }

    /* break-word, NOT anywhere. `anywhere` also shrinks a column's intrinsic
       minimum width, which let the table squeeze every column to a few
       characters and then break mid-word to fit -- on a phone that turned an
       award count of 772 into "77" above a lone "2", i.e. a wrong number
       rather than merely ugly wrapping. `break-word` still rescues a single
       unbreakable run that genuinely cannot fit, but stops the layout from
       treating every cell as infinitely compressible. */
    .search-past-winners .spw__table th,
    .search-past-winners .spw__table td {
      overflow-wrap: break-word;
    }

    /* Figures must never break or wrap: they are read as one token, and half a
       number silently reads as a different number. */
    .search-past-winners .spw__num,
    .search-past-winners .spw__medal {
      white-space: nowrap;
      overflow-wrap: normal;
    }

    /* One wrapper around the three medal counts. Needed because the mobile card
       layout makes each cell a two-column grid (label | value), and a grid
       container treats every ELEMENT child as its own grid item -- so three
       bare <span> medals were being dealt into separate grid cells instead of
       sitting together beside their label. Grouping them keeps the cell at
       exactly two items whatever it contains. */
    .search-past-winners .spw__medal-group {
      display: grid;
      grid-template-columns: repeat(2, minmax(6.2rem, 1fr));
      gap: 0.35rem 0.4rem;
      min-width: 13rem;
    }

    /* Wide tabular data (the drawer's award history) scrolls inside its own box
       so it can keep real column widths without widening the page. */
    .search-past-winners .spw__table-scroll {
      max-width: 100%;
      overflow-x: auto;
    }

    .search-past-winners .spw__history-cards {
      display: none;
    }

    .search-past-winners .spw__cell-org {
      font-weight: var(--font-weight-semibold);
    }

    .search-past-winners .spw__cell-muted {
      color: var(--color-text-muted);
    }

    .search-past-winners .spw__level {
      display: inline-block;
      padding: 2px var(--spacing-sm);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-full);
      font-size: var(--font-size-xs);
      white-space: nowrap;
    }

    .search-past-winners .spw__level--gold {
      border-color: var(--spw-gold);
      color: var(--spw-gold);
      background: var(--spw-gold-soft);
    }

    .search-past-winners .spw__level--silver {
      border-color: var(--spw-silver);
      color: var(--spw-silver);
      background: var(--spw-silver-soft);
    }

    .search-past-winners .spw__level--bronze {
      border-color: var(--spw-bronze);
      color: var(--spw-bronze);
      background: var(--spw-bronze-soft);
    }

    .search-past-winners .spw__hit {
      cursor: pointer;
      transition: background-color var(--animation-fast) ease;
    }

    .search-past-winners .spw__hit:hover td {
      background-color: var(--color-state-hover, rgba(223, 186, 25, 0.06));
    }

    .search-past-winners .spw__pager {
      display: flex;
      gap: var(--spacing-md);
      align-items: center;
      justify-content: center;
      margin-top: var(--spacing-lg);
    }

    .search-past-winners .spw__page-info {
      color: var(--color-text-muted);
      font-size: var(--font-size-sm);
    }

    .search-past-winners .spw__num {
      font-variant-numeric: tabular-nums;
      text-align: right;
    }

    .search-past-winners .spw__profile-link {
      border: 0;
      background: none;
      padding: 0;
      color: var(--color-link, var(--color-brand));
      font: inherit;
      font-weight: var(--font-weight-semibold);
      text-align: left;
      cursor: pointer;
    }

    .search-past-winners .spw__profile-link:hover {
      color: var(--color-link-hover, var(--color-brand));
      text-decoration: underline;
    }

    .search-past-winners .spw__type-badge {
      display: inline-block;
      padding: 2px var(--spacing-sm);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-full);
      font-size: var(--font-size-xs);
      white-space: nowrap;
    }

    .search-past-winners .spw__medal {
      display: inline-flex;
      align-items: center;
      justify-content: flex-start;
      gap: 0.3em;
      padding: 0.18em 0.55em;
      border-radius: var(--radius-full);
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-semibold);
      white-space: nowrap;
      line-height: 1.2;
    }

    .search-past-winners .spw__medal--gold {
      color: var(--spw-gold);
      background: var(--spw-gold-soft);
    }

    .search-past-winners .spw__medal--silver {
      color: var(--spw-silver);
      background: var(--spw-silver-soft);
    }

    .search-past-winners .spw__medal--bronze {
      color: var(--spw-bronze);
      background: var(--spw-bronze-soft);
    }

    /* Deliberately NOT medal-colored: it's a reconciling remainder, not a
       fourth medal tier this data distinguishes (see renderRows). Muted and
       unbolded so it doesn't compete with the three that are real tiers, but
       still legible enough that the row total visibly checks out. */
    .search-past-winners .spw__medal--other {
      color: var(--color-text-muted);
      font-weight: var(--font-weight-regular, 400);
    }

    /* Detail overlay: a scrim plus a fixed side panel, matching the pattern
       already established by Modal.astro (Popover-API-driven there; this one
       is plain fixed-position + hidden attribute, since the content is filled
       in dynamically per profile rather than known at markup time). */
    /* --layer-6 (60) lost to the site's own sticky main nav in practice, even
       though the nav's own rule asks for only --layer-2 (20) -- confirmed
       live: the drawer's close button rendered underneath the nav bar,
       invisible and unclickable. Sticky/fixed elements compare z-index within
       whatever stacking context they end up in, not always as one flat list
       against every other z-index on the page, so a numerically-larger value
       is not a guarantee once a component is dropped into someone else's
       page. --layer-8 ("critical UI elements", 1000) is deliberately the
       highest tier the design tokens define, to make this win outright rather
       than needing to reason about the surrounding page's stacking contexts. */
    .search-past-winners .spw__scrim {
      position: fixed;
      inset: 0;
      z-index: calc(var(--layer-8, 1000) - 1);
      background: var(--color-overlay, rgba(0, 0, 0, 0.45));
    }

    .search-past-winners .spw__drawer {
      position: fixed;
      top: 50%;
      left: 50%;
      right: auto;
      bottom: auto;
      z-index: var(--layer-8, 1000);
      display: flex;
      flex-direction: column;
      width: min(56rem, calc(100vw - 2rem));
      max-height: min(88vh, 56rem);
