---
/**
 * BlogGenerator — search a Stevie Award winner, generate their profile
 * article, review it, publish it.
 *
 * WHY EVERYTHING HAPPENS ON THE PAGE, NOT IN THE CLOUDCANNON SIDEBAR
 * This went through three shapes before this one, and the history is worth
 * keeping because each step was a real constraint, not a preference:
 *   1. sidebar Profile Type select + one Organization list + one Person list;
 *   2. one combined sidebar dropdown, then a multi-select of the same;
 *   3. (this) no winner field in the sidebar at all -- search, select and
 *      Generate all live on the rendered page.
 * The deciding factor for (3) is scale as much as taste: the serving release
 * carries 22,958 organizations and 11,537 named people, which is a live query
 * against the API, not a list that can be inlined as sidebar options. An
 * earlier attempt at inlining ~1,449 of them into cloudcannon.config.yml
 * pushed that file past 200KB and broke CloudCannon's git sync for every page
 * on the site, not just this one.
 *
 * WHY THE FETCH IS CLIENT-SIDE
 * This site builds static (no `output: "server"`, no active adapter), so
 * frontmatter runs once at build time. Searching and drafting are per-click,
 * per-visitor actions, so they run in the browser against the blog writer
 * API -- the same way SearchPastWinners talks to the winners API.
 *
 * WHY THE ENDPOINT IS A `PUBLIC_` ENV VAR
 * It is baked into the client bundle and therefore visible to anyone. The
 * generate endpoint calls the Gemini API using a key that lives only on the
 * server (blog_writer.py) -- the browser never sees it, it only ever talks to
 * our own FastAPI server. Never put a token here; there is nowhere private to
 * hide one in a static build.
 *
 * WHY EVERY DRAFT SHOWS ITS FACT-CHECK VERDICT
 * The backend runs every draft through grounding_check.py before it is ever
 * returned, and the requirements doc is explicit that AI-written copy must
 * never present unverified claims as fact. This component always renders the
 * pass/flag verdict; it never shows body copy without it.
 *
 * THE ARTICLE IS ITS OWN VIEW
 * Generating (or opening a saved draft) hides the entire picker and shows only
 * the article, at its own ?draft=<slug> URL. There is no server route to give
 * it -- the site builds fully static and drafts are created long after build
 * time, so getStaticPaths() has no slug list -- so this is History-API routing
 * on the same physical page. Bookmarkable, reloadable, back-button correct.
 */
import CustomSection from "@builders/custom-section/CustomSection.astro";

const BLOG_API_ENDPOINT = "http://127.0.0.1:8002";

const {
  heading = "Generate a Winner Profile",
  description = "Search a Stevie Award winner, then generate a fact-checked article in the Stevie blog's own style.",
  // Overridable in CloudCannon so an editor can repoint the component at a
  // tunnel URL without a code change, and by env for per-environment builds.
  apiEndpoint = "",
  showAngle = true,
  pageSize = 12,
  emptyStateText = "Start typing to find a winner, or browse the most-awarded below.",
  // Prints every fetch and every error into a visible on-page panel, not just
  // the console -- a CMS preview iframe is awkward to open devtools against.
  debug = false,

  // Light by default: the team wants this tool to read as a light, editorial
  // workspace. Still overridable per-page from the sidebar.
  colorScheme = "light",
  backgroundColor = "base",
  paddingVertical = "3xl",
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const endpoint = (
  apiEndpoint ||
  import.meta.env.PUBLIC_BLOG_API_ENDPOINT ||
  BLOG_API_ENDPOINT
).replace(/\/+$/, "");

const config = {
  endpoint,
  pageSize: Math.max(6, Math.min(Number(pageSize) || 12, 60)),
  debug: !!debug,
};
---

<CustomSection
  class:list={["blog-generator", className]}
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <div
    class="bg"
    data-bg
    data-config={JSON.stringify(config)}
  >
    <!-- ============ PICKER VIEW ============ -->
    <div data-bg-list-view>
      <header class="bg__head">
        <p class="bg__eyebrow">Blog Generator</p>
        <h2
          class="bg__title"
          data-prop="heading"
        >{heading}</h2>
        <p
          class="bg__sub"
          data-prop="description"
        >{description}</p>
      </header>

      <div class="bg__panel">
        <div class="bg__searchbar">
          <svg
            class="bg__search-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
          </svg>
          <input
            type="search"
            class="bg__search"
            data-bg-q
            placeholder="Search a company or person — e.g. IBM, Cisco, Jean Henri Lhuillier"
            autocomplete="off"
            aria-label="Search Stevie Award winners"
          />
          <span
            class="bg__spinner"
            data-bg-search-spin
            hidden
            aria-hidden="true"
          ></span>
        </div>

        <div
          class="bg__filters"
          role="group"
          aria-label="Filter by winner type"
        >
          <button type="button" class="bg__pill is-active" data-bg-filter="all">All</button>
          <button type="button" class="bg__pill" data-bg-filter="org">Organizations</button>
          <button type="button" class="bg__pill" data-bg-filter="person">People</button>
        </div>

        <p
          class="bg__status"
          data-bg-status
          role="status"
          aria-live="polite"
        >{emptyStateText}</p>

        <div
          class="bg__results"
          data-bg-results
          role="listbox"
          aria-label="Search results"
        ></div>

        <!-- Prev/Next + "Page X of Y", the same pattern SearchPastWinners.astro
             uses for its own results pager -- rather than an append-more
             button, so browsing the picker behaves the same way browsing that
             other search page does. -->
        <nav
          class="bg__pager"
          data-bg-pager
          hidden
          aria-label="Search results pages"
        >
          <button type="button" class="bg__page-btn" data-bg-prev>Previous</button>
          <span class="bg__page-info" data-bg-page-info></span>
          <button type="button" class="bg__page-btn" data-bg-next>Next</button>
        </nav>

        <!-- Sticky action bar: appears only once something is selected, so the
             page never shows a Generate button with nothing to generate.
             Selection is multi: cards toggle, and one angle applies to the
             whole batch (see the client script's generate()). -->
        <div
          class="bg__actionbar"
          data-bg-actionbar
          hidden
        >
          <div class="bg__chosen">
            <span class="bg__chosen-label" data-bg-chosen-label>Selected</span>
            <strong class="bg__chosen-name" data-bg-chosen-name></strong>
            <button
              type="button"
              class="bg__clear"
              data-bg-clear
              hidden
            >Clear</button>
          </div>

          {
            showAngle && (
              <label class="bg__angle-wrap">
                <span class="bg__angle-label">Editorial angle <em>(optional)</em></span>
                <input
                  type="text"
                  class="bg__angle"
                  data-bg-angle
                  placeholder="e.g. how their customer service team scaled across the region"
                />
              </label>
            )
          }

          <button
            type="button"
            class="bg__generate"
            data-bg-generate
          >
            <span data-bg-generate-label>Generate article</span>
          </button>

          <!-- Multi-generate progress: hidden for a single pick (that path
               opens straight into the finished article, nothing to track). -->
          <div
            class="bg__progress"
            data-bg-progress
            hidden
            role="progressbar"
            aria-valuemin="0"
          >
            <div class="bg__progress-track">
              <div class="bg__progress-fill" data-bg-progress-fill></div>
            </div>
            <span class="bg__progress-label" data-bg-progress-label></span>
          </div>
        </div>
      </div>

      {
        debug && (
          <pre class="bg__debug" data-bg-debug>
            {"Debug: waiting for the client script to start…"}
          </pre>
        )
      }

      <section class="bg__drafts-section">
        <div class="bg__drafts-head">
          <h3 class="bg__drafts-title">Saved drafts</h3>
          <button
            type="button"
            class="bg__ghost"
            data-bg-select-all
            >Select all</button
          >
          <button
            type="button"
            class="bg__ghost"
            data-bg-refresh
            >Refresh</button
          >
        </div>

        <!-- Batch publish bar: hidden until at least one draft is ticked, so
             the section never shows a Publish button with nothing selected.
             The whole batch goes out as ONE commit -- see the publish-batch
             endpoint and blog_publish.publish_drafts. -->
        <div
          class="bg__batchbar"
          data-bg-batchbar
          hidden
        >
          <span class="bg__batch-count" data-bg-batch-count></span>
          <button
            type="button"
            class="bg__generate bg__batch-publish"
            data-bg-batch-publish
          >
            <span data-bg-batch-publish-label>Approve &amp; publish selected</span>
          </button>
          <button
            type="button"
            class="bg__ghost"
            data-bg-batch-clear
            >Clear</button
          >
        </div>
        <p
          class="bg__batch-status"
          data-bg-batch-status
          role="status"
          aria-live="polite"
          hidden
        ></p>

        <div
          class="bg__drafts"
          data-bg-drafts
        >
          <p class="bg__status">Loading…</p>
        </div>
      </section>
    </div>

    <!-- ============ ARTICLE VIEW ============ -->
    <article
      class="bg__article"
      data-bg-draft
      hidden
    >
      <button
        type="button"
        class="bg__back"
        data-bg-back
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Back to drafts
      </button>

      <div
        class="bg__verdict"
        data-bg-verdict
      ></div>

      <p class="bg__kicker">Draft — for review</p>
      <h1
        class="bg__headline"
        data-bg-headline
      ></h1>
      <p
        class="bg__dek"
        data-bg-dek
      ></p>
      <div
        class="bg__body"
        data-bg-body
      ></div>
      <div
        class="bg__tags"
        data-bg-tags
      ></div>
      <dl
        class="bg__meta"
        data-bg-meta
      ></dl>

      <div class="bg__publish-row">
        <button
          type="button"
          class="bg__generate"
          data-bg-publish
          >Approve &amp; publish</button
        >
        <button
          type="button"
          class="bg__danger"
          data-bg-delete
          >Delete</button
        >
        <span
          class="bg__status"
          data-bg-publish-status
          role="status"
          aria-live="polite"
        ></span>
      </div>
    </article>
  </div>
</CustomSection>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";

  const NS = "[blog-generator]";

  type ProfileRow = {
    profile_key?: string;
    display_name?: string;
    profile_type?: "org" | "person";
    award_count?: number;
    gold?: number;
    silver?: number;
    bronze?: number;
    first_year?: string;
    last_year?: string;
    detail?: string;
  };

  type DraftRow = {
    slug?: string;
    headline?: string;
    org_name?: string;
    angle?: string;
    fact_check_status?: string;
    grounding_score?: number;
    status?: string;
    cloudcannon_id?: string;
    updated_at?: string;
  };

  const esc = (value: unknown): string =>
    String(value ?? "").replace(
      /[&<>"']/g,
      (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] ?? c
    );

  const num = (value: unknown): string => Number(value ?? 0).toLocaleString("en-US");

  /** Minimal markdown -> HTML. Escapes text BEFORE any tag is introduced, so
   *  model-written prose can never inject markup. Not a full parser: just the
   *  constructs the article prompt actually asks for. */
  const mdToHtml = (md: string): string => {
    const lines = String(md || "").split(/\r?\n/);
    const blocks: string[] = [];
    let para: string[] = [];
    const flush = () => {
      if (!para.length) return;
      const text = esc(para.join(" "))
        .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
        .replace(/\*([^*]+)\*/g, "<em>$1</em>")
        .replace(/\[VERIFY\]/g, '<mark class="bg__verify">VERIFY</mark>');
      blocks.push(`<p>${text}</p>`);
      para = [];
    };
    for (const raw of lines) {
      const line = raw.trim();
      if (!line) { flush(); continue; }
      const h3 = line.match(/^###\s+(.*)/);
      const h2 = line.match(/^##\s+(.*)/);
      if (h3) { flush(); blocks.push(`<h3>${esc(h3[1])}</h3>`); continue; }
      if (h2) { flush(); blocks.push(`<h2>${esc(h2[1])}</h2>`); continue; }
      para.push(line);
    }
    flush();
    return blocks.join("");
  };

  const span = (a?: string, b?: string): string =>
    a && b ? (a === b ? a : `${a}–${b}`) : a || b || "";

  const initBlogGenerator = () => {
    const roots = document.querySelectorAll<HTMLElement>("[data-bg]");
    if (!roots.length) return;

    roots.forEach((root) => {
      // Astro re-runs module scripts on view transitions; without this a
      // second set of listeners would fire one request per past navigation.
      if (root.dataset.bgReady === "true") return;
      root.dataset.bgReady = "true";

      const debugEl = root.querySelector<HTMLElement>("[data-bg-debug]");
      const log = (msg: string, ...rest: unknown[]) => {
        console.log(NS, msg, ...rest);
        if (debugEl) {
          debugEl.textContent +=
            `\n[${new Date().toLocaleTimeString()}] ${msg}` +
            (rest.length ? " " + JSON.stringify(rest[0]) : "");
        }
      };

      log("component script started");

      let config: { endpoint: string; pageSize: number; debug: boolean };
      try {
        config = JSON.parse(root.dataset.config || "{}");
      } catch (err) {
        log("FAILED to parse config JSON", String(err));
        return;
      }
      const { endpoint, pageSize } = config;
      log(`config parsed: endpoint="${endpoint}"`);
      if (!endpoint) {
        log("STOPPING: no API endpoint configured (apiEndpoint field is empty)");
        return;
      }

      const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel);
      const qInput = $<HTMLInputElement>("[data-bg-q]");
      const searchSpin = $("[data-bg-search-spin]");
      const resultsEl = $("[data-bg-results]");
      const statusEl = $("[data-bg-status]");
      const pagerEl = $<HTMLElement>("[data-bg-pager]");
      const pageInfoEl = $("[data-bg-page-info]");
      const prevBtn = $<HTMLButtonElement>("[data-bg-prev]");
      const nextBtn = $<HTMLButtonElement>("[data-bg-next]");
      const actionbar = $<HTMLElement>("[data-bg-actionbar]");
      const chosenNameEl = $("[data-bg-chosen-name]");
      const chosenLabelEl = $("[data-bg-chosen-label]");
      const clearBtn = $<HTMLButtonElement>("[data-bg-clear]");
      const batchbar = $<HTMLElement>("[data-bg-batchbar]");
      const batchCountEl = $("[data-bg-batch-count]");
      const batchPublishBtn = $<HTMLButtonElement>("[data-bg-batch-publish]");
      const batchPublishLabel = $("[data-bg-batch-publish-label]");
      const batchClearBtn = $<HTMLButtonElement>("[data-bg-batch-clear]");
      const batchStatusEl = $<HTMLElement>("[data-bg-batch-status]");
      const selectAllBtn = $<HTMLButtonElement>("[data-bg-select-all]");
      const angleInput = $<HTMLInputElement>("[data-bg-angle]");
      const generateBtn = $<HTMLButtonElement>("[data-bg-generate]");
      const generateLabel = $("[data-bg-generate-label]");
      const progressEl = $<HTMLElement>("[data-bg-progress]");
      const progressFillEl = $<HTMLElement>("[data-bg-progress-fill]");
      const progressLabelEl = $("[data-bg-progress-label]");
      const draftEl = $<HTMLElement>("[data-bg-draft]");
      const verdictEl = $("[data-bg-verdict]");
      const headlineEl = $("[data-bg-headline]");
      const dekEl = $("[data-bg-dek]");
      const bodyEl = $("[data-bg-body]");
      const tagsEl = $("[data-bg-tags]");
      const metaEl = $("[data-bg-meta]");
      const draftsEl = $("[data-bg-drafts]");
      const publishBtn = $<HTMLButtonElement>("[data-bg-publish]");
      const deleteBtn = $<HTMLButtonElement>("[data-bg-delete]");
      const backBtn = $<HTMLButtonElement>("[data-bg-back]");
      const publishStatusEl = $("[data-bg-publish-status]");
      const filterBtns = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-bg-filter]"));
      const listViewEls = Array.from(root.querySelectorAll<HTMLElement>("[data-bg-list-view]"));
      if (!qInput || !resultsEl || !statusEl || !draftEl) return;

      let currentSlug = "";
      // Multi-select, keyed "type::key". A Map (not an array) because cards
      // are re-rendered on every search and page change, so membership has to
      // be answerable from the key alone -- the ProfileRow object identity
      // from the previous render is long gone by then. Insertion order is
      // preserved, so the batch generates in the order they were picked.
      const selectedMap = new Map<string, ProfileRow>();
      const selKey = (t: string | undefined, k: string | undefined) =>
        `${t || "org"}::${k || ""}`;
      // Slugs ticked in the saved-drafts list, for batch publish. Separate
      // from selectedMap: these are drafts that already exist, not profiles
      // waiting to be drafted.
      const selectedDrafts = new Set<string>();

      // "NEW" tag on a draft nobody has opened yet -- per-browser, in
      // localStorage, not a blog_store column: this is "has THIS reviewer
      // looked at it", which is a viewer's own state, not a fact about the
      // draft itself. Wrapped in try/catch throughout because localStorage
      // can throw (private browsing, a full quota, storage disabled) and a
      // "which drafts are new" nicety must never be why the list fails to
      // load.
      const SEEN_KEY = "bg:seenDraftSlugs";
      const loadSeenSlugs = (): Set<string> => {
        try {
          return new Set(JSON.parse(localStorage.getItem(SEEN_KEY) || "[]"));
        } catch {
          return new Set();
        }
      };
      const markSeen = (slug: string) => {
        try {
          const seen = loadSeenSlugs();
          if (seen.has(slug)) return;
          seen.add(slug);
          // Capped so this can't grow forever across months of use -- only
          // the most recent slugs matter for "have I opened this lately".
          const capped = [...seen].slice(-500);
          localStorage.setItem(SEEN_KEY, JSON.stringify(capped));
        } catch {
          /* per-viewer nicety only -- a storage failure here changes nothing
             about the draft, so there is nothing to surface to the user */
        }
      };
      let ptype = "all";
      // The current page's offset and the true match count, used to render
      // the Prev/Next pager. Reset to 0 on every fresh search() call, since a
      // new query or filter pill invalidates whatever page you were on.
      let resultOffset = 0;
      let resultTotal = 0;

      const url = (path: string, params: Record<string, string | number> = {}) => {
        const qs = new URLSearchParams();
        Object.entries(params).forEach(([k, v]) => {
          if (v !== "" && v !== undefined && v !== null) qs.set(k, String(v));
        });
        const suffix = qs.toString();
        return `${endpoint}${path}${suffix ? `?${suffix}` : ""}`;
      };

      // ---------- view switching ----------
      const draftParam = (slug: string) => {
        const u = new URL(window.location.href);
        u.searchParams.set("draft", slug);
        return u.toString();
      };
      const listUrl = () => {
        const u = new URL(window.location.href);
        u.searchParams.delete("draft");
        return u.toString();
      };
      // A real page load starts at the top; client-side view switching does
      // not. scrollIntoView on the shown element was tried first and measured
      // mid-layout-shift (as the other view collapses via `hidden`), landing
      // somewhere arbitrary -- scrolling the window is what navigation does.
      const scrollTop = () => window.scrollTo({ top: 0, behavior: "smooth" });
      const showListView = () => {
        listViewEls.forEach((el) => { el.hidden = false; });
        draftEl.hidden = true;
        scrollTop();
      };
      const showDraftView = () => {
        listViewEls.forEach((el) => { el.hidden = true; });
        draftEl.hidden = false;
        scrollTop();
      };

      // ---------- search ----------
      let seq = 0;
      let timer: ReturnType<typeof setTimeout> | undefined;

      const medals = (r: ProfileRow) => {
        const parts = [
          r.gold ? `<span class="bg__medal g" title="${num(r.gold)} Gold">${num(r.gold)}</span>` : "",
          r.silver ? `<span class="bg__medal s" title="${num(r.silver)} Silver">${num(r.silver)}</span>` : "",
          r.bronze ? `<span class="bg__medal b" title="${num(r.bronze)} Bronze">${num(r.bronze)}</span>` : "",
        ].filter(Boolean).join("");
        return parts ? `<span class="bg__medals">${parts}</span>` : "";
      };

      const cardHtml = (r: ProfileRow) => {
        const key = r.profile_key || r.display_name || "";
        const isPerson = r.profile_type === "person";
        const yrs = span(r.first_year, r.last_year);
        // Re-read from selectedMap rather than trusting a flag on the row:
        // a card can be re-rendered by a search or a page change while its
        // profile is still selected, and must come back still ticked.
        const chosen = selectedMap.has(selKey(r.profile_type, key));
        return `<button
          type="button"
          class="bg__card${chosen ? " is-chosen" : ""}"
          role="option"
          aria-selected="${chosen ? "true" : "false"}"
          data-key="${esc(key)}"
          data-type="${isPerson ? "person" : "org"}"
          data-name="${esc(r.display_name || key)}"
        >
          <span class="bg__card-top">
            <span class="bg__type ${isPerson ? "p" : "o"}">${isPerson ? "Person" : "Organization"}</span>
            <span class="bg__check" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
                   stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
          </span>
          <span class="bg__card-name">${esc(r.display_name || key)}</span>
          ${r.detail ? `<span class="bg__card-detail">${esc(String(r.detail).split("|")[0].trim())}</span>` : ""}
          <span class="bg__card-foot">
            <span class="bg__awards"><b>${num(r.award_count)}</b> awards</span>
            ${medals(r)}
            ${yrs ? `<span class="bg__years">${esc(yrs)}</span>` : ""}
          </span>
        </button>`;
      };

      const renderResults = (rows: ProfileRow[]) => {
        if (!rows.length) {
          resultsEl.innerHTML =
            `<div class="bg__empty"><p>No winners match that search.</p></div>`;
          return;
        }
        resultsEl.innerHTML = rows.map(cardHtml).join("");
      };

      const skeleton = (n = 6) =>
        `<div class="bg__skel-grid">${'<div class="bg__skel"></div>'.repeat(n)}</div>`;

      // Same convention SearchPastWinners.astro's own pager uses, so browsing
      // this picker reads the same way browsing that page does.
      const renderPager = () => {
        if (!pagerEl || !pageInfoEl || !prevBtn || !nextBtn) return;
        const pages = Math.max(1, Math.ceil(resultTotal / pageSize));
        const page = Math.floor(resultOffset / pageSize) + 1;
        pagerEl.hidden = resultTotal <= pageSize;
        pageInfoEl.textContent = `Page ${num(page)} of ${num(pages)}`;
        prevBtn.disabled = resultOffset <= 0;
        nextBtn.disabled = resultOffset + pageSize >= resultTotal;
      };

      const search = async (nextOffset = 0) => {
        const mine = ++seq;
        resultOffset = nextOffset;
        const q = qInput.value.trim();
        if (searchSpin) searchSpin.hidden = false;
        resultsEl.innerHTML = skeleton();
        const searchUrl = url("/api/blog-writer/profiles",
          { q, profile_type: ptype, limit: pageSize, offset: resultOffset });
        log(`searching: ${searchUrl}`);
        try {
          const res = await fetch(searchUrl);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();
          if (mine !== seq) return; // superseded by a newer keystroke/page click
          const rows: ProfileRow[] = data.results || [];
          renderResults(rows);
          resultTotal = typeof data.total === "number" ? data.total : rows.length;
          const noun = ptype === "person" ? "people" : ptype === "org" ? "organizations" : "winners";
          const from = resultTotal ? resultOffset + 1 : 0;
          const to = resultOffset + rows.length;
          statusEl.textContent = resultTotal
            ? `${num(from)}–${num(to)} of ${num(resultTotal)} ${noun}${q ? ` for “${q}”` : ""}`
            : q ? `No winners match “${q}”.` : "Most-awarded winners — search above to narrow it down.";
          statusEl.removeAttribute("data-kind");
          renderPager();
          log(`search ok: ${rows.length} rows, offset ${resultOffset}/${resultTotal}`);
        } catch (err) {
          if (mine !== seq) return;
          const detail = err instanceof Error ? err.message : String(err);
          const network = err instanceof TypeError;
          log(`SEARCH FAILED: ${detail}` +
            (network ? " -- likely CORS blocked, tunnel down, or wrong URL" : ""));
          resultsEl.innerHTML = "";
          statusEl.textContent = "Search is unavailable right now. Check the API endpoint.";
          statusEl.dataset.kind = "error";
          if (pagerEl) pagerEl.hidden = true;
        } finally {
          if (mine === seq && searchSpin) searchSpin.hidden = true;
        }
      };

      // Repaint tick state on the cards currently in the DOM. Cheaper and
      // less disruptive than re-rendering the grid: a full re-render would
      // also rebuild every card's markup mid-click.
      const paintCards = () => {
        resultsEl.querySelectorAll<HTMLElement>(".bg__card").forEach((el) => {
          const on = selectedMap.has(selKey(el.dataset.type, el.dataset.key));
          el.classList.toggle("is-chosen", on);
          el.setAttribute("aria-selected", on ? "true" : "false");
        });
      };

      const renderActionbar = () => {
        const n = selectedMap.size;
        if (actionbar) actionbar.hidden = n === 0;
        if (clearBtn) clearBtn.hidden = n < 2;
        if (chosenLabelEl) {
          chosenLabelEl.textContent = n > 1 ? `${num(n)} selected` : "Selected";
        }
        if (chosenNameEl) {
          const names = [...selectedMap.values()]
            .map((r) => r.display_name || r.profile_key || "");
          // One name reads better than "1 selected"; a long list would
          // overflow the bar, so past three it summarises.
          chosenNameEl.textContent =
            n === 0 ? ""
              : n <= 3 ? names.join(", ")
                : `${names.slice(0, 2).join(", ")} +${num(n - 2)} more`;
        }
        if (generateLabel) {
          generateLabel.textContent =
            n > 1 ? `Generate ${num(n)} articles` : "Generate article";
        }
      };

      const toggleProfile = (row: ProfileRow) => {
        const k = selKey(row.profile_type, row.profile_key);
        if (selectedMap.has(k)) selectedMap.delete(k);
        else selectedMap.set(k, row);
        paintCards();
        renderActionbar();
      };

      const clearProfiles = () => {
        selectedMap.clear();
        paintCards();
        renderActionbar();
      };

      // ---------- saved-draft selection (batch publish) ----------
      const renderBatchbar = () => {
        const n = selectedDrafts.size;
        if (batchbar) batchbar.hidden = n === 0;
        if (batchCountEl) {
          batchCountEl.textContent =
            n === 1 ? "1 draft selected" : `${num(n)} drafts selected`;
        }
        if (batchPublishLabel) {
          batchPublishLabel.textContent =
            n > 1 ? `Approve & publish ${num(n)} drafts` : "Approve & publish selected";
        }
      };

      const paintDraftChecks = () => {
        draftsEl?.querySelectorAll<HTMLElement>("[data-slug]").forEach((el) => {
          const on = selectedDrafts.has(el.dataset.slug || "");
          el.classList.toggle("is-picked", on);
          const box = el.querySelector<HTMLInputElement>("[data-bg-draft-check]");
          if (box) box.checked = on;
        });
      };

      const toggleDraft = (slug: string) => {
        if (selectedDrafts.has(slug)) selectedDrafts.delete(slug);
        else selectedDrafts.add(slug);
        paintDraftChecks();
        renderBatchbar();
      };

      // ---------- draft rendering ----------
      const renderVerdict = (d: {
        fact_check_status?: string; grounding_score?: number;
        fact_check_reason?: string; flagged_claims?: string[];
      }) => {
        if (!verdictEl) return;
        const passed = d.fact_check_status === "passed";
        const pct = Math.round((d.grounding_score || 0) * 100);
        const claims = (d.flagged_claims || []).map((c) => `<li>${esc(c)}</li>`).join("");
        verdictEl.innerHTML = `
          <div class="bg__verdict-box" data-kind="${passed ? "pass" : "flag"}">
            <span class="bg__verdict-pct">${pct}%</span>
            <div class="bg__verdict-text">
              <p class="bg__verdict-title">${passed ? "Fact-check passed" : "Fact-check flagged claims"}</p>
              <p class="bg__verdict-reason">${esc(d.fact_check_reason || "")}</p>
              ${claims ? `<ul class="bg__verdict-claims">${claims}</ul>` : ""}
            </div>
          </div>`;
      };

      const renderDraft = (d: any) => {
        if (!headlineEl || !dekEl || !bodyEl || !tagsEl || !metaEl) return;
        currentSlug = d.slug || "";
        if (publishStatusEl) publishStatusEl.textContent = "";
        headlineEl.textContent = d.headline || "";
        dekEl.textContent = d.dek || "";
        // Render the annotated text when the gate flagged something, so the
        // [VERIFY] markers land in the copy a reviewer actually reads.
        bodyEl.innerHTML = mdToHtml(
          d.fact_check_status === "passed" ? d.body_md || "" : d.annotated_text || d.body_md || ""
        );
        tagsEl.innerHTML = (d.tags || []).map((t: string) => `<span class="bg__tag">${esc(t)}</span>`).join("");
        renderVerdict(d);
        metaEl.innerHTML = [
          ["Claims verified", `<b>${num(d.verified_claims)} / ${num(d.total_claims)}</b>`],
          ["Words", `<b>${num(d.word_count)}</b>`],
          ["SEO title", esc(d.title_tag || "")],
          ["Meta description", esc(d.meta_description || "")],
          ["Slug", `<code>${esc(d.slug || "")}</code>`],
        ].map(([k, v]) => `<dt>${k}</dt><dd>${v}</dd>`).join("");
        showDraftView();
      };

      const setProgress = (done: number, total: number, label: string) => {
        if (!progressEl) return;
        progressEl.hidden = false;
        progressEl.setAttribute("aria-valuenow", String(done));
        progressEl.setAttribute("aria-valuemax", String(total));
        if (progressFillEl) progressFillEl.style.width = `${(done / total) * 100}%`;
        if (progressLabelEl) progressLabelEl.textContent = label;
      };

      const generateOne = async (p: ProfileRow, angle: string) => {
        const res = await fetch(url("/api/blog-writer/generate"), {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            profile_type: p.profile_type || "org",
            profile_key: p.profile_key,
            angle,
          }),
        });
        const d = await res.json();
        if (!res.ok) throw new Error(d.detail || `HTTP ${res.status}`);
        return d;
      };

      const generate = async () => {
        const picks = [...selectedMap.values()];
        if (!picks.length) return;
        const many = picks.length > 1;
        if (generateBtn) generateBtn.disabled = true;
        if (generateLabel) {
          generateLabel.innerHTML =
            `<span class="bg__spinner sm" aria-hidden="true"></span> ` +
            (many ? `Writing ${num(picks.length)} articles…` : "Writing and fact-checking…");
        }
        const angle = angleInput?.value || "";
        try {
          if (!many) {
            // Single pick keeps the original behaviour: open straight into the
            // finished article. With several there is no single article to
            // open, so the loop below reports a summary instead.
            const p = picks[0];
            log(`generating: ${p.profile_type}/${p.profile_key}`);
            const d = await generateOne(p, angle);
            log(`draft generated: ${d.slug} (${d.fact_check_status})`);
            clearProfiles();
            renderDraft(d);
            history.pushState({ slug: d.slug }, "", draftParam(d.slug));
            void loadDrafts();
            return;
          }

          // Sequential, not Promise.all: these are paid Gemini calls against a
          // per-minute quota, and firing them all at once is how a batch turns
          // into a rate-limit error that loses most of the drafts (the server
          // side generate-batch endpoint enforces the same one-at-a-time rule
          // for the same reason). Driving the loop from here rather than
          // POSTing the whole batch in one call is what makes a real,
          // per-item progress bar possible -- a single blocking request has
          // nothing to report until every profile is done.
          log(`generating ${picks.length} drafts, one at a time`);
          setProgress(0, picks.length, `0 of ${num(picks.length)} complete`);
          const succeeded: string[] = [];
          const failed: { key: string; error: string }[] = [];
          for (let i = 0; i < picks.length; i++) {
            const p = picks[i];
            try {
              const d = await generateOne(p, angle);
              succeeded.push(d.slug);
              log(`  [${i + 1}/${picks.length}] ok: ${p.profile_key} -> ${d.slug}`);
            } catch (err) {
              const detail = err instanceof Error ? err.message : String(err);
              failed.push({ key: p.profile_key || "", error: detail });
              log(`  [${i + 1}/${picks.length}] FAILED: ${p.profile_key} -- ${detail}`);
            }
            setProgress(i + 1, picks.length,
              `${num(i + 1)} of ${num(picks.length)} complete` +
              (failed.length ? ` (${num(failed.length)} failed)` : ""));
            // A profile already drafted shows up right away rather than only
            // after the whole batch finishes.
            void loadDrafts();
          }

          statusEl.textContent =
            `Generated ${num(succeeded.length)} of ${num(picks.length)} drafts.` +
            (failed.length
              ? ` Failed: ${failed.map((f) => f.key).join(", ")}.`
              : " They are in Saved drafts below.");
          statusEl.dataset.kind = failed.length ? "error" : "";
          if (!failed.length) statusEl.removeAttribute("data-kind");
          log(`batch done: ${succeeded.length}/${picks.length} generated`);
          clearProfiles();
        } catch (err) {
          const detail = err instanceof Error ? err.message : String(err);
          log(`GENERATE FAILED: ${detail}`);
          statusEl.textContent = "Could not generate: " + detail;
          statusEl.dataset.kind = "error";
        } finally {
          if (generateBtn) generateBtn.disabled = false;
          if (progressEl) progressEl.hidden = true;
          renderActionbar();
        }
      };

      const publishSelectedDrafts = async () => {
        const slugs = [...selectedDrafts];
        if (!slugs.length) return;
        if (!window.confirm(
          slugs.length === 1
            ? "Publish this draft to the live site?"
            : `Publish these ${slugs.length} drafts to the live site?`)) return;
        if (batchPublishBtn) batchPublishBtn.disabled = true;
        if (batchPublishLabel) {
          batchPublishLabel.innerHTML =
            `<span class="bg__spinner sm" aria-hidden="true"></span> Publishing…`;
        }
        if (batchStatusEl) {
          batchStatusEl.hidden = false;
          batchStatusEl.removeAttribute("data-kind");
          batchStatusEl.textContent =
            "Committing and pushing to the site repository…";
        }
        try {
          const res = await fetch(url("/api/blog-writer/publish-batch"), {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ slugs }),
          });
          const d = await res.json();
          if (!res.ok) throw new Error(d.detail || `HTTP ${res.status}`);
          log(`batch published ${d.published}/${d.requested} on ${d.branch}`);
          if (batchStatusEl) {
            batchStatusEl.textContent =
              `Published ${num(d.published)} page${d.published === 1 ? "" : "s"}` +
              ` to ${esc(d.branch || "the site branch")}.` +
              (d.missing?.length ? ` Not found: ${d.missing.join(", ")}.` : "") +
              " They appear on the site once it rebuilds.";
          }
          selectedDrafts.clear();
          renderBatchbar();
          void loadDrafts();
        } catch (err) {
          const detail = err instanceof Error ? err.message : String(err);
          log(`BATCH PUBLISH FAILED: ${detail}`);
          if (batchStatusEl) {
            batchStatusEl.hidden = false;
            batchStatusEl.dataset.kind = "error";
            batchStatusEl.textContent = "Could not publish: " + detail;
          }
        } finally {
          if (batchPublishBtn) batchPublishBtn.disabled = false;
          renderBatchbar();
        }
      };

      // ---------- saved drafts ----------
      const loadDrafts = async () => {
        if (!draftsEl) return;
        try {
          const res = await fetch(url("/api/blog-writer/drafts", { limit: 24 }));
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();
          const rows: DraftRow[] = data.rows || [];
          if (!rows.length) {
            draftsEl.innerHTML = `<p class="bg__status">No drafts yet — generate one above.</p>`;
            // Slugs ticked before a refresh that returned nothing are gone.
            selectedDrafts.clear();
            renderBatchbar();
            return;
          }
          // Drop ticks for drafts that no longer exist (deleted elsewhere, or
          // pushed off the end of the list) -- otherwise a stale slug would
          // travel into a batch publish and 404 there.
          const live = new Set(rows.map((r) => r.slug));
          [...selectedDrafts].forEach((s) => { if (!live.has(s)) selectedDrafts.delete(s); });

          // The card is a <div>, not a <button>: it holds BOTH a checkbox and
          // an open-button, and interactive elements cannot legally nest
          // inside a button. The open-button carries the card's content and
          // fills the card, so clicking the body still opens the draft.
          const seenSlugs = loadSeenSlugs();
          draftsEl.innerHTML = `<div class="bg__draft-grid">${rows.map((r) => {
            const published = r.status === "published" && r.cloudcannon_id;
            const passed = r.fact_check_status === "passed";
            const picked = selectedDrafts.has(r.slug);
            const isNew = !seenSlugs.has(r.slug);
            const headline = r.headline || "Untitled";
            return `<div class="bg__draft-card${picked ? " is-picked" : ""}" data-slug="${esc(r.slug)}">
              <label class="bg__draft-pick">
                <input type="checkbox" data-bg-draft-check ${picked ? "checked" : ""}
                       aria-label="Select ${esc(headline)} for publishing">
                <span class="bg__draft-pick-text">Select</span>
              </label>
              <button type="button" class="bg__draft-open" data-bg-draft-open>
                <span class="bg__card-top">
                  <span class="bg__pill-sm ${passed ? "ok" : "warn"}">${passed ? "Passed" : "Flagged"}</span>
                  <span class="bg__draft-state-group">
                    <span class="bg__draft-state${published ? " is-live" : ""}">${published ? "Published" : esc(r.status || "draft")}</span>
                    ${isNew ? `<span class="bg__draft-new" data-bg-draft-new>New</span>` : ""}
                  </span>
                </span>
                <span class="bg__draft-headline">${esc(headline)}</span>
                <span class="bg__draft-subject">${esc(r.org_name || "")}</span>
                ${r.angle ? `<span class="bg__draft-angle">${esc(r.angle)}</span>` : ""}
                <span class="bg__draft-when">${esc(r.updated_at || "")}</span>
              </button>
            </div>`;
          }).join("")}</div>`;
          renderBatchbar();
        } catch (err) {
          const detail = err instanceof Error ? err.message : String(err);
          log(`drafts FAILED: ${detail}`);
          draftsEl.innerHTML = `<p class="bg__status" data-kind="error">Could not load drafts.</p>`;
        }
      };

      const openDraft = async (slug: string, pushUrl = true) => {
        log(`opening draft: ${slug}`);
        try {
          const res = await fetch(url(`/api/blog-writer/draft/${encodeURIComponent(slug)}`));
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const d = await res.json();
          if (d.error) throw new Error(d.error);
          const parse = (v: unknown) =>
            Array.isArray(v) ? v : JSON.parse((v as string) || "[]");
          renderDraft({
            headline: d.headline, dek: d.dek, body_md: d.draft_text,
            annotated_text: d.annotated_text, fact_check_status: d.fact_check_status,
            tags: parse(d.tags), title_tag: d.title_tag,
            meta_description: d.meta_description, slug: d.slug,
            word_count: d.word_count, fact_check_reason: d.reason,
            grounding_score: d.grounding_score,
            // Missing from this mapping entirely showed "0 / 0" for every
            // draft reopened from Saved Drafts, regardless of the real count
            // -- num(undefined) renders as 0, and a fresh /generate response
            // is the ONLY path that ever set these two fields here.
            verified_claims: d.verified_claims, total_claims: d.total_claims,
            // Stored as a JSON string in blog_store, same as tags -- passing it
            // through unparsed made renderVerdict's .map() throw on any draft
            // that actually had flagged claims.
            flagged_claims: parse(d.flagged_claims),
          });
          if (pushUrl) history.pushState({ slug }, "", draftParam(slug));
          markSeen(slug);
          // Drop just this card's own NEW badge rather than re-fetching the
          // whole drafts list for one flag flip.
          draftsEl?.querySelector(`[data-slug="${slug}"] [data-bg-draft-new]`)?.remove();
        } catch (err) {
          const detail = err instanceof Error ? err.message : String(err);
          log(`open draft FAILED: ${detail}`);
          statusEl.textContent = "Could not load that draft.";
          statusEl.dataset.kind = "error";
        }
      };

      const publishCurrent = async () => {
        if (!currentSlug) return;
        if (publishBtn) publishBtn.disabled = true;
        if (publishStatusEl) {
          publishStatusEl.removeAttribute("data-kind");
          publishStatusEl.innerHTML =
            `<span class="bg__spinner sm" aria-hidden="true"></span> Committing…`;
        }
        try {
          const res = await fetch(
            url(`/api/blog-writer/publish/${encodeURIComponent(currentSlug)}`),
            { method: "POST" });
          const d = await res.json();
          if (!res.ok) throw new Error(d.detail || `HTTP ${res.status}`);
          if (publishStatusEl) {
            publishStatusEl.innerHTML =
              `Published to <strong>${esc(d.branch)}</strong> — ` +
              `<a href="${esc(d.url_path)}" target="_blank" rel="noopener noreferrer">${esc(d.url_path)}</a>`;
          }
          void loadDrafts();
        } catch (err) {
          const detail = err instanceof Error ? err.message : String(err);
          log(`PUBLISH FAILED: ${detail}`);
          if (publishStatusEl) {
            publishStatusEl.setAttribute("data-kind", "error");
            publishStatusEl.textContent = "Could not publish: " + detail;
          }
        } finally {
          if (publishBtn) publishBtn.disabled = false;
        }
      };

      const deleteCurrent = async () => {
        if (!currentSlug) return;
        if (!window.confirm(
          "Delete this draft? If it was already published, its live page is removed too. This cannot be undone."
        )) return;
        if (deleteBtn) deleteBtn.disabled = true;
        try {
          const res = await fetch(
            url(`/api/blog-writer/draft/${encodeURIComponent(currentSlug)}`),
            { method: "DELETE" });
          const d = await res.json();
          if (!res.ok) throw new Error(d.detail || `HTTP ${res.status}`);
          currentSlug = "";
          showListView();
          history.pushState(null, "", listUrl());
          void loadDrafts();
        } catch (err) {
          const detail = err instanceof Error ? err.message : String(err);
          log(`DELETE FAILED: ${detail}`);
          if (publishStatusEl) {
            publishStatusEl.setAttribute("data-kind", "error");
            publishStatusEl.textContent = "Could not delete: " + detail;
          }
        } finally {
          if (deleteBtn) deleteBtn.disabled = false;
        }
      };

      // ---------- wiring ----------
      qInput.addEventListener("input", () => {
        if (timer) clearTimeout(timer);
        // A new query always restarts at page 1 -- offset 0, not resultOffset,
        // which still points at whatever page the PREVIOUS query left off on.
        timer = setTimeout(() => void search(0), 220);
      });
      filterBtns.forEach((btn) => btn.addEventListener("click", () => {
        ptype = btn.dataset.bgFilter || "all";
        filterBtns.forEach((b) => b.classList.toggle("is-active", b === btn));
        void search(0);
      }));
      prevBtn?.addEventListener("click", () => void search(Math.max(0, resultOffset - pageSize)));
      nextBtn?.addEventListener("click", () => void search(resultOffset + pageSize));
      resultsEl.addEventListener("click", (event) => {
        const card = (event.target as HTMLElement)?.closest<HTMLElement>(".bg__card");
        if (!card) return;
        toggleProfile({
          profile_key: card.dataset.key,
          profile_type: (card.dataset.type as "org" | "person") || "org",
          display_name: card.dataset.name,
        });
      });
      clearBtn?.addEventListener("click", clearProfiles);
      generateBtn?.addEventListener("click", () => void generate());
      publishBtn?.addEventListener("click", () => void publishCurrent());
      deleteBtn?.addEventListener("click", () => void deleteCurrent());
      backBtn?.addEventListener("click", () => {
        showListView();
        history.pushState(null, "", listUrl());
      });
      root.querySelector("[data-bg-refresh]")?.addEventListener("click", () => void loadDrafts());
      draftsEl?.addEventListener("click", (event) => {
        const target = event.target as HTMLElement;
        const card = target?.closest<HTMLElement>("[data-slug]");
        const slug = card?.dataset.slug;
        if (!slug) return;
        // The checkbox and its <label> toggle selection; anywhere else on the
        // card opens the draft. Checked via closest() rather than the click
        // target itself because a click on the label's text still has to
        // reach the box, and the browser then re-fires it on the input.
        if (target.closest(".bg__draft-pick")) {
          if (target instanceof HTMLInputElement) toggleDraft(slug);
          return;
        }
        void openDraft(slug);
      });
      batchPublishBtn?.addEventListener("click", () => void publishSelectedDrafts());
      batchClearBtn?.addEventListener("click", () => {
        selectedDrafts.clear();
        paintDraftChecks();
        renderBatchbar();
        if (batchStatusEl) batchStatusEl.hidden = true;
      });
      selectAllBtn?.addEventListener("click", () => {
        const cards = Array.from(
          draftsEl?.querySelectorAll<HTMLElement>("[data-slug]") || []);
        // Toggle: a second click clears, so this one button covers both.
        const allOn = cards.length > 0 && cards.every(
          (el) => selectedDrafts.has(el.dataset.slug || ""));
        selectedDrafts.clear();
        if (!allOn) cards.forEach((el) => {
          if (el.dataset.slug) selectedDrafts.add(el.dataset.slug);
        });
        paintDraftChecks();
        renderBatchbar();
      });
      // Re-read the URL rather than trusting popstate's state object, so back
      // and a reload on a draft URL take the same path.
      window.addEventListener("popstate", () => {
        const slug = new URL(window.location.href).searchParams.get("draft");
        if (slug) void openDraft(slug, false);
        else showListView();
      });

      void search(0);
      void loadDrafts();

      // Deep link: reloading or sharing ?draft=<slug> opens straight into it.
      const initial = new URL(window.location.href).searchParams.get("draft");
      if (initial) void openDraft(initial, false);
    });
  };

  onPageLoad(initBlogGenerator);
</script>

<style is:global>
  @layer page-sections {
    .blog-generator {
      --bgx-gold: #b8941a;
      --bgx-pass: #1f6f5c;
      --bgx-pass-bg: rgba(31, 111, 92, 0.08);
      --bgx-flag: #b3261e;
      --bgx-flag-bg: rgba(179, 38, 30, 0.07);
      --bgx-line: var(--color-border, rgba(0, 0, 0, 0.12));
      --bgx-radius: 14px;
    }

    @keyframes bgx-spin { to { transform: rotate(360deg); } }
    @keyframes bgx-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
    @keyframes bgx-shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

    /* ---------- header ---------- */
    .blog-generator .bg__head { max-width: 44rem; }

    .blog-generator .bg__eyebrow {
      margin: 0 0 0.5rem;
      color: var(--bgx-gold);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .blog-generator .bg__title {
      margin: 0 0 0.6rem;
      font-family: var(--font-headings, var(--font-body));
      font-size: clamp(1.7rem, 3.4vw, 2.5rem);
      font-weight: 700;
      line-height: 1.1;
      color: var(--color-text-strong, var(--color-text));
    }

    .blog-generator .bg__sub {
      margin: 0;
      color: var(--color-text-muted);
      font-size: 1.02rem;
      line-height: 1.55;
    }

    /* ---------- picker panel ---------- */
    .blog-generator .bg__panel {
      margin-top: 1.75rem;
      padding: 1.25rem;
      border: 1px solid var(--bgx-line);
      border-radius: var(--bgx-radius);
      background-color: var(--color-bg-surface, var(--color-bg));
    }

    .blog-generator .bg__searchbar {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0 0.9rem;
      border: 1px solid var(--bgx-line);
      border-radius: 10px;
      background-color: var(--color-bg);
      transition: border-color 140ms ease, box-shadow 140ms ease;
    }

    .blog-generator .bg__searchbar:focus-within {
      border-color: var(--bgx-gold);
      box-shadow: 0 0 0 3px rgba(184, 148, 26, 0.15);
    }

    .blog-generator .bg__search-icon {
      width: 1.1rem; height: 1.1rem; flex: none;
      color: var(--color-text-muted);
    }

    .blog-generator .bg__search {
      flex: 1; min-width: 0;
      padding: 0.85rem 0;
      border: none; outline: none; background: none;
      color: var(--color-text);
      font-family: var(--font-body);
      font-size: 1rem;
      /* type="search" keeps its own native rounded field chrome (border +
         background, and its OWN native focus ring on click) in Chrome/Safari/
         Edge unless appearance is reset -- both showed as a second border
         nested inside .bg__searchbar's own. `appearance: none` alone doesn't
         reliably strip this on the search element itself in WebKit/Blink;
         `-webkit-appearance: textfield` is the documented pairing that does
         (standard `none` still covers Firefox/other engines). */
      appearance: none;
      -webkit-appearance: textfield;
    }

    /* Belt and braces against that native focus ring specifically -- the
       wrapper's own :focus-within rule below is the only highlight this
       input should ever show. */
    .blog-generator .bg__search:focus,
    .blog-generator .bg__search:focus-visible {
      outline: none;
      box-shadow: none;
    }

    .blog-generator .bg__search::-webkit-search-cancel-button { cursor: pointer; }
    .blog-generator .bg__search::-webkit-search-decoration,
    .blog-generator .bg__search::-webkit-search-results-button,
    .blog-generator .bg__search::-webkit-search-results-decoration {
      appearance: none;
      -webkit-appearance: none;
    }

    .blog-generator .bg__spinner {
      width: 1rem; height: 1rem; flex: none;
      border: 2px solid var(--bgx-line);
      border-top-color: var(--bgx-gold);
      border-radius: 50%;
      animation: bgx-spin 0.7s linear infinite;
    }
    .blog-generator .bg__spinner.sm {
      width: 0.85rem; height: 0.85rem;
      display: inline-block; vertical-align: -0.1em; margin-right: 0.35em;
    }

    /* ---------- filters ---------- */
    .blog-generator .bg__filters {
      display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem;
      margin-top: 0.85rem;
    }

    .blog-generator .bg__pill {
      padding: 0.35rem 0.85rem;
      border: 1px solid var(--bgx-line);
      border-radius: 999px;
      background: none;
      color: var(--color-text-muted);
      font-family: var(--font-body);
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 140ms ease;
    }

    .blog-generator .bg__pill:hover { color: var(--color-text); border-color: var(--color-text-muted); }

    .blog-generator .bg__pill.is-active {
      background-color: var(--color-text-strong, var(--color-text));
      border-color: var(--color-text-strong, var(--color-text));
      color: var(--color-bg);
    }


    .blog-generator .bg__status {
      margin: 0.85rem 0 0;
      color: var(--color-text-muted);
      font-size: 0.88rem;
    }
    .blog-generator .bg__status[data-kind="error"] { color: var(--bgx-flag); }

    /* ---------- result cards ---------- */
    .blog-generator .bg__results,
    .blog-generator .bg__skel-grid,
    .blog-generator .bg__draft-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
      gap: 0.75rem;
      margin-top: 0.85rem;
    }

    .blog-generator .bg__card {
      position: relative;
      display: flex; flex-direction: column; gap: 0.4rem;
      padding: 0.9rem;
      border: 1px solid var(--bgx-line);
      border-radius: 12px;
      background-color: var(--color-bg);
      color: var(--color-text);
      font-family: var(--font-body);
      text-align: left;
      cursor: pointer;
      animation: bgx-in 200ms ease both;
      transition: border-color 140ms ease, box-shadow 140ms ease, transform 140ms ease;
    }

    .blog-generator .bg__card:hover {
      border-color: var(--color-text-muted);
      transform: translateY(-1px);
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
    }

    .blog-generator .bg__card:focus-visible {
      outline: 2px solid var(--bgx-gold);
      outline-offset: 2px;
    }

    .blog-generator .bg__card.is-chosen {
      border-color: var(--bgx-gold);
      box-shadow: 0 0 0 2px rgba(184, 148, 26, 0.25);
    }

    .blog-generator .bg__card-top {
      display: flex; align-items: center; justify-content: space-between;
      gap: 0.5rem; width: 100%;
    }

    .blog-generator .bg__type {
      padding: 0.12em 0.5em;
      border-radius: 999px;
      font-size: 0.66rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .blog-generator .bg__type.o { background: rgba(45, 114, 114, 0.12); color: #2d7272; }
    .blog-generator .bg__type.p { background: rgba(184, 148, 26, 0.16); color: #8a6f14; }

    .blog-generator .bg__check {
      display: grid; place-items: center;
      width: 1.15rem; height: 1.15rem; flex: none;
      border-radius: 50%;
      background-color: var(--bgx-gold);
      color: #fff;
      opacity: 0; transform: scale(0.6);
      transition: all 140ms ease;
    }
    .blog-generator .bg__check svg { width: 0.7rem; height: 0.7rem; }
    .blog-generator .bg__card.is-chosen .bg__check { opacity: 1; transform: none; }

    .blog-generator .bg__card-name {
      font-size: 0.97rem; font-weight: 650; line-height: 1.3;
      color: var(--color-text-strong, var(--color-text));
    }

    .blog-generator .bg__card-detail {
      font-size: 0.8rem; color: var(--color-text-muted);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }

    .blog-generator .bg__card-foot {
      display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem;
      margin-top: auto; padding-top: 0.35rem;
      font-size: 0.78rem; color: var(--color-text-muted);
    }
    .blog-generator .bg__awards b { color: var(--color-text-strong, var(--color-text)); }

    .blog-generator .bg__medals { display: inline-flex; gap: 0.2rem; }
    .blog-generator .bg__medal {
      min-width: 1.35rem; padding: 0.05em 0.3em;
      border-radius: 4px; text-align: center;
      font-size: 0.7rem; font-weight: 700;
      font-variant-numeric: tabular-nums;
    }
    .blog-generator .bg__medal.g { background: rgba(184, 148, 26, 0.18); color: #7d6412; }
    .blog-generator .bg__medal.s { background: rgba(120, 128, 140, 0.18); color: #5b6270; }
    .blog-generator .bg__medal.b { background: rgba(176, 108, 58, 0.18); color: #8a5325; }

    .blog-generator .bg__years { margin-left: auto; font-variant-numeric: tabular-nums; }

    .blog-generator .bg__empty {
      grid-column: 1 / -1;
      padding: 2rem 1rem; text-align: center;
      border: 1px dashed var(--bgx-line); border-radius: 12px;
      color: var(--color-text-muted);
    }
    .blog-generator .bg__empty p { margin: 0; }

    .blog-generator .bg__pager {
      display: flex; align-items: center; justify-content: center;
      gap: 1rem;
      margin-top: 1.1rem;
    }
    .blog-generator .bg__page-info {
      color: var(--color-text-muted);
      font-size: 0.85rem;
      font-variant-numeric: tabular-nums;
    }
    .blog-generator .bg__page-btn {
      padding: 0.5rem 1.1rem;
      border: 1px solid var(--bgx-line);
      border-radius: 999px;
      background: none;
      color: var(--color-text);
      font-family: var(--font-body);
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 140ms ease;
    }
    .blog-generator .bg__page-btn:hover:not(:disabled) {
      border-color: var(--bgx-gold);
      color: var(--bgx-gold);
    }
    .blog-generator .bg__page-btn:disabled { cursor: default; opacity: 0.4; }

    .blog-generator .bg__skel {
      height: 7.5rem; border-radius: 12px;
      background: linear-gradient(90deg,
        var(--color-bg-muted) 25%, var(--bgx-line) 37%, var(--color-bg-muted) 63%);
      background-size: 200% 100%;
      animation: bgx-shimmer 1.3s ease-in-out infinite;
    }

    /* ---------- action bar ---------- */
    .blog-generator .bg__actionbar {
      position: sticky; bottom: 0.75rem;
      display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem;
      margin-top: 1rem; padding: 0.85rem;
      border: 1px solid var(--bgx-gold);
      border-radius: 12px;
      background-color: var(--color-bg);
      box-shadow: 0 6px 22px rgba(0, 0, 0, 0.09);
      animation: bgx-in 200ms ease both;
    }

    .blog-generator .bg__chosen { display: flex; flex-direction: column; min-width: 0; }
    .blog-generator .bg__chosen-label {
      font-size: 0.66rem; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--color-text-muted);
    }
    .blog-generator .bg__chosen-name {
      font-size: 0.98rem; color: var(--color-text-strong, var(--color-text));
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }

    .blog-generator .bg__angle-wrap { display: flex; flex: 1 1 16rem; flex-direction: column; min-width: 0; }
    .blog-generator .bg__angle-label {
      font-size: 0.66rem; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--color-text-muted);
    }
    .blog-generator .bg__angle-label em { font-weight: 500; text-transform: none; letter-spacing: 0; }
    .blog-generator .bg__angle {
      width: 100%; padding: 0.4rem 0;
      border: none; border-bottom: 1px solid var(--bgx-line);
      background: none; color: var(--color-text);
      font-family: var(--font-body); font-size: 0.9rem;
    }
    .blog-generator .bg__angle:focus { outline: none; border-bottom-color: var(--bgx-gold); }

    .blog-generator .bg__generate {
      padding: 0.7rem 1.4rem;
      border: 1px solid var(--bgx-gold); border-radius: 9px;
      background-color: var(--bgx-gold); color: #fff;
      font-family: var(--font-body); font-size: 0.92rem; font-weight: 700;
      cursor: pointer; white-space: nowrap;
      transition: filter 140ms ease;
    }
    .blog-generator .bg__generate:hover:not(:disabled) { filter: brightness(1.08); }
    .blog-generator .bg__generate:disabled { opacity: 0.6; cursor: progress; }

    .blog-generator .bg__progress {
      display: flex; align-items: center; gap: 0.65rem;
      width: 100%; margin-top: 0.15rem;
    }
    .blog-generator .bg__progress-track {
      flex: 1; height: 6px; border-radius: 999px;
      background-color: var(--bgx-line);
      overflow: hidden;
    }
    .blog-generator .bg__progress-fill {
      height: 100%; width: 0%;
      background-color: var(--bgx-gold);
      border-radius: inherit;
      transition: width 220ms ease;
    }
    .blog-generator .bg__progress-label {
      flex: none;
      color: var(--color-text-muted);
      font-size: 0.78rem;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    .blog-generator .bg__ghost,
    .blog-generator .bg__danger {
      padding: 0.5rem 1rem;
      border: 1px solid var(--bgx-line); border-radius: 9px;
      background: none; color: var(--color-text);
      font-family: var(--font-body); font-size: 0.85rem; font-weight: 600;
      cursor: pointer; transition: all 140ms ease;
    }
    .blog-generator .bg__ghost:hover { border-color: var(--color-text-muted); }
    .blog-generator .bg__danger { border-color: var(--bgx-flag); color: var(--bgx-flag); }
    .blog-generator .bg__danger:hover:not(:disabled) { background-color: var(--bgx-flag-bg); }
    .blog-generator .bg__danger:disabled { opacity: 0.5; cursor: not-allowed; }

    /* ---------- saved drafts ---------- */
    .blog-generator .bg__drafts-section { margin-top: 2.25rem; }
    .blog-generator .bg__drafts-head {
      display: flex; align-items: center; justify-content: space-between; gap: 1rem;
      padding-bottom: 0.6rem; border-bottom: 1px solid var(--bgx-line);
    }
    .blog-generator .bg__drafts-title {
      margin: 0; font-size: 1.05rem; font-weight: 700;
      color: var(--color-text-strong, var(--color-text));
    }

    /* The card is now a container holding a checkbox plus an open-button
       (interactive elements cannot nest inside a button), so the visual card
       styling lives on the wrapper and the button inside it is transparent. */
    .blog-generator .bg__draft-card {
      position: relative;
      display: flex; flex-direction: column;
      border: 1px solid var(--bgx-line); border-radius: 12px;
      background-color: var(--color-bg); color: var(--color-text);
      transition: border-color 140ms ease, box-shadow 140ms ease, transform 140ms ease;
    }
    .blog-generator .bg__draft-card:hover {
      border-color: var(--color-text-muted); transform: translateY(-1px);
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
    }
    .blog-generator .bg__draft-card.is-picked {
      border-color: var(--bgx-gold);
      box-shadow: 0 0 0 2px rgba(184, 148, 26, 0.18);
    }
    .blog-generator .bg__draft-open {
      display: flex; flex-direction: column; gap: 0.35rem;
      padding: 0.9rem; padding-top: 2.1rem;   /* room for the pick row above */
      border: 0; border-radius: 12px; background: none; color: inherit;
      font-family: var(--font-body); font-size: inherit;
      text-align: left; cursor: pointer;
    }
    .blog-generator .bg__draft-open:focus-visible {
      outline: 2px solid var(--bgx-gold); outline-offset: -2px;
    }

    .blog-generator .bg__draft-pick {
      position: absolute; top: 0.55rem; left: 0.7rem; z-index: 1;
      display: inline-flex; align-items: center; gap: 0.35rem;
      color: var(--color-text-muted); font-size: 0.72rem; font-weight: 600;
      cursor: pointer; user-select: none;
    }
    .blog-generator .bg__draft-pick input { cursor: pointer; margin: 0; }
    .blog-generator .bg__draft-card.is-picked .bg__draft-pick { color: var(--bgx-gold); }

    .blog-generator .bg__batchbar {
      display: flex; flex-wrap: wrap; align-items: center; gap: 0.7rem;
      margin-top: 0.85rem; padding: 0.7rem 0.9rem;
      border: 1px solid var(--bgx-gold); border-radius: 10px;
      background-color: rgba(184, 148, 26, 0.06);
    }
    .blog-generator .bg__batch-count {
      font-size: 0.85rem; font-weight: 600;
      font-variant-numeric: tabular-nums;
    }
    .blog-generator .bg__batch-publish { margin-left: auto; }
    .blog-generator .bg__batch-status {
      margin: 0.6rem 0 0; font-size: 0.85rem; color: var(--color-text-muted);
    }
    .blog-generator .bg__batch-status[data-kind="error"] { color: var(--bgx-flag); }

    .blog-generator .bg__clear {
      margin-left: 0.5rem; padding: 0.15rem 0.6rem;
      border: 1px solid var(--bgx-line); border-radius: 999px;
      background: none; color: var(--color-text-muted);
      font-family: var(--font-body); font-size: 0.72rem; cursor: pointer;
    }
    .blog-generator .bg__clear:hover { border-color: var(--bgx-gold); color: var(--bgx-gold); }

    .blog-generator .bg__pill-sm {
      padding: 0.12em 0.55em; border-radius: 999px;
      font-size: 0.66rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
    }
    .blog-generator .bg__pill-sm.ok { background: var(--bgx-pass-bg); color: var(--bgx-pass); }
    .blog-generator .bg__pill-sm.warn { background: var(--bgx-flag-bg); color: var(--bgx-flag); }

    .blog-generator .bg__draft-state-group {
      display: flex; align-items: center; gap: 0.4rem;
    }
    .blog-generator .bg__draft-state { font-size: 0.72rem; color: var(--color-text-muted); text-transform: capitalize; }
    .blog-generator .bg__draft-state.is-live { color: var(--bgx-pass); font-weight: 700; }
    .blog-generator .bg__draft-new {
      padding: 0.1em 0.5em;
      border-radius: 999px;
      background-color: var(--bgx-gold);
      color: #fff;
      font-size: 0.62rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }
    .blog-generator .bg__draft-headline {
      font-size: 0.95rem; font-weight: 650; line-height: 1.32;
      color: var(--color-text-strong, var(--color-text));
    }
    .blog-generator .bg__draft-subject { font-size: 0.8rem; color: var(--color-text-muted); }
    .blog-generator .bg__draft-angle { font-size: 0.75rem; color: var(--color-text-muted); font-style: italic; }
    .blog-generator .bg__draft-when {
      margin-top: auto; padding-top: 0.3rem;
      font-size: 0.72rem; color: var(--color-text-muted); font-variant-numeric: tabular-nums;
    }

    /* ---------- article view ---------- */
    .blog-generator .bg__article {
      max-width: 46rem; margin: 0 auto;
      animation: bgx-in 240ms ease both;
    }

    .blog-generator .bg__back {
      display: inline-flex; align-items: center; gap: 0.4rem;
      margin-bottom: 1.5rem; padding: 0;
      border: none; background: none;
      color: var(--color-text-muted);
      font-family: var(--font-body); font-size: 0.88rem; font-weight: 600;
      cursor: pointer;
    }
    .blog-generator .bg__back svg { width: 1rem; height: 1rem; }
    .blog-generator .bg__back:hover { color: var(--bgx-gold); }

    .blog-generator .bg__verdict-box {
      display: flex; align-items: flex-start; gap: 0.9rem;
      padding: 0.9rem 1rem; margin-bottom: 1.5rem;
      border: 1px solid var(--bgx-pass); border-radius: 10px;
      background-color: var(--bgx-pass-bg);
    }
    .blog-generator .bg__verdict-box[data-kind="flag"] {
      border-color: var(--bgx-flag); background-color: var(--bgx-flag-bg);
    }
    .blog-generator .bg__verdict-pct {
      font-size: 1.5rem; font-weight: 800; line-height: 1;
      color: var(--bgx-pass); font-variant-numeric: tabular-nums;
    }
    .blog-generator .bg__verdict-box[data-kind="flag"] .bg__verdict-pct { color: var(--bgx-flag); }
    .blog-generator .bg__verdict-title {
      margin: 0; font-weight: 700; color: var(--color-text-strong, var(--color-text));
    }
    .blog-generator .bg__verdict-reason,
    .blog-generator .bg__verdict-claims {
      margin: 0.2rem 0 0; font-size: 0.85rem; color: var(--color-text-muted);
    }
    .blog-generator .bg__verdict-claims { padding-left: 1.1em; }
    .blog-generator .bg__verdict-claims li { margin-top: 0.2em; }

    .blog-generator .bg__kicker {
      margin: 0 0 0.5rem;
      color: var(--bgx-gold); font-size: 0.68rem; font-weight: 700;
      letter-spacing: 0.14em; text-transform: uppercase;
    }

    .blog-generator .bg__headline {
      margin: 0 0 0.7rem;
      font-family: var(--font-headings, var(--font-body));
      font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 700; line-height: 1.14;
      color: var(--color-text-strong, var(--color-text));
    }

    .blog-generator .bg__dek {
      margin: 0 0 1.75rem; padding-bottom: 1.25rem;
      border-bottom: 1px solid var(--bgx-line);
      font-size: 1.12rem; line-height: 1.5; color: var(--color-text-muted);
    }

    .blog-generator .bg__body {
      font-size: 1.06rem; line-height: 1.75; color: var(--color-text);
    }
    .blog-generator .bg__body p { margin: 0 0 1.15em; }
    .blog-generator .bg__body h2,
    .blog-generator .bg__body h3 {
      margin: 1.8em 0 0.6em; font-family: var(--font-headings, var(--font-body));
      color: var(--color-text-strong, var(--color-text));
    }
    .blog-generator .bg__body mark.bg__verify {
      padding: 0 0.3em; border-radius: 3px;
      background-color: rgba(184, 148, 26, 0.22);
      color: var(--color-text-strong, var(--color-text));
      font-size: 0.72em; font-weight: 700; letter-spacing: 0.04em; vertical-align: 0.1em;
    }

    .blog-generator .bg__tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 1.75rem; }
    .blog-generator .bg__tag {
      padding: 0.25em 0.7em; border-radius: 999px;
      background-color: var(--color-bg-muted); color: var(--color-text-muted);
      font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;
    }

    .blog-generator .bg__meta {
      display: grid; grid-template-columns: max-content 1fr; gap: 0.4em 1rem;
      margin: 1.75rem 0 0; padding-top: 1.25rem;
      border-top: 1px solid var(--bgx-line);
    }
    .blog-generator .bg__meta dt {
      font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em;
      text-transform: uppercase; color: var(--color-text-muted);
    }
    .blog-generator .bg__meta dd { margin: 0; font-size: 0.88rem; }
    .blog-generator .bg__meta code { font-size: 0.82rem; word-break: break-all; }

    .blog-generator .bg__publish-row {
      display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem;
      margin-top: 1.75rem; padding-top: 1.5rem;
      border-top: 1px solid var(--bgx-line);
    }
