---
/**
 * BlogGenerator — draft one Stevie Award winner's profile article on demand.
 *
 * Same shape as SearchPastWinners.astro, and deliberately so: this is that
 * component's sibling feature, built the same way for the same reasons.
 *
 * WHY THE FETCH IS CLIENT-SIDE
 * This site builds static (no `output: "server"`, no active adapter), so
 * frontmatter runs once at build time. Drafting is inherently a per-click,
 * per-visitor action, so it has to run in the browser against the blog
 * writer API, the same way SearchPastWinners talks to the winners API.
 *
 * WHY THE ENDPOINT IS A `PUBLIC_` ENV VAR
 * It is baked into the client bundle and therefore visible to anyone. The
 * generate endpoint calls the Gemini API using a key that lives only on the
 * server (blog_writer.py / benchmark/gemini_client.py) — the browser never
 * sees it, it only ever talks to our own FastAPI server. Never put a token
 * here; there is nowhere private to hide one in a static build.
 *
 * WHY EVERY DRAFT SHOWS ITS FACT-CHECK VERDICT
 * The backend runs every draft through grounding_check.py before it is ever
 * returned, and the requirements doc is explicit that AI-written copy must
 * never present unverified claims as fact. Hiding that verdict here would
 * silently drop the one signal an editor needs before publishing anything.
 * This component always renders the pass/flag banner; it never shows body
 * copy without it.
 *
 * WHY THE PROFILE IS PICKED IN THE CLOUDCANNON SIDEBAR, NOT ON THE PAGE
 * This used to be a live search box (type a name, results fetched as you
 * type) -- the same pattern SearchPastWinners still uses. The team wants
 * picking the winner to happen in CloudCannon's own field editor instead, the
 * same place `heading` or `colorScheme` get set, not as an interactive
 * control on the rendered page. CloudCannon's structured inputs can do real
 * dropdowns backed by a real data list (see `_select_data.blogOrgProfiles` /
 * `blogPersonProfiles` in cloudcannon.config.yml, generated from the same
 * database), so `profileType` + `organizationProfile`/`personProfile` are
 * now plain component props an editor sets in the sidebar, exactly like
 * `defaultProfileType` used to be a sidebar-only default.
 *
 * WHY THERE IS NO "GENERATE" BUTTON ON THIS PAGE ANY MORE
 * StevieIntel's own blog_autogen.py polls the repo (no GitHub webhook access
 * was available to react to a save instantly) and drafts whatever profile a
 * picker page's saved frontmatter currently names, the moment that changes --
 * so saving the sidebar's pick IS the trigger, with nothing left to click
 * here. This page now only shows which profile is selected and the resulting
 * drafts. Approve & publish still has to be a button ON a page, for the
 * reason CloudCannon's sidebar can never remove: it can only SET field
 * values, never run an action.
 *
 * CSS-FIRST, PER THE COMPONENT SKILL
 * "Refresh drafts" is still a real, focusable <button>. JS is the
 * enhancement that fills the drafts list and the draft panel in; without it
 * the page still legibly says what it's for.
 */
import Heading from "@core-elements/heading/Heading.astro";
import Text from "@core-elements/text/Text.astro";
import CustomSection from "@builders/custom-section/CustomSection.astro";

const BLOG_API_ENDPOINT = "http://127.0.0.1:8002";

const {
  heading = "Generate a Winner Profile",
  description = "Pick a Stevie Award winner, optionally say what the piece should be about, and draft a fact-checked article in the Stevie blog's own style.",
  // Overridable in CloudCannon so an editor can repoint the component at a
  // tunnel URL without a code change, and by env for per-environment builds.
  apiEndpoint = "",
  // Set from the sidebar (see cloudcannon.config.yml's blogOrgProfiles /
  // blogPersonProfiles _select_data lists). Whichever of the two profile
  // fields matches profileType is the one actually used.
  profileType = "org",
  organizationProfile = "",
  personProfile = "",
  emptyStateText = "Waiting for the first saved pick to be drafted.",
  // Prints every step (config read, each fetch, each error) into a visible
  // on-page panel, not just the browser console — see SearchPastWinners for
  // why this matters inside a CMS preview iframe. Default true while new.
  debug = true,

  colorScheme = "inherit",
  backgroundColor,
  paddingVertical = "4xl",
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const endpoint = (
  apiEndpoint ||
  import.meta.env.PUBLIC_BLOG_API_ENDPOINT ||
  BLOG_API_ENDPOINT
).replace(/\/+$/, "");

const resolvedProfileType = profileType === "person" ? "person" : "org";
const resolvedProfileKey = resolvedProfileType === "person" ? personProfile : organizationProfile;
// Person keys are stored lowercase ("jean henri lhuillier"); organizations
// are already display-cased. Title-casing only the person case is enough to
// show something readable here -- the real display name comes back from the
// API's own response once a draft is generated.
const selectedProfileLabel = resolvedProfileKey
  ? (resolvedProfileType === "person"
      ? resolvedProfileKey.replace(/\b\w/g, (c) => c.toUpperCase())
      : resolvedProfileKey)
  : "";

const config = {
  endpoint,
  profileType: resolvedProfileType,
  profileKey: resolvedProfileKey,
  debug: !!debug,
};
---

<CustomSection
  class:list={["blog-generator", className]}
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <div
    class="bg"
    data-bg
    data-config={JSON.stringify(config)}
  >
    <Heading
      level="h2"
      size="lg"
      text={heading}
      data-prop="heading"
    />
    <Text
      text={description}
      data-prop="description"
    />

    <div class="bg__form" data-bg-form>
      <div class="bg__selected" data-selected-empty={selectedProfileLabel ? undefined : "true"}>
        <span class="bg__label">Selected profile</span>
        {
          selectedProfileLabel ? (
            <p class="bg__selected-name">
              {selectedProfileLabel}
              <span class="bg__type-badge">{resolvedProfileType === "person" ? "Person" : "Organization"}</span>
            </p>
          ) : (
            <p class="bg__selected-name bg__selected-name--empty">
              No profile chosen yet — pick one in the editor sidebar (Profile Type, then Organization or Person).
            </p>
          )
        }
      </div>
      <p class="bg__hint">
        Saving the sidebar's pick drafts this profile automatically, in the
        Stevie blog's own style — no separate step here. It can take up to
        about 20 seconds after Save to show up below. The draft is checked
        against the award record before anything else happens to it; open a
        card to see its fact-check result and to Approve &amp; publish or
        Delete it.
      </p>

      <div class="bg__row">
        <button
          type="button"
          class="bg__reset"
          data-bg-refresh
          >Refresh drafts</button
        >
      </div>
    </div>

    <p
      class="bg__status"
      data-bg-status
      role="status"
      aria-live="polite"
    >
      {emptyStateText}
    </p>

    {
      debug && (
        <pre class="bg__debug" data-bg-debug>
          {"Debug: waiting for the client script to start…\n" +
            "(if this line never changes, the <script> below never ran " +
            "in this preview — that is itself the finding)"}
        </pre>
      )
    }

    <!-- Draft panel: styled like a real Stevie blog post (kicker, headline,
         dek, tags) so an editor previews it the way a reader would see it,
         with the fact-check verdict pinned above the copy rather than
         alongside it, since that verdict gates whether anything below it
         should be trusted yet. -->
    <article
      class="bg__draft"
      data-bg-draft
      hidden
    >
      <p class="bg__kicker">Draft — for review</p>
      <div
        class="bg__verdict"
        data-bg-verdict
      ></div>
      <h1
        class="bg__headline"
        data-bg-headline
      ></h1>
      <p
        class="bg__dek"
        data-bg-dek
      ></p>
      <div
        class="bg__body"
        data-bg-body
      ></div>
      <div
        class="bg__tags"
        data-bg-tags
      ></div>
      <dl
        class="bg__meta"
        data-bg-meta
      ></dl>
      <div class="bg__publish-row">
        <button
          type="button"
          class="bg__submit"
          data-bg-publish
          >Approve &amp; publish</button
        >
        <button
          type="button"
          class="bg__delete"
          data-bg-delete
          >Delete</button
        >
        <span
          class="bg__status"
          data-bg-publish-status
          role="status"
          aria-live="polite"
        ></span>
      </div>
    </article>

    <section class="bg__drafts-section">
      <h3 class="bg__drafts-heading">Saved drafts</h3>
      <div
        class="bg__drafts"
        data-bg-drafts
      >
        <p class="bg__status">Loading…</p>
      </div>
    </section>
  </div>
</CustomSection>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";

  const NS = "[blog-generator]";

  type DraftRow = {
    slug?: string;
    headline?: string;
    org_name?: string;
    angle?: string;
    fact_check_status?: string;
    grounding_score?: number;
    status?: string;
    cloudcannon_id?: string;
    updated_at?: string;
  };

  const esc = (value: unknown): string =>
    String(value ?? "").replace(
      /[&<>"']/g,
      (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] ?? c
    );

  const num = (value: unknown): string => Number(value ?? 0).toLocaleString("en-US");

  /** Minimal markdown -> HTML. Escapes text BEFORE any tag is introduced, so
   *  model-written prose can never inject markup — the same rule blog_writer's
   *  own static/blog_writer.html preview follows. Not a full parser: just the
   *  handful of constructs the article prompt actually asks the model for
   *  (paragraphs, ##/### headings, **bold**, *italic*). */
  const mdToHtml = (md: string): string => {
    const lines = String(md || "").split(/\r?\n/);
    const blocks: string[] = [];
    let para: string[] = [];
    const flush = () => {
      if (!para.length) return;
      const text = esc(para.join(" "))
        .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
        .replace(/\*([^*]+)\*/g, "<em>$1</em>")
        .replace(/\[VERIFY\]/g, '<mark class="bg__verify">VERIFY</mark>');
      blocks.push(`<p>${text}</p>`);
      para = [];
    };
    for (const raw of lines) {
      const line = raw.trim();
      if (!line) { flush(); continue; }
      const h3 = line.match(/^###\s+(.*)/);
      const h2 = line.match(/^##\s+(.*)/);
      if (h3) { flush(); blocks.push(`<h3>${esc(h3[1])}</h3>`); continue; }
      if (h2) { flush(); blocks.push(`<h2>${esc(h2[1])}</h2>`); continue; }
      para.push(line);
    }
    flush();
    return blocks.join("");
  };

  const initBlogGenerator = () => {
    const roots = document.querySelectorAll<HTMLElement>("[data-bg]");
    if (!roots.length) return;

    roots.forEach((root) => {
      // Astro re-runs module scripts on view transitions; without this a
      // second set of listeners would fire one request per past navigation.
      if (root.dataset.bgReady === "true") return;
      root.dataset.bgReady = "true";

      const debugEl = root.querySelector<HTMLElement>("[data-bg-debug]");
      const log = (msg: string, ...rest: unknown[]) => {
        const line = `[${new Date().toLocaleTimeString()}] ${msg}`;
        console.log(NS, msg, ...rest);
        if (debugEl) {
          debugEl.textContent += "\n" + line + (rest.length ? " " + JSON.stringify(rest[0]) : "");
        }
      };

      log("component script started");

      let config: { endpoint: string; profileType: "org" | "person"; profileKey: string; debug: boolean };
      try {
        config = JSON.parse(root.dataset.config || "{}");
      } catch (err) {
        log("FAILED to parse config JSON", String(err));
        return;
      }
      const { endpoint, profileType, profileKey } = config;
      log(`config parsed: endpoint="${endpoint}" profileType="${profileType}" profileKey="${profileKey}"`);
      if (!endpoint) {
        log("STOPPING: no API endpoint configured (apiEndpoint field is empty)");
        return;
      }

      const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel);
      const form = $<HTMLElement>("[data-bg-form]");
      const refreshBtn = $<HTMLButtonElement>("[data-bg-refresh]");
      const statusEl = $("[data-bg-status]");
      const draftEl = $<HTMLElement>("[data-bg-draft]");
      const verdictEl = $("[data-bg-verdict]");
      const headlineEl = $("[data-bg-headline]");
      const dekEl = $("[data-bg-dek]");
      const bodyEl = $("[data-bg-body]");
      const tagsEl = $("[data-bg-tags]");
      const metaEl = $("[data-bg-meta]");
      const draftsEl = $("[data-bg-drafts]");
      const publishBtn = $<HTMLButtonElement>("[data-bg-publish]");
      const deleteBtn = $<HTMLButtonElement>("[data-bg-delete]");
      const publishStatusEl = $("[data-bg-publish-status]");
      if (!form || !statusEl || !draftEl) return;

      // Whichever draft is currently shown in the panel -- set by both
      // generate() and openDraft(), since Approve & publish has to work on a
      // freshly generated draft AND on a previously saved one reopened from
      // the table below.
      let currentSlug = "";

      const url = (path: string, params: Record<string, string | number> = {}) => {
        const qs = new URLSearchParams();
        Object.entries(params).forEach(([k, v]) => {
          if (v !== "" && v !== undefined && v !== null) qs.set(k, String(v));
        });
        const suffix = qs.toString();
        return `${endpoint}${path}${suffix ? `?${suffix}` : ""}`;
      };

      const renderVerdict = (d: {
        fact_check_status?: string;
        grounding_score?: number;
        fact_check_reason?: string;
        flagged_claims?: string[];
      }) => {
        if (!verdictEl) return;
        const passed = d.fact_check_status === "passed";
        const pct = Math.round((d.grounding_score || 0) * 100);
        const claims = (d.flagged_claims || [])
          .map((c) => `<li>${esc(c)}</li>`)
          .join("");
        verdictEl.innerHTML = `
          <div class="bg__verdict-banner" data-kind="${passed ? "pass" : "flag"}">
            <span class="bg__verdict-pct">${pct}%</span>
            <div>
              <p class="bg__verdict-title">${passed ? "Fact-check passed" : "Fact-check flagged claims"}</p>
              <p class="bg__verdict-reason">${esc(d.fact_check_reason || "")}</p>
              ${claims ? `<ul class="bg__verdict-claims">${claims}</ul>` : ""}
            </div>
          </div>`;
      };

      const renderDraft = (d: {
        headline?: string;
        dek?: string;
        body_md?: string;
        annotated_text?: string;
        fact_check_status?: string;
        tags?: string[];
        title_tag?: string;
        meta_description?: string;
        slug?: string;
        verified_claims?: number;
        total_claims?: number;
        word_count?: number;
        fact_check_reason?: string;
        grounding_score?: number;
        flagged_claims?: string[];
      }) => {
        if (!headlineEl || !dekEl || !bodyEl || !tagsEl || !metaEl || !draftEl) return;
        currentSlug = d.slug || "";
        if (publishStatusEl) publishStatusEl.textContent = "";
        headlineEl.textContent = d.headline || "";
        dekEl.textContent = d.dek || "";
        // Render the annotated text when the gate flagged something, so the
        // [VERIFY] markers land in the copy a reviewer actually reads.
        bodyEl.innerHTML = mdToHtml(
          d.fact_check_status === "passed" ? d.body_md || "" : d.annotated_text || d.body_md || ""
        );
        tagsEl.innerHTML = (d.tags || []).map((t) => `<span class="bg__tag">${esc(t)}</span>`).join("");
        renderVerdict(d);
        metaEl.innerHTML = [
          ["Claims verified", `<span class="bg__num">${num(d.verified_claims)} / ${num(d.total_claims)}</span>`],
          ["Words", `<span class="bg__num">${num(d.word_count)}</span>`],
          ["SEO title", esc(d.title_tag || "")],
          ["Meta description", esc(d.meta_description || "")],
          ["Slug", esc(d.slug || "")],
        ]
          .map(([k, v]) => `<dt>${k}</dt><dd>${v}</dd>`)
          .join("");
        draftEl.hidden = false;
      };

      const loadDrafts = async () => {
        if (!draftsEl) return;
        const draftsUrl = url("/api/blog-writer/drafts", { limit: 50 });
        log(`fetching drafts: ${draftsUrl}`);
        try {
          const res = await fetch(draftsUrl);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();
          const rows: DraftRow[] = data.rows || [];
          if (!rows.length) {
            draftsEl.innerHTML = `<p class="bg__status">No drafts yet.</p>`;
            return;
          }
          draftsEl.innerHTML = `
            <div class="bg__cards">
              ${rows
                .map((r) => {
                  const published = r.status === "published" && r.cloudcannon_id;
                  return `<button
                    type="button"
                    class="bg__card"
                    data-slug="${esc(r.slug)}"
                  >
                    <span class="bg__card-top">
                      <span class="bg__pill bg__pill--${esc(r.fact_check_status || "")}">${esc(r.fact_check_status || "—")}</span>
                      <span class="bg__card-status" data-kind="${published ? "published" : ""}">${published ? "Published" : esc(r.status || "draft")}</span>
                    </span>
                    <span class="bg__card-headline">${esc(r.headline || "Untitled")}</span>
                    <span class="bg__card-subject">${esc(r.org_name || "—")}</span>
                    ${r.angle ? `<span class="bg__card-angle">${esc(r.angle)}</span>` : ""}
                    <span class="bg__card-updated">${esc(r.updated_at || "")}</span>
                  </button>`;
                })
                .join("")}
            </div>`;
          log(`drafts loaded: ${rows.length}`);
        } catch (err) {
          const detail = err instanceof Error ? err.message : String(err);
          log(`drafts FAILED: ${detail}`);
          draftsEl.innerHTML = `<p class="bg__status" data-kind="error">Could not load drafts.</p>`;
        }
      };

      const openDraft = async (slug: string) => {
        const draftUrl = url(`/api/blog-writer/draft/${encodeURIComponent(slug)}`);
        log(`fetching draft: ${draftUrl}`);
        try {
          const res = await fetch(draftUrl);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const d = await res.json();
          if (d.error) throw new Error(d.error);
          renderDraft({
            headline: d.headline,
            dek: d.dek,
            body_md: d.draft_text,
            annotated_text: d.annotated_text,
            fact_check_status: d.fact_check_status,
            tags: Array.isArray(d.tags) ? d.tags : JSON.parse(d.tags || "[]"),
            title_tag: d.title_tag,
            meta_description: d.meta_description,
            slug: d.slug,
            word_count: d.word_count,
            fact_check_reason: d.reason,
            grounding_score: d.grounding_score,
            flagged_claims: Array.isArray(d.flagged_claims) ? d.flagged_claims : JSON.parse(d.flagged_claims || "[]"),
          });
          draftEl?.scrollIntoView({ behavior: "smooth", block: "start" });
        } catch (err) {
          const detail = err instanceof Error ? err.message : String(err);
          log(`open draft FAILED: ${detail}`);
          statusEl.textContent = "Could not load that draft.";
          statusEl.dataset.kind = "error";
        }
      };

      const publishCurrent = async () => {
        if (!currentSlug) {
          if (publishStatusEl) publishStatusEl.textContent = "Generate or open a draft first.";
          return;
        }
        if (publishBtn) publishBtn.disabled = true;
        if (publishStatusEl) {
          publishStatusEl.removeAttribute("data-kind");
          publishStatusEl.innerHTML = `<span class="bg__inline-spin" aria-hidden="true"></span> Committing to TestCloudCannon…`;
        }
        const publishUrl = url(`/api/blog-writer/publish/${encodeURIComponent(currentSlug)}`);
        log(`publishing: ${publishUrl}`);
        try {
          const res = await fetch(publishUrl, { method: "POST" });
          const d = await res.json();
          if (!res.ok) throw new Error(d.detail || `HTTP ${res.status}`);
          log(`published OK: branch="${d.branch}" url_path="${d.url_path}"`);
          if (publishStatusEl) {
            publishStatusEl.innerHTML =
              `Published to branch <strong>${esc(d.branch)}</strong> at ` +
              `<a href="${esc(d.url_path)}" target="_blank" rel="noopener noreferrer">${esc(d.url_path)}</a>`;
          }
          void loadDrafts();
        } catch (err) {
          const detail = err instanceof Error ? err.message : String(err);
          log(`PUBLISH FAILED: ${detail}`);
          if (publishStatusEl) {
            publishStatusEl.setAttribute("data-kind", "error");
            publishStatusEl.textContent = "Could not publish: " + detail;
          }
        } finally {
          if (publishBtn) publishBtn.disabled = false;
        }
      };

      const deleteCurrent = async () => {
        if (!currentSlug) {
          if (publishStatusEl) publishStatusEl.textContent = "Generate or open a draft first.";
          return;
        }
        const confirmed = window.confirm(
          "Delete this draft? If it was already published, its live page is removed too. This cannot be undone."
        );
        if (!confirmed) return;

        if (deleteBtn) deleteBtn.disabled = true;
        if (publishStatusEl) {
          publishStatusEl.removeAttribute("data-kind");
          publishStatusEl.innerHTML = `<span class="bg__inline-spin" aria-hidden="true"></span> Deleting…`;
        }
        const deleteUrl = url(`/api/blog-writer/draft/${encodeURIComponent(currentSlug)}`);
        log(`deleting: ${deleteUrl}`);
        try {
          const res = await fetch(deleteUrl, { method: "DELETE" });
          const d = await res.json();
          if (!res.ok) throw new Error(d.detail || `HTTP ${res.status}`);
          log(`deleted OK: slug="${currentSlug}" unpublished=${JSON.stringify(d.unpublished)}`);
          currentSlug = "";
          draftEl.hidden = true;
          if (publishStatusEl) publishStatusEl.textContent = "";
          void loadDrafts();
        } catch (err) {
          const detail = err instanceof Error ? err.message : String(err);
          log(`DELETE FAILED: ${detail}`);
          if (publishStatusEl) {
            publishStatusEl.setAttribute("data-kind", "error");
            publishStatusEl.textContent = "Could not delete: " + detail;
          }
        } finally {
          if (deleteBtn) deleteBtn.disabled = false;
        }
      };

      publishBtn?.addEventListener("click", () => void publishCurrent());
      deleteBtn?.addEventListener("click", () => void deleteCurrent());
      refreshBtn?.addEventListener("click", () => void loadDrafts());
      draftsEl?.addEventListener("click", (event) => {
        const card = (event.target as HTMLElement)?.closest<HTMLElement>("[data-slug]");
        if (card?.dataset.slug) void openDraft(card.dataset.slug);
      });

      void loadDrafts();
    });
  };

  onPageLoad(initBlogGenerator);
</script>

<style is:global>
  @layer page-sections {
    .blog-generator {
      --bg-gold: #dfba19;
      --bg-gold-soft: rgba(223, 186, 25, 0.16);
      --bg-pass: #2d7272;
      --bg-pass-soft: rgba(45, 114, 114, 0.14);
      --bg-flag: #b3261e;
      --bg-flag-soft: rgba(179, 38, 30, 0.12);
    }

    @keyframes bg-spin {
      to { transform: rotate(360deg); }
    }

    @keyframes bg-fade-up {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: none; }
    }

    .blog-generator .bg__form {
      margin-top: var(--spacing-lg);
      display: flex;
      flex-direction: column;
      gap: var(--spacing-md);
    }

    .blog-generator .bg__row {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-md);
      align-items: flex-end;
    }

    .blog-generator .bg__field {
      display: flex;
      flex: 1 1 12rem;
      flex-direction: column;
      gap: var(--spacing-xs);
      min-width: 0;
    }

    .blog-generator .bg__field--grow {
      flex: 4 1 20rem;
    }

    .blog-generator .bg__field--narrow {
      flex: 0 1 12rem;
    }

    .blog-generator .bg__label {
      font-size: var(--font-size-xs);
      color: var(--color-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .blog-generator .bg__selected {
      padding: var(--spacing-md);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
