---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import calendarData from "@data/calendar.json";
import { getCalendarDateParts } from "@utils/calendar-dates";
import Card from "@wrappers/card/Card.astro";
import Grid from "@wrappers/grid/Grid.astro";
import GridItem from "@wrappers/grid/GridItem.astro";

// An event with an "endDate" renders as a range in place: the month/day/year
// slots widen (e.g. "OCT" / "28–30" / "2026") rather than gaining a second
// date block. Events with no usable start date are dropped, so a half-filled
// event in the CloudCannon editor cannot render "NaN".
function getEvents(): CalendarEvent[] {
  return calendarData.events.flatMap((e) => {
    const parts = getCalendarDateParts(e.date, (e as { endDate?: string | null }).endDate);

    if (!parts) return [];

    return [{ ...parts, title: e.title, description: e.description }];
  });
}

type CalendarEvent = {
  month: string;
  day: string;
  year: string;
  isRange: boolean;
  title: string;
  description?: string | null;
};

const {
  colorScheme = "inherit",
  backgroundColor,
  paddingVertical = "3xl",
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const resolvedEvents: CalendarEvent[] = getEvents();

const hasEvents = resolvedEvents.length > 0;

if (!_component && !hasEvents) return;
---

<CustomSection
  class:list={["grid-calendar", className]}
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <Grid
    layout="start"
    minItemWidth={350}
    gap="lg"
    class="grid-calendar__grid"
    useDefaultEditableBinding={false}
  >
    {
      resolvedEvents.map((event: CalendarEvent) => (
        <GridItem useDefaultEditableBinding={false}>
          <Card
            rounded={false}
            useDefaultEditableBinding={false}
            backgroundColor="surface"
            paddingHorizontal="lg"
            paddingVertical="lg"
            class="grid-calendar__card"
          >
            <div class="grid-calendar__date">
              <SimpleText
                class:list={["grid-calendar__month", event.isRange && "grid-calendar__month--range"]}
                text={event.month}
                useDefaultEditableBinding={false}
                size="xl"
                alignX="center"
              />
              <SimpleText
                class:list={["grid-calendar__day", event.isRange && "grid-calendar__day--range"]}
                text={event.day}
                useDefaultEditableBinding={false}
                size="5xl"
                alignX="center"
              />
              <SimpleText
                class:list={["grid-calendar__year", event.isRange && "grid-calendar__year--range"]}
                text={event.year}
                useDefaultEditableBinding={false}
                size="sm"
                alignX="center"
              />
            </div>
            <div class="grid-calendar__content">
              <SimpleText
                class="grid-calendar__title"
                text={event.title}
                useDefaultEditableBinding={false}
                size="md"
              />
              <SimpleText
                class="grid-calendar__description"
                text={event.description}
                useDefaultEditableBinding={false}
                size="sm"
              />
            </div>
          </Card>
        </GridItem>
      ))
    }
  </Grid>
</CustomSection>

<style is:global>
  @layer page-sections {
    .grid-calendar__card > .card-inner {
      border-left: 4px solid var(--color-brand);
    }

    .grid-calendar__card > .card-inner .card-content {
      display: flex;
      gap: var(--spacing-md);
      align-items: center;
    }

    .grid-calendar__month,
    .grid-calendar__day,
    .grid-calendar__title {
      margin: 0;
      p {
        color: var(--color-text-strong);
        font-weight: var(--font-weight-bold);
      }
    }

    .grid-calendar__month,
    .grid-calendar__day {
      p {
        line-height: 1;
      }
    }

    .grid-calendar__year {
      margin-top: var(--spacing-xs);
      p {
        color: var(--color-text-muted);
        font-weight: var(--font-weight-bold);
        letter-spacing: 0.05em;
      }
    }

    /* A date range packs more characters into the same three slots, so ease the
       type down and keep each slot on one line. The date column stays roughly
       as wide as a single date and the card proportions hold. */
    .grid-calendar__date {
      white-space: nowrap;
    }

    .grid-calendar__day--range p {
      font-size: var(--font-size-3xl);
    }

    .grid-calendar__month--range p,
    .grid-calendar__year--range p {
      font-size: var(--font-size-sm);
      letter-spacing: 0;
    }

    .grid-calendar__description {
      margin: 0;
      p {
        color: var(--color-text-muted);
      }
    }
  }
</style>
