---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Button from "@core-elements/button/Button.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Text from "@core-elements/text/Text.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";
import Split from "@wrappers/split/Split.astro";

const {
  backgroundImage = {},
  subheading = "ENTRIES NOW OPEN",
  heading = "The 23rd Annual International Business Awards",
  description = "",
  buttonSections = [],
  socialLinks = [],
  awardPrograms = [],
  awardProgramsHeading = "Our Award Programs",

  colorScheme = "dark",
  backgroundColor,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<CustomSection
  class:list={["hero-calendar", className]}
  maxContentWidth="3xl"
  paddingHorizontal="xl"
  paddingVertical="3xl"
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  backgroundImage={{ ...backgroundImage, positionVertical: "center", positionHorizontal: "center" }}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <Split
    distributionMode="half"
    verticalAlignment="top"
    gap="3xl"
    minSplitWidth={960}
  >
    <div
      slot="first"
      class="hero-calendar__content"
    >
      <p
        class="hero-calendar__subheading"
        data-prop="subheading"
      >{subheading}</p>
      <!-- h1: this hero is used only on the homepage, which otherwise ships no h1
           at all (Page.astro declares pageHeading but never renders it). No risk of
           a second h1 — the collection pages use CollectionLayout, not this hero. -->
      <Heading
        level="h1"
        size="2xl"
        text={heading}
        class="hero-calendar__heading"
        data-prop="heading"
      />
      <Text
        size="sm"
        text={description}
        class="hero-calendar__description"
        data-prop="description"
      />
      {
        buttonSections.length > 0 && (
          <ButtonGroup
            buttonSections={buttonSections}
            direction="row"
            data-children-prop="buttonSections"
          />
        )
      }
    </div>

    <div
      slot="second"
      class="hero-calendar__right-panel"
    >
      {
        awardPrograms.length > 0 && (
          <div class="award-programs" data-children-prop="awardPrograms">
            <div class="award-programs__header">
              <h2 class="award-programs__title" data-prop="awardProgramsHeading">{awardProgramsHeading}</h2>
            </div>
            <ul class="award-programs__list">
              {awardPrograms.map((program) => (
                <li
                  class="award-programs__item"
                  data-editable="array-item"
                  data-id="page-sections/heroes/hero-calendar/awardProgram"
                >
                  <a href={program.link} class="award-programs__link" target="_blank" rel="noopener noreferrer">
                    <span class="award-programs__diamond">&#9670;</span>
                    <div class="award-programs__info">
                      <div class="award-programs__name-row">
                        <span class="award-programs__name" data-prop="name">{program.name}</span>
                        <span
                          class:list={[
                            "award-programs__status",
                            program.statusType === "open"
                              ? "award-programs__status--open"
                              : "award-programs__status--closed",
                          ]}
                          data-prop="status"
                        >{program.status}</span>
                      </div>
                      {(program.dateLabel || program.dateValue) && (
                        <p class="award-programs__date">
                          {program.dateLabel && (
                            <span class="award-programs__date-label" data-prop="dateLabel">{program.dateLabel}</span>
                          )}
                          {program.dateValue && (
                            <strong class="award-programs__date-value" data-prop="dateValue">{program.dateValue}</strong>
                          )}
                        </p>
                      )}
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </Split>
  {
    socialLinks.length > 0 && (
      <div class="hero-calendar__hero-socials" data-children-prop="socialLinks">
        {socialLinks.map((social) => (
          <Button
            size="md"
            link={social.link}
            iconName={social.icon || "social/linkedin"}
            hideText={true}
            variant="ghost"
            openInNewTab={true}
            aria-label={social.platform}
            class="hero-calendar__social-link"
            data-editable="array-item"
            data-id="page-sections/heroes/hero-calendar/socialLink"
          />
        ))}
      </div>
    )
  }
</CustomSection>

<style is:global>
  @layer page-sections {
    .hero-calendar {
      min-height: 55em;
    }

    .hero-calendar > .outer-content {
      min-height: inherit;
      display: flex;
      flex-direction: column;
    }

    .hero-calendar > .outer-content::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.55));
      z-index: 11;
      pointer-events: none;
    }
    .hero-calendar > .outer-content > .background-image picture {
      display: flex;
      justify-content: center;
    }

    .hero-calendar > .outer-content > .background-image img {
      max-width: var(--content-width-4xl);
    }

    .hero-calendar > .outer-content > .content {
      position: static;
      z-index: 12;
      width: 100%;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .hero-calendar .split {
      margin-top: 0;
    }

    .hero-calendar__subheading {
      margin-top: 9rem;
      font-weight: var(--font-weight-bold);
      color: var(--color-link);
      text-transform: uppercase;
    }

    .hero-calendar__heading {
      text-wrap: auto;
      margin-top: var(--spacing-sm);
      font-weight: var(--font-weight-semibold);
    }

    .hero-calendar__description {
      margin-top: var(--spacing-md);
    }

    .hero-calendar__right-panel {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-end;
    }

    .award-programs {
      border-radius: 1.5rem;
      overflow: hidden;
      max-width: 420px;
      width: 100%;
    }

    .award-programs__header {
      background: #fff;
      padding: var(--spacing-lg) var(--spacing-xl);
      margin-top: 9rem;
    }

    .award-programs__title {
      margin: 0;
      font-family: var(--font-headings);
      font-size: 1.2rem;
      font-weight: 900;
      color: #111;
      text-transform: uppercase;
      letter-spacing: 0.02em;
    }

    .award-programs__list {
      list-style: none;
      margin: 0;
      padding: 0;
      background: rgba(10, 10, 40, 0.8);
      max-height: calc(4 * 5.2em);
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: rgba(255, 255, 255, 0.3) transparent;
    }

    .award-programs__list::-webkit-scrollbar {
      width: 4px;
    }

    .award-programs__list::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.3);
      border-radius: 2px;
    }

    .award-programs__item {
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }

    .award-programs__item:last-child {
      border-bottom: none;
    }

    .award-programs__link {
      display: flex;
      align-items: flex-start;
      gap: var(--spacing-sm);
      padding: var(--spacing-md) var(--spacing-xl);
      text-decoration: none;
      color: inherit;
      transition: background 0.15s ease;
    }

    .award-programs__link:hover {
      background: rgba(255, 255, 255, 0.06);
    }

    .award-programs__diamond {
      color: #fff;
      font-size: 0.7rem;
      margin-top: 0.2em;
      flex-shrink: 0;
    }

    .award-programs__info {
      flex: 1;
      min-width: 0;
    }

    .award-programs__name-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--spacing-sm);
    }

    .award-programs__name {
      font-family: var(--font-headings);
      font-size: 0.85rem;
      font-weight: 700;
      color: #fff;
      text-transform: uppercase;
      letter-spacing: 0.02em;
    }

    .award-programs__status {
      font-size: 0.75rem;
      font-weight: 600;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .award-programs__status--open {
      color: var(--color-brand);
    }

    .award-programs__status--closed {
      color: var(--color-text-red);
    }

    .award-programs__date {
      margin: 0.25em 0 0;
      font-size: 0.75rem;
      color: rgba(255, 255, 255, 0.5);
    }

    .award-programs__date-label {
      margin-right: 0.25em;
    }

    .award-programs__date-value {
      color: var(--color-brand);
      font-weight: 700;
    }

    .hero-calendar__hero-socials {
      position: absolute;
      right: var(--spacing-md);
      top: 50%;
      transform: translateY(-50%);
      display: flex;
      flex-direction: column;
      gap: var(--spacing-sm);
      z-index: 13;
    }

    .hero-calendar__hero-socials .button {
      margin-top: 0;
    }

    .hero-calendar__social-link > .button-inner {
      border-radius: var(--radius-full);
      padding: var(--spacing-sm);
      background: rgba(40, 40, 40, 0.75);
    }

    .hero-calendar__social-link > .button-inner:hover {
      background: rgba(60, 60, 60, 0.9);
    }

    @media (max-width: 960px) {
      .hero-calendar__hero-socials {
        position: static;
        transform: none;
        flex-direction: row;
        justify-content: center;
        margin-top: var(--spacing-md);
      }
    }
  }
</style>
