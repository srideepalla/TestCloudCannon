---
/**
 * EnquiryForm — enquiry/support form for the static site.
 *
 * Submits client-side (browser) straight to the Zendesk Requests API
 * (POST /api/v2/requests.json) as an anonymous request. Attachments are uploaded
 * first to the Zendesk Uploads API and attached via comment.uploads. Override the
 * endpoints with PUBLIC_ZENDESK_REQUEST_ENDPOINT / PUBLIC_ZENDESK_UPLOADS_ENDPOINT.
 *
 * NO API token is sent: the Requests + Uploads APIs accept anonymous end-user calls,
 * so no credentials are exposed in the browser. (We deliberately do NOT use the
 * Tickets API, which would require a token.)
 *
 * Routing: the requester picks a category then a subcategory; the subcategory's unique
 * routing code is embedded in the subject —
 *   "[<Category> / <Subcategory>] Stevie enquiry: <program> - <company/name> [<CODE>]"
 * Groups/assignees are NOT set from the frontend (anonymous request). A Zendesk trigger
 * keyed on each <CODE> routes the ticket (group + assignee_<name> tag). See
 * enquiry-routing.ts (CATEGORIES) for the code → category/subcategory/assignee mapping.
 *
 * Zendesk has "Verify anonymous requests" enabled, so a new submission may land in
 * Suspended tickets until the requester verifies their email.
 */
import {
  PROGRAMS,
  CATEGORIES,
  COUNTRIES,
  ZENDESK_REQUEST_ENDPOINT,
  ZENDESK_UPLOADS_ENDPOINT,
} from "@utils/enquiry-routing";

// colorScheme drives the section's theme tokens. The site root defaults to "dark",
// so default this section to "light" for a readable form; pass "dark"/"inherit" to override.
const { class: className, colorScheme = "light" } = Astro.props;
const themeAttr = colorScheme && colorScheme !== "inherit" ? colorScheme : undefined;

// Zendesk endpoints — hardcoded defaults, overridable via env.
const endpoint = import.meta.env.PUBLIC_ZENDESK_REQUEST_ENDPOINT || ZENDESK_REQUEST_ENDPOINT;
const uploadsEndpoint = import.meta.env.PUBLIC_ZENDESK_UPLOADS_ENDPOINT || ZENDESK_UPLOADS_ENDPOINT;

const programMap = Object.fromEntries(
  PROGRAMS.map((p) => [p.value, { label: p.label, short: p.short }])
);
// Category data for the dependent dropdowns (passed to the client script).
// Each category lists its subcategories; the subcategory's `code` is the option value.
const categoryData = CATEGORIES.map((c) => ({
  value: c.value,
  label: c.label,
  subs: c.subcategories.map((s) => ({ code: s.code, label: s.label })),
}));
// code -> { categoryLabel, subLabel } for building the subject + body on submit.
const codeMeta = Object.fromEntries(
  CATEGORIES.flatMap((c) =>
    c.subcategories.map((s) => [s.code, { category: c.label, subcategory: s.label }])
  )
);
---

<section
  class:list={["enquiry", className]}
  data-theme={themeAttr}
>
  <div class="enquiry-shell">
    <header class="enquiry-intro">
      <h1>Contact &amp; Enquiries</h1>
      <p>
        Tell us a little about yourself and what your enquiry relates to, and we&rsquo;ll route it
        to the right team. We&rsquo;ll reply to the email address you provide.
      </p>
    </header>

    <form
      id="enquiry-form"
      class="form"
      novalidate
    >
      <!-- Honeypot: real users never fill this; bots often do. -->
      <input
        type="checkbox"
        name="botcheck"
        class="enquiry-honeypot"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />

      <div class="field-row">
        <label for="enquiry-name">
          Full name <span
            class="req"
            aria-label="required"
            >*</span
          >
        </label>
        <input
          id="enquiry-name"
          type="text"
          name="name"
          autocomplete="name"
          placeholder="Jane Doe"
          required
          aria-required="true"
        />
        <p
          class="field-error"
          data-error-for="name"
          hidden
        >
        </p>
      </div>

      <div class="field-row">
        <label for="enquiry-email">
          Email <span
            class="req"
            aria-label="required"
            >*</span
          >
        </label>
        <input
          id="enquiry-email"
          type="email"
          name="email"
          autocomplete="email"
          placeholder="you@example.com"
          required
          aria-required="true"
        />
        <p
          class="field-error"
          data-error-for="email"
          hidden
        >
        </p>
      </div>

      <div class="field-row">
        <label for="enquiry-company">
          Company / organization <span
            class="req"
            aria-label="required"
            >*</span
          >
        </label>
        <input
          id="enquiry-company"
          type="text"
          name="company"
          autocomplete="organization"
          placeholder="Acme Inc."
          required
          aria-required="true"
        />
        <p
          class="field-error"
          data-error-for="company"
          hidden
        >
        </p>
      </div>

      <div class="field-row">
        <label for="enquiry-job-title">Job title / occupation</label>
        <input
          id="enquiry-job-title"
          type="text"
          name="jobTitle"
          autocomplete="organization-title"
          placeholder="Marketing Director"
        />
      </div>

      <div class="field-row">
        <label for="enquiry-country">Country / region</label>
        <select
          id="enquiry-country"
          name="country"
        >
          <option
            value=""
            selected
            >Select your country / region…</option
          >
          {COUNTRIES.map((c) => <option value={c}>{c}</option>)}
        </select>
      </div>

      <div class="field-row">
        <label for="enquiry-program">
          Select your program <span
            class="req"
            aria-label="required"
            >*</span
          >
        </label>
        <select
          id="enquiry-program"
          name="program"
          required
          aria-required="true"
        >
          <option
            value=""
            disabled
            selected
            >Select your program…</option
          >
          {PROGRAMS.map((p) => <option value={p.value}>{p.label}</option>)}
        </select>
        <p
          class="field-error"
          data-error-for="program"
          hidden
        >
        </p>
      </div>

      <div class="field-row">
        <label for="enquiry-category">
          Select a category <span
            class="req"
            aria-label="required"
            >*</span
          >
        </label>
        <select
          id="enquiry-category"
          name="category"
          required
          aria-required="true"
        >
          <option
            value=""
            disabled
            selected
            >Select a category…</option
          >
          {CATEGORIES.map((c) => <option value={c.value}>{c.label}</option>)}
        </select>
        <p
          class="field-error"
          data-error-for="category"
          hidden
        >
        </p>
      </div>

      <div class="field-row">
        <label for="enquiry-subcategory">
          Select a subcategory <span
            class="req"
            aria-label="required"
            >*</span
          >
        </label>
        <select
          id="enquiry-subcategory"
          name="subcategory"
          required
          aria-required="true"
          disabled
        >
          <option
            value=""
            disabled
            selected
            >Select a category first…</option
          >
        </select>
        <p
          class="field-error"
          data-error-for="subcategory"
          hidden
        >
        </p>
      </div>

      <div class="field-row">
        <label for="enquiry-message">
          Message <span
            class="req"
            aria-label="required"
            >*</span
          >
        </label>
        <textarea
          id="enquiry-message"
          name="message"
          rows="6"
          placeholder="Describe your enquiry in as much detail as you can."
          required
          aria-required="true"
        ></textarea>
        <p
          class="field-error"
          data-error-for="message"
          hidden
        >
        </p>
      </div>

      <div class="field-row">
        <label for="enquiry-phone">Phone number</label>
        <input
          id="enquiry-phone"
          type="tel"
          name="phone"
          autocomplete="tel"
          inputmode="tel"
          maxlength="18"
          placeholder="Include your country code"
        />
        <p class="field-hint">Country code + 10-digit number.</p>
        <p
          class="field-error"
          data-error-for="phone"
          hidden
        >
        </p>
      </div>

      <div class="field-row">
        <label for="enquiry-entry-id">Entry / nomination ID</label>
        <input
          id="enquiry-entry-id"
          type="text"
          name="entryId"
          placeholder="If you have one"
        />
      </div>

      <div class="field-row">
        <label for="enquiry-files">Attach screenshots or videos</label>
        <input
          id="enquiry-files"
          type="file"
          name="attachments"
          multiple
          accept="image/*,video/*,.pdf"
        />
        <p class="field-hint">Optional. You can attach multiple files.</p>
        <p
          class="field-error"
          data-error-for="attachments"
          hidden
        >
        </p>
      </div>

      <button
        type="submit"
        class="enquiry-submit"
        >Send enquiry</button
      >

      <!-- Status region: polite so screen readers announce success/error. -->
      <p
        id="enquiry-status"
        class="enquiry-status"
        role="status"
        aria-live="polite"
        hidden
      >
      </p>
    </form>
  </div>
</section>

<script define:vars={{ endpoint, uploadsEndpoint, programMap, categoryData, codeMeta }}>
  const form = document.getElementById("enquiry-form");
  if (form) {
    const statusEl = document.getElementById("enquiry-status");
    const submitBtn = form.querySelector(".enquiry-submit");
    const fileInput = document.getElementById("enquiry-files");

    // Dependent dropdowns: picking a category repopulates the subcategory <select>.
    // Rebuilds the subcategory options from the current category selection. With no
    // category (e.g. after form.reset()), it clears to the disabled placeholder state.
    const categoryMap = Object.fromEntries(categoryData.map((c) => [c.value, c]));
    const categorySelect = document.getElementById("enquiry-category");
    const subcategorySelect = document.getElementById("enquiry-subcategory");
    const syncSubcategories = () => {
      if (!categorySelect || !subcategorySelect) return;
      const cat = categoryMap[categorySelect.value];
      subcategorySelect.innerHTML = "";
      const placeholder = document.createElement("option");
      placeholder.value = "";
      placeholder.disabled = true;
      placeholder.selected = true;
      placeholder.textContent = cat ? "Select a subcategory…" : "Select a category first…";
      subcategorySelect.appendChild(placeholder);
      if (cat) {
        for (const sub of cat.subs) {
          const opt = document.createElement("option");
          opt.value = sub.code; // routing code — embedded in the subject
          opt.textContent = sub.label;
          subcategorySelect.appendChild(opt);
        }
        subcategorySelect.disabled = false;
      } else {
        subcategorySelect.disabled = true;
      }
    };
    if (categorySelect) categorySelect.addEventListener("change", syncSubcategories);

    // form.reset() reverts the category to its placeholder but does NOT clear the
    // JS-built subcategory options or re-disable it, and fires no "change" — so resync
    // the subcategory explicitly after any reset.
    const resetForm = () => {
      form.reset();
      syncSubcategories();
    };

    // Gatekeep the phone field as the user types: only "+", digits and separators,
    // and never more than 14 digits (country code + 10).
    const phoneInput = document.getElementById("enquiry-phone");
    if (phoneInput) {
      phoneInput.addEventListener("input", () => {
        let cleaned = phoneInput.value.replace(/[^\d+\s\-()]/g, "");
        const hasPlus = cleaned.trimStart().startsWith("+");
        let digits = cleaned.replace(/\D/g, "").slice(0, 14);
        phoneInput.value = (hasPlus ? "+" : "") + digits;
      });
    }

    const setError = (field, message) => {
      const el = form.querySelector(`[data-error-for="${field}"]`);
      if (!el) return;
      el.textContent = message;
      el.hidden = !message;
    };

    const clearErrors = () => {
      form.querySelectorAll(".field-error").forEach((el) => {
        el.textContent = "";
        el.hidden = true;
      });
    };

    const setStatus = (message, kind) => {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.hidden = !message;
      statusEl.dataset.kind = kind || "";
    };

    // Basic, fail-safe client validation. Returns the first invalid field name.
    const validate = (data) => {
      clearErrors();
      let firstInvalid = null;
      const fail = (field, msg) => {
        setError(field, msg);
        if (!firstInvalid) firstInvalid = field;
      };
      const requireText = (field, msg) => {
        if (!String(data.get(field) || "").trim()) fail(field, msg);
      };
      requireText("name", "Please enter your full name.");
      const email = String(data.get("email") || "").trim();
      if (!email) fail("email", "Please enter your email so we can reply.");
      else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email))
        fail("email", "Please enter a valid email address.");
      requireText("company", "Please enter your company or organization.");
      if (!data.get("program")) fail("program", "Please select your program.");
      if (!data.get("category")) fail("category", "Please select a category.");
      if (!data.get("subcategory")) fail("subcategory", "Please select a subcategory.");
      requireText("message", "Please describe your enquiry.");
      // Phone is optional, but if provided it must be a country code + 10 digits.
      const phone = String(data.get("phone") || "").trim();
      if (phone && !isValidPhone(phone)) {
        fail("phone", "Enter a country code followed by a 10-digit number.");
      }
      return firstInvalid;
    };

    // Must be a country code + a 10-digit number. Allow an optional leading "+" and
    // common separators (spaces / hyphens / parens), which are ignored. Country code
    // is 1–4 digits, so total digit count must be 11–14 (anything < 11 means no
    // country code; the 25-digit paste from before is > 14 and is rejected).
    const isValidPhone = (value) => {
      const compact = value.replace(/[\s\-().]/g, "");
      if (!/^\+?\d+$/.test(compact)) return false;
      const digits = compact.replace(/\D/g, "");
      return digits.length >= 11 && digits.length <= 14;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      // Honeypot tripped → silently pretend success, send nothing.
      if (form.elements.botcheck && form.elements.botcheck.checked) {
        setStatus("Thanks — your enquiry has been sent.", "success");
        resetForm();
        return;
      }

      const data = new FormData(form);
      const invalid = validate(data);
      if (invalid) {
        const el = form.querySelector(`[name="${invalid}"]`);
        if (el) el.focus();
        setStatus("Please fix the highlighted fields and try again.", "error");
        return;
      }

      const get = (field) => String(data.get(field) || "").trim();
      const fullName = get("name");
      const email = get("email");
      const company = get("company");
      const timestamp = new Date().toISOString();
      const pageUrl = window.location.href;

      // Routing: the chosen subcategory's CODE is embedded in the subject; a Zendesk
      // trigger keyed on that unique code assigns/tags the ticket. Program is shown in
      // compact form in the subject.
      const code = get("subcategory");
      const meta = codeMeta[code] || { category: get("category"), subcategory: code };
      const programValue = get("program");
      const program = programMap[programValue] || { label: programValue, short: programValue };

      // Subject: "[<Category> / <Subcategory>] Stevie enquiry: <program> - <company/name> [<CODE>]"
      const subject = `[${meta.category} / ${meta.subcategory}] Stevie enquiry: ${program.short} - ${company || fullName} [${code}]`;

      // Human-readable comment body with every field, for the Zendesk agent.
      const line = (k, v) => `${k}: ${v || "—"}`;
      const body = [
        line("Full name", fullName),
        line("Email", email),
        line("Company / organization", company),
        line("Job title / occupation", get("jobTitle")),
        line("Country / region", get("country")),
        line("Program", program.label),
        line("Category", meta.category),
        line("Subcategory", meta.subcategory),
        "",
        "Message:",
        get("message"),
        "",
        line("Phone", get("phone")),
        line("Entry / nomination ID", get("entryId")),
        "",
        "—",
        line("Submitted from", pageUrl),
        line("Timestamp", timestamp),
      ].join("\n");

      console.info("[enquiry] submitting to Zendesk", {
        code,
        category: meta.category,
        program: program.short,
        endpoint,
      });

      const ERROR_MSG = "Could not submit your enquiry. Please try again or contact support.";

      if (!endpoint) {
        console.error("[enquiry] Zendesk endpoint is not set — cannot submit.");
        setStatus(ERROR_MSG, "error");
        return;
      }

      submitBtn.disabled = true;
      const originalLabel = submitBtn.textContent;
      submitBtn.textContent = "Sending…";
      setStatus("", "");

      // Restore the button before bailing out on an error.
      const stopSending = () => {
        submitBtn.disabled = false;
        submitBtn.textContent = originalLabel;
      };

      try {
        // 1) Upload any attachments to the Zendesk Uploads API and collect tokens.
        //    Each file is POSTed as raw binary to uploads.json?filename=<name>.
        //    If ANY upload fails we abort — never submit silently without attachments.
        let uploadTokens = [];
        const files = fileInput && fileInput.files ? Array.from(fileInput.files) : [];
        if (files.length) {
          setStatus("Uploading attachments…", "");
          try {
            uploadTokens = await Promise.all(files.map(uploadFile));
          } catch (uploadErr) {
            console.error("[enquiry] attachment upload failed", uploadErr);
            setStatus(
              "We couldn't upload your attachment(s). Please remove them or try again.",
              "error"
            );
            setError("attachments", "Attachment upload failed — please try again.");
            stopSending();
            return;
          }
        }

        // 2) Create the Zendesk request (anonymous — no token, no Tickets API),
        //    attaching the upload tokens via comment.uploads.
        const comment = { body };
        if (uploadTokens.length) comment.uploads = uploadTokens;
        const payload = { request: { requester: { name: fullName, email }, subject, comment } };

        const response = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(payload),
        });
        console.info("[enquiry] Zendesk result", { ok: response.ok, status: response.status });
        if (response.ok) {
          // "Verify anonymous requests" is on, so the requester may get a verification
          // email and the ticket may sit in Suspended until they confirm.
          setStatus(
            "Thanks — your enquiry has been submitted. Please verify your email so our team can respond.",
            "success"
          );
          resetForm();
        } else {
          setStatus(ERROR_MSG, "error");
        }
      } catch (err) {
        console.error("[enquiry] submit failed", err);
        setStatus(ERROR_MSG, "error");
      } finally {
        stopSending();
      }
    });

    // Upload one file to the Zendesk Uploads API and return its upload token.
    // Raw-binary POST to uploads.json?filename=<name>; response: { upload: { token } }.
    async function uploadFile(file) {
      const url = `${uploadsEndpoint}?filename=${encodeURIComponent(file.name)}`;
      const res = await fetch(url, {
        method: "POST",
        headers: { "Content-Type": file.type || "application/binary" },
        body: file,
      });
      if (!res.ok) throw new Error(`upload failed (${res.status}) for ${file.name}`);
      const json = await res.json();
      const token = json && json.upload && json.upload.token;
      if (!token) throw new Error(`no upload token returned for ${file.name}`);
      return token;
    }
  }
</script>

<style>
  @layer components {
    .enquiry {
      background-color: var(--color-bg);
      color: var(--color-text);
      padding-block: var(--spacing-2xl, 3rem);
      width: 100%;
    }

    .enquiry-shell {
      margin-inline: auto;
      max-width: 40rem;
      padding-inline: var(--spacing-md);
      width: 100%;
    }

    .enquiry-intro {
      margin-bottom: var(--spacing-lg);

      p {
        color: var(--color-text-muted);
        margin-top: var(--spacing-xs);
      }
    }

    .field-row {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-xs);
      margin-bottom: var(--spacing-md);

      select,
      input,
      textarea {
        width: 100%;
      }
    }

    .req {
      color: var(--color-error);
      margin-inline-start: var(--spacing-em-xs);
    }

    .field-hint {
      color: var(--color-text-muted);
      font-size: var(--font-size-sm);
    }

    .field-error {
      color: var(--color-error);
      font-size: var(--font-size-sm);
    }

    /* Visually hide the honeypot without using display:none (bots skip those). */
    .enquiry-honeypot {
      height: 0;
      left: -9999px;
      opacity: 0;
      position: absolute;
      width: 0;
    }

    .enquiry-submit {
      background-color: var(--color-bg-brand, var(--color-brand));
      border: 0;
      border-radius: var(--radius-xs);
      color: var(--color-text-on-brand, #fff);
      cursor: pointer;
      font-size: var(--font-size-md);
      font-weight: var(--font-weight-semibold);
      padding: var(--spacing-em-sm) var(--spacing-lg);
      transition: opacity var(--animation-normal) ease-in-out;

      &:hover {
        opacity: 0.9;
      }

      &:disabled {
        cursor: not-allowed;
        opacity: 0.6;
      }
    }

    .enquiry-status {
      border-radius: var(--radius-xs);
      margin-top: var(--spacing-md);
      padding: var(--spacing-em-sm) var(--spacing-em-md, 1rem);

      &[data-kind="success"] {
        background-color: var(--color-bg-success, #e6f4ea);
        color: var(--color-success, #1e7e34);
      }

      &[data-kind="error"] {
        background-color: var(--color-bg-error, #fdecea);
        color: var(--color-error, #c0392b);
      }
    }
  }
</style>
