---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";

const {
  heading = "Add a Profile or Page",
  formUrl = "https://stevie-profiles-api.stevieawards.workers.dev/new",
  height = 900,
  colorScheme = "dark",
  backgroundColor = "base",
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const hasFormUrl = typeof formUrl === "string" && formUrl.trim().length > 0;
const heightStyle = `--add-profile-form-height: ${Number(height) || 900}px;`;
---

<CustomSection
  class:list={["add-profile-form", className]}
  maxContentWidth="xl"
  paddingHorizontal="md"
  paddingVertical="2xl"
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  {
    heading && (
      <Heading level="h2" size="2xl" alignX="center" text={heading} data-prop="heading" />
    )
  }
  {
    hasFormUrl ? (
      <iframe
        class="add-profile-form__frame"
        style={heightStyle}
        src={formUrl}
        title="Add a profile or page"
        loading="lazy"
        data-prop="formUrl"
      />
    ) : (
      <div class="add-profile-form__placeholder">
        Set the "Form URL" field to the profiles-api Worker's /new URL.
      </div>
    )
  }
</CustomSection>

<style is:global>
  @layer page-sections {
    .add-profile-form .heading {
      text-transform: uppercase;
      font-weight: var(--font-weight-bold);
    }

    .add-profile-form__frame {
      margin-top: var(--spacing-xl);
      border: 0;
      display: block;
      width: 100%;
      height: var(--add-profile-form-height, 900px);
      background: #0f1115;
    }

    .add-profile-form__placeholder {
      align-items: center;
      background: var(--color-bg-surface);
      border: 1px dashed var(--color-border);
      border-radius: var(--radius-md);
      color: var(--color-text-muted);
      display: flex;
      justify-content: center;
      margin-top: var(--spacing-xl);
      min-height: 220px;
      padding: var(--spacing-xl);
      text-align: center;
    }
  }
</style>
