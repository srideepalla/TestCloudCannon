---
/**
 * StevieChatbot — Executive Stevie Awards Intelligence Canvas.
 * A full-canvas, executive-grade AI assistant integrated into the website.
 */
import CustomSection from "@components/page-sections/builders/custom-section/CustomSection.astro";

const {
  heading = "Stevie Awards Assistant",
  text = "Ask about entering, fees, deadlines, categories, judging or look up a winning organization or honoree. Every answer cites its source.",
  placeholder = "Ask anything about winners, categories, deadlines, fees, or how to enter...",
  buttonLabel = "Ask",
  apiEndpoint = "",
  apiKey: apiKeyProp = "",
  showSources = true,
  colorScheme = "inherit",
  backgroundColor,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const apiUrl = (
  apiEndpoint ||
  import.meta.env.PUBLIC_STEVIE_API_URL ||
  "https://sulhhxqwfc.execute-api.us-east-1.amazonaws.com"
)
  .toString()
  .replace(/\/+$/, "");
const apiKey = apiKeyProp || import.meta.env.PUBLIC_STEVIE_API_KEY || "";
---

<CustomSection
  class:list={["stevie-chatbot-section", className]}
  maxContentWidth="full"
  paddingHorizontal="none"
  paddingVertical="none"
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <div
    class="stevie-canvas"
    id="stevie-canvas-root"
  >
    <!-- Identity gate: the chat stays covered until we know who is asking, so
         every conversation can be attributed and followed up on. -->
    <div
      class="stevie-gate"
      id="stevie-gate"
      hidden
    >
      <div class="stevie-gate__card">
        <span class="stevie-gate__badge">
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle
              cx="12"
              cy="7"
              r="4"
            ></circle></svg
          >
          Before we begin
        </span>
        <h3 class="stevie-gate__title">Tell us who you are</h3>
        <p class="stevie-gate__copy">
          We ask for your name and email so our team can follow up on anything the assistant cannot
          answer.
        </p>
        <form
          class="stevie-gate__form"
          id="stevie-gate-form"
          novalidate
        >
          <div class="stevie-gate__field">
            <label
              class="stevie-gate__label"
              for="stevie-gate-name"
              >Your Name <span class="stevie-gate__req">*</span></label
            >
            <input
              type="text"
              id="stevie-gate-name"
              class="stevie-gate__input"
              placeholder="e.g. Jane Doe"
              autocomplete="name"
              required
            />
          </div>
          <div class="stevie-gate__field">
            <label
              class="stevie-gate__label"
              for="stevie-gate-email"
              >Your Email <span class="stevie-gate__req">*</span></label
            >
            <input
              type="email"
              id="stevie-gate-email"
              class="stevie-gate__input"
              placeholder="e.g. jane@company.com"
              autocomplete="email"
              required
            />
          </div>
          <p
            class="stevie-gate__error"
            id="stevie-gate-error"
            role="alert"
            hidden
          >
          </p>
          <button
            type="submit"
            class="stevie-gate__submit"
            id="stevie-gate-submit"
          >
            Start chatting
          </button>
        </form>
      </div>
    </div>

    <!-- Executive Top Header Bar -->
    <header class="stevie-canvas__header">
      <div class="stevie-canvas__brand">
        <div class="stevie-canvas__brand-text">
          <span class="stevie-canvas__brand-title">STEVIE AWARDS INTELLIGENCE</span>
          <span class="stevie-canvas__brand-status">
            <span class="stevie-canvas__status-dot"></span>
            Official Knowledge Engine
          </span>
        </div>
      </div>
      <div class="stevie-canvas__header-actions">
        <div
          class="stevie-profile"
          id="stevie-profile"
          hidden
        >
          <button
            type="button"
            class="stevie-profile__btn"
            id="stevie-profile-btn"
            aria-expanded="false"
            aria-controls="stevie-profile-panel"
            title="Your details"
          >
            <span
              class="stevie-profile__avatar"
              id="stevie-profile-initials"
              aria-hidden="true"
            ></span>
            <span
              class="stevie-profile__name"
              id="stevie-profile-name"
            ></span>
          </button>
          <div
            class="stevie-profile__panel"
            id="stevie-profile-panel"
            role="dialog"
            aria-label="Your details"
            hidden
          >
            <p class="stevie-profile__panel-label">Chatting as</p>
            <p
              class="stevie-profile__panel-name"
              id="stevie-profile-panel-name"
            >
            </p>
            <p
              class="stevie-profile__panel-email"
              id="stevie-profile-panel-email"
            >
            </p>
            <button
              type="button"
              class="stevie-profile__switch"
              id="stevie-profile-switch"
            >
              Switch user
            </button>
          </div>
        </div>
        <button
          type="button"
          class="stevie-canvas__btn-reset"
          id="stevie-chatbot-reset"
          title="Start a fresh conversation"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
          </svg>
          <span>New Session</span>
        </button>
      </div>
    </header>

    <!-- Main Stage / Conversation Feed with consistent height -->
    <div
      class="stevie-canvas__stage"
      data-stage
      id="stevie-chatbot-transcript"
      role="log"
      aria-live="polite"
    >
      <!-- Initial Hero (Visible inside stage, collapses once conversation starts) -->
      <div
        class="stevie-canvas__hero"
        id="stevie-canvas-hero"
      >
        <h1 class="stevie-canvas__hero-title">{heading}</h1>
        <p class="stevie-canvas__hero-subtitle">{text}</p>

        <!-- Quick Discovery Starter Inquiries -->
        <div class="stevie-canvas__starters">
          <span class="stevie-canvas__starters-label">Suggested Inquiries</span>
          <div class="stevie-canvas__starters-grid">
            <button
              type="button"
              class="stevie-canvas__starter-btn"
            >
              <span class="stevie-canvas__starter-icon">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><circle
                    cx="12"
                    cy="8"
                    r="6"
                  ></circle><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path></svg
                >
              </span>
              <span>What are Stevie awards</span>
            </button>
            <button
              type="button"
              class="stevie-canvas__starter-btn"
            >
              <span class="stevie-canvas__starter-icon">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><circle
                    cx="12"
                    cy="12"
                    r="10"
                  ></circle><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"
                  ></polygon></svg
                >
              </span>
              <span>Which program should I enter</span>
            </button>
            <button
              type="button"
              class="stevie-canvas__starter-btn"
            >
              <span class="stevie-canvas__starter-icon">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle
                    cx="9"
                    cy="7"
                    r="4"
                  ></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path
                    d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg
                >
              </span>
              <span>How to nominate myself/my organization</span>
            </button>
            <button
              type="button"
              class="stevie-canvas__starter-btn"
            >
              <span class="stevie-canvas__starter-icon">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle
                    cx="8.5"
                    cy="7"
                    r="4"
                  ></circle><polyline points="17 11 19 13 23 9"></polyline></svg
                >
              </span>
              <span>How can I become a judge</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Live Messages Stream Container -->
      <div
        class="stevie-canvas__feed"
        id="stevie-chatbot-feed"
      >
      </div>
    </div>

    <!-- Executive Bottom Floating Composer Dock -->
    <div
      class="stevie-canvas__dock-container"
      id="stevie-chatbot-composer"
    >
      <div class="stevie-canvas__dock">
        <label
          class="stevie-canvas__dock-label"
          for="stevie-chatbot-input"
          >Ask a question</label
        >
        <div class="stevie-canvas__dock-row">
          <input
            id="stevie-chatbot-input"
            class="stevie-canvas__dock-input"
            type="text"
            name="question"
            placeholder={placeholder}
            autocomplete="off"
            maxlength="600"
          />
          <button
            class="stevie-canvas__dock-submit"
            type="button"
            aria-label={buttonLabel}
          >
            <svg
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line
                x1="12"
                y1="19"
                x2="12"
                y2="5"
              ></line>
              <polyline points="5 12 12 5 19 12"></polyline>
            </svg>
          </button>
        </div>
      </div>
      <div class="stevie-canvas__dock-footnote">Official Stevie Awards Assistant</div>
    </div>
    <!-- Feedback Modal Popup -->
    <div
      class="stevie-modal-backdrop"
      id="stevie-feedback-modal"
      hidden
    >
      <div
        class="stevie-modal-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="stevie-feedback-title"
      >
        <div class="stevie-modal-header">
          <div class="stevie-modal-title-wrap">
            <span class="stevie-modal-icon">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><circle
                  cx="12"
                  cy="12"
                  r="10"
                ></circle><line
                  x1="12"
                  y1="8"
                  x2="12"
                  y2="12"
                ></line><line
                  x1="12"
                  y1="16"
                  x2="12.01"
                  y2="16"
                ></line></svg
              >
            </span>
            <h3
              id="stevie-feedback-title"
              class="stevie-modal-title"
            >
              Help Us Improve This Answer
            </h3>
          </div>
          <button
            type="button"
            class="stevie-modal-close"
            data-modal-close
            aria-label="Close feedback modal"
            >&times;</button
          >
        </div>
        <form
          class="stevie-modal-body"
          id="stevie-feedback-form"
        >
          <p class="stevie-modal-desc">
            We're sorry this response didn't meet your expectations. Tell us what went wrong, and we
            will automatically open a support ticket with our team.
          </p>
          <input
            type="hidden"
            id="stevie-feedback-id"
            value=""
          />
          <input
            type="hidden"
            id="stevie-feedback-query"
            value=""
          />
          <input
            type="hidden"
            id="stevie-feedback-answer"
            value=""
          />

          <div class="stevie-form-group">
            <label
              for="stevie-feedback-name"
              class="stevie-form-label"
              >Your Name <span class="stevie-required">*</span></label
            >
            <input
              type="text"
              id="stevie-feedback-name"
              class="stevie-form-input"
              placeholder="e.g. Jane Doe"
              required
            />
          </div>

          <div class="stevie-form-group">
            <label
              for="stevie-feedback-email"
              class="stevie-form-label"
              >Your Email <span class="stevie-required">*</span>
              <span class="stevie-optional">(so we can follow up on your ticket)</span></label
            >
            <input
              type="email"
              id="stevie-feedback-email"
              class="stevie-form-input"
              placeholder="e.g. jane@company.com"
              required
            />
          </div>

          <div class="stevie-form-group">
            <label
              for="stevie-feedback-comments"
              class="stevie-form-label"
              >Feedback Details <span class="stevie-required">*</span></label
            >
            <textarea
              id="stevie-feedback-comments"
              class="stevie-form-textarea"
              rows="3"
              placeholder="Tell us what was inaccurate, missing, or how this response could be improved..."
              required
            ></textarea>
          </div>

          <div class="stevie-modal-footer">
            <button
              type="button"
              class="stevie-modal-btn is-secondary"
              data-modal-close
              >Cancel</button
            >
            <button
              type="submit"
              class="stevie-modal-btn is-primary"
              id="stevie-feedback-submit-btn"
            >
              <span>Submit & Create Ticket</span>
            </button>
          </div>
        </form>
        <div
          class="stevie-modal-success"
          id="stevie-feedback-success"
          hidden
        >
          <div class="stevie-modal-success-icon">
            <svg
              width="32"
              height="32"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#0b6e6e"
              stroke-width="2.2"
              ><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline
                points="22 4 12 14.01 9 11.01"></polyline></svg
            >
          </div>
          <h4 class="stevie-modal-success-title">Thank You!</h4>
          <p
            class="stevie-modal-success-copy"
            id="stevie-feedback-success-msg"
          >
            Your feedback has been recorded and submitted to our support team.
          </p>
          <button
            type="button"
            class="stevie-modal-btn is-primary"
            data-modal-close
            >Done</button
          >
        </div>
      </div>
    </div>
  </div>
</CustomSection>

<script define:vars={{ apiUrl, apiKey, showSources }}>
  // Automatically route to local chatbot API if on localhost/127.0.0.1
  const effectiveApiUrl =
    typeof window !== "undefined" &&
    (window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1")
      ? "http://127.0.0.1:8003"
      : apiUrl;

  const TIERS = {
    profile: ["is-records", "Official Winner Records"],
    totals: ["is-records", "Stevie Awards Database"],
    tier1: ["is-verified", "Verified Program Information"],
    tier2a: ["is-live", "Official Stevie Awards Site"],
    tier2b: ["is-web", "External Web Reference"],
  };

  function getTierSvg(tierClass) {
    if (tierClass === "is-records") {
      return '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"></circle><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path></svg>';
    }
    if (tierClass === "is-verified") {
      return '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>';
    }
    return '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>';
  }

  const HISTORY_TURNS = 30;
  const history = [];

  const root = document.getElementById("stevie-canvas-root");
  const hero = document.getElementById("stevie-canvas-hero");
  const composer = document.getElementById("stevie-chatbot-composer");
  const resetBtn = document.getElementById("stevie-chatbot-reset");

  if (composer && root) {
    const input = document.getElementById("stevie-chatbot-input");
    const transcript = document.getElementById("stevie-chatbot-transcript");
    const submitBtn = composer.querySelector(".stevie-canvas__dock-submit");

    const escapeHtml = (value) =>
      String(value ?? "").replace(
        /[&<>"']/g,
        (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char]
      );

    const stage = document.getElementById("stevie-chatbot-transcript");
    const feed = document.getElementById("stevie-chatbot-feed") || stage;

    function push(el) {
      if (root) root.classList.add("has-conversation");
      feed.appendChild(el);
      return el;
    }

    function userMessage(question) {
      const el = document.createElement("div");
      el.className = "stevie-msg is-user";
      el.innerHTML = `
        <div class="stevie-msg__user-bubble">
          <div class="stevie-msg__user-text">${escapeHtml(question)}</div>
        </div>`;
      return push(el);
    }

    function pendingMessage() {
      const el = document.createElement("div");
      el.className = "stevie-msg is-bot is-pending";
      el.innerHTML = `
        <div class="stevie-msg__card" data-theme="light">
          <div class="stevie-msg__thinking">
            <span class="stevie-msg__thinking-dots">
              <i></i><i></i><i></i>
            </span>
            <span class="stevie-msg__thinking-label">Consulting Stevie Awards knowledge engine...</span>
          </div>
        </div>`;
      return push(el);
    }

    const normalizeSources = (rawSources) => {
      const list = Array.isArray(rawSources) ? rawSources : [];
      const out = [];
      const seen = new Set();
      for (const s of list) {
        const str = String(s || "").trim();
        if (!str || seen.has(str)) continue;
        seen.add(str);
        // Citations show live website links only -- a database record count or
        // internal-catalog description (e.g. "Official Stevie Awards Database
        // (83,021 Records)") isn't a link a visitor can open, so it's dropped
        // here rather than shown as a non-clickable citation chip.
        if (/^https?:\/\//i.test(str)) {
          out.push({ isUrl: true, href: str, label: linkLabel(str) });
        }
      }
      if (!out.length) {
        out.push({
          isUrl: true,
          href: "https://stevieawards.com",
          label: "stevieawards.com/official-program-rules",
        });
      }
      return out;
    };

    function linkLabel(url) {
      try {
        const u = new URL(url);
        const parts = u.pathname.split("/").filter(Boolean);
        const tail = parts.length ? "/" + parts[parts.length - 1] : "";
        const trimmed = tail.length > 40 ? tail.slice(0, 40) + "…" : tail;
        return u.hostname + (parts.length > 1 ? "/…" : "") + trimmed;
      } catch {
        return url;
      }
    }

    function formatInline(str) {
      return String(str || "")
        .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
        .replace(/__(.+?)__/g, "<strong>$1</strong>")
        .replace(/\*([^\*\n]+)\*/g, "<em>$1</em>")
        .replace(/_([^_\n]+)_/g, "<em>$1</em>")
        .replace(/`([^`\n]+)`/g, '<code class="stevie-code">$1</code>')
        .replace(
          /\[([^\]]+)\]\((https?:\/\/[^\s\)]+)\)/g,
          '<a class="stevie-link" href="$2" target="_blank" rel="noopener noreferrer">$1</a>'
        );
    }

    function renderKpiBlock(lines) {
      const items = [];
      for (const line of lines) {
        const trimmed = line.trim();
        if (!trimmed) continue;
        let p1 = "",
          p2 = "";
        if (trimmed.includes("|")) {
          const parts = trimmed.split("|").map((p) => p.trim());
          p1 = parts[0];
          p2 = parts[1];
        } else if (trimmed.includes(":")) {
          const parts = trimmed.split(":").map((p) => p.trim());
          p1 = parts[0];
          p2 = parts.slice(1).join(":");
        }
        if (p1 && p2) {
          if (/[\d]/.test(p2) && !/[\d]/.test(p1)) {
            items.push({ val: p2, label: p1 });
          } else {
            items.push({ val: p1, label: p2 });
          }
        }
      }
      if (!items.length) return "";
      let html = '<div class="stevie-kpi-grid">';
      for (const it of items) {
        const isLong = it.val.length > 10 || /[@\/\.]/.test(it.val);
        html += `
          <div class="stevie-kpi-card">
            <div class="stevie-kpi-card__val ${isLong ? "is-long" : ""}">${escapeHtml(it.val)}</div>
            <div class="stevie-kpi-card__label">${escapeHtml(it.label)}</div>
          </div>`;
      }
      html += "</div>";
      return html;
    }

    function renderTimelineBlock(lines) {
      let title = "";
      const items = [];
      for (const line of lines) {
        const trimmed = line.trim();
        if (!trimmed) continue;
        if (/^title\s*:\s*(.+)$/i.test(trimmed)) {
          title = trimmed.replace(/^title\s*:\s*/i, "").trim();
          continue;
        }
        const parts = trimmed.split("|").map((p) => p.trim());
        if (parts.length >= 2) {
          items.push({
            date: parts[0],
            title: parts[1],
            status: (parts[2] || "upcoming").toLowerCase(),
          });
        }
      }
      if (!items.length) return "";
      let html = '<div class="stevie-timeline-card">';
      if (title) {
        html += `<div class="stevie-timeline-card__header"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg><span class="stevie-timeline-card__title">${escapeHtml(title)}</span></div>`;
      }
      html += '<div class="stevie-timeline">';
      for (const it of items) {
        const statusClass =
          it.status.includes("done") || it.status.includes("passed")
            ? "is-done"
            : it.status.includes("active") || it.status.includes("open")
              ? "is-active"
              : "is-upcoming";
        html += `
          <div class="stevie-timeline__item ${statusClass}">
            <div class="stevie-timeline__marker"></div>
            <div class="stevie-timeline__content">
              <span class="stevie-timeline__date">${escapeHtml(it.date)}</span>
              <span class="stevie-timeline__desc">${escapeHtml(it.title)}</span>
            </div>
          </div>`;
      }
      html += "</div></div>";
      return html;
    }

    function renderAccordionBlock(lines) {
      let title = "More Information";
      const bodyLines = [];
      for (const line of lines) {
        const trimmed = line.trim();
        if (/^title\s*:\s*(.+)$/i.test(trimmed)) {
          title = trimmed.replace(/^title\s*:\s*/i, "").trim();
        } else if (trimmed) {
          bodyLines.push(line);
        }
      }
      const renderedBody = renderRichMarkdown(bodyLines.join("\n"));
      return `
        <details class="stevie-accordion">
          <summary class="stevie-accordion__summary">${escapeHtml(title)}</summary>
          <div class="stevie-accordion__body">${renderedBody}</div>
        </details>`;
    }

    function renderProgramsBlock(lines) {
      const items = [];
      for (const line of lines) {
        const trimmed = line.trim();
        if (!trimmed) continue;
        const parts = trimmed.split("|").map((p) => p.trim());
        if (parts.length >= 1) {
          items.push({ name: parts[0], tags: parts.slice(1) });
        }
      }
      if (!items.length) return "";
      let html = '<div class="stevie-programs-grid">';
      for (const p of items) {
        const q = `Tell me about the ${p.name} and how to enter`;
        html += `
          <div class="stevie-program-card is-interactive" role="button" tabindex="0" data-query="${escapeHtml(q)}" aria-label="Select ${escapeHtml(p.name)}">
            <div class="stevie-program-card__header">
              <div class="stevie-program-card__name">${escapeHtml(p.name)}</div>
              <div class="stevie-program-card__action">
                <span class="stevie-program-card__prompt">Select</span>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </div>
            </div>
            <div class="stevie-program-card__tags">${p.tags.map((t) => `<span class="stevie-tag">${escapeHtml(t)}</span>`).join("")}</div>
          </div>`;
      }
      html += "</div>";
      return html;
    }

    function renderOptionsBlock(lines) {
      let title = "";
      let isMulti = false;
      const items = [];

      for (const line of lines) {
        const trimmed = line.trim();
        if (!trimmed) continue;
        if (/^title\s*:\s*(.+)$/i.test(trimmed)) {
          title = trimmed.replace(/^title\s*:\s*/i, "").trim();
          continue;
        }
        if (/^mode\s*:\s*(.+)$/i.test(trimmed)) {
          const modeVal = trimmed
            .replace(/^mode\s*:\s*/i, "")
            .trim()
            .toLowerCase();
          isMulti = modeVal === "multi" || modeVal === "multiple" || modeVal === "checkbox";
          continue;
        }
        if (/^(?:type|directive|setting)\s*:/i.test(trimmed)) {
          continue;
        }
        const parts = trimmed.split("|").map((p) => p.trim());
        if (parts.length >= 1 && parts[0]) {
          // Extra guard: ignore if label is a stray directive like 'mode: single'
          if (/^mode\s*:/i.test(parts[0])) continue;
          items.push({
            label: parts[0],
            desc: parts[1] || "",
            query: parts[2] || parts[0],
          });
        }
      }
      if (!items.length) return "";

      let html = `<div class="stevie-options-container ${isMulti ? "is-multi" : "is-single"}">`;
      if (title) {
        html += `<div class="stevie-options-title">${escapeHtml(title)}</div>`;
      }
      html += '<div class="stevie-options-grid">';
      for (const opt of items) {
        html += `
          <div class="stevie-option-card" role="button" tabindex="0" data-query="${escapeHtml(opt.query)}" data-label="${escapeHtml(opt.label)}">
            <div class="stevie-option-card__indicator">
              ${isMulti ? '<span class="stevie-checkbox"></span>' : '<span class="stevie-radio"></span>'}
            </div>
            <div class="stevie-option-card__content">
              <div class="stevie-option-card__label">${escapeHtml(opt.label)}</div>
              ${opt.desc ? `<div class="stevie-option-card__desc">${escapeHtml(opt.desc)}</div>` : ""}
            </div>
            <div class="stevie-option-card__chevron">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
          </div>`;
      }
      html += "</div>";
      if (isMulti) {
        html += `
          <div class="stevie-options-actions">
            <button type="button" class="stevie-options-submit" disabled>
              <span>Continue with Selected (0)</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          </div>`;
      }
      html += "</div>";
      return html;
    }

    function renderChipsBlock(lines) {
      const chips = [];
      for (const line of lines) {
        const trimmed = line.trim().replace(/^[\*\-•]\s*/, "");
        if (trimmed) chips.push(trimmed);
      }
      if (!chips.length) return "";
      let html = '<div class="stevie-chips-wrap">';
      html += '<span class="stevie-chips-label">Explore Next:</span>';
      html += '<div class="stevie-chips">';
      for (const c of chips) {
        html += `<button type="button" class="stevie-chip" data-query="${escapeHtml(c)}">${escapeHtml(c)}</button>`;
      }
      html += "</div></div>";
      return html;
    }

    function renderChartBlock(lines) {
      let title = "Data Comparison";
      const items = [];
      const colors = ["#0b6e6e", "#0284c7", "#d97706", "#7c3aed", "#059669", "#dc2626", "#4f46e5"];

      for (const line of lines) {
        const trimmed = line.trim();
        if (!trimmed) continue;
        if (/^title\s*:\s*(.+)$/i.test(trimmed)) {
          title = trimmed.replace(/^title\s*:\s*/i, "").trim();
          continue;
        }
        if (/^type\s*:/i.test(trimmed)) continue;

        const m = trimmed.match(/^([^:]+?)\s*[:=\-]\s*([\d,]+(?:\.\d+)?)\s*(?:%|awards?|wins?)?$/i);
        if (m) {
          const label = m[1].trim();
          const num = parseFloat(m[2].replace(/,/g, ""));
          if (!isNaN(num)) items.push({ label, val: num });
        }
      }
      if (!items.length) return "";

      const maxVal = Math.max(...items.map((i) => i.val)) || 1;
      const getColor = (lbl, idx) => {
        const l = lbl.toLowerCase();
        if (l.includes("gold")) return "linear-gradient(90deg, #d4af37, #f6d365)";
        if (l.includes("silver")) return "linear-gradient(90deg, #8a9ba8, #bdc3c7)";
        if (l.includes("bronze")) return "linear-gradient(90deg, #b87333, #e67e22)";
        if (l.includes("grand")) return "linear-gradient(90deg, #6b21a8, #a855f7)";
        const base = colors[idx % colors.length];
        return `linear-gradient(90deg, ${base}, color-mix(in srgb, ${base} 75%, #ffffff))`;
      };

      let html = '<div class="stevie-chart-card">';
      html += `<div class="stevie-chart-card__header"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg><span class="stevie-chart-card__title">${escapeHtml(title)}</span></div>`;
      html += '<div class="stevie-chart-card__list">';

      items.forEach((item, idx) => {
        const pct = Math.max(Math.round((item.val / maxVal) * 100), 2);
        const bg = getColor(item.label, idx);
        html += `
          <div class="stevie-chart-item">
            <div class="stevie-chart-item__meta">
              <span class="stevie-chart-item__label">${escapeHtml(item.label)}</span>
              <span class="stevie-chart-item__val">${item.val.toLocaleString()}</span>
            </div>
            <div class="stevie-chart-item__track">
              <div class="stevie-chart-item__bar" style="width: ${pct}%; background: ${bg};"></div>
            </div>
          </div>`;
      });
      html += "</div></div>";
      return html;
    }

    function renderRichMarkdown(md) {
      if (!md) return "";
      const rawLines = String(md).replace(/\r\n/g, "\n").split("\n");
      const out = [];
      let i = 0;

      while (i < rawLines.length) {
        const line = rawLines[i];
        const trimmed = line.trim();

        if (!trimmed) {
          i++;
          continue;
        }

        // 1. KPI Stat Cards
        if (/^`{3,}\s*(?:kpi|stats)/i.test(trimmed)) {
          const kpiLines = [];
          i++;
          while (i < rawLines.length && !/^`{3,}\s*$/.test(rawLines[i].trim())) {
            kpiLines.push(rawLines[i]);
            i++;
          }
          if (i < rawLines.length && /^`{3,}\s*$/.test(rawLines[i].trim())) i++;
          const kpiHtml = renderKpiBlock(kpiLines);
          if (kpiHtml) out.push(kpiHtml);
          continue;
        }

        // 2. Timeline Block
        if (/^`{3,}\s*timeline/i.test(trimmed)) {
          const timeLines = [];
          i++;
          while (i < rawLines.length && !/^`{3,}\s*$/.test(rawLines[i].trim())) {
            timeLines.push(rawLines[i]);
            i++;
          }
          if (i < rawLines.length && /^`{3,}\s*$/.test(rawLines[i].trim())) i++;
          const timeHtml = renderTimelineBlock(timeLines);
          if (timeHtml) out.push(timeHtml);
          continue;
        }

        // 3. Accordion Block
        if (/^`{3,}\s*accordion/i.test(trimmed)) {
          const accLines = [];
          i++;
          while (i < rawLines.length && !/^`{3,}\s*$/.test(rawLines[i].trim())) {
            accLines.push(rawLines[i]);
            i++;
          }
          if (i < rawLines.length && /^`{3,}\s*$/.test(rawLines[i].trim())) i++;
          const accHtml = renderAccordionBlock(accLines);
          if (accHtml) out.push(accHtml);
          continue;
        }

        // 4. Interactive Programs Block
        if (/^`{3,}\s*programs/i.test(trimmed)) {
          const progLines = [];
          i++;
          while (i < rawLines.length && !/^`{3,}\s*$/.test(rawLines[i].trim())) {
            progLines.push(rawLines[i]);
            i++;
          }
          if (i < rawLines.length && /^`{3,}\s*$/.test(rawLines[i].trim())) i++;
          const progHtml = renderProgramsBlock(progLines);
          if (progHtml) out.push(progHtml);
          continue;
        }

        // 5. Interactive Options / Choices Block
        if (/^`{3,}\s*(?:options|select|choices)/i.test(trimmed)) {
          const optLines = [];
          i++;
          while (i < rawLines.length && !/^`{3,}\s*$/.test(rawLines[i].trim())) {
            optLines.push(rawLines[i]);
            i++;
          }
          if (i < rawLines.length && /^`{3,}\s*$/.test(rawLines[i].trim())) i++;
          const optHtml = renderOptionsBlock(optLines);
          if (optHtml) out.push(optHtml);
          continue;
        }

        // 6. Follow-Up Chips Block
        if (/^`{3,}\s*(?:chips|suggested|followups)/i.test(trimmed)) {
          const chipLines = [];
          i++;
          while (i < rawLines.length && !/^`{3,}\s*$/.test(rawLines[i].trim())) {
            chipLines.push(rawLines[i]);
            i++;
          }
          if (i < rawLines.length && /^`{3,}\s*$/.test(rawLines[i].trim())) i++;
          const chipHtml = renderChipsBlock(chipLines);
          if (chipHtml) out.push(chipHtml);
          continue;
        }

        // 7. Chart Code Blocks
        if (/^`{3,}\s*(?:chart|graph)/i.test(trimmed)) {
          const chartLines = [];
          i++;
          while (i < rawLines.length && !/^`{3,}\s*$/.test(rawLines[i].trim())) {
            chartLines.push(rawLines[i]);
            i++;
          }
          if (i < rawLines.length && /^`{3,}\s*$/.test(rawLines[i].trim())) i++;
          const chartHtml = renderChartBlock(chartLines);
          if (chartHtml) out.push(chartHtml);
          continue;
        }

        // 8. Generic Code Block Fallback (safely consumes any other ``` block to prevent hang)
        if (/^`{3,}/.test(trimmed)) {
          const genericLines = [];
          i++;
          while (i < rawLines.length && !/^`{3,}\s*$/.test(rawLines[i].trim())) {
            genericLines.push(rawLines[i]);
            i++;
          }
          if (i < rawLines.length && /^`{3,}\s*$/.test(rawLines[i].trim())) i++;
          out.push(
            `<pre class="stevie-code"><code>${escapeHtml(genericLines.join("\n"))}</code></pre>`
          );
          continue;
        }

        // 9. Executive Insight Insets (> [!TIP], > [!IMPORTANT], etc.)
        if (/^>\s*\[!(TIP|NOTE|IMPORTANT|WARNING|CAUTION)\]/i.test(trimmed)) {
          const typeMatch = trimmed.match(
            /^>\s*\[!(TIP|NOTE|IMPORTANT|WARNING|CAUTION)\]\s*(.*)$/i
          );
          const calloutType = (typeMatch ? typeMatch[1] : "NOTE").toLowerCase();
          const firstLineText = typeMatch && typeMatch[2] ? typeMatch[2].trim() : "";
          const calloutLines = [];
          if (firstLineText) calloutLines.push(firstLineText);
          i++;
          while (i < rawLines.length) {
            const nextL = rawLines[i].trim();
            if (/^>\s*\[!(TIP|NOTE|IMPORTANT|WARNING|CAUTION)\]/i.test(nextL)) {
              break;
            }
            if (nextL.startsWith(">")) {
              const cleaned = nextL.replace(/^>\s?/, "").trim();
              if (cleaned) calloutLines.push(cleaned);
              i++;
            } else if (
              nextL === "" &&
              i + 1 < rawLines.length &&
              rawLines[i + 1].trim().startsWith(">")
            ) {
              i++;
            } else if (
              calloutLines.length > 0 &&
              nextL !== "" &&
              !/^[#`\*\-•]/.test(nextL) &&
              !nextL.startsWith("|")
            ) {
              // Continuation line inside callout
              calloutLines.push(nextL);
              i++;
            } else {
              break;
            }
          }

          if (!calloutLines.length) {
            // Guard: do not render an empty box if there is no text
            continue;
          }

          let svgIcon = "";
          let badgeText = "EXECUTIVE INSIGHT";
          if (calloutType === "tip") {
            badgeText = "EXECUTIVE INSIGHT";
            svgIcon =
              '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>';
          } else if (calloutType === "important") {
            badgeText = "KEY REQUIREMENT";
            svgIcon =
              '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>';
          } else if (calloutType === "warning" || calloutType === "caution") {
            badgeText = "COMPLIANCE ADVISORY";
            svgIcon =
              '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>';
          } else {
            badgeText = "OFFICIAL GUIDELINES";
            svgIcon =
              '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>';
          }

          const innerText = formatInline(escapeHtml(calloutLines.join(" ")));
          out.push(`
            <div class="stevie-insight is-${calloutType}">
              <div class="stevie-insight__header">
                <span class="stevie-insight__badge">${svgIcon}<span>${badgeText}</span></span>
              </div>
              <div class="stevie-insight__content">${innerText}</div>
            </div>`);
          continue;
        }

        // 10. Horizontal Rule
        if (/^(?:---|\*\*\*|___)$/.test(trimmed)) {
          out.push('<hr class="stevie-divider" />');
          i++;
          continue;
        }

        // 11. Markdown Headings (# H1, ## H2, ### H3, #### H4)
        const headingMatch = trimmed.match(/^(#{1,4})\s+(.+)$/);
        if (headingMatch) {
          const level = headingMatch[1].length;
          const text = formatInline(escapeHtml(headingMatch[2]));
          const tag = level === 1 ? "h2" : level === 2 ? "h3" : "h4";
          out.push(`<${tag} class="stevie-${tag}">${text}</${tag}>`);
          i++;
          continue;
        }

        // 12. Implicit Section Titles
        if (
          /^(?:The \d+-Step|Key Takeaways|Judging Process|Overview|Step-by-Step|Criteria|Eligibility|Key Program Highlights)/i.test(
            trimmed
          ) &&
          trimmed.length <= 60 &&
          !trimmed.endsWith(".")
        ) {
          const text = formatInline(escapeHtml(trimmed.replace(/:$/, "")));
          out.push(`<h3 class="stevie-h3 stevie-section-heading">${text}</h3>`);
          i++;
          continue;
        }

        // 13. Markdown Tables
        if (trimmed.startsWith("|") && trimmed.endsWith("|")) {
          const tableLines = [];
          while (
            i < rawLines.length &&
            rawLines[i].trim().startsWith("|") &&
            rawLines[i].trim().endsWith("|")
          ) {
            tableLines.push(rawLines[i].trim());
            i++;
          }
          if (tableLines.length >= 2) {
            const parseRow = (r) =>
              r
                .split("|")
                .slice(1, -1)
                .map((c) => formatInline(escapeHtml(c.trim())));
            const headers = parseRow(tableLines[0]);
            const isSep = /^\|(?::?-+:?\|)+$/.test(tableLines[1].replace(/\s+/g, ""));
            const startBody = isSep ? 2 : 1;

            let tableHtml = '<div class="stevie-table-wrap"><table class="stevie-table">';
            tableHtml +=
              "<thead><tr>" + headers.map((h) => `<th>${h}</th>`).join("") + "</tr></thead><tbody>";
            for (let b = startBody; b < tableLines.length; b++) {
              const cells = parseRow(tableLines[b]);
              tableHtml += "<tr>" + cells.map((c) => `<td>${c}</td>`).join("") + "</tr>";
            }
            tableHtml += "</tbody></table></div>";
            out.push(tableHtml);
            continue;
          }
        }

        // 14. Unordered Lists
        if (/^[\*\-•]\s+/.test(trimmed)) {
          let listHtml = '<ul class="stevie-list">';
          while (i < rawLines.length) {
            const l = rawLines[i];
            const t = l.trim();
            if (/^[\*\-•]\s+/.test(t)) {
              let clean = t.replace(/^[\*\-•]\s+/, "");
              if (
                /^([A-Z][A-Za-z0-9\s\/\-&]{1,30}):\s+(.+)$/.test(clean) &&
                !clean.startsWith("**")
              ) {
                clean = clean.replace(/^([A-Z][A-Za-z0-9\s\/\-&]{1,30}):\s+(.+)$/, "**$1:** $2");
              }
              const itemText = formatInline(escapeHtml(clean));
              listHtml += `<li>${itemText}</li>`;
              i++;
            } else if (/^\s{2,}[\*\-•]\s+/.test(l)) {
              let clean = t.replace(/^[\*\-•]\s+/, "");
              if (
                /^([A-Z][A-Za-z0-9\s\/\-&]{1,30}):\s+(.+)$/.test(clean) &&
                !clean.startsWith("**")
              ) {
                clean = clean.replace(/^([A-Z][A-Za-z0-9\s\/\-&]{1,30}):\s+(.+)$/, "**$1:** $2");
              }
              const subText = formatInline(escapeHtml(clean));
              listHtml += `<li class="stevie-nested-li">${subText}</li>`;
              i++;
            } else if (
              l.trim() === "" &&
              i + 1 < rawLines.length &&
              /^[\*\-•]\s+/.test(rawLines[i + 1].trim())
            ) {
              i++;
            } else {
              break;
            }
          }
          listHtml += "</ul>";
          out.push(listHtml);
          continue;
        }

        // 15. Ordered Lists with Badges
        if (/^\d+\.\s+/.test(trimmed)) {
          let olistHtml = '<ol class="stevie-olist">';
          while (i < rawLines.length) {
            const t = rawLines[i].trim();
            if (/^\d+\.\s+/.test(t)) {
              const numMatch = t.match(/^(\d+)\.\s+(.+)$/);
              const stepNum = numMatch ? numMatch[1] : "";
              const itemText = formatInline(
                escapeHtml(numMatch ? numMatch[2] : t.replace(/^\d+\.\s+/, ""))
              );
              olistHtml += `<li class="stevie-olist__item"><span class="stevie-olist__badge">${stepNum}</span><div class="stevie-olist__content">${itemText}</div></li>`;
              i++;
            } else if (
              rawLines[i].trim() === "" &&
              i + 1 < rawLines.length &&
              /^\d+\.\s+/.test(rawLines[i + 1].trim())
            ) {
              i++;
            } else {
              break;
            }
          }
          olistHtml += "</ol>";
          out.push(olistHtml);
          continue;
        }

        // 16. Paragraphs
        const pLines = [];
        const startI = i;
        while (i < rawLines.length) {
          const l = rawLines[i];
          const t = l.trim();
          if (
            !t ||
            /^`{3,}/.test(t) ||
            /^~{3,}/.test(t) ||
            t.startsWith(">") ||
            /^(?:---|\*\*\*|___)$/.test(t) ||
            /^(#{1,4})\s+/.test(t) ||
            /^[\*\-•]\s+/.test(t) ||
            /^\d+\.\s+/.test(t) ||
            (t.startsWith("|") && t.endsWith("|"))
          ) {
            break;
          }
          pLines.push(formatInline(escapeHtml(t)));
          i++;
        }
        if (pLines.length) {
          out.push(`<p class="stevie-p">${pLines.join("<br />")}</p>`);
        }
        // Safety: Always advance if nothing consumed to prevent any infinite loop
        if (i === startI) {
          i++;
        }
      }

      return out.join("");
    }

    function fillAnswer(el, data) {
      const [badgeClass, badgeLabel] = TIERS[data.tier] || ["is-other", data.label || ""];
      const sources = showSources ? normalizeSources(data.sources) : [];

      el.className = "stevie-msg is-bot";
      el.innerHTML = `
        <div class="stevie-msg__card" data-theme="light">
          <div class="stevie-msg__meta-bar">
            ${badgeLabel ? `<span class="stevie-badge ${badgeClass}">${getTierSvg(badgeClass)}<span>${escapeHtml(badgeLabel)}</span></span>` : ""}
            <span class="stevie-msg__timestamp">Live Response</span>
          </div>
          ${data.rewritten ? `<p class="stevie-rewritten">Answering context: ${escapeHtml(data.rewritten)}</p>` : ""}
          <div class="stevie-body">${renderRichMarkdown(data.answer || "")}</div>
          ${
            sources.length
              ? `
            <div class="stevie-sources-bar">
              <div class="stevie-sources-bar__header">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                <span>Verified Official Sources & Citations (${sources.length})</span>
              </div>
              <div class="stevie-sources-bar__chips">
                ${sources
                  .map((s, idx) =>
                    s.isUrl
                      ? `
                  <a href="${escapeHtml(s.href)}" target="_blank" rel="noopener noreferrer" class="stevie-source-chip">
                    <span class="stevie-source-chip__num">[${idx + 1}]</span>
                    <span class="stevie-source-chip__text">${escapeHtml(s.label)}</span>
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                  </a>`
                      : `
                  <span class="stevie-source-chip is-db">
                    <span class="stevie-source-chip__num">[${idx + 1}]</span>
                    <span class="stevie-source-chip__text">${escapeHtml(s.label)}</span>
                  </span>`
                  )
                  .join("")}
              </div>
            </div>`
              : ""
          }
          <div class="stevie-feedback-bar" data-feedback-bar>
            <span class="stevie-feedback-label">Was this answer helpful?</span>
            <div class="stevie-feedback-actions">
              <button type="button" class="stevie-feedback-btn is-up" data-feedback-action="thumbs_up" title="Helpful" aria-label="Thumbs up">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10v12"></path><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h3"></path><path d="m7 10 5-5.5a2 2 0 0 1 3 1.38z"></path></svg>
                <span>Helpful</span>
              </button>
              <button type="button" class="stevie-feedback-btn is-down" data-feedback-action="thumbs_down" title="Not helpful" aria-label="Thumbs down">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 14V2"></path><path d="M9 18.12 10 14H4.17a2 2 0 0 1-1.92-2.56l2.33-8A2 2 0 0 1 6.5 2H20a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-3"></path><path d="m17 14-5 5.5a2 2 0 0 1-3-1.38z"></path></svg>
                <span>Not helpful</span>
              </button>
            </div>
            <span class="stevie-feedback-status" hidden></span>
          </div>
        </div>`;

      // Smoothly scroll inside the stage so the TOP of the new answer is aligned cleanly
      const targetY = Math.max(0, el.offsetTop - 15);
      stage.scrollTo({ top: targetY, behavior: "smooth" });
    }

    function fillError(el, message) {
      el.className = "stevie-msg is-bot has-error";
      el.innerHTML = `
        <div class="stevie-msg__card is-error" data-theme="light">
          <div class="stevie-msg__error-title">System Advisory</div>
          <div class="stevie-body">${escapeHtml(message)}</div>
        </div>`;
    }

    // Click delegation for interactive components (Chips, Program Cards, Option Cards)
    transcript.addEventListener("click", (e) => {
      // 1. Suggested Follow-up Chip clicks
      const chip = e.target.closest(".stevie-chip");
      if (chip && chip.dataset.query && !submitBtn.disabled) {
        input.value = chip.dataset.query.trim();
        ask();
        return;
      }

      // 2. Program Card Click
      const progCard = e.target.closest(".stevie-program-card.is-interactive");
      if (progCard && progCard.dataset.query && !submitBtn.disabled) {
        input.value = progCard.dataset.query.trim();
        ask();
        return;
      }

      // 3. Option Card Click (Single or Multi)
      const optCard = e.target.closest(".stevie-option-card");
      if (optCard && !submitBtn.disabled) {
        const container = optCard.closest(".stevie-options-container");
        if (container && container.classList.contains("is-multi")) {
          optCard.classList.toggle("is-selected");
          const selectedCards = container.querySelectorAll(".stevie-option-card.is-selected");
          const submit = container.querySelector(".stevie-options-submit");
          if (submit) {
            submit.disabled = selectedCards.length === 0;
            submit.querySelector("span").innerText =
              `Continue with Selected (${selectedCards.length})`;
          }
        } else {
          // Single select -> immediately ask
          input.value = optCard.dataset.query
            ? optCard.dataset.query.trim()
            : optCard.dataset.label.trim();
          ask();
        }
        return;
      }

      // 4. Multi-Select Continue Button Click
      const submit = e.target.closest(".stevie-options-submit");
      if (submit && !submit.disabled && !submitBtn.disabled) {
        const container = submit.closest(".stevie-options-container");
        if (container) {
          const selectedLabels = Array.from(
            container.querySelectorAll(".stevie-option-card.is-selected")
          ).map((c) => (c.dataset.label ? c.dataset.label.trim() : c.innerText.trim()));
          if (selectedLabels.length) {
            input.value = `I am interested in: ${selectedLabels.join(", ")}`;
            ask();
          }
        }
        return;
      }

      // 5. Thumbs Up / Down Feedback Click Handling
      const fbBtn = e.target.closest("[data-feedback-action]");
      if (fbBtn) {
        const bar = fbBtn.closest("[data-feedback-bar]");
        const botMsg = bar ? bar.closest(".stevie-msg") : null;
        const action = fbBtn.dataset.feedbackAction;
        const statusEl = bar ? bar.querySelector(".stevie-feedback-status") : null;
        const upBtn = bar ? bar.querySelector(".is-up") : null;
        const downBtn = bar ? bar.querySelector(".is-down") : null;

        if (upBtn) upBtn.disabled = true;
        if (downBtn) downBtn.disabled = true;
        fbBtn.classList.add("is-selected");

        const query = botMsg ? botMsg.dataset.userQuery || "" : "";
        const answerEl = botMsg ? botMsg.querySelector(".stevie-body") : null;
        const answer = answerEl ? answerEl.innerText.slice(0, 3000) : "";

        (async () => {
          try {
            const res = await fetch(`${effectiveApiUrl}/feedback`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                source: "chatbot",
                rating: action,
                query: query,
                response_summary: answer,
              }),
            });
            const data = await res.json();
            const feedbackId = data.feedback_id;

            if (action === "thumbs_up") {
              if (statusEl) {
                statusEl.textContent = "Thank you for your feedback!";
                statusEl.hidden = false;
              }
            } else {
              activeFeedbackBar = bar;
              if (feedbackIdInput) feedbackIdInput.value = feedbackId || "";
              if (feedbackQueryInput) feedbackQueryInput.value = query;
              if (feedbackAnswerInput) feedbackAnswerInput.value = answer;
              if (feedbackModal) {
                feedbackModal.hidden = false;
                setTimeout(() => feedbackNameInput?.focus(), 100);
              }
            }
          } catch (err) {
            console.warn("Feedback error:", err);
            if (action === "thumbs_up" && statusEl) {
              statusEl.textContent = "Thank you!";
              statusEl.hidden = false;
            }
          }
        })();
        return;
      }
    });

    // Feedback Modal elements & handler inside composer scope
    const feedbackModal = document.getElementById("stevie-feedback-modal");
    if (feedbackModal && feedbackModal.parentElement !== document.body) {
      document.body.appendChild(feedbackModal);
    }
    const feedbackForm = document.getElementById("stevie-feedback-form");
    const feedbackSuccess = document.getElementById("stevie-feedback-success");
    const feedbackIdInput = document.getElementById("stevie-feedback-id");
    const feedbackQueryInput = document.getElementById("stevie-feedback-query");
    const feedbackAnswerInput = document.getElementById("stevie-feedback-answer");
    const feedbackNameInput = document.getElementById("stevie-feedback-name");
    const feedbackEmailInput = document.getElementById("stevie-feedback-email");
    const feedbackCommentsInput = document.getElementById("stevie-feedback-comments");
    const feedbackSubmitBtn = document.getElementById("stevie-feedback-submit-btn");
    let activeFeedbackBar = null;

    function closeFeedbackModal() {
      if (!feedbackModal) return;
      feedbackModal.hidden = true;
      if (feedbackForm) {
        feedbackForm.reset();
        feedbackForm.hidden = false;
      }
      if (feedbackSuccess) feedbackSuccess.hidden = true;
      if (feedbackSubmitBtn) feedbackSubmitBtn.disabled = false;
    }

    document.querySelectorAll("#stevie-feedback-modal [data-modal-close]").forEach((btn) => {
      btn.addEventListener("click", closeFeedbackModal);
    });
    feedbackModal?.addEventListener("click", (e) => {
      if (e.target === feedbackModal) closeFeedbackModal();
    });

    feedbackForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const name = (feedbackNameInput?.value || "").trim();
      const email = (feedbackEmailInput?.value || "").trim();
      const comments = (feedbackCommentsInput?.value || "").trim();
      const feedbackId = feedbackIdInput?.value ? parseInt(feedbackIdInput.value, 10) : null;
      const query = feedbackQueryInput?.value || "";
      const answer = feedbackAnswerInput?.value || "";

      if (!name || !email || !comments) return;

      if (feedbackSubmitBtn) {
        feedbackSubmitBtn.disabled = true;
        feedbackSubmitBtn.innerHTML = `<span class="stevie-inline-spin" aria-hidden="true"></span> Submitting...`;
      }

      try {
        const res = await fetch(`${effectiveApiUrl}/feedback/submit`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            feedback_id: feedbackId,
            user_name: name,
            user_email: email || null,
            feedback_text: comments,
            source: "chatbot",
            query: query,
            response_summary: answer,
          }),
        });
        const result = await res.json();

        if (feedbackForm) feedbackForm.hidden = true;
        if (feedbackSuccess) {
          feedbackSuccess.hidden = false;
          const msgEl = document.getElementById("stevie-feedback-success-msg");
          if (msgEl) {
            if (result.ticket_id) {
              msgEl.textContent = `Thank you, ${name}! Your feedback was received and ticket #${result.ticket_id} was opened with our support team.`;
            } else {
              msgEl.textContent = `Thank you, ${name}! Your feedback has been saved and forwarded to our support team.`;
            }
          }
        }
        if (activeFeedbackBar) {
          const statusEl = activeFeedbackBar.querySelector(".stevie-feedback-status");
          if (statusEl) {
            statusEl.textContent = "Ticket created. Thank you!";
            statusEl.hidden = false;
          }
        }
      } catch (err) {
        console.error("Failed to submit detailed feedback:", err);
        alert("Thank you for your feedback! It has been captured.");
        closeFeedbackModal();
      }
    });

    // Keyboard support for cards (Enter or Space)
    transcript.addEventListener("keydown", (e) => {
      if ((e.key === "Enter" || e.key === " ") && !submitBtn.disabled) {
        const target = e.target.closest(".stevie-program-card.is-interactive, .stevie-option-card");
        if (target) {
          e.preventDefault();
          target.click();
        }
      }
    });

    // Starter Discovery Buttons
    if (hero) {
      hero.addEventListener("click", (e) => {
        const btn = e.target.closest(".stevie-canvas__starter-btn");
        if (btn && !submitBtn.disabled) {
          input.value = btn.querySelector("span:last-child")
            ? btn.querySelector("span:last-child").innerText.trim()
            : btn.innerText.trim();
          ask();
        }
      });
    }

    // Reset / New Session Button
    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
        history.length = 0;
        if (feed && feed !== stage) {
          feed.innerHTML = "";
        }
        root.classList.remove("has-conversation");
        input.value = "";
        input.focus();
        stage.scrollTo({ top: 0, behavior: "smooth" });
      });
    }

    // ---------- Identity gate ----------
    // The chat is gated on a name and email so every conversation can be
    // attributed to a person and followed up on. Identity is remembered in
    // localStorage so a returning visitor is not asked again; "Switch user"
    // clears it and opens a fresh session.
    const IDENTITY_KEY = "stevie_chat_identity";
    let chatIdentity = null;

    const gate = document.getElementById("stevie-gate");
    const gateForm = document.getElementById("stevie-gate-form");
    const gateName = document.getElementById("stevie-gate-name");
    const gateEmail = document.getElementById("stevie-gate-email");
    const gateError = document.getElementById("stevie-gate-error");
    const gateSubmit = document.getElementById("stevie-gate-submit");
    const profile = document.getElementById("stevie-profile");
    const profileBtn = document.getElementById("stevie-profile-btn");
    const profilePanel = document.getElementById("stevie-profile-panel");
    const profileInitials = document.getElementById("stevie-profile-initials");
    const profileName = document.getElementById("stevie-profile-name");
    const profilePanelName = document.getElementById("stevie-profile-panel-name");
    const profilePanelEmail = document.getElementById("stevie-profile-panel-email");
    const profileSwitch = document.getElementById("stevie-profile-switch");

    const initialsOf = (name) =>
      String(name || "")
        .trim()
        .split(/\s+/)
        .slice(0, 2)
        .map((part) => part.charAt(0).toUpperCase())
        .join("") || "?";

    function readIdentity() {
      // A private window or blocked site data makes localStorage throw rather
      // than return null, so a failure here must simply mean "not identified".
      try {
        const raw = window.localStorage.getItem(IDENTITY_KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        return parsed && parsed.session_id && parsed.email ? parsed : null;
      } catch {
        return null;
      }
    }

    function storeIdentity(value) {
      try {
        window.localStorage.setItem(IDENTITY_KEY, JSON.stringify(value));
      } catch {
        /* identity still works for this page load, just not the next one */
      }
    }

    function clearIdentity() {
      try {
        window.localStorage.removeItem(IDENTITY_KEY);
      } catch {}
    }

    function paintIdentity() {
      if (!chatIdentity) {
        if (profile) profile.hidden = true;
        if (gate) gate.hidden = false;
        return;
      }
      if (profileInitials) profileInitials.textContent = initialsOf(chatIdentity.name);
      if (profileName) profileName.textContent = chatIdentity.name;
      if (profilePanelName) profilePanelName.textContent = chatIdentity.name;
      if (profilePanelEmail) profilePanelEmail.textContent = chatIdentity.email;
      if (profile) profile.hidden = false;
      if (gate) gate.hidden = true;
    }

    function closeProfilePanel() {
      if (profilePanel) profilePanel.hidden = true;
      if (profileBtn) profileBtn.setAttribute("aria-expanded", "false");
    }

    profileBtn?.addEventListener("click", (event) => {
      event.stopPropagation();
      if (!profilePanel) return;
      const willOpen = profilePanel.hidden;
      profilePanel.hidden = !willOpen;
      profileBtn.setAttribute("aria-expanded", willOpen ? "true" : "false");
    });

    document.addEventListener("click", (event) => {
      if (profile && !profile.contains(event.target)) closeProfilePanel();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeProfilePanel();
    });

    profileSwitch?.addEventListener("click", () => {
      closeProfilePanel();
      clearIdentity();
      chatIdentity = null;
      // Wipe the transcript with the identity: the next person must not land in
      // the previous one's conversation.
      history.length = 0;
      if (feed && feed !== stage) feed.innerHTML = "";
      root.classList.remove("has-conversation");
      if (input) input.value = "";
      if (gateForm) gateForm.reset();
      if (gateError) gateError.hidden = true;
      paintIdentity();
      gateName?.focus();
    });

    gateForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const name = (gateName?.value || "").trim();
      const email = (gateEmail?.value || "").trim();

      const showGateError = (message) => {
        if (!gateError) return;
        gateError.textContent = message;
        gateError.hidden = false;
      };

      if (!name) return showGateError("Please enter your name.");
      if (!email || !/^[^@\s]+@[^@\s.]+\.[^@\s]{2,}$/.test(email)) {
        return showGateError("Please enter a valid email address.");
      }
      if (gateError) gateError.hidden = true;

      if (gateSubmit) {
        gateSubmit.disabled = true;
        gateSubmit.textContent = "Starting...";
      }

      try {
        const res = await fetch(`${effectiveApiUrl}/chat/identify`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            ...(apiKey ? { "X-API-Key": apiKey } : {}),
          },
          body: JSON.stringify({ name, email, page_url: window.location.pathname }),
        });
        if (!res.ok) throw new Error(`Sign-in failed (${res.status})`);
        const data = await res.json();
        if (!data.session_id) throw new Error("Sign-in failed (no session)");
        chatIdentity = { name: data.name, email: data.email, session_id: data.session_id };
        storeIdentity(chatIdentity);
        paintIdentity();
        input?.focus();
      } catch (error) {
        showGateError(
          error && error.message && !/^Failed to fetch$/i.test(error.message)
            ? error.message
            : "Could not reach the assistant. Please try again."
        );
      } finally {
        if (gateSubmit) {
          gateSubmit.disabled = false;
          gateSubmit.textContent = "Start chatting";
        }
      }
    });

    chatIdentity = readIdentity();
    paintIdentity();

    submitBtn.addEventListener("click", () => ask());
    input.addEventListener("keydown", (event) => {
      if (event.key === "Enter" && !event.shiftKey) {
        event.preventDefault();
        ask();
      }
    });

    async function ask() {
      const question = input.value.trim();
      if (!question || submitBtn.disabled) return;

      userMessage(question);
      input.value = "";
      submitBtn.disabled = true;
      const pending = pendingMessage();

      // Scroll stage to pending so user sees question and thinking state
      stage.scrollTo({ top: stage.scrollHeight, behavior: "smooth" });

      try {
        const response = await fetch(`${effectiveApiUrl}/ask`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            ...(apiKey ? { "X-API-Key": apiKey } : {}),
          },
          body: JSON.stringify({
            q: question,
            history: history.slice(-HISTORY_TURNS),
            session_id: chatIdentity?.session_id || null,
          }),
        });

        if (!response.ok) {
          let detail = `Request failed (${response.status})`;
          try {
            const body = await response.json();
            if (body && body.detail) detail = body.detail;
          } catch {}
          throw new Error(detail);
        }

        const data = await response.json();
        fillAnswer(pending, data);
        history.push({ role: "user", content: question });
        history.push({ role: "assistant", content: String(data.answer || "").slice(0, 3500) });
      } catch (error) {
        const message =
          error && error.message && !/^Failed to fetch$/i.test(error.message)
            ? error.message
            : "Could not reach the chatbot service. Please ensure the local backend server is running.";
        fillError(pending, message);
      } finally {
        submitBtn.disabled = false;
        input.focus();
      }
    }
  }
</script>

<style is:global>
  @layer page-sections {
    /* ==========================================================================
       Stevie Awards Chatbot — Executive Intelligence Canvas
       Integrated Editorial Redesign matching site design tokens & typography
       ========================================================================== */

