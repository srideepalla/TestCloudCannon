---
/**
 * StevieChatbot — a chat transcript backed by the StevieIntel chatbot API.
 *
 * WHY THIS COMPONENT DOES NOT ANSWER ANYTHING ITSELF
 * Answering a Stevie Awards question means searching 2,048 scraped passages and
 * 83,574 winner records, then calling a paid AI model. None of that can happen
 * in a browser — there is no database there, no server runtime, and a paid API
 * key in a page's source is readable by anyone. So this component is the input
 * box and the transcript; the thinking happens in the API it calls.
 *
 * WHY A TRANSCRIPT AND NOT A SINGLE ANSWER
 * The first version showed one answer at a time and replaced it on the next
 * question. That is a search box, not a chat: a reader could not see what they
 * had already asked, compare two answers, or scroll back. Every message now
 * stays on screen in the order it happened, which is what "chatbot" leads people
 * to expect.
 *
 * WHAT THIS UI PROMISES THAT THE API DOES NOT YET KEEP
 * A transcript implies memory. The API has none — each question is answered on
 * its own, so "what about 2023?" is not understood as a follow-up and gets
 * answered as if asked cold. The layout makes that limitation more surprising,
 * not less, so it is worth fixing in the API rather than hiding in the UI.
 *
 * PATTERN
 * Follows EnquiryForm.astro, which already calls an external API from the
 * browser using a PUBLIC_ environment variable and passes values into client
 * script with `define:vars`.
 *
 * ONE DELIBERATE DIFFERENCE FROM EnquiryForm
 * EnquiryForm's own comment reads: "NO API token is sent ... so no credentials
 * are exposed in the browser." It uses Zendesk's anonymous endpoints for that.
 *
 * This component DOES send a key, and anyone can read it from the page source.
 * That is acceptable only while both hold:
 *   - it is a test key, never a production one
 *   - the API enforces a daily spend cap, so a leaked key cannot run up a bill
 *
 * Before this goes to a public production page, pick one:
 *   a) drop the key requirement on the API and rely on its spend cap and rate
 *      limit alone — this matches EnquiryForm's existing approach; or
 *   b) put a proxy on your own domain that holds the key server-side. Note
 *      CloudCannon cannot host that proxy: it serves static files only.
 *
 * ENVIRONMENT
 * Set in CloudCannon under Site Settings → Environment Variables. The PUBLIC_
 * prefix is required: Astro only exposes PUBLIC_-prefixed variables to browser
 * code, and this request is made from the browser.
 *
 *   PUBLIC_STEVIE_API_URL   e.g. https://xxxx.trycloudflare.com
 *   PUBLIC_STEVIE_API_KEY   the API's STEVIE_API_KEY
 */
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Text from "@core-elements/text/Text.astro";

const {
  // Two distinct jobs, so the copy has to name both. The chatbot answers
  // questions about the awards themselves (fees, deadlines, categories,
  // judging) AND looks up individual winning organizations and honorees from
  // the scraped winner records. Earlier copy advertised only the first, so
  // nobody thought to ask the second kind of question.
  heading = "Stevie Awards Assistant",
  text =
    "Ask about entering — fees, deadlines, categories, judging — or look up a " +
    "winning organization or honoree. Every answer cites its source.",
  placeholder = "What is the late entry fee?",
  buttonLabel = "Ask",
  apiEndpoint = "",
  showSources = true,

  colorScheme = "inherit",
  backgroundColor,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

// apiEndpoint is editable in CloudCannon and takes precedence over the build
// setting. A quick-tunnel URL changes every time the tunnel restarts, so an
// editor has to be able to update it without a code change and a rebuild —
// the same reason the Search Past Winners section exposes its endpoint as an
// input rather than relying on an environment variable alone.
const apiUrl = (apiEndpoint || import.meta.env.PUBLIC_STEVIE_API_URL || "http://localhost:8003")
  .toString()
  .replace(/\/+$/, "");
const apiKey = import.meta.env.PUBLIC_STEVIE_API_KEY || "";
---

<CustomSection
  class:list={["stevie-chatbot", className]}
  maxContentWidth="2xl"
  paddingHorizontal="2xl"
  paddingVertical="2xl"
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <!--
    The heading and tagline are a HERO before the first question and a small
    title after it, the way Gemini and ChatGPT open. Both are wrapped so the
    script can collapse them: it adds `has-messages` to the section, and the CSS
    below shrinks the title and hides the tagline. Wrapping is necessary because
    Heading and Text are shared components whose internals this file must not
    reach into.
  -->
  <div class="stevie-chatbot__hero">
    <div class="stevie-chatbot__title">
      <Heading level="h2" size="2xl" alignX="center" text={heading} data-prop="heading" />
    </div>
    <div class="stevie-chatbot__tagline">
      <Text alignX="center" text={text} data-prop="text" />
    </div>
  </div>

  <div class="stevie-chatbot__window">
    <!--
      role="log" with aria-live="polite" so a screen reader announces each new
      message as it arrives, rather than the reader having to hunt for it.
    -->
    <div class="stevie-chatbot__transcript" id="stevie-chatbot-transcript" role="log" aria-live="polite"></div>

    <!--
      Deliberately a div, not a form. CloudCannon's visual editor renders the page
      in a sandboxed iframe without the 'allow-forms' permission, so the browser
      blocks submission before any handler runs — "Blocked form submission to ''
      because the form's frame is sandboxed". A form works on the live site and
      silently does nothing in the editor, which is where an editor will try it
      first. A button click and an Enter keypress work in both.
    -->
    <div class="stevie-chatbot__composer" id="stevie-chatbot-composer">
      <!--
        The label is present for screen readers and hidden visually: a pill-shaped
        input with a send icon carries its own meaning, and "YOUR QUESTION" sitting
        above it belongs to a form, not a chat. Removing the element entirely would
        leave the field unlabelled.
      -->
      <label class="stevie-chatbot__label" for="stevie-chatbot-input">Your question</label>
      <div class="stevie-chatbot__row">
        <input
          id="stevie-chatbot-input"
          class="stevie-chatbot__input"
          type="text"
          name="question"
          placeholder={placeholder}
          autocomplete="off"
          maxlength="500"
        />
        <!--
          buttonLabel is still the button's name — it moves from visible text to
          aria-label, so the CloudCannon field keeps working and a screen reader
          announces "Ask" rather than "button". aria-hidden on the icon stops it
          being read as a second, meaningless label.
        -->
        <button class="stevie-chatbot__submit" type="button" aria-label={buttonLabel}>
          <svg
            class="stevie-chatbot__send"
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <line x1="12" y1="19.5" x2="12" y2="5" />
            <polyline points="5.5 11.5 12 5 18.5 11.5" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</CustomSection>

<script define:vars={{ apiUrl, apiKey, showSources }}>
  // The API returns a `tier` naming where the answer came from. Showing it is
  // the point: a reader can tell "from our own verified records" apart from
  // "found on the open web", which is otherwise invisible and matters a lot for
  // a question about fees or deadlines.
  const TIERS = {
    profile: ["is-records", "From our winner records"],
    totals: ["is-records", "Counted from our winner records"],
    tier1: ["is-verified", "From our verified knowledge base"],
    tier2a: ["is-live", "Found live on stevieawards.com"],
    tier2b: ["is-web", "Found on the web — not an official source"],
  };

  // The conversation so far, sent with each question so the API can turn a
  // follow-up ("what about 2023?") into a standalone question before searching.
  // Only the last few turns are sent — the API caps it anyway, and a long
  // transcript is pure cost.
  const HISTORY_TURNS = 6;
  const history = [];

  const composer = document.getElementById("stevie-chatbot-composer");

  if (composer) {
    const input = document.getElementById("stevie-chatbot-input");
    const transcript = document.getElementById("stevie-chatbot-transcript");
    const submitBtn = composer.querySelector(".stevie-chatbot__submit");
    // The section element, so the hero can be collapsed once a conversation
    // starts. closest() rather than a hard-coded id: CustomSection owns the
    // outer element and this component only knows the class it was given.
    const root = composer.closest(".stevie-chatbot");

    const escapeHtml = (value) =>
      String(value ?? "").replace(/[&<>"']/g, (char) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char],
      );

    /** Append a message element and keep the newest in view. */
    function push(el) {
      // First message collapses the hero: title shrinks, tagline goes. Done once
      // and never undone — a conversation does not go back to being empty.
      if (root) root.classList.add("has-messages");
      transcript.appendChild(el);
      // scrollTop rather than scrollIntoView: the latter scrolls the whole page
      // when the transcript is taller than the viewport, yanking the reader away
      // from the input they are typing in.
      transcript.scrollTop = transcript.scrollHeight;
      return el;
    }

    function userMessage(question) {
      const el = document.createElement("div");
      el.className = "stevie-chatbot__msg is-user";
      el.innerHTML = `<div class="stevie-chatbot__bubble">${escapeHtml(question)}</div>`;
      return push(el);
    }

    /** A placeholder bubble, replaced in place once the answer arrives. */
    function pendingMessage() {
      const el = document.createElement("div");
      el.className = "stevie-chatbot__msg is-bot is-pending";
      el.innerHTML =
        `<div class="stevie-chatbot__bubble">` +
        `<span class="stevie-chatbot__dots" aria-label="Thinking">` +
        `<i></i><i></i><i></i></span></div>`;
      return push(el);
    }

    /**
     * Only web sources are worth showing, and only as links.
     *
     * Answers from our own data cite internal references — "site/sales#faq-p6",
     * "5 scraped winner record(s) for MEXC", "83,574 scraped winner records" —
     * which mean something to us and nothing to a reader, and cannot be opened.
     * The badge already says the answer came from our records; a list of our own
     * filenames underneath adds noise and invites clicks that go nowhere.
     *
     * A web answer is the opposite case: the reader should be able to check it,
     * especially when the badge warns the source is not official.
     *
     * The http(s) test doubles as the security filter. Anything else — including
     * a javascript: or data: URL, however it got into the response — is dropped
     * rather than turned into an anchor.
     */
    const linkableSources = (sources) =>
      sources.filter((s) => /^https?:\/\//i.test(String(s ?? "")));

    /** "blog.stevieawards.com/…/first-stevie-awards" — readable, not a wall of URL. */
    function linkLabel(url) {
      try {
        const u = new URL(url);
        const parts = u.pathname.split("/").filter(Boolean);
        const tail = parts.length ? "/" + parts[parts.length - 1] : "";
        const trimmed = tail.length > 44 ? tail.slice(0, 44) + "…" : tail;
        return u.hostname + (parts.length > 1 ? "/…" : "") + trimmed;
      } catch {
        return url;
      }
    }

    function fillAnswer(el, data) {
      const [badgeClass, badgeLabel] = TIERS[data.tier] || ["is-other", data.label || ""];
      const sources = showSources && Array.isArray(data.sources)
        ? linkableSources(data.sources)
        : [];

      el.className = "stevie-chatbot__msg is-bot";
      el.innerHTML =
        `<div class="stevie-chatbot__bubble">` +
        (badgeLabel
          ? `<span class="stevie-chatbot__badge ${badgeClass}">${escapeHtml(badgeLabel)}</span>`
          : "") +
        // When a follow-up was rewritten, show what was actually searched. The
        // rewrite is a guess — "what about 2023?" after two different questions
        // is genuinely ambiguous — so a wrong guess should be visible rather
        // than leaving the reader wondering why the answer changed subject.
        (data.rewritten
          ? `<p class="stevie-chatbot__rewritten">Answering: ${escapeHtml(data.rewritten)}</p>`
          : "") +
        `<div class="stevie-chatbot__text">${escapeHtml(data.answer || "")}</div>` +
        // Collapsed by default. An answer citing eight pages was showing eight
        // lines of internal references under two lines of answer, which buried
        // the answer and made every reply look like a search dump.
        (sources.length
          ? `<details class="stevie-chatbot__sources-panel">` +
            `<summary class="stevie-chatbot__sources-summary">Sources (${sources.length})</summary>` +
            `<ul class="stevie-chatbot__sources">${sources
              .map(
                (source, index) =>
                  `<li>[${index + 1}] <a class="stevie-chatbot__source-link" ` +
                  // rel="noopener noreferrer" because these are third-party pages
                  // opened in a new tab; without it the opened page can reach back
                  // through window.opener.
                  `href="${escapeHtml(source)}" target="_blank" rel="noopener noreferrer">` +
                  `${escapeHtml(linkLabel(source))}</a></li>`,
              )
              .join("")}</ul></details>`
          : "") +
        `</div>`;
      transcript.scrollTop = transcript.scrollHeight;
    }

    function fillError(el, message) {
      el.className = "stevie-chatbot__msg is-bot has-error";
      el.innerHTML =
        `<div class="stevie-chatbot__bubble">` +
        `<div class="stevie-chatbot__text">${escapeHtml(message)}</div></div>`;
      transcript.scrollTop = transcript.scrollHeight;
    }

    submitBtn.addEventListener("click", () => ask());
    input.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        event.preventDefault();
        ask();
      }
    });

    async function ask() {
      const question = input.value.trim();
      if (!question || submitBtn.disabled) return;

      userMessage(question);
      // Cleared immediately, like every chat app: the question is already on
      // screen above, so leaving it in the box reads as "not sent".
      input.value = "";
      submitBtn.disabled = true;
      const pending = pendingMessage();

      try {
        const response = await fetch(`${apiUrl}/ask`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            ...(apiKey ? { "X-API-Key": apiKey } : {}),
          },
          body: JSON.stringify({ q: question, history: history.slice(-HISTORY_TURNS) }),
        });

        if (!response.ok) {
          // The API sends a plain-language `detail` for 401 (bad key), 402
          // (daily spend cap reached) and 429 (rate limited). Showing it beats a
          // bare status code, which reads as "broken" whatever the cause.
          let detail = `Request failed (${response.status})`;
          try {
            const body = await response.json();
            if (body && body.detail) detail = body.detail;
          } catch {
            /* response was not JSON — keep the status-based message */
          }
          throw new Error(detail);
        }

        const data = await response.json();
        fillAnswer(pending, data);
        // Recorded only on success. A failed turn has no answer, and a history
        // entry with a missing reply would give the rewriter a dangling question
        // to resolve the next follow-up against.
        history.push({ role: "user", content: question });
        history.push({ role: "assistant", content: String(data.answer || "").slice(0, 600) });
      } catch (error) {
        // A browser-blocked cross-origin request surfaces as a bare
        // "Failed to fetch" with no detail, so name the two causes that
        // actually occur rather than showing that to a visitor.
        const message =
          error && error.message && !/^Failed to fetch$/i.test(error.message)
            ? error.message
            : "Could not reach the chatbot. It may be offline, or the browser blocked the " +
              "request — a page served over https cannot call an http address, and this " +
              "site's domain must be listed in the API's allowed origins.";
        fillError(pending, message);
      } finally {
        submitBtn.disabled = false;
        input.focus();
      }
    }
  }
</script>

<style>
  /* Before the first question the heading and tagline sit in the middle of a
     generous block, like Gemini's opening screen. After it, the block collapses
     to a small title — see the has-messages rules in the global sheet. */
  .stevie-chatbot__hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 26vh;
    transition: min-height 0.25s ease;
  }

  .stevie-chatbot__window {
    margin-top: 1.25rem;
  }

  /* The border lives on the composer alone now, not around the whole panel, so
     the answers sit on the page rather than inside a box.
     The top padding is generous because the transcript scrolls: without a clear
     gap, the last line of an answer sits right against the input and reads as
     part of it. */
  .stevie-chatbot__composer {
    padding-top: 1.75rem;
  }

  /* Available to assistive technology, invisible on screen. clip-path rather than
     display:none, which would remove it from the accessibility tree too. */
  .stevie-chatbot__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* One pill holding the field and the send button, so the border belongs to the
     pair rather than to the input alone. */
  .stevie-chatbot__row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.3rem 0.3rem 1.1rem;
    border: 1px solid color-mix(in srgb, currentcolor 40%, transparent);
    border-radius: 2rem;
  }

  /* Softer than plain currentcolor, which on this dark section reads as a bright
     yellow outline round the whole pill. */
  .stevie-chatbot__row:focus-within {
    border-color: color-mix(in srgb, currentcolor 70%, transparent);
  }

  /* The site's base stylesheet styles every input with a border, a background, a
     radius and — the one that showed as a second box inside the pill — a 3px
     box-shadow focus ring:

       input:focus { box-shadow: 0 0 0 3px var(--color-focus-ring); }

     Removing the border and outline was not enough; the ring is a shadow. All of
     it is neutralised here so the field is just text inside the pill. */
  .stevie-chatbot__input,
  .stevie-chatbot__input:focus,
  .stevie-chatbot__input:focus-visible {
    flex: 1 1 auto;
    min-width: 0;
    padding: 0.7rem 0;
    font: inherit;
    color: inherit;
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    /* The pill shows focus via :focus-within, so a second ring inside it is noise. */
    outline: none;
  }

  .stevie-chatbot__submit {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    color: #fff;
    cursor: pointer;
    background: #0b6e6e;
    border: 0;
    border-radius: 50%;
    transition: background-color 0.15s ease, opacity 0.15s ease;
  }

  .stevie-chatbot__submit:hover:not(:disabled) {
    background: #0d8484;
  }

  .stevie-chatbot__submit:disabled {
    cursor: default;
    opacity: 0.45;
  }

  .stevie-chatbot__send {
    display: block;
  }
</style>

<!--
  The message elements are created by JavaScript after the page loads, so they do
  not carry Astro's data-astro-cid scope attribute and scoped rules cannot match
  them. Every rule below is therefore global, and every selector is prefixed with
  .stevie-chatbot__ so nothing leaks into the rest of the site.
-->
<style is:global>
  /* --- the Gemini-style opening, and its collapse ----------------------- */
  /* Nothing is reserved for the transcript until there is one, so the hero is
     genuinely centred on an empty page instead of being pushed up by an empty
     scroll area. */
  .stevie-chatbot .stevie-chatbot__transcript:empty {
    display: none;
  }

  .stevie-chatbot.has-messages .stevie-chatbot__hero {
    min-height: 0;
    margin-bottom: 0.25rem;
  }

  /* The tagline is scene-setting for someone who has not started. Once they
     have, it is a line of copy between them and their answers. */
  .stevie-chatbot.has-messages .stevie-chatbot__tagline {
    display: none;
  }

  /* Reaching into Heading's markup by tag, because the size is a prop chosen at
     build time and the collapse happens in the browser. :where() keeps this at
     zero specificity so the component's own styles still win where they matter. */
  .stevie-chatbot.has-messages .stevie-chatbot__title :where(h1, h2, h3, h4) {
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    line-height: 1.25;
  }

  .stevie-chatbot__transcript {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    /* Capped so the composer stays on screen instead of being pushed below the
       fold as the chat grows. No min-height: an empty transcript takes no room. */
    max-height: 60vh;
    /* Right padding keeps text off the scrollbar; bottom padding stops the last
       line touching the composer's top edge when scrolled to the end. */
    padding: 0.25rem 0.75rem 0.75rem 0;
    overflow-y: auto;
    /* A chat reads bottom-up when it overflows; anchoring keeps the newest
       message pinned while earlier ones scroll away above it. */
    overflow-anchor: auto;
  }

  .stevie-chatbot__msg {
    display: flex;
    max-width: 100%;
  }

  .stevie-chatbot__msg.is-user {
    justify-content: flex-end;
  }

  .stevie-chatbot__msg.is-bot {
    justify-content: flex-start;
  }

  .stevie-chatbot__bubble {
    max-width: 46ch;
    padding: 0.7rem 0.9rem;
    border-radius: 0.75rem;
    line-height: 1.5;
  }

  .stevie-chatbot__msg.is-user .stevie-chatbot__bubble {
    color: #fff;
    background: #0b6e6e;
    border-bottom-right-radius: 0.2rem;
  }

  /* No box on an answer. ChatGPT and Gemini bubble the question and leave the
     reply as plain text, which reads as prose rather than as a card — and these
     answers are long enough that a border round them looks like a form field. */
  .stevie-chatbot__msg.is-bot .stevie-chatbot__bubble {
    max-width: 100%;
    padding: 0;
    background: none;
    border-radius: 0;
  }

  /* An error still needs to look different from an answer, so it keeps a rule
     down its left edge — the only bot message that gets any decoration. */
  .stevie-chatbot__msg.has-error .stevie-chatbot__bubble {
    padding-left: 0.85rem;
    border-left: 3px solid #99302b;
  }

  .stevie-chatbot__badge {
    display: inline-block;
    margin-bottom: 0.5rem;
    padding: 0.15rem 0.45rem;
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid currentcolor;
    border-radius: 0.15rem;
  }

  .stevie-chatbot__badge.is-records { color: #2e9e6b; }
  .stevie-chatbot__badge.is-verified { color: #35b0b0; }
  .stevie-chatbot__badge.is-live { color: #d3922a; }
  .stevie-chatbot__badge.is-web { color: #d9645e; }

  .stevie-chatbot__rewritten {
    margin: 0 0 0.5rem;
    font-size: 0.78rem;
    font-style: italic;
    opacity: 0.7;
  }

  .stevie-chatbot__text {
    white-space: pre-wrap;
  }

  /* Three dots while a question is in flight. A question can take five seconds,
     and a bubble that appears with nothing in it reads as a failure. */
  .stevie-chatbot__dots {
    display: inline-flex;
    gap: 0.25rem;
    align-items: center;
    height: 1.2em;
  }

  .stevie-chatbot__dots i {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: currentcolor;
    opacity: 0.35;
    animation: stevie-chatbot-blink 1.2s infinite ease-in-out;
  }

  .stevie-chatbot__dots i:nth-child(2) { animation-delay: 0.2s; }
  .stevie-chatbot__dots i:nth-child(3) { animation-delay: 0.4s; }

  @keyframes stevie-chatbot-blink {
    0%, 80%, 100% { opacity: 0.25; }
    40% { opacity: 0.9; }
  }

  /* Respect a reader who has asked the system for less motion. */
  @media (prefers-reduced-motion: reduce) {
    .stevie-chatbot__dots i {
      animation: none;
      opacity: 0.5;
    }
  }

  .stevie-chatbot__sources-panel {
    margin-top: 0.7rem;
    padding-top: 0.5rem;
    border-top: 1px solid color-mix(in srgb, currentcolor 20%, transparent);
  }

  .stevie-chatbot__sources-summary {
    cursor: pointer;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
