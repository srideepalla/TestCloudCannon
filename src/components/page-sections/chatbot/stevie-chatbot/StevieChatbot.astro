    margin: 0 0 2.5rem;
  }

  .stevie-canvas__starters {
    width: 100%;
    max-width: 780px;
  }

  .stevie-canvas__starters-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #64748b;
    margin-bottom: 0.9rem;
  }

  .stevie-canvas__starters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0.85rem;
  }

  .stevie-canvas__starter-btn {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.95rem 1.15rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.85rem;
    color: #f1f5f9;
    font-size: 0.88rem;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .stevie-canvas__starter-btn:hover {
    background: rgba(11, 110, 110, 0.3);
    border-color: #0b6e6e;
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
  }

  .stevie-canvas__starter-icon {
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  /* Conversation Feed */
  .stevie-canvas__feed {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  /* User Message */
  .stevie-msg.is-user {
    display: flex;
    justify-content: flex-end;
  }

  .stevie-msg__user-bubble {
    max-width: min(720px, 85%);
    padding: 0.9rem 1.35rem;
    background: linear-gradient(135deg, #0e766e, #0b5e58);
    border-radius: 1.25rem 1.25rem 0.25rem 1.25rem;
    box-shadow: 0 6px 18px rgba(11, 110, 110, 0.35);
    color: #ffffff;
  }

  .stevie-msg__user-text {
    font-size: 1rem;
    line-height: 1.55;
    font-weight: 500;
  }

  /* Bot Message Dossier Card */
  .stevie-msg.is-bot {
    display: flex;
    justify-content: flex-start;
  }

  .stevie-msg__card {
    width: 100%;
    background: #ffffff !important;
    border: 1px solid #d4e2e0;
    border-radius: 1.35rem;
    padding: 1.6rem 2rem;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.25);
    color: #142a30 !important;
    transition: box-shadow 0.2s ease;
  }

  /* Universal Dark Text Guarantee inside White Briefing Card */
  .stevie-msg__card,
  .stevie-msg__card *,
  .stevie-msg__card p,
  .stevie-msg__card li,
  .stevie-msg__card ul,
  .stevie-msg__card ol,
  .stevie-msg__card span,
  .stevie-msg__card div,
  .stevie-msg__card td {
    color: #142a30 !important;
  }

  /* Specific exceptions for badges with dark backgrounds */
  .stevie-msg__card .stevie-olist__badge,
  .stevie-olist__badge {
    background: linear-gradient(135deg, #0b6e6e, #064444) !important;
    color: #ffffff !important;
    font-weight: 800 !important;
  }

  .stevie-msg__card strong,
  .stevie-msg__card h1,
  .stevie-msg__card h2,
  .stevie-msg__card h3,
  .stevie-msg__card h4,
  .stevie-msg__card .stevie-h2,
  .stevie-msg__card .stevie-h3,
  .stevie-msg__card .stevie-h4 {
    color: #0b4f4f !important;
  }

  .stevie-msg__card th {
    color: #0b4f4f !important;
    background: #f0f6f6 !important;
  }

  .stevie-msg__card .stevie-kpi-card__val {
    color: #0b4f4f !important;
  }

  .stevie-msg__card .stevie-kpi-card__label {
    color: #52666d !important;
  }

  .stevie-msg__card .stevie-chart-item__val {
    color: #0b6e6e !important;
  }

  .stevie-msg__card .stevie-timeline__date {
    color: #0b6e6e !important;
  }

  .stevie-msg__card .stevie-callout__badge {
    color: #0b4f4f !important;
  }

  .stevie-msg__card .stevie-chip {
    color: #0f766e !important;
    background: #f0fdfa !important;
    border-color: #99f6e4 !important;
  }

  .stevie-msg__card .stevie-tag {
    color: #0b6e6e !important;
    background: #e3f2f1 !important;
  }

  .stevie-msg__card.is-error {
    border-left: 4px solid #ef4444;
    background: #fffafa;
  }

  .stevie-msg__error-title {
    font-weight: 700;
    color: #b91c1c;
    margin-bottom: 0.5rem;
  }

  .stevie-msg__meta-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #edf2f2;
  }

  .stevie-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.75rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border-radius: 999px;
  }

  .stevie-badge.is-records { color: #047857; background: #ecfdf5; border: 1px solid #a7f3d0; }
  .stevie-badge.is-verified { color: #0f766e; background: #f0fdfa; border: 1px solid #99f6e4; }
  .stevie-badge.is-live { color: #b45309; background: #fffbeb; border: 1px solid #fde68a; }
  .stevie-badge.is-web { color: #b91c1c; background: #fef2f2; border: 1px solid #fecaca; }

  .stevie-msg__timestamp {
    font-size: 0.72rem;
    font-weight: 600;
    color: #94a3b8;
  }

  .stevie-rewritten {
    font-size: 0.8rem;
    font-style: italic;
    color: #64748b;
    margin-bottom: 0.85rem;
  }

  /* Thinking Animation */
  .stevie-msg__thinking {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.6rem 0;
  }

  .stevie-msg__thinking-dots {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
  }

  .stevie-msg__thinking-dots i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #0b6e6e;
    animation: stevie-blink 1.2s infinite ease-in-out;
  }
  .stevie-msg__thinking-dots i:nth-child(2) { animation-delay: 0.2s; }
  .stevie-msg__thinking-dots i:nth-child(3) { animation-delay: 0.4s; }

  @keyframes stevie-blink {
    0%, 80%, 100% { opacity: 0.25; }
    40% { opacity: 1; }
  }

  .stevie-msg__thinking-label {
    font-size: 0.92rem;
    font-weight: 500;
    color: #64748b;
  }

  /* Content Elements Inside Briefing Card */
  .stevie-body {
    font-size: 0.98rem;
    line-height: 1.7;
    color: #142a30 !important;
  }

  .stevie-body,
  .stevie-body p,
  .stevie-p,
  .stevie-list,
  .stevie-olist,
  .stevie-list li,
  .stevie-olist li {
    color: #142a30 !important;
    font-weight: 450;
    line-height: 1.7;
  }

  .stevie-body strong {
    color: #0b4f4f !important;
    font-weight: 700;
  }

  .stevie-p {
    margin: 0 0 0.95rem;
    color: #142a30 !important;
  }
  .stevie-p:last-child { margin-bottom: 0; }

  .stevie-h2 {
    font-size: 1.35rem;
    font-weight: 800;
    color: #0b4f4f;
    margin: 1.4rem 0 0.6rem;
    line-height: 1.3;
  }
  .stevie-h3 {
    font-size: 1.18rem;
    font-weight: 800;
    color: #0b6e6e;
    margin: 1.2rem 0 0.5rem;
    line-height: 1.3;
  }
  .stevie-h4 {
    font-size: 1.02rem;
    font-weight: 700;
    color: #142a30;
    margin: 1rem 0 0.4rem;
  }

  .stevie-list, .stevie-olist {
    margin: 0.5rem 0 1rem 1.5rem;
    padding: 0;
    line-height: 1.7;
  }
  .stevie-list li, .stevie-olist li {
    margin-bottom: 0.45rem;
  }
  .stevie-nested-li {
    margin-left: 1.4rem;
    list-style-type: circle;
  }

  .stevie-divider {
    border: 0;
    border-top: 1px solid #e2e8f0;
    margin: 1.3rem 0;
  }

  .stevie-link {
    color: #0b6e6e;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .stevie-link:hover { color: #0d9488; }

  .stevie-code {
    background: #f1f5f9;
    color: #0b6e6e;
    padding: 0.2rem 0.45rem;
    border-radius: 4px;
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.88em;
  }

  /* Modern Responsive Tables */
  .stevie-table-wrap {
    overflow-x: auto;
    margin: 1.1rem 0;
    border: 1px solid #d4e2e0;
    border-radius: 0.85rem;
    background: #ffffff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .stevie-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
  }

  .stevie-table th {
    background: #f0f6f6;
    color: #0b4f4f;
    font-weight: 700;
    padding: 0.75rem 1.1rem;
    border-bottom: 2px solid #d4e2e0;
    white-space: nowrap;
  }

  .stevie-table td {
    padding: 0.7rem 1.1rem;
    border-bottom: 1px solid #edf2f2;
    color: #142a30;
    vertical-align: top;
  }
  .stevie-table tr:last-child td { border-bottom: 0; }
  .stevie-table tr:nth-child(even) { background: #fafcfc; }
  .stevie-table tr:hover { background: #f0fdfa; }

  /* KPI Stat Highlight Cards */
  .stevie-kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.9rem;
    margin: 1.2rem 0;
  }

  .stevie-kpi-card {
    padding: 1.1rem 1.25rem;
    background: linear-gradient(180deg, #ffffff 0%, #f7faf9 100%);
    border: 1px solid #d4e2e0;
    border-radius: 0.95rem;
    text-align: center;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.04);
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .stevie-kpi-card:hover {
    transform: translateY(-2px);
    border-color: #0b6e6e;
    box-shadow: 0 6px 16px rgba(11, 110, 110, 0.12);
  }

  .stevie-kpi-card__val {
    font-size: clamp(1.3rem, 2vw, 1.8rem);
    font-weight: 800;
    color: #0b4f4f;
    line-height: 1.15;
    margin-bottom: 0.35rem;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .stevie-kpi-card__val.is-long {
    font-size: clamp(0.82rem, 1.25vw, 1.12rem) !important;
    line-height: 1.3;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
    word-break: break-all;
  }

  .stevie-kpi-card__label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Visual Comparison Chart Card */
  .stevie-chart-card {
    margin: 1.2rem 0;
    padding: 1.2rem 1.5rem;
    background: #ffffff;
    border: 1px solid #d4e2e0;
    border-radius: 1rem;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
  }

  .stevie-chart-card__header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.1rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid #edf2f2;
    color: #0b4f4f;
  }

  .stevie-chart-card__title {
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .stevie-chart-card__list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .stevie-chart-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .stevie-chart-item__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.88rem;
  }

  .stevie-chart-item__label {
    font-weight: 600;
    color: #142a30;
  }

  .stevie-chart-item__val {
    font-weight: 700;
    color: #0b6e6e;
    font-variant-numeric: tabular-nums;
  }

  .stevie-chart-item__track {
    width: 100%;
    height: 10px;
    background: #edf2f2;
    border-radius: 999px;
    overflow: hidden;
  }

  .stevie-chart-item__bar {
    height: 100%;
    border-radius: 999px;
    transition: width 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Timeline Card */
  .stevie-timeline-card {
    margin: 1.2rem 0;
    padding: 1.25rem 1.5rem;
    background: #ffffff;
    border: 1px solid #d4e2e0;
    border-radius: 1rem;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
  }

  .stevie-timeline-card__header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.98rem;
    font-weight: 700;
    color: #0b4f4f;
    margin-bottom: 1.2rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid #edf2f2;
  }

  .stevie-timeline {
    position: relative;
    margin-left: 0.5rem;
    padding-left: 1.8rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .stevie-timeline::before {
    content: "";
    position: absolute;
    top: 0.4rem;
    bottom: 0.4rem;
    left: 0.45rem;
    width: 2px;
    background: #d8e4e4;
  }

  .stevie-timeline__item {
    position: relative;
    display: flex;
    align-items: flex-start;
  }

  .stevie-timeline__marker {
    position: absolute;
    left: -1.8rem;
    top: 0.2rem;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: #ffffff;
    border: 2px solid #8fa2a6;
  }

  .stevie-timeline__item.is-done .stevie-timeline__marker {
    border-color: #10b981;
    background: #10b981;
  }

  .stevie-timeline__item.is-active .stevie-timeline__marker {
    border-color: #0b6e6e;
    background: #0b6e6e;
    box-shadow: 0 0 0 4px rgba(11, 110, 110, 0.2);
  }

  .stevie-timeline__content {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .stevie-timeline__date {
    font-size: 0.75rem;
    font-weight: 700;
    color: #0b6e6e;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .stevie-timeline__desc {
    font-size: 0.92rem;
    font-weight: 600;
    color: #142a30;
  }

  /* Executive Editorial Inset Cards (Non-AI, High-End Corporate Inset) */
  .stevie-insight {
    margin: 1.35rem 0;
    padding: 1.25rem 1.45rem;
    border-radius: 0.9rem;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);
    border: 1px solid #d8e5e3;
    background: #ffffff;
  }

  .stevie-insight.is-tip {
    background: linear-gradient(180deg, #f9fbfb 0%, #f2f7f6 100%);
    border-color: #cce0dd;
  }

  .stevie-insight.is-important {
    background: linear-gradient(180deg, #f9fbff 0%, #f0f4fc 100%);
    border-color: #d2e0f8;
  }

  .stevie-insight.is-warning, .stevie-insight.is-caution {
    background: linear-gradient(180deg, #fffdfa 0%, #fdf6ec 100%);
    border-color: #fae4c8;
  }

  .stevie-insight__header {
    display: flex;
    align-items: center;
    margin-bottom: 0.65rem;
  }

  .stevie-insight__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem 0.65rem;
    background: rgba(11, 110, 110, 0.12);
    color: #0b4f4f !important;
    border-radius: 0.35rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .stevie-insight.is-important .stevie-insight__badge {
    background: rgba(37, 99, 235, 0.12);
    color: #1e40af !important;
  }

  .stevie-insight.is-warning .stevie-insight__badge,
  .stevie-insight.is-caution .stevie-insight__badge {
    background: rgba(217, 119, 6, 0.12);
    color: #92400e !important;
  }

  .stevie-insight__content {
    font-size: 0.95rem;
    line-height: 1.65;
    color: #142a30 !important;
  }

  /* Executive Step Numbers & Ordered List Roadmap */
  .stevie-olist {
    list-style: none;
    padding-left: 0;
    margin: 1.1rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .stevie-olist__item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    line-height: 1.65;
    color: #142a30 !important;
  }

  .stevie-olist__badge {
    flex-shrink: 0;
    width: 1.45rem;
    height: 1.45rem;
    background: linear-gradient(135deg, #0b6e6e, #064444);
    color: #ffffff !important;
    border-radius: 50%;
    font-size: 0.75rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(11, 110, 110, 0.3);
    margin-top: 0.15rem;
  }

  .stevie-olist__content {
    flex: 1 1 auto;
    color: #142a30 !important;
    font-size: 0.96rem;
  }

  /* Section Headings & Visual Anchors */
  .stevie-h2 {
    font-size: 1.35rem;
    font-weight: 800;
    color: #0b4f4f !important;
    margin: 1.5rem 0 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid #edf2f2;
    letter-spacing: -0.01em;
  }

  .stevie-h3, .stevie-section-heading {
    font-size: 1.15rem;
    font-weight: 800;
    color: #0f766e !important;
    margin: 1.25rem 0 0.55rem;
    letter-spacing: -0.01em;
  }

  .stevie-h4 {
    font-size: 1.02rem;
    font-weight: 700;
    color: #142a30 !important;
    margin: 1rem 0 0.45rem;
  }

  /* Program Badges */
  .stevie-programs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0.9rem;
    margin: 1.2rem 0;
  }

  .stevie-program-card {
    padding: 1.1rem 1.25rem;
    background: #ffffff;
    border: 1px solid #d4e2e0;
    border-radius: 0.9rem;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.03);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .stevie-program-card.is-interactive {
    cursor: pointer;
    user-select: none;
    outline: none;
  }
  .stevie-program-card.is-interactive:hover {
    transform: translateY(-3px);
    border-color: #0b6e6e;
    box-shadow: 0 6px 18px rgba(11, 110, 110, 0.12);
    background: #fbfdfd;
  }
  .stevie-program-card.is-interactive:focus-visible {
    box-shadow: 0 0 0 3px rgba(11, 110, 110, 0.35);
    border-color: #0b6e6e;
  }

  .stevie-program-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .stevie-program-card__name {
    font-size: 0.96rem;
    font-weight: 700;
    color: #0b4f4f;
    line-height: 1.35;
  }

  .stevie-program-card__action {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: #0b6e6e;
    background: #e6f4f3;
    padding: 0.2rem 0.5rem;
    border-radius: 0.4rem;
    opacity: 0.85;
    transition: all 0.18s ease;
    flex-shrink: 0;
  }
  .stevie-program-card.is-interactive:hover .stevie-program-card__action {
    opacity: 1;
    background: #0b6e6e;
    color: #ffffff;
    transform: translateX(2px);
  }

  /* Interactive Option Cards (Single & Multi-Select) */
  .stevie-options-container {
    margin: 1.25rem 0;
    padding: 1.15rem 1.3rem;
    background: linear-gradient(180deg, #f9fbfb 0%, #f4f8f7 100%);
    border: 1px solid #d4e4e2;
    border-radius: 1rem;
  }

  .stevie-options-title {
    font-size: 0.95rem;
    font-weight: 800;
    color: #0b4f4f;
    margin-bottom: 0.85rem;
    letter-spacing: -0.01em;
