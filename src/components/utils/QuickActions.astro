---
import quickActionOpen from "@assets/images/quick-action.svg?raw";
import quickActionClose from "@assets/images/quick-action-close.svg?raw";
import Heading from "@core-elements/heading/Heading.astro";
import Button from "@core-elements/button/Button.astro";
import quickActionsData from "@data/quickActions.json";
import { slugifyLabel } from "@components/utils/slugify";

const { heading, links, awardPrograms = [] } = quickActionsData;
const popoverId = `modal-${slugifyLabel(heading)}`;
---

<div
  class="quick-actions-wrapper modal"
  data-theme="dark"
>
  <!-- Custom trigger button -->
  <button
    class="quick-actions-button modal-trigger"
    popovertarget={popoverId}
    aria-label="Toggle quick actions menu"
  >
    <span
      class="quick-actions-icon quick-actions-icon-open"
      set:html={quickActionOpen}
    />
    <span
      class="quick-actions-icon quick-actions-icon-close"
      set:html={quickActionClose}
    />
  </button>

  <!-- Quick Actions popover -->
  <div
    id={popoverId}
    popover="auto"
    class="modal-popover quick-actions-modal"
    role="dialog"
    aria-labelledby={`${popoverId}-title`}
  >
    <div class="modal-body quick-actions-body">
      <div class="quick-actions-header-row">
        <Heading
          id={`${popoverId}-title`}
          text={heading}
          level="h2"
          size="xs"
          class="quick-actions-heading"
        />
        <Button
          iconName="x-mark"
          hideText
          text="Close"
          variant="text-strong"
          size="lg"
          element="button"
          class="modal-close quick-actions-close"
          popovertarget={popoverId}
          popovertargetaction="hide"
        />
      </div>
      <hr class="quick-actions-divider" />
      <ul class="quick-actions-list">
        {
          links.map((link, index) => (
            <li class="quick-actions-list-item">
              <span class="quick-actions-number">{String(index + 1).padStart(2, "0")}</span>
              {link.modalTarget ? (
                <Button
                  text={link.text}
                  element="button"
                  variant="text-strong"
                  size="md"
                  uppercase
                  class="quick-action-button quick-action-modal-trigger"
                  data-modal-target={link.modalTarget}
                />
              ) : (
                <Button
                  text={link.text}
                  link={link.href}
                  openInNewTab={link.openInNewTab}
                  variant="text-strong"
                  size="md"
                  uppercase
                  class="quick-action-button"
                />
              )}
            </li>
          ))
        }
      </ul>
      <div class="quick-actions-enter-row">
        <button type="button" class="quick-actions-enter-btn quick-action-modal-trigger" data-modal-target="select-program">ENTER</button>
      </div>
    </div>
  </div>
</div>

<!-- Select Awards Program Modal -->
<div
  id="modal-select-program"
  popover="auto"
  class="qa-modal-overlay"
  role="dialog"
  aria-label="Select Awards Program"
  data-theme="light"
>
  <div class="qa-modal-panel">
    <div class="qa-modal-header">
      <h2 class="qa-modal-title">SELECT AWARDS PROGRAM</h2>
      <button class="qa-modal-close" popovertarget="modal-select-program" popovertargetaction="hide" aria-label="Close">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18"/><path d="M6 6l12 12"/></svg>
      </button>
    </div>
    <ul class="qa-program-list">
      {awardPrograms.map((program, i) => (
        <li class="qa-program-item">
          <label class="qa-program-label">
            <input type="radio" name="award-program" value={program.href} class="qa-program-radio" checked={i === 0} />
            <span class="qa-program-radio-custom"></span>
            <span class="qa-program-name">{program.name}</span>
          </label>
        </li>
      ))}
    </ul>
    <button class="qa-program-enter-btn" type="button">CONTINUE</button>
  </div>
</div>

<!-- Schedule Reminders Modal -->
<div
  id="modal-schedule-reminders"
  popover="auto"
  class="qa-modal-overlay"
  role="dialog"
  aria-label="Schedule Reminders"
  data-theme="light"
>
  <div class="qa-modal-panel">
    <div class="qa-modal-header">
      <h2 class="qa-modal-title">SCHEDULE REMINDERS</h2>
      <button class="qa-modal-close" popovertarget="modal-schedule-reminders" popovertargetaction="hide" aria-label="Close">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18"/><path d="M6 6l12 12"/></svg>
      </button>
    </div>
    <!-- Step 1: Enter details -->
    <div class="qa-reminder-step" data-step="1">
      <div class="qa-reminder-field">
        <label class="qa-reminder-label" for="reminder-name">Full Name<span class="qa-required">*</span></label>
        <input type="text" id="reminder-name" class="qa-reminder-input" placeholder="Full Name" />
      </div>
      <div class="qa-reminder-field">
        <label class="qa-reminder-label" for="reminder-country">Select Country<span class="qa-required">*</span></label>
        <select id="reminder-country" class="qa-reminder-input qa-reminder-select">
          <option value="">Select Country</option>
          <option value="US">United States</option>
          <option value="GB">United Kingdom</option>
          <option value="CA">Canada</option>
          <option value="AU">Australia</option>
          <option value="DE">Germany</option>
          <option value="FR">France</option>
          <option value="IN">India</option>
          <option value="AE">United Arab Emirates</option>
          <option value="SA">Saudi Arabia</option>
          <option value="SG">Singapore</option>
          <option value="JP">Japan</option>
          <option value="KR">South Korea</option>
          <option value="CN">China</option>
          <option value="BR">Brazil</option>
          <option value="MX">Mexico</option>
          <option value="OTHER">Other</option>
        </select>
      </div>
      <div class="qa-reminder-field">
        <label class="qa-reminder-label" for="reminder-phone">Mobile Number</label>
        <div class="qa-phone-row">
          <select id="reminder-phone-code" class="qa-reminder-input qa-phone-code">
            <option value="+1">🇺🇸 +1</option>
            <option value="+44">🇬🇧 +44</option>
            <option value="+1-ca">🇨🇦 +1</option>
            <option value="+61">🇦🇺 +61</option>
            <option value="+49">🇩🇪 +49</option>
            <option value="+33">🇫🇷 +33</option>
            <option value="+91">🇮🇳 +91</option>
            <option value="+971">🇦🇪 +971</option>
            <option value="+966">🇸🇦 +966</option>
            <option value="+65">🇸🇬 +65</option>
            <option value="+81">🇯🇵 +81</option>
            <option value="+82">🇰🇷 +82</option>
            <option value="+86">🇨🇳 +86</option>
            <option value="+55">🇧🇷 +55</option>
            <option value="+52">🇲🇽 +52</option>
          </select>
          <input type="tel" id="reminder-phone" class="qa-reminder-input qa-phone-input" placeholder="Mobile Number" />
        </div>
      </div>
      <div class="qa-reminder-field">
        <label class="qa-reminder-label" for="reminder-type">Reminder Type<span class="qa-required">*</span></label>
        <select id="reminder-type" class="qa-reminder-input qa-reminder-select">
          <option value="">Reminder Type</option>
          <option value="sms">SMS</option>
          <option value="email">Email</option>
          <option value="both">SMS & Email</option>
        </select>
      </div>
      <div class="qa-reminder-field">
        <label class="qa-reminder-label" for="reminder-options">Select Options<span class="qa-required">*</span></label>
        <select id="reminder-options" class="qa-reminder-input qa-reminder-select">
          <option value="">Select Options</option>
          <option value="all">All Programs</option>
          <option value="aba">American Business Awards</option>
          <option value="iba">International Business Awards</option>
          <option value="sales">Sales & Customer Service</option>
          <option value="women">Women In Business</option>
          <option value="mena">Middle East & North Africa</option>
          <option value="apac">Asia-Pacific</option>
          <option value="employers">Great Employers</option>
          <option value="tech">Technology Excellence</option>
        </select>
      </div>
      <div class="qa-reminder-field qa-consent-field">
        <label class="qa-consent-label">
          <input type="checkbox" id="reminder-consent" class="qa-consent-checkbox" />
          <span>I give consent to gather and process my data provided in the form above, and to the storing of IP address of my internet service provider.</span>
        </label>
      </div>
      <div class="qa-reminder-field qa-recaptcha-placeholder" title="Placeholder — real reCAPTCHA will be integrated">
        <div class="qa-recaptcha-box">
          <input type="checkbox" id="reminder-captcha" class="qa-consent-checkbox" />
          <span>I am not a robot</span>
          <span class="qa-recaptcha-badge">reCAPTCHA</span>
        </div>
      </div>
      <div class="qa-reminder-actions">
        <button class="qa-reminder-btn qa-reminder-btn--outline" type="button" data-action="remove-info">REMOVE MY INFORMATION</button>
        <button class="qa-reminder-btn qa-reminder-btn--primary" type="button" data-action="send-otp">SUBMIT</button>
      </div>
      <p class="qa-reminder-note">Reminders are sent 8 days prior to every program deadline unless you edit your preferences.</p>
    </div>
    <!-- Step 2: OTP verification -->
    <div class="qa-reminder-step" data-step="2" hidden>
      <h3 class="qa-reminder-subtitle">CONFIRM MOBILE NUMBER</h3>
      <p class="qa-reminder-text">We sent a 4 digit confirmation code to your mobile number. Enter the code below.</p>
      <div class="qa-otp-inputs">
        <input type="text" maxlength="1" class="qa-otp-digit" inputmode="numeric" pattern="[0-9]" />
        <input type="text" maxlength="1" class="qa-otp-digit" inputmode="numeric" pattern="[0-9]" />
        <input type="text" maxlength="1" class="qa-otp-digit" inputmode="numeric" pattern="[0-9]" />
        <input type="text" maxlength="1" class="qa-otp-digit" inputmode="numeric" pattern="[0-9]" />
      </div>
      <p class="qa-reminder-text qa-reminder-resend">I didn't get a code. <button type="button" class="qa-reminder-link" data-action="resend-otp">Resend the code</button></p>
      <button class="qa-reminder-btn qa-reminder-btn--primary qa-reminder-btn--full" type="button" data-action="verify-otp">VERIFY</button>
    </div>
    <!-- Step 3: Success -->
    <div class="qa-reminder-step" data-step="3" hidden>
      <div class="qa-reminder-status">
        <div class="qa-reminder-status-icon qa-reminder-status-icon--success">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <p class="qa-reminder-status-text">Your Mobile Number has been verified</p>
        <button class="qa-reminder-btn qa-reminder-btn--primary" type="button" data-action="got-it">GOT IT</button>
      </div>
    </div>
  </div>
</div>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { trapFocus } from "@component-utils/focusTrap";

  function setupQuickActions() {
    const modal = document.querySelector<HTMLElement>(".quick-actions-wrapper");
    if (!modal) return;
    if (modal.hasAttribute("data-modal-initialized")) return;
    modal.setAttribute("data-modal-initialized", "");

    const trigger = modal.querySelector<HTMLButtonElement>(".modal-trigger");
    const popover = modal.querySelector<HTMLElement>(".modal-popover");
    if (!trigger || !popover) return;

    trapFocus(popover);

    popover.addEventListener("toggle", (e) => {
      const { newState } = e as ToggleEvent;
      trigger.setAttribute("aria-expanded", String(newState === "open"));

      if (newState === "closed") {
        trigger.focus();
      }
    });

    // Modal trigger buttons inside quick actions
    modal.querySelectorAll<HTMLButtonElement>(".quick-action-modal-trigger").forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.getAttribute("data-modal-target");
        const targetModal = document.getElementById(`modal-${targetId}`);
        if (targetModal) {
          popover.hidePopover();
          targetModal.showPopover();
        }
      });
    });

    // Select Awards Program — CONTINUE button navigates to selected program
    const programEnterBtn = document.querySelector<HTMLButtonElement>(".qa-program-enter-btn");
    if (programEnterBtn) {
      programEnterBtn.addEventListener("click", () => {
        const selected = document.querySelector<HTMLInputElement>('input[name="award-program"]:checked');
        if (selected?.value) {
          window.location.href = selected.value;
        }
      });
    }

    // Schedule Reminders — step navigation
    const remindersModal = document.getElementById("modal-schedule-reminders");
    if (remindersModal) {
      const steps = remindersModal.querySelectorAll<HTMLElement>(".qa-reminder-step");

      function showStep(stepNum: number) {
        steps.forEach((step) => {
          step.hidden = step.getAttribute("data-step") !== String(stepNum);
        });
      }

      const nameInput = remindersModal.querySelector<HTMLInputElement>("#reminder-name");
      const countrySelect = remindersModal.querySelector<HTMLSelectElement>("#reminder-country");
      const phoneInput = remindersModal.querySelector<HTMLInputElement>("#reminder-phone");
      const typeSelect = remindersModal.querySelector<HTMLSelectElement>("#reminder-type");
      const optionsSelect = remindersModal.querySelector<HTMLSelectElement>("#reminder-options");
      const consentCheckbox = remindersModal.querySelector<HTMLInputElement>("#reminder-consent");
      const captchaCheckbox = remindersModal.querySelector<HTMLInputElement>("#reminder-captcha");
      const phoneRegex = /^[\d\s\-()]{7,}$/;

      function clearErrors() {
        remindersModal.querySelectorAll<HTMLElement>(".qa-field-error").forEach((el) => el.remove());
      }

      function showError(el: HTMLElement, msg: string) {
        const parent = el.closest(".qa-reminder-field") || el.parentElement;
        const existing = parent?.querySelector(".qa-field-error");
        if (existing) existing.remove();
        const err = document.createElement("span");
        err.className = "qa-field-error";
        err.textContent = msg;
        parent?.appendChild(err);
      }

      const removeBtn = remindersModal.querySelector<HTMLButtonElement>('[data-action="remove-info"]');
      removeBtn?.addEventListener("click", () => {
        if (nameInput) nameInput.value = "";
        if (countrySelect) countrySelect.value = "";
        if (phoneInput) phoneInput.value = "";
        if (typeSelect) typeSelect.value = "";
        if (optionsSelect) optionsSelect.value = "";
        if (consentCheckbox) consentCheckbox.checked = false;
        if (captchaCheckbox) captchaCheckbox.checked = false;
        clearErrors();
      });

      const sendOtpBtn = remindersModal.querySelector<HTMLButtonElement>('[data-action="send-otp"]');
      sendOtpBtn?.addEventListener("click", () => {
        clearErrors();
        let valid = true;

        if (!nameInput?.value.trim()) {
          showError(nameInput!, "Name is required");
          valid = false;
        }
        if (!countrySelect?.value) {
          showError(countrySelect!, "Select a country");
          valid = false;
        }
        if (!phoneInput?.value.trim() || !phoneRegex.test(phoneInput!.value.trim())) {
          showError(phoneInput!, "Enter a valid phone number");
          valid = false;
        }
        if (!typeSelect?.value) {
          showError(typeSelect!, "Select a reminder type");
          valid = false;
        }
        if (!optionsSelect?.value) {
          showError(optionsSelect!, "Select an option");
          valid = false;
        }
        if (!consentCheckbox?.checked) {
          showError(consentCheckbox!, "Consent is required");
          valid = false;
        }
        if (!captchaCheckbox?.checked) {
          showError(captchaCheckbox!, "Please verify you are not a robot");
          valid = false;
        }

        if (valid) showStep(2);
      });

      const verifyBtn = remindersModal.querySelector<HTMLButtonElement>('[data-action="verify-otp"]');
      verifyBtn?.addEventListener("click", () => {
        showStep(3);
      });

      const gotItBtn = remindersModal.querySelector<HTMLButtonElement>('[data-action="got-it"]');
      gotItBtn?.addEventListener("click", () => {
        remindersModal.hidePopover();
      });

      const resendBtn = remindersModal.querySelector<HTMLButtonElement>('[data-action="resend-otp"]');
      resendBtn?.addEventListener("click", () => {
        // Placeholder for resend logic
      });

      // OTP auto-advance
      const otpInputs = remindersModal.querySelectorAll<HTMLInputElement>(".qa-otp-digit");
      otpInputs.forEach((input, idx) => {
        input.addEventListener("input", () => {
          if (input.value.length === 1 && idx < otpInputs.length - 1) {
            otpInputs[idx + 1].focus();
          }
        });
        input.addEventListener("keydown", (e) => {
          if (e.key === "Backspace" && !input.value && idx > 0) {
            otpInputs[idx - 1].focus();
          }
        });
      });

      // Reset to step 1 when modal closes
      remindersModal.addEventListener("toggle", (e) => {
        if ((e as ToggleEvent).newState === "closed") {
          showStep(1);
          otpInputs.forEach((input) => (input.value = ""));
          clearErrors();
          if (nameInput) nameInput.value = "";
          if (countrySelect) countrySelect.value = "";
          if (phoneInput) phoneInput.value = "";
          if (typeSelect) typeSelect.value = "";
          if (optionsSelect) optionsSelect.value = "";
          if (consentCheckbox) consentCheckbox.checked = false;
          if (captchaCheckbox) captchaCheckbox.checked = false;
        }
      });
    }
  }

  onPageLoad(setupQuickActions);
</script>

<style is:global>
  @layer components {
    /* Wrapper positioning */
    .quick-actions-wrapper {
      position: fixed;
      bottom: var(--spacing-2xl);
      right: var(--spacing-2xl);
      z-index: 9999;
      display: block;
      margin: 0;
    }

    /* Custom trigger button */
    .quick-actions-button {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 74px;
      height: 74px;
      padding: 0;
      background-color: transparent;
      border: none;
      cursor: pointer;
      transition: all 0.3s ease;
      user-select: none;
      position: relative;
    }

    .quick-actions-icon {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      transition: opacity 0.3s ease;
    }

    .quick-actions-icon-open {
      opacity: 1;
    }

    .quick-actions-icon-close {
      opacity: 0;
    }

    .quick-actions-button[aria-expanded="true"] .quick-actions-icon-open {
      opacity: 0;
    }

    .quick-actions-button[aria-expanded="true"] .quick-actions-icon-close {
      opacity: 1;
    }

    /* Override modal popover positioning and styling */
    .quick-actions-modal {
      position: fixed;
      bottom: calc(var(--spacing-2xl) + 90px);
      right: var(--spacing-2xl);
      top: unset;
      left: unset;
      border: none;
      background-color: rgb(228, 105, 37);
      border-radius: var(--radius-lg);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
      width: 100%;
      max-width: min(450px, calc(100vw - var(--spacing-2xl) * 2));
      margin: 0;
      padding: var(--spacing-xl);
    }

    .quick-actions-header-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--spacing-sm);
    }

    .quick-actions-heading.heading {
      margin: 0;
      margin-top: 0;
    }

    .quick-actions-divider {
      margin: var(--spacing-md) 0 var(--spacing-lg) 0;
      border-color: var(--color-text-strong);
    }

    .quick-actions-list {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .quick-actions-list-item {
      display: flex;
      align-items: center;
      gap: var(--spacing-md);
    }

    .quick-actions-number {
      font-family: var(--font-headings);
      font-size: var(--font-size-sm);
      font-weight: 700;
      color: var(--color-text-strong);
      opacity: 0.7;
      flex-shrink: 0;
    }

    .quick-action-button {
      padding: var(--spacing-sm) 0;
    }

    .quick-actions-list .quick-action-button .button-inner.variant-text-strong {
      font-weight: 400 !important;
    }

    .quick-action-modal-trigger.button {
      padding: var(--spacing-sm) 0;
    }

    .quick-actions-enter-row {
      margin-top: var(--spacing-lg);
    }

    .quick-actions-enter-btn {
      display: block;
      width: 100%;
      text-align: center;
      padding: var(--spacing-md);
      background: #111;
      color: #fff;
      font-family: var(--font-headings);
      font-size: var(--font-size-sm);
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      text-decoration: none;
      border-radius: var(--radius-xs);
      transition: background 0.15s ease;
    }

    .quick-actions-enter-btn:hover {
      background: #333;
    }

    /* Shared modal overlay styles */
    .qa-modal-overlay {
      position: fixed;
      inset: 0;
      margin: auto;
      border: none;
      background: transparent;
      width: 100%;
      max-width: 500px;
      max-height: 85vh;
      overflow-y: auto;
      padding: 0;

      opacity: 0;
      transform: translateY(16px);
      transition:
        opacity 0.2s ease-out,
        transform 0.2s ease-out,
        overlay 0.2s ease-out allow-discrete,
        display 0.2s ease-out allow-discrete;
    }

    .qa-modal-overlay:popover-open {
      opacity: 1;
      transform: translateY(0);

      @starting-style {
        opacity: 0;
        transform: translateY(16px);
      }
    }

    .qa-modal-overlay::backdrop {
      background-color: rgba(0, 0, 0, 0.5);
      opacity: 0;
      transition:
        opacity 0.2s ease-out,
        overlay 0.2s ease-out allow-discrete,
        display 0.2s ease-out allow-discrete;
    }

    .qa-modal-overlay:popover-open::backdrop {
      opacity: 1;

      @starting-style {
        opacity: 0;
      }
    }

    .qa-modal-panel {
      background: #fff;
      border-radius: 0;
      padding: var(--spacing-2xl);
      box-shadow: 0 16px 48px rgba(0, 0, 0, 0.2);
    }

    .qa-modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: var(--spacing-xl);
    }

    .qa-modal-title {
      margin: 0;
      font-family: var(--font-headings);
      font-size: 1.1rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: #111;
    }

    .qa-modal-close {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      padding: 0;
      border: none;
      background: none;
      cursor: pointer;
      color: #666;
      border-radius: var(--radius-full);
      transition: background 0.15s ease;
    }

    .qa-modal-close:hover {
      background: #f0f0f0;
    }

    /* Select Awards Program */
    .qa-program-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .qa-program-item {
      border-bottom: 1px solid #eee;
    }

    .qa-program-item:last-child {
      border-bottom: none;
    }

    .qa-program-label {
      display: flex;
      align-items: center;
      gap: var(--spacing-md);
