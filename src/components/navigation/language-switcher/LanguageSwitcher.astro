---
import Image from "@core-elements/image/Image.astro";

type Language = {
  name: string;
  langCode: string;
  flag: string;
};

const {
  currentLanguage = "EN",
  currentFlag = "us",
  languages = [] as Language[],
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;

const currentPath = Astro.url.pathname;

// Known locale URL prefixes (lowercase content-dir codes), excluding English/base.
const localeCodes = languages
  .map((l) => l.langCode)
  .filter((c) => c && c.toLowerCase() !== "en");

// Strip a leading locale segment so switching from one language to another
// replaces the prefix instead of stacking it (e.g. /pt-br/about/ -> /about/).
const firstSegment = currentPath.split("/").filter(Boolean)[0];
const basePath =
  firstSegment && localeCodes.includes(firstSegment)
    ? currentPath.slice(firstSegment.length + 1) || "/"
    : currentPath;

// Build the href for a target language: English (or empty code) links to the
// unprefixed base path; every other locale prefixes the base path.
const localeHref = (langCode: string) => {
  if (!langCode || langCode.toLowerCase() === "en") return basePath || "/";
  return `/${langCode}${basePath}`;
};

const navInstanceId = crypto.randomUUID();
const dropdownId = `dropdown-toggle-${crypto.randomUUID()}`;
const contentId = `dropdown-content-${crypto.randomUUID()}`;
const groupName = `lang-switcher-${navInstanceId}`;
---

<div
  class:list={["lang-switcher", className]}
  {...htmlAttributes}
>
  <ul class="lang-switcher-list">
    <li class="nav-item has-children">
      <input
        type="checkbox"
        name={groupName}
        id={dropdownId}
        class="nav-item-toggle"
        aria-expanded="false"
        aria-controls={contentId}
        autocomplete="off"
      />
      <label
        for={dropdownId}
        class="nav-item-trigger"
        role="button"
        aria-controls={contentId}
        tabindex="0"
      >
        <Image
          source={`/src/assets/images/${currentFlag}.svg`}
          alt=""
          aria-hidden="true"
          class="lang-flag"
        />
        <span>{currentLanguage}</span>
      </label>
      <div
        id={contentId}
        class="nav-item-content"
        role="region"
        aria-label={`${currentLanguage} submenu`}
        aria-hidden="true"
      >
        <ul class="nav-list">
          {
            languages.map((lang: Language) => (
              <li class="nav-item">
                <a href={localeHref(lang.langCode)}>
                  <Image
                    source={`/src/assets/images/${lang.flag}.svg`}
                    alt=""
                    aria-hidden="true"
                    class="lang-flag"
                  />
                  <span>{lang.name}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </li>
  </ul>
</div>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";

  let langGlobalHandlersBound = false;

  function updateAriaStates(toggle, isExpanded) {
    const contentId = toggle.getAttribute("aria-controls");
    const content = document.getElementById(contentId || "");
    const triggerId = toggle.getAttribute("id");
    const trigger = document.querySelector(`label[for="${triggerId}"]`);

    toggle.setAttribute("aria-expanded", isExpanded.toString());

    if (content) {
      content.setAttribute("aria-hidden", (!isExpanded).toString());
      content.querySelectorAll(".nav-item-nested").forEach((nested) => {
        nested.setAttribute("aria-hidden", (!isExpanded).toString());
      });
    }

    if (trigger) {
      trigger.setAttribute("aria-expanded", isExpanded.toString());
    }
  }

  // Handle toggle change events
  function handleToggleChange(e) {
    const target = e.target as HTMLInputElement;

    // Only handle checkboxes closing other checkboxes
    // Radio buttons handle themselves and don't affect parents
    if (target.type !== "checkbox") {
      updateAriaStates(target, target.checked);
      return;
    }

    const langSwitcher = target.closest(".lang-switcher");
    updateAriaStates(target, target.checked);

    if (target.checked && langSwitcher) {
      // Close other open checkbox dropdowns
      langSwitcher.querySelectorAll(".nav-item-toggle[type='checkbox']").forEach((toggle) => {
        const checkbox = toggle as HTMLInputElement;
        if (checkbox !== target && checkbox.checked) {
          checkbox.checked = false;
          updateAriaStates(checkbox, false);
        }
      });
    }
  }

  // Handle trigger click events
  function handleTriggerClick(e) {
    const label = e.currentTarget as HTMLElement;
    const toggle = document.getElementById(label.getAttribute("for") || "") as HTMLInputElement;

    if (toggle?.checked) {
      e.preventDefault();
      toggle.checked = false;
      toggle.dispatchEvent(new Event("change"));
    }
  }

  // Handle keyboard events
  function handleKeydown(e) {
    if (e.key !== "Enter" && e.key !== " ") return;

    e.preventDefault();
    const label = e.currentTarget;
    const toggle = document.getElementById(label.getAttribute("for") || "");

    if (toggle) {
      toggle.checked = !toggle.checked;
      toggle.dispatchEvent(new Event("change"));
    }
  }

  // Initialize language switcher
  function initLanguageSwitcher() {
    if (!langGlobalHandlersBound) {
      // Handle clicks outside language switcher to close dropdowns
      document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (!target) return;

        const clickedLangSwitcher = target.closest(".lang-switcher");

        // Only close dropdowns if clicking completely outside the lang switcher
        if (!clickedLangSwitcher) {
          document.querySelectorAll(".lang-switcher .nav-item-toggle").forEach((toggle) => {
            const checkbox = toggle as HTMLInputElement;
            if (checkbox.checked) {
              checkbox.checked = false;
              updateAriaStates(checkbox, false);
            }
          });
        }
      });

      // Handle escape key to close all dropdowns
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          document.querySelectorAll(".lang-switcher .nav-item-toggle").forEach((toggle) => {
            if (toggle.checked) {
              toggle.checked = false;
              updateAriaStates(toggle, false);
            }
          });
        }
      });

      langGlobalHandlersBound = true;
    }

    // Initialize all language switcher instances
    document.querySelectorAll(".lang-switcher").forEach((langSwitcher) => {
      const navElement = langSwitcher as HTMLElement;
      if (navElement.dataset.langInitialized === "true") return;
      navElement.dataset.langInitialized = "true";

      langSwitcher.querySelectorAll(".nav-item-toggle").forEach((toggle) => {
        const isChecked = toggle.checked;
        updateAriaStates(toggle, isChecked);
        toggle.addEventListener("change", handleToggleChange);
      });

      langSwitcher.querySelectorAll(".nav-item-trigger").forEach((trigger) => {
        trigger.addEventListener("click", handleTriggerClick);
        trigger.addEventListener("keydown", handleKeydown);
      });

      // Prevent clicks inside dropdown content from bubbling to document handler
      langSwitcher.querySelectorAll(".nav-item-content, .nav-item-nested").forEach((content) => {
        content.addEventListener("click", (e) => {
          // Don't stop if clicking directly on a trigger (let it handle itself)
          const target = e.target as HTMLElement;
          if (!target.closest(".nav-item-trigger")) {
            e.stopPropagation();
          }
        });
      });
    });
  }

  onPageLoad(initLanguageSwitcher);
</script>

<style>
  @layer components {
    .lang-switcher {
      .nav-item-toggle {
        display: none;
      }

      .nav-item-toggle ~ .nav-item-content,
      .nav-item-toggle ~ .nav-item-nested {
        display: none;
      }

      .nav-item-toggle:checked ~ .nav-item-content {
        animation: grow-out-centered var(--animation-normal) ease-out forwards;
        display: block;
      }

      .nav-item-toggle:checked ~ .nav-item-nested {
        animation: grow-out var(--animation-normal) ease-out forwards;
        display: block;
      }

      .nav-item-content {
        position: absolute;
        top: 100%;
        right: 0;
        z-index: var(--layer-3);
        background-color: var(--color-bg-inverse);
      }

      .nav-item-trigger {
        cursor: pointer;
        align-items: center;
        background-color: var(--color-bg-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-none);
        color: var(--color-text-strong);
        font-size: var(--font-size-sm);
        line-height: 1.5rem;
        display: inline-flex;
        flex-shrink: 0;
        gap: var(--spacing-sm);
        justify-content: center;
        min-height: 10px;
        min-width: 10px;
        padding-block: var(--spacing-em-sm);
        padding-inline: var(--spacing-em-lg);
        text-align: center;
        text-decoration: none;
        transition-duration: var(--animation-normal);
        transition-property: background-color, color, border-color;
        transition-timing-function: ease-in-out;
        font-family: var(--font-headings);
        display: inline-flex;
        max-width: 100%;
        vertical-align: middle;
        background-color: color-mix(in srgb, var(--gray-1) 10%, transparent);
        border-color: color-mix(in srgb, var(--gray-3) 30%, transparent);
        color: var(--color-text-strong);

        &:hover,
        &:focus {
          background-color: var(--color-bg-brand);
          border-color: var(--color-bg-brand);
          color: var(--color-text-strong);
        }
      }

      .lang-switcher-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .lang-flag {
        width: 24px;
        height: 16px;
        margin: 0;
        align-self: center;
      }

      .nav-item-content {
        background: var(--color-bg-inverse);
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-xs);
        margin-top: var(--spacing-md);
        max-height: min(70vh, 600px);
        max-width: min(90vw, 350px);
        min-width: 200px;
        overflow-y: auto;
        right: -45%;
        top: 100%;
        width: max-content;
        z-index: var(--layer-3);
      }

      .nav-list {
        list-style: none;
        padding: 0;
        margin: 0;
        column-count: 2;
        column-gap: var(--spacing-md);
      }

      .nav-item-content .nav-item > a {
        align-items: flex-start;
        border-radius: 0;
        color: var(--color-text-inverse);
        display: flex;
        font-family: var(--font-headings);
        gap: var(--spacing-sm);
        padding-block: var(--spacing-sm);
        padding-inline: var(--spacing-lg);
        text-decoration: none;
        width: 100%;
      }

      .nav-item-content .nav-item > a > span {
        flex: 1;
        word-wrap: break-word;
        overflow-wrap: break-word;
      }

      .nav-item-content .nav-item > a:hover {
        color: var(--color-brand);
      }
    }
  }
</style>
