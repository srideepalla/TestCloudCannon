---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Bar from "@components/navigation/bar/Bar.astro";
import Mobile from "@components/navigation/mobile/Mobile.astro";
import Image from "@core-elements/image/Image.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";
import { localizePath } from "@utils/i18n";

type NavButton = {
  text?: string;
  /** Canonical destination key used by Button.astro and the nav JSON. */
  link?: string;
  /** Legacy alias, still accepted so older data keeps working. */
  href?: string;
  [key: string]: unknown;
};

const {
  logoSource,
  logoAlt = "logo",
  navData = [],
  buttonSections = [] as NavButton[],
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const mobileNavData = [
  ...navData,
  ...buttonSections.map((button: NavButton) => ({
    _component: button._component || "building-blocks/core-elements/button",
    name: button.text || button.currentLanguage || "Button",
    // Button data uses `link`; `href` is only a legacy fallback. Reading href
    // first left every entry undefined, so the mobile drawer rendered "#".
    path: button.link || button.href || "#",
    currentFlag: button.currentFlag || "",
    children: button.languages || [],
  })),
];
---

<CustomSection
  maxContentWidth="3xl"
  paddingHorizontal="lg"
  paddingVertical="none"
  colorScheme=""
  backgroundColor=""
  class:list={["main-nav", className]}
  {...htmlAttributes}
  useDefaultEditableBinding={false}
>
  <a href={localizePath("/", Astro.url.pathname)}>
    <Image
      source={logoSource}
      class="main-nav-logo"
      alt={logoAlt}
      useDefaultEditableBinding={false}
    />
  </a>
  <Bar
    navData={navData}
    class="desktop-main-nav"
  />
  <ButtonGroup
    direction="row"
    alignX="center"
    class="desktop-button-group"
    buttonSections={buttonSections}
    useDefaultEditableBinding={false}
  />
  <Mobile
    logoSource={logoSource}
    logoAlt={logoAlt}
    navData={mobileNavData}
    class="mobile-main-nav"
    useDefaultEditableBinding={false}
  />
</CustomSection>

<style is:global>
  @layer page-sections {
    .main-nav {
      background-color: var(--navbar-bg-color, var(--color-bg-accent));
      padding-block: var(--spacing-md);
      position: sticky;
      top: 0;
      z-index: var(--layer-2);

      .desktop-main-nav,
      .desktop-button-group.button-group {
        @media (max-width: 1024px) {
          display: none;
        }
      }

      .main-nav-logo {
        margin-top: 0 !important;
        max-width: min(250px, 45vw);
        width: 250px;
      }

      .main-nav-logo picture,
      .main-nav-logo img {
        display: block;
        height: auto;
        width: 100%;
      }

      .desktop-main-nav.bar > .bar-list > .nav-item > a:not(:hover),
      .desktop-main-nav.bar > .bar-list > .nav-item > .nav-item-trigger:not(:hover) {
        color: var(--gray-12) !important;
      }

      .desktop-main-nav.bar > .bar-list > .nav-item > a:hover,
      .desktop-main-nav.bar > .bar-list > .nav-item > .nav-item-trigger:hover {
        color: var(--color-brand) !important;
      }

      .desktop-main-nav.bar .nav-item-content a:not(:hover),
      .desktop-main-nav.bar .nav-item-content .nav-item-group-heading:not(:hover) {
        color: var(--gray-12) !important;
      }

      .desktop-main-nav.bar .nav-item-content a:hover,
      .desktop-main-nav.bar .nav-item-content .nav-item-group-heading:hover {
        color: var(--color-brand) !important;
      }

      /* The ghost button variant colours itself with --color-text-strong, which
         html[data-theme] sets to #fff — white on this bar's cream background,
         and white on gold once :hover swaps in --color-bg-brand. Both states are
         pinned to black so the button matches the nav links beside it. */
      .desktop-button-group.button-group .button-inner,
      .desktop-button-group.button-group .button-inner:hover,
      .desktop-button-group.button-group .button-inner:focus {
        color: var(--gray-12) !important;
      }

      .nav-hamburger.mobile-button {
        @media (min-width: 1025px) {
          display: none;
        }
      }

      > .outer-content > .content {
        align-items: center;
        container-type: inline-size;
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: var(--spacing-md);

        @media (width < 1025px) {
          grid-template-columns: 1fr auto;
        }

        > a {
          grid-column: 1;
          justify-self: start;

          > .image img {
            max-width: 250px;
          }
        }

        > .desktop-main-nav.bar {
          grid-column: 2;
          min-width: 0;
        }

        > .desktop-button-group.button-group {
          container-type: normal;
          grid-column: 3;
          justify-self: end;
          margin-top: 0;
        }

        > .mobile-main-nav {
          grid-column: 3;
          justify-self: end;
        }
      }
    }

    /* Deliberately NOT nested inside .main-nav. Mobile.astro's script relocates
       the drawer to #overlays-container at the top of <body>, so nesting compiled
       this to `.main-nav .mobile`, which stops matching the moment the element
       moves. The drawer therefore stayed display:flex at desktop widths, hidden
       only by a transform — which does not remove it from the tab order, so its
       links became the first tab stops on the page, ahead of the skip link.

       Safe as a bare class selector: class="mobile" is used by exactly one
       element in the codebase. Layer order (reset, base, components,
       page-sections, ...) puts this after Mobile.astro's `display: flex` in
       @layer components, so it wins without needing !important. */
    @media (min-width: 1025px) {
      .mobile {
        display: none;
      }
    }
  }
</style>
