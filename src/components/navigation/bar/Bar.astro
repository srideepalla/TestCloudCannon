---
import Icon from "@core-elements/icon/Icon.astro";
import { itemHasSplitNavLink } from "@component-utils/navSplitLink";
import { localizePath } from "@utils/i18n";

const {
  navData = [],
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const navInstanceId = crypto.randomUUID();
const pathname = Astro.url.pathname;

function isCurrentPage(item: any) {
  return Boolean(item.path && pathname === localizePath(item.path, pathname));
}

function hasCurrentChild(item: any) {
  if (isCurrentPage(item)) return true;
  return Boolean(item.children?.some((child: any) => hasCurrentChild(child)));
}

// Helper function to create navigation item data
function createNavItemData(item: any, level: any, parentGroupId: any) {
  const hasChildren = Boolean(item.children?.length);

  return {
    ...item,
    hasChildren,
    hasSplitLink: itemHasSplitNavLink(item),
    level,
    dropdownId: `dropdown-toggle-${crypto.randomUUID()}`,
    contentId: `dropdown-content-${crypto.randomUUID()}`,
    isCurrent: isCurrentPage(item),
    hasCurrent: hasCurrentChild(item),
    groupName: level === "top" ? `bar-nav-top-${navInstanceId}` : `bar-nav-${parentGroupId}`,
    parentGroupId: parentGroupId || crypto.randomUUID(),
  };
}
---

<nav
  class:list={["bar", className]}
  aria-label="Main"
  {...htmlAttributes}
>
  <ul class="bar-list">
    {
      navData.map((item: any) => {
        const itemData = createNavItemData(item, "top", null);

        if (!itemData.hasChildren) {
          return (
            <li class="nav-item">
              <a
                href={localizePath(itemData.path, pathname)}
                target={itemData.openInNewTab ? "_blank" : undefined}
                rel={itemData.openInNewTab ? "noopener" : undefined}
                aria-current={itemData.isCurrent ? "page" : undefined}
              >
                {itemData.name}
              </a>
            </li>
          );
        }

        return (
          <li class="nav-item has-children">
            {/* CSS state holder, not a control: display:none at every breakpoint,
                with the real semantics (aria-expanded, aria-controls, aria-label)
                on the trigger button below. Marking it so keeps DOM-only auditors
                from filing it as an unlabelled form field. */}
            <input
              type="checkbox"
              name={itemData.groupName}
              id={itemData.dropdownId}
              class="nav-item-toggle"
              aria-controls={itemData.contentId}
              autocomplete="off"
              aria-hidden="true"
              tabindex="-1"
            />
            {itemData.hasSplitLink ? (
              <div class="nav-item-split">
                <a
                  href={localizePath(itemData.path, pathname)}
                  class="nav-item-link"
                  target={itemData.openInNewTab ? "_blank" : undefined}
                  rel={itemData.openInNewTab ? "noopener" : undefined}
                  aria-current={itemData.isCurrent ? "page" : undefined}
                >
                  {itemData.name}
                </a>
                <button
                  type="button"
                  data-toggle-for={itemData.dropdownId}
                  class="nav-item-trigger nav-item-toggle-btn"
                  aria-controls={itemData.contentId}
                  aria-expanded="false"
                  aria-label={`Toggle ${itemData.name} submenu`}
                >
                  <span class="nav-item-icon">
                    <Icon
                      name="chevron-down"
                      size="none"
                      aria-hidden="true"
                    />
                  </span>
                </button>
              </div>
            ) : (
              <button
                type="button"
                data-toggle-for={itemData.dropdownId}
                class="nav-item-trigger"
                aria-controls={itemData.contentId}
                aria-expanded="false"
                aria-current={itemData.isCurrent ? "page" : undefined}
              >
                {itemData.name}
                <span class="nav-item-icon">
                  <Icon
                    name="chevron-down"
                    size="none"
                    aria-hidden="true"
                  />
                </span>
              </button>
            )}
            <div
              id={itemData.contentId}
              class="nav-item-content"
              {/* No aria-hidden: the closed state is display:none, which already
                  removes this from the accessibility tree. A static aria-hidden
                  would persist when CSS opens the menu on hover or focus, hiding
                  the links from assistive tech while they remain tabbable. */}
            >
              <ul class="nav-list">
                {itemData.children!.map((child: any) => {
                  const childData = createNavItemData(child, "child", itemData.parentGroupId);

                  if (!childData.hasChildren) {
                    return (
                      <li class="nav-item">
                        <a
                          href={localizePath(childData.path, pathname)}
                          target={childData.openInNewTab ? "_blank" : undefined}
                          rel={childData.openInNewTab ? "noopener" : undefined}
                          aria-current={childData.isCurrent ? "page" : undefined}
                        >
                          {childData.name}
                        </a>
                      </li>
                    );
                  }

                  return (
                    <li class="nav-item has-children">
                      {/* CSS state holder, not a control — see above. */}
                      <input
                        type="radio"
                        name={childData.groupName}
                        id={childData.dropdownId}
                        class="nav-item-toggle"
                        aria-controls={childData.contentId}
                        autocomplete="off"
                        aria-hidden="true"
                        tabindex="-1"
                      />
                      {childData.hasSplitLink ? (
                        <div class="nav-item-split">
                          <a
                            href={localizePath(childData.path, pathname)}
                            class="nav-item-link"
                            target={childData.openInNewTab ? "_blank" : undefined}
                            rel={childData.openInNewTab ? "noopener" : undefined}
                            aria-current={childData.isCurrent ? "page" : undefined}
                          >
                            {childData.name}
                          </a>
                          <button
                            type="button"
                            data-toggle-for={childData.dropdownId}
                            class="nav-item-trigger nav-item-toggle-btn"
                            aria-controls={childData.contentId}
                            aria-expanded="false"
                            aria-label={`Toggle ${childData.name} submenu`}
                          >
                            <span class="nav-item-icon">
                              <Icon
                                name="chevron-right"
                                size="none"
                                aria-hidden="true"
                              />
                            </span>
                          </button>
                        </div>
                      ) : (
                        <button
                          type="button"
                          data-toggle-for={childData.dropdownId}
                          class="nav-item-trigger"
                          aria-controls={childData.contentId}
                          aria-expanded="false"
                          aria-current={childData.isCurrent ? "page" : undefined}
                        >
                          {childData.name}
                          <span class="nav-item-icon">
                            <Icon
                              name="chevron-right"
                              size="none"
                              aria-hidden="true"
                            />
                          </span>
                        </button>
                      )}
                      <div
                        id={childData.contentId}
                        class="nav-item-nested"
                      >
                        <ul class="nav-list">
                          {childData.children!.map((grandChild: any) => {
                            const grandChildData = createNavItemData(
                              grandChild,
                              "child",
                              childData.parentGroupId
                            );

                            return (
                              <li class="nav-item">
                                <a
                                  href={localizePath(grandChildData.path, pathname)}
                                  target={grandChildData.openInNewTab ? "_blank" : undefined}
                                  rel={grandChildData.openInNewTab ? "noopener" : undefined}
                                  aria-current={grandChildData.isCurrent ? "page" : undefined}
                                >
                                  {grandChildData.name}
                                </a>
                              </li>
                            );
                          })}
                        </ul>
                      </div>
                    </li>
                  );
                })}
              </ul>
            </div>
          </li>
        );
      })
    }
  </ul>
</nav>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";

  let barGlobalHandlersBound = false;

  // The dropdown panels carry no aria-hidden: display:none already removes them
  // from the accessibility tree, and a JS-managed attribute went stale whenever
  // CSS opened a menu on hover or :focus-visible without firing a change event.
  // State belongs on the trigger, which is what screen readers announce.
  function updateAriaStates(toggle: any, isExpanded: any) {
    const triggerId = toggle.getAttribute("id");
    const barRoot = toggle.closest(".bar");
    const toggleBtn = barRoot?.querySelector(
      `button.nav-item-toggle-btn[data-toggle-for="${triggerId}"]`
    );
    const fullTrigger =
      barRoot?.querySelector(
        `button.nav-item-trigger:not(.nav-item-toggle-btn)[data-toggle-for="${triggerId}"]`
      ) ?? null;

    if (toggleBtn) {
      toggleBtn.setAttribute("aria-expanded", isExpanded.toString());
    }

    if (fullTrigger) {
      fullTrigger.setAttribute("aria-expanded", isExpanded.toString());
    }
  }

  // Handle toggle change events
  function handleToggleChange(e: any) {
    const target = e.target as HTMLInputElement;

    // Only handle checkboxes closing other checkboxes
    // Radio buttons handle themselves and don't affect parents
    if (target.type !== "checkbox") {
      updateAriaStates(target, target.checked);
      return;
    }

    const barNav = target.closest(".bar");
    updateAriaStates(target, target.checked);

    if (target.checked && barNav) {
      // Close other open checkbox dropdowns
      barNav.querySelectorAll(".nav-item-toggle[type='checkbox']").forEach((toggle) => {
        const checkbox = toggle as HTMLInputElement;
        if (checkbox !== target && checkbox.checked) {
          checkbox.checked = false;
          updateAriaStates(checkbox, false);
        }
      });
    }
  }

  // The trigger is a real <button>, so it no longer toggles the checkbox natively
  // the way a <label for> did — this handler owns both opening and closing.
  // No keydown handler: a button already fires click on Enter and Space, and
  // handling keydown as well would toggle twice and cancel itself out.
  function handleTriggerClick(e: any) {
    const trigger = e.currentTarget as HTMLElement;
    const toggle = document.getElementById(
      trigger.getAttribute("data-toggle-for") || ""
    ) as HTMLInputElement;
    if (!toggle) return;

    toggle.checked = !toggle.checked;
    toggle.dispatchEvent(new Event("change"));
  }

  // CSS also opens a menu on :hover and :has(:focus-visible), neither of which
  // fires a change event. Without this the trigger keeps reporting
  // aria-expanded="false" while the panel is open and its links are focusable
  // (WCAG 4.1.2). Mirror whatever the CSS is actually showing.
  function syncOpenState(item: Element) {
    const toggle = item.querySelector(":scope > .nav-item-toggle") as HTMLInputElement | null;
    if (!toggle) return;

    // Mirror the conditions the CSS actually opens on, rather than reading the
    // panel's computed display. The panel closes via `transition: display 0s
    // allow-discrete`, so a display read taken mid-close still says "block" and
    // would re-assert aria-expanded="true" right after Escape set it to false.
    //
    // matches() throws SyntaxError on a selector the engine cannot parse, and
    // :has() is unsupported on Firefox ESR 115, so it is guarded. Where :has()
    // does not parse, the CSS rule that opens the menu on focus does not apply
    // either, so treating it as "not open" is the correct fallback.
    const safeMatches = (el: Element, selector: string) => {
      try {
        return el.matches(selector);
      } catch {
        return false;
      }
    };

    const open =
      toggle.checked || safeMatches(item, ":hover") || safeMatches(item, ":has(:focus-visible)");
    updateAriaStates(toggle, open);
  }

  // Initialize bar navigation
  function initBarNavigation() {
    if (!barGlobalHandlersBound) {
      // Handle clicks outside bar navigation to close dropdowns
      document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (!target) return;

        const clickedBar = target.closest(".bar");

        // Only close dropdowns if clicking completely outside the bar
        if (!clickedBar) {
          document.querySelectorAll(".bar .nav-item-toggle").forEach((toggle) => {
            const checkbox = toggle as HTMLInputElement;
            if (checkbox.checked) {
              checkbox.checked = false;
              updateAriaStates(checkbox, false);
            }
          });
        }
      });

      // Handle escape key to close all dropdowns
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          document.querySelectorAll(".bar .nav-item-toggle").forEach((toggle) => {
            const checkbox = toggle as HTMLInputElement;

            if (checkbox.checked) {
              checkbox.checked = false;
              updateAriaStates(checkbox, false);
            }
          });
        }
      });

      barGlobalHandlersBound = true;
    }

    // Initialize all bar navigation instances
    document.querySelectorAll(".bar").forEach((barNav) => {
      const navElement = barNav as HTMLElement;
      if (navElement.dataset.barInitialized === "true") return;
      navElement.dataset.barInitialized = "true";

      barNav.querySelectorAll(".nav-item-toggle").forEach((toggle) => {
        const checkbox = toggle as HTMLInputElement;
        const isChecked = checkbox.checked;
        updateAriaStates(checkbox, isChecked);
        checkbox.addEventListener("change", handleToggleChange);
      });

      barNav.querySelectorAll(".nav-item-toggle-btn").forEach((trigger) => {
        trigger.addEventListener("click", handleTriggerClick);
      });

      barNav.querySelectorAll(".nav-item.has-children > .nav-item-trigger").forEach((trigger) => {
        trigger.addEventListener("click", handleTriggerClick);
      });

      // Tabbing out of a focus-opened menu used to land on <body>, and the next
      // Tab skipped the menu entirely — so its links were reachable only after
      // Enter/Space (WCAG 2.1.1, and focus vanishing breaks 2.4.3).
      //
      // Cause: the panel is displayed only while
      // `.nav-item.has-children:has(:focus-visible)` matches. Tab blurs the
      // trigger before focus reaches the first link, so for that instant nothing
      // inside the item is :focus-visible, the panel flips to display:none, and
      // the link the browser was moving to stops being focusable — focus falls
      // back to <body>.
      //
      // CSS cannot bridge that gap (:focus-within would also pin a menu open
      // after a mouse click, which is why :has(:focus-visible) was chosen). So
      // commit the open state to the checkbox *before* the browser moves focus:
      // `.nav-item-toggle:checked ~ .nav-item-content` then holds the panel open
      // regardless of where focus is mid-transition.
      // Descendant selectors, not `>`: a nested submenu's control is a
      // .nav-item-toggle-btn inside .nav-item-split, so a child selector matches
      // only the top-level triggers and leaves the nested ones dropping focus.
      // closest() below resolves whichever item actually owns the control.
      barNav
        .querySelectorAll(
          ".nav-item.has-children .nav-item-trigger, .nav-item.has-children .nav-item-toggle-btn"
        )
        .forEach((trigger) => {
          trigger.addEventListener("keydown", (event) => {
            const e = event as KeyboardEvent;

            if (e.key !== "Tab" || e.shiftKey || e.altKey || e.ctrlKey || e.metaKey) return;

            const item = (trigger as HTMLElement).closest(".nav-item.has-children");
            const toggle = item?.querySelector(
              ":scope > .nav-item-toggle"
            ) as HTMLInputElement | null;

            if (!item || !toggle || toggle.checked) return;

            // Only when the menu is genuinely open on focus. A closed menu must
            // let Tab move on to the next item, as it does today.
            let openOnFocus = false;

            try {
              openOnFocus = item.matches(":has(:focus-visible)");
            } catch {
              // :has() unsupported (Firefox ESR 115) — the CSS rule that opens on
              // focus does not apply either, so there is nothing to hold open.
              return;
            }
            if (!openOnFocus) return;

            toggle.checked = true;
            updateAriaStates(toggle, true);
          });
        });

      // Counterpart to the commit above: once focus has genuinely left the item,
      // release the checkbox so the menu does not stay pinned open. Read
      // activeElement on the next frame rather than trusting relatedTarget, which
      // is null when focus lands on <body> mid-transition.
      barNav.querySelectorAll(".nav-item.has-children").forEach((item) => {
        item.addEventListener("focusout", () => {
          requestAnimationFrame(() => {
            if (item.contains(document.activeElement)) return;

            let hovered = false;
            try {
              hovered = item.matches(":hover");
            } catch {
              hovered = false;
            }
            // Hover owns the menu while the cursor is on it; closing here would
            // fight the hover rule.
            if (hovered) return;

            const toggle = item.querySelector(
              ":scope > .nav-item-toggle"
            ) as HTMLInputElement | null;

            if (toggle?.checked) {
              toggle.checked = false;
              updateAriaStates(toggle, false);
            }
          });
        });
      });

      // Keep aria-expanded honest for the hover- and focus-opened paths.
      barNav.querySelectorAll(".nav-item.has-children").forEach((item) => {
        ["mouseenter", "mouseleave", "focusin", "focusout"].forEach((evt) => {
          item.addEventListener(evt, () => {
            // Let the CSS transition settle before reading computed display.
            requestAnimationFrame(() => syncOpenState(item));
          });
        });
      });

      // Hovering one top-level item closes any dropdown pinned open on another
      // via a clicked checkbox, so two click-opened menus never show at once.
      //
      // Deliberately does NOT blur() a lingering keyboard focus in another item
      // (removed — see WCAG 2.4.3): that silently destroyed keyboard focus with
      // nothing re-focused, disorienting keyboard/AT users. The rare cosmetic
      // cost — a keyboard-opened menu staying visible a moment while a hovered
      // menu also opens — is preferable to losing focus entirely.
      barNav.querySelectorAll(":scope > .bar-list > .nav-item").forEach((item) => {
        item.addEventListener("mouseenter", () => {
          barNav.querySelectorAll(".nav-item-toggle[type='checkbox']").forEach((toggle) => {
            const checkbox = toggle as HTMLInputElement;
            if (checkbox.checked && checkbox.closest(".bar-list > .nav-item") !== item) {
              checkbox.checked = false;
              updateAriaStates(checkbox, false);
            }
          });
        });
      });

      // Prevent clicks inside dropdown content from bubbling to document handler
      barNav.querySelectorAll(".nav-item-content, .nav-item-nested").forEach((content) => {
        content.addEventListener("click", (e) => {
          const target = e.target as HTMLElement;
          if (!target.closest(".nav-item-trigger") && !target.closest(".nav-item-link")) {
            e.stopPropagation();
          }
        });
      });
    });
  }

  onPageLoad(initBarNavigation);
</script>

<style>
  @layer components {
    .bar {
      font-weight: var(--font-weight-semibold);
      .bar-list {
        align-items: center;
        justify-content: center;
        display: flex;

        /* Fluid spacing between top-level nav items. Held at the previous
           0.5rem at the 1025px breakpoint — with 10 nowrap items in a
           min-width:0 grid column there is no spare width there — and opened up
           to 1.5rem on wider screens where the room exists. */
        gap: clamp(0.5rem, 1.8vw - 10px, 1.5rem);
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .nav-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .nav-item {
        position: relative;
      }

      > .bar-list > .nav-item:last-child {
        margin-inline-start: var(--spacing-md);
      }

      > .bar-list > .nav-item > a,
      > .bar-list > .nav-item > .nav-item-trigger,
      > .bar-list > .nav-item > .nav-item-split {
        border-radius: var(--radius-xs);
        color: var(--gray-12) !important;
        cursor: pointer;
        display: block;
        font-family: var(--font-headings);
        font-size: var(--font-size-xs);
        font-weight: var(--font-weight-medium);
        padding-block: var(--spacing-sm);
        text-decoration: none;
        transition: background var(--animation-normal) ease-in-out;
        white-space: nowrap;
      }

      > .bar-list > .nav-item > a:not(:hover),
      > .bar-list > .nav-item > .nav-item-trigger:not(:hover) {
        color: var(--gray-12) !important;
      }

      > .bar-list > .nav-item > .nav-item-trigger:hover,
      > .bar-list > .nav-item > a:hover {
        color: var(--color-brand) !important;
      }

      .nav-item-split {
        align-items: center;
        display: flex;
        flex-wrap: nowrap;
        min-width: 0;

        .nav-item-link {
          color: var(--gray-12) !important;
          cursor: pointer;
          display: block;
          flex: 1 1 auto;
          min-width: 0;
          padding: 0 var(--spacing-xs) 0 0;
          text-decoration: none;
          transition: color var(--animation-normal) ease-in-out;
          white-space: nowrap;

          &:hover {
            color: var(--color-brand) !important;
          }
        }

        .nav-item-toggle-btn {
          align-items: center;
          aspect-ratio: 1;
          border: 1px solid transparent;
          border-radius: var(--radius-xs);
          box-sizing: border-box;
          cursor: pointer;
          display: flex;
          flex: 0 0 auto;
          /* 2em = 24px at this element's 12px font-size — the WCAG 2.5.8 minimum.
             Was 1.75em (21px). */
          height: 2em;
          justify-content: center;
          margin-inline-end: 4px;
          padding: 0;
          width: 2em;
          transition:
            background var(--animation-normal) ease-in-out,
            border-color var(--animation-normal) ease-in-out;

          .nav-item-icon {
            align-items: center;
            display: flex;
            justify-content: center;
            line-height: 0;
            top: 0;
            margin: 0;
          }
        }

        &:hover {
          .nav-item-toggle-btn {
            background: color-mix(in srgb, var(--color-state-hover), var(--color-text) 3%);
          }
        }

        .nav-item-toggle-btn:hover {
          background: color-mix(in srgb, var(--color-state-hover), var(--color-text) 8%);
          border-color: var(--color-border);
        }
      }

      .nav-item-trigger {
        align-items: center;
        display: flex;
        gap: var(--spacing-xs);

        /* These triggers are real <button>s now (they used to be <label>s, which
           carry no UA chrome). Strip the button styling so the rendered result is
           unchanged. .nav-item-split .nav-item-toggle-btn is more specific, so its
           own border and sizing still win over the border:0 here.

           The explicit background/border/color/font/padding below are what actually
           neutralise the UA button styling, on every engine. `appearance: none` is
           belt-and-braces only: lightningcss runs with no browser targets set, so
           it emits this unprefixed and strips any -webkit- prefix added by hand. */
        appearance: none;
        background: none;
        border: 0;
        color: inherit;
        cursor: pointer;
        font: inherit;
        padding: 0;
        text-align: inherit;
      }

      .nav-item-icon {
        display: inline-block;
        transition:
          color var(--animation-normal) ease-in-out,
          transform var(--animation-normal) ease-in-out;
        width: 1rem;
        position: relative;
        margin-left: var(--spacing-xs);

        :global(path) {
          stroke-width: 3px;
          stroke: var(--color-text);
        }
      }

      /* Top-level chevrons follow their label instead of --color-text, which is
         a theme token set by the page's colour scheme and does not track the
         explicit link colour above — it left the arrows light on a light bar. */
      > .bar-list > .nav-item > .nav-item-trigger > .nav-item-icon,
      > .bar-list > .nav-item > .nav-item-split .nav-item-icon {
        /* Nested, not `... .nav-item-icon :global(path)` on one line: Astro only
           resolves :global() when it is the whole nested selector, and the
           single-line form shipped a literal `:global(path)` that matched
           nothing. */
        :global(path) {
          stroke: currentColor;
        }
      }

      .nav-item-trigger:hover .nav-item-icon {
        color: var(--color-text-strong);
      }

      .nav-item-toggle:checked ~ .nav-item-trigger .nav-item-icon,
      .nav-item-toggle:checked ~ .nav-item-split .nav-item-icon {
        transform: rotate(180deg);
      }

      .nav-item-content .nav-item-toggle:checked ~ .nav-item-trigger .nav-item-icon,
      .nav-item-content .nav-item-toggle:checked ~ .nav-item-split .nav-item-icon {
        transform: rotate(90deg);
      }

      .nav-item-toggle {
        display: none;
      }

      /* Closing waits 80ms before a quick fade-out, fully gone at 140ms,
         so brief cursor slips off the menu don't snap it shut */
      .nav-item-toggle ~ .nav-item-content {
        display: none;
        opacity: 0;
        transition:
          display 0s allow-discrete 0.14s,
          visibility 0s 0.14s,
          opacity 0.06s ease 0.08s;
        visibility: hidden;
      }

      /* No grace when the cursor is already on a different top-level item:
         close the old dropdown right away so two menus never overlap */
      .bar-list:has(> .nav-item:hover) > .nav-item:not(:hover) > .nav-item-content {
        transition:
          display 0s allow-discrete 0.08s,
          visibility 0s 0.08s,
          opacity 0.08s ease;
      }

      /* Nested fly-outs get a longer 200ms grace (gone at 260ms) since the
         diagonal path from trigger to fly-out crosses neighboring items */
      .nav-item-toggle ~ .nav-item-nested {
        display: none;
        opacity: 0;
        transition:
