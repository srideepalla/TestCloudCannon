---
import footerData from "@data/footer.json";
import mainNavData from "@data/mainNav.json";
import CollectionLayout from "@layouts/CollectionLayout.astro";
import Page from "@layouts/Page.astro";
import { draftFilter } from "@utils/draft-filter";
import LocalizedLink from "@components/utils/LocalizedLink.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

const componentImports = {
  ...import.meta.glob("../components/building-blocks/**/*.astro", { eager: true }),
  ...import.meta.glob("../components/page-sections/**/*.astro", { eager: true }),
};

const mdxComponents: Record<string, any> = {};

Object.entries(componentImports).forEach(([path, module]) => {
  const fileName = path.split("/").at(-1)!.replace(".astro", "");

  mdxComponents[fileName] = (module as any).default;
});

// Localize internal links inside rendered markdown/MDX bodies (keeps the locale).
mdxComponents.a = LocalizedLink;

// Collections that should use the sidebar layout
const SIDEBAR_COLLECTIONS = [
  "about",
  "awards",
  "enter",
  "judges",
  "press",
  "tickets",
  "sponsors",
  "webinars",
];

export interface Props {
  page: CollectionEntry<"pages">;
}

export async function getStaticPaths() {
  const INDIVIDUAL_ROUTES = new Set([
    "privacy",
    "refund-policy",
    "thank-you-for-requesting-the-iba-entry-kit",
  ]);

  const pages = await getCollection("pages", draftFilter);

  return pages
    .filter((page) => {
      return !INDIVIDUAL_ROUTES.has(page.id);
    })
    .map((page) => {
      const slug = page.id.replace(/index$/, "");

      if (slug.length === 0) return { params: { slug: undefined }, props: { page } };
      return { params: { slug }, props: { page } };
    });
}

const { page } = Astro.props;
const { Content } = await render(page);

// Determine if this page should use CollectionLayout
// Check if the page path starts with a sidebar collection (e.g., es/about/, en/about/, about/)
const pageId = page.id;
const pathParts = pageId.split("/");
let collectionName: string | null = null;

// Frontmatter override: explicit sidebar collection
if (page.data.sidebarCollection && SIDEBAR_COLLECTIONS.includes(page.data.sidebarCollection)) {
  collectionName = page.data.sidebarCollection;
} else {
  // Check patterns like "es/about/page" or "about/page"
  for (const part of pathParts) {
    if (SIDEBAR_COLLECTIONS.includes(part)) {
      collectionName = part;
      break;
    }
  }
}

const useSidebarLayout = collectionName !== null;
---

{
  useSidebarLayout ? (
    <CollectionLayout
      title={page.data.title || ""}
      pageHeading={page.data.pageHeading || ""}
      description={page.data.description || ""}
      image={page.data.image || ""}
      collection={collectionName}
      entry={page}
    />
  ) : (
    <Page
      frontmatter={page.data}
      mainNav={mainNavData}
      footer={footerData}
    >
      <Content components={mdxComponents} />
    </Page>
  )
}
