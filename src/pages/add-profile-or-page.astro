---
// Bare admin route: no site nav/footer, just the profiles-api Worker's own
// form filling the page. Swap FORM_URL back to the live Worker once the
// temporary tunnel used for testing goes away.
const FORM_URL = "https://enterprises-trying-motherboard-valium.trycloudflare.com/new";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Add a Profile or Page</title>
  </head>
  <body>
    <iframe src={FORM_URL} title="Add a profile or page" />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    height: 100%;
  }

  iframe {
    border: 0;
    display: block;
    width: 100vw;
    height: 100vh;
  }
</style>
