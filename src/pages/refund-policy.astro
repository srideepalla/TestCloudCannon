---
import CollectionLayout from "@layouts/CollectionLayout.astro";
import { getEntry } from "astro:content";

const entry = await getEntry("pages", "refund-policy");
---

<CollectionLayout
  title={entry?.data.title || "Refund Policy"}
  pageHeading={entry?.data.pageHeading || ""}
  description={entry?.data.description || ""}
  image={entry?.data.image || ""}
  collection="about"
  entry={entry}
/>
