---
import ProfilesListLayout from "@layouts/ProfilesListLayout.astro";
import { draftFilter } from "@utils/draft-filter";
import { getCollection } from "astro:content";

const entries = await getCollection(
  "profiles",
  (entry) => draftFilter(entry) && entry.data.type === "person",
);
---

<ProfilesListLayout
  title="People"
  description="Person profiles."
  breadcrumbCurrent="People"
  entries={entries}
/>
