# ─────────────────────────────────────────────────────────────────────────────
# Enquiry / contact form (Zendesk Requests API)
# ─────────────────────────────────────────────────────────────────────────────
# This is a static site, so the enquiry form (src/pages/enquiry.astro) submits
# from the browser straight to the Zendesk Requests API as an anonymous request.
# No API token is involved — the Requests API creates end-user requests without
# credentials (we deliberately do NOT use the Tickets API).
#
# PUBLIC_* on purpose: exposed to the browser. The endpoint URL is not a secret.
# Never put a Zendesk API token here.
#
# Optional overrides — the form already hardcodes these defaults in
# src/utils/enquiry-routing.ts (ZENDESK_REQUEST_ENDPOINT / ZENDESK_UPLOADS_ENDPOINT).
# Set these only to point at a different Zendesk subdomain.
PUBLIC_ZENDESK_REQUEST_ENDPOINT=https://thestevieawardshelp.zendesk.com/api/v2/requests.json
PUBLIC_ZENDESK_UPLOADS_ENDPOINT=https://thestevieawardshelp.zendesk.com/api/v2/uploads.json

# --- Search Past Winners -----------------------------------------------------
# Base URL of the read-only winners API (StevieIntel/public_api.py), no trailing
# slash. The site builds static, so this search runs in the visitor's browser --
# which means localhost only works while developing on the same machine. For a
# deployed site this must be a URL the visitor can reach: run
# StevieIntel/go_live_api.ps1 for a public HTTPS tunnel, or host the API.
#
# PUBLIC_* on purpose: exposed to the browser. The API is read-only and
# unauthenticated by design, so there is no token to leak -- and nowhere to hide
# one in a static build. Never put a credential here.
#
# An editor can also override this per-component in CloudCannon (apiEndpoint),
# which is the easier path while a quick-tunnel URL keeps changing.
PUBLIC_WINNERS_API_ENDPOINT=http://127.0.0.1:8010

# --- Blog Generator -----------------------------------------------------------
# Base URL of the StevieIntel server that hosts the on-demand blog writer
# (server.py's /api/blog-writer/* routes, Gemini-backed via blog_writer.py) --
# the same server static/blog_writer.html already talks to locally, port 8002
# by default. This is a DIFFERENT server than public_api.py above: Search Past
# Winners and Blog Generator are two separate StevieIntel processes, each with
# its own tunnel when testing off the same laptop.
#
# PUBLIC_* on purpose: exposed to the browser. The Gemini API key itself never
# leaves the server -- the browser only ever calls our own FastAPI route, which
# calls Gemini server-side. Never put a token here.
#
# An editor can also override this per-component in CloudCannon (apiEndpoint),
# which is the easier path while a quick-tunnel URL keeps changing.
PUBLIC_BLOG_API_ENDPOINT=http://127.0.0.1:8002
